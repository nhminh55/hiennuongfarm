---
import { contact } from '../data/site';
import BrandLogo from './BrandLogo.astro';

interface Props {
  /** Transparent header over a full-bleed hero; turns solid on scroll. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

// Header navigation. Kept separate from the footer's `nav` (src/data/site.ts):
// the header says "Sản phẩm"; homepage section headings keep "Sản vật".
const links = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Về Hiền Nương', href: '/#ve-hien-nuong' },
  { label: 'Nông nghiệp tuần hoàn', href: '/#tuan-hoan' },
  { label: 'Sản phẩm', href: '/san-pham/' },
  { label: 'Vùng Bảy Núi', href: '/#bay-nui' },
  { label: 'Hợp tác', href: '/#hop-tac' },
];
// Contact details sit in the Hợp tác section until a contact page exists.
const contactLink = { label: 'Liên hệ', href: '/#hop-tac' };

// Home is current only on "/"; a page link is current for its own path and
// everything below it; in-page section links are never "current".
const path = Astro.url.pathname;
const current = (href: string) => {
  if (href === '/') return path === '/' ? 'page' : undefined;
  if (href.includes('#')) return undefined;
  return path.startsWith(href) ? 'page' : undefined;
};
---
<header
  class:list={['site-header', { 'site-header--overlay': overlay }]}
  data-header
  data-overlay={overlay ? '' : undefined}
>
  <div class="site-header__bar">
    <div class="container site-header__inner">
      <BrandLogo href="/" class="site-header__brand" menuVariant />

      <nav class="site-nav" aria-label="Điều hướng chính">
        <ul class="site-nav__list">
          {links.map((item) => (
            <li><a class="site-nav__link" href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
          ))}
          <li class="site-nav__contact">
            <a class="site-nav__link" href={contactLink.href}>{contactLink.label}</a>
          </li>
        </ul>
      </nav>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle__label" data-menu-label>Menu</span>
        <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <div class="container mobile-menu__inner">
      <nav aria-label="Điều hướng">
        <ol class="mobile-menu__list">
          {links.map((item, i) => (
            <li>
              <a class="mobile-menu__link" href={item.href} aria-current={current(item.href)} data-menu-link>
                <span class="mobile-menu__num" aria-hidden="true">{i === 0 ? '—' : String(i).padStart(2, '0')}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- VERIFY: address and email (see src/data/site.ts). -->
      <div class="mobile-menu__foot">
        <p class="mobile-menu__label">{contactLink.label}</p>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <p>{contact.addressLines.join(', ')}</p>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header && toggle && label && menu) {
    // Solid background once the page has scrolled past the top.
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Đóng' : 'Menu';
      header.classList.toggle('is-menu-open', open);
      document.body.classList.toggle('is-locked', open);
      menu.hidden = !open;
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }

      // Keep focus inside the open menu: header controls and menu links.
      if (event.key === 'Tab') {
        const items = [...header.querySelectorAll<HTMLElement>('a[href], button')].filter(
          (el) => el.getClientRects().length > 0,
        );
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // Close the menu if the viewport grows into the desktop layout.
    window.matchMedia('(min-width: 1000px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    --header-fg: var(--color-charcoal);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--header-fg);
  }

  .site-header__bar {
    position: relative;
    z-index: 2;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    transition: background-color 400ms var(--ease), border-color 400ms var(--ease), color 400ms var(--ease);
  }

  .site-header--overlay { --header-fg: var(--color-deep-green); }
  .site-header--overlay .site-header__bar {
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header--overlay.is-scrolled { --header-fg: var(--color-charcoal); }
  .site-header--overlay.is-scrolled .site-header__bar {
    background: var(--color-paper);
    border-bottom-color: var(--color-line);
  }

  .site-header.is-menu-open { --header-fg: var(--color-cream); }
  .site-header.is-menu-open .site-header__bar {
    background: var(--color-deep-green);
    border-bottom-color: var(--color-line-inverse);
  }

  /* Side margin matches the hero text on phones (min 1.5rem). */
  .site-header__inner,
  .mobile-menu__inner { padding-inline: max(var(--gutter), 1.5rem); }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    height: var(--header-h);
  }

  /* Desktop navigation ---------------------------------------------------
     Quiet running links, one line. Liên hệ is set apart by a hairline only. */

  .site-nav { margin-left: auto; display: none; }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.1rem + 1.45vw, 1.875rem);
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    font-size: var(--type-nav);
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: 0.015em;
    white-space: nowrap;
    opacity: 0.86;
    transition: opacity 300ms var(--ease);
  }
  .site-nav__link:hover,
  .site-nav__link[aria-current="page"] { opacity: 1; }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.25rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease);
  }
  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after { transform: scaleX(1); }

  .site-nav__contact {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.1rem + 1.45vw, 1.875rem);
  }
  .site-nav__contact::before {
    content: "";
    width: 1px;
    height: 0.875rem;
    background: currentColor;
    opacity: 0.35;
  }
  .site-nav__contact .site-nav__link { font-weight: 500; opacity: 1; }

  /* Menu toggle (below desktop) */
  .menu-toggle {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .menu-toggle__icon {
    position: relative;
    width: 1.5rem;
    height: 0.5rem;
  }
  .menu-toggle__icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    transition: transform 400ms var(--ease), top 400ms var(--ease);
  }
  .menu-toggle__icon span:first-child { top: 0; }
  .menu-toggle__icon span:last-child { top: calc(100% - 1px); }

  /* Open: the two lines cross into a close mark. */
  .is-menu-open .menu-toggle__icon span { top: calc(50% - 0.5px); }
  .is-menu-open .menu-toggle__icon span:first-child { transform: rotate(45deg); }
  .is-menu-open .menu-toggle__icon span:last-child { transform: rotate(-45deg); }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__icon span { transition: none; }
  }

  /* Mobile menu ----------------------------------------------------------
     A calm panel: a short list at reading size, easy to scan and tap. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: var(--color-deep-green);
    color: var(--color-cream);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) { animation: menu-in 300ms var(--ease); }
    @keyframes menu-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-top: calc(var(--header-h) + var(--space-m));
    padding-bottom: var(--space-xl);
  }

  .mobile-menu__list li { border-bottom: 1px solid var(--color-line-inverse); }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.875rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .mobile-menu__link[href="/"] { font-style: italic; }

  .mobile-menu__num {
    flex: none;
    width: 1.5rem;
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--color-text-inverse-muted);
  }

  .mobile-menu__foot {
    display: grid;
    gap: 0.25rem;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--color-text-inverse-muted);
  }
  .mobile-menu__foot a {
    justify-self: start;
    padding-block: 0.375rem;
    color: var(--color-cream);
  }

  .mobile-menu__label {
    margin-bottom: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .is-menu-open .menu-toggle { gap: 0.5rem; }
    .is-menu-open .menu-toggle__icon {
      width: 1.125rem;
      height: 1.125rem;
    }

    .mobile-menu__inner { gap: var(--space-m); }
    .mobile-menu__link {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: 0.75rem;
      min-height: 3rem;
      padding-block: 0.625rem;
    }
    .mobile-menu__link > span:last-child {
      font-family: var(--font-editorial);
      font-size: 1.3125rem;
      font-weight: 500;
      letter-spacing: -0.005em;
    }
    .mobile-menu__foot {
      padding-left: 2.25rem;
      gap: 0.5rem;
    }
    .mobile-menu__foot a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      padding-block: 0.5rem;
    }
    .mobile-menu__label { margin-bottom: 0; }
  }

  /* Horizontal navigation wherever it fits on one line with room to spare:
     logo + links measure ≈ 800px; at 1000px about 80px remain between them.
     Narrower than that, the menu panel takes over. */
  @media (min-width: 1000px) {
    .site-nav { display: block; }
    .menu-toggle,
    .mobile-menu { display: none; }
  }
</style>
