---
import { contact } from '../data/site';
import { navDropdowns } from '../data/drafts';
import { SHOWROOM_FRESH, showroomHref, showroomProducts } from '../data/showroom';
import { getLocale, isTranslated, localizePath, pageHref } from '../i18n';
import '../styles/desktop-header.css';
import BrandLogo from './BrandLogo.astro';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  /** Transparent header over a full-bleed hero; turns solid on scroll. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const lang = getLocale(Astro.url);

// Header navigation. Kept separate from the footer's `nav` (src/data/site.ts):
// the header says "Sản phẩm"; homepage section headings keep "Sản vật".
// Each label goes to its homepage section; its dropdown (src/data/drafts.ts)
// opens the pages, Sản phẩm (#san-vat) and Về Hiền Nương included.
const links = [
  { label: { vi: 'Về Hiền Nương', en: 'About Hiền Nương', zh: '关于 Hiền Nương' }, anchor: '/#ve-hien-nuong' },
  { label: { vi: 'Nông nghiệp tuần hoàn', en: 'Circular Agriculture', zh: '循环农业' }, anchor: '/#tuan-hoan' },
  { label: { vi: 'Sản phẩm', en: 'Products', zh: '产品' }, anchor: '/#san-vat' },
  { label: { vi: 'Dấu ấn', en: 'Press', zh: '媒体报道' }, anchor: '/#dau-an' },
  { label: { vi: 'Hợp tác', en: 'Partnership', zh: '合作' }, anchor: '/#hop-tac' },
];
// Vietnamese-only pages (viOnlyPaths) open in Vietnamese from every language.
const subLink = (href: string) =>
  isTranslated(href) ? { href: localizePath(href, lang) } : { href, hreflang: lang === 'vi' ? undefined : 'vi' };
// Products in the two showroom groups, for the Sản phẩm flyouts.
const products = showroomProducts(lang).map((p) => ({ label: p.name, href: showroomHref(p.slug, lang) }));
const productGroups = [products.slice(0, SHOWROOM_FRESH), products.slice(SHOWROOM_FRESH)];
const navItems = links.map((item) => ({
  label: item.label[lang],
  href: localizePath(item.anchor, lang),
  children: navDropdowns[item.anchor]?.map((child) => ({ label: child.label[lang], video: child.video, items: child.group === undefined ? undefined : productGroups[child.group], ...subLink(child.href) })),
}));
// Contact details: the cooperation page's contact section; the homepage
// section in languages without that page.
const contactLink = { label: { vi: 'Liên hệ', en: 'Contact', zh: '联系我们' }[lang], href: pageHref('/hop-tac/#lien-he', lang, '/#hop-tac') };

// Search covers the Vietnamese pages only (see src/pages/tim-kiem/).
const searchable = lang === 'vi';

const t = {
  vi: { mainNav: 'Điều hướng chính', menuNav: 'Điều hướng', menu: 'Menu', close: 'Đóng', submenu: 'Menu con' },
  en: { mainNav: 'Main navigation', menuNav: 'Navigation', menu: 'Menu', close: 'Close', submenu: 'Submenu' },
  zh: { mainNav: '主导航', menuNav: '导航', menu: '菜单', close: '关闭', submenu: '子菜单' },
}[lang];

// Home is current only on "/"; a page link is current for its own path and
// everything below it; in-page section links are never "current".
const path = Astro.url.pathname;
const current = (href: string) => {
  if (href === '/') return path === '/' ? 'page' : undefined;
  if (href.includes('#')) return undefined;
  return path.startsWith(href) ? 'page' : undefined;
};
// A dropdown link is current only for its own page.
const currentSub = (href: string) => (href === path ? 'page' : undefined);
---
<header
  class:list={['site-header', { 'site-header--overlay': overlay }]}
  data-header
  data-overlay={overlay ? '' : undefined}
>
  <div class="site-header__bar">
    <div class="container site-header__inner">
      <BrandLogo href={localizePath('/', lang)} class="site-header__brand" menuVariant />

      <nav class="site-nav" aria-label={t.mainNav}>
        <ul class="site-nav__list">
          {navItems.map((item, i) => (
            item.children ? (
              <li class="site-nav__item" data-dropdown data-dropdown-hover>
                <a class="site-nav__link" href={item.href}><span class="site-nav__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{item.label}</a>
                <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls={`nav-sub-${i}`} aria-label={`${t.submenu}: ${item.label}`} data-dropdown-toggle>
                  <svg viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1" /></svg>
                </button>
                <div class="site-nav__panel" id={`nav-sub-${i}`} data-dropdown-panel hidden>
                  <ul class="site-nav__sub">
                    {item.children.map((child) => child.items ? (
                      <li class="site-nav__fly">
                        <a class="site-nav__sublink site-nav__sublink--fly" href={child.href} aria-current={currentSub(child.href)}>{child.label}<svg class="site-nav__fly-mark" viewBox="0 0 6 10" aria-hidden="true" focusable="false"><path d="M1 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1" /></svg></a>
                        <ul class="site-nav__sub site-nav__flyout">
                          {child.items.map((p) => <li><a class="site-nav__sublink" href={p.href}>{p.label}</a></li>)}
                        </ul>
                      </li>
                    ) : (
                      <li><a class="site-nav__sublink" href={child.href} hreflang={child.hreflang} aria-current={currentSub(child.href)}>{child.label}{child.video && <svg class="nav-video" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="1" y="3.5" width="10" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.2" /><path d="M11 7l4-2.5v7L11 9z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg>}</a></li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li><a class="site-nav__link" href={item.href} aria-current={current(item.href)}><span class="site-nav__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{item.label}</a></li>
            )
          ))}

        </ul>
      </nav>

      <LanguageSwitch class="site-header__lang" />

      {searchable && (
        <button class="search-toggle" type="button" aria-expanded="false" aria-controls="site-search" aria-label="Tìm kiếm" data-search-toggle>
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
      )}

      <a class="desktop-contact" href={contactLink.href}><span class="desktop-contact__sizer" aria-hidden="true">{contactLink.label}</span><span class="desktop-contact__label">{contactLink.label} <span aria-hidden="true">→</span></span></a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-label-open={t.menu}
        data-label-close={t.close}
      >
        <span class="menu-toggle__label" data-menu-label>{t.menu}</span>
        <span class="menu-toggle__icon" aria-hidden="true"><span></span><span class="menu-toggle__middle"></span><span></span></span>
      </button>
    </div>
  </div>

  {searchable && (
    <div class="site-search" id="site-search" data-search hidden>
      <form class="container site-search__form" action="/tim-kiem/" method="get" role="search">
        <label class="sr-only" for="site-search-input">Tìm trên Hiền Nương Farm</label>
        <input class="site-search__input" id="site-search-input" type="search" name="q" placeholder="Tìm sản phẩm, bài báo, sự kiện…" autocomplete="off" required />
        <button class="site-search__submit" type="submit" aria-label="Tìm">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
      </form>
    </div>
  )}

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <div class="container mobile-menu__inner">
      <nav aria-label={t.menuNav}>
        <ol class="mobile-menu__list">
          {navItems.map((item, i) => (
            <li class:list={[{ 'mobile-menu__item': item.children }]} data-dropdown={item.children ? '' : undefined}>
              <a class="mobile-menu__link" href={item.href} aria-current={item.children ? undefined : current(item.href)} data-menu-link>
                <span class="mobile-menu__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{item.label}</span>
              </a>
              {item.children && (
                <>
                  <button class="mobile-menu__toggle" type="button" aria-expanded="false" aria-controls={`menu-sub-${i}`} aria-label={`${t.submenu}: ${item.label}`} data-dropdown-toggle>
                    <svg viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1" /></svg>
                  </button>
                  <ul class="mobile-menu__sub" id={`menu-sub-${i}`} data-dropdown-panel hidden>
                    {item.children.map((child) => (
                      <li><a href={child.href} hreflang={child.hreflang} aria-current={currentSub(child.href)} data-menu-link>{child.label}{child.video && <svg class="nav-video" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="1" y="3.5" width="10" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.2" /><path d="M11 7l4-2.5v7L11 9z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg>}</a></li>
                    ))}
                  </ul>
                </>
              )}
            </li>
          ))}
        </ol>
      </nav>

      <LanguageSwitch class="mobile-menu__lang" />

      <!-- VERIFY: address and email (see src/data/site.ts). -->
      <div class="mobile-menu__foot">
        <p class="mobile-menu__label">{contactLink.label}</p>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a>
        <p>{contact.addressLines[lang].join(', ')}</p>
      </div>
    </div>
  </div>
</header>

<script>
  // Search panel: a single row under the bar, opened by the magnifier.
  const searchToggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');
  const searchPanel = document.querySelector<HTMLElement>('[data-search]');
  if (searchToggle && searchPanel) {
    const setSearch = (open: boolean) => {
      searchToggle.setAttribute('aria-expanded', String(open));
      searchPanel.hidden = !open;
      if (open) searchPanel.querySelector<HTMLInputElement>('input')?.focus();
    };
    searchToggle.addEventListener('click', () => setSearch(searchPanel.hidden));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || searchPanel.hidden) return;
      setSearch(false);
      searchToggle.focus();
    });
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!searchPanel.hidden && !searchPanel.contains(target) && !searchToggle.contains(target)) setSearch(false);
    });
  }

  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header && toggle && label && menu) {
    // Solid background once the page has scrolled past the top.
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
      header.classList.toggle('is-menu-open', open);
      document.body.classList.toggle('is-locked', open);
      menu.hidden = !open;
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }

      // Keep focus inside the open menu: header controls and menu links.
      if (event.key === 'Tab') {
        const items = [...header.querySelectorAll<HTMLElement>('a[href], button')].filter(
          (el) => el.getClientRects().length > 0,
        );
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // Close the menu if the viewport grows into the desktop layout.
    window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Dropdowns (review scaffold only; see src/data/drafts.ts). The chevron
  // toggles; on desktop a mouse hover also opens, with a short grace period
  // so the pointer can travel from the label into the panel.
  const dropdowns = [...document.querySelectorAll<HTMLElement>('[data-dropdown]')].flatMap((item) => {
    const button = item.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    const panel = item.querySelector<HTMLElement>('[data-dropdown-panel]');
    return button && panel ? [{ item, button, panel, hover: item.hasAttribute('data-dropdown-hover') }] : [];
  });
  type Dropdown = (typeof dropdowns)[number];

  const setDropdown = (d: Dropdown, open: boolean) => {
    d.button.setAttribute('aria-expanded', String(open));
    d.item.classList.toggle('is-open', open);
    d.panel.hidden = !open;
  };
  const isDropdownOpen = (d: Dropdown) => d.button.getAttribute('aria-expanded') === 'true';
  const closeOthers = (d: Dropdown) => dropdowns.forEach((o) => o !== d && o.hover && setDropdown(o, false));

  dropdowns.forEach((d) => {
    let timer: number | undefined;
    let byHover = false;

    d.button.addEventListener('click', () => {
      // A click on a hover-opened panel keeps it open.
      const open = byHover ? true : !isDropdownOpen(d);
      byHover = false;
      if (d.hover) closeOthers(d);
      setDropdown(d, open);
    });

    if (!d.hover) return;

    d.item.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      clearTimeout(timer);
      if (!isDropdownOpen(d)) byHover = true;
      closeOthers(d);
      setDropdown(d, true);
    });
    d.item.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return;
      timer = window.setTimeout(() => {
        byHover = false;
        setDropdown(d, false);
      }, 200);
    });
    // Tabbing past the last link closes the panel.
    d.item.addEventListener('focusout', (event) => {
      if (!d.item.contains(event.relatedTarget as Node | null)) setDropdown(d, false);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = dropdowns.find((d) => d.hover && isDropdownOpen(d));
    if (!open) return;
    setDropdown(open, false);
    open.button.focus();
  });

  document.addEventListener('click', (event) => {
    dropdowns.forEach((d) => {
      if (d.hover && !d.item.contains(event.target as Node)) setDropdown(d, false);
    });
  });
</script>

<style>
  .site-header {
    --header-fg: var(--color-charcoal);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--header-fg);
  }

  .site-header__bar {
    position: relative;
    z-index: 2;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    transition: background-color 400ms var(--ease), border-color 400ms var(--ease), color 400ms var(--ease);
  }

  .site-header--overlay { --header-fg: var(--color-deep-green); }
  .site-header--overlay .site-header__bar {
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header--overlay.is-scrolled { --header-fg: var(--color-charcoal); }
  .site-header--overlay.is-scrolled .site-header__bar {
    background: var(--color-paper);
    border-bottom-color: var(--color-line);
  }

  .site-header.is-menu-open { --header-fg: var(--color-cream); }
  .site-header.is-menu-open .site-header__bar {
    background: var(--color-deep-green);
    border-bottom-color: var(--color-line-inverse);
  }

  /* Side margin matches the hero text on phones (min 1.5rem). */
  .site-header__inner,
  .mobile-menu__inner { padding-inline: max(var(--gutter), 1.5rem); }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    height: var(--header-h);
  }

  /* Desktop navigation ---------------------------------------------------
     Quiet running links, one line. Liên hệ is set apart by a hairline only. */

  .site-nav { margin-left: auto; display: none; }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1vw, 1rem);
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    font-size: var(--type-nav);
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: 0.015em;
    white-space: nowrap;
    opacity: 0.86;
    transition: opacity 300ms var(--ease);
  }
  .site-nav__link:hover,
  .site-nav__link[aria-current="page"] { opacity: 1; }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.25rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease);
  }
  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after { transform: scaleX(1); }

  /* Dropdowns (review scaffold only). The label link and the chevron are
     separate controls; the panel hangs from the item with a padded bridge so
     the pointer can move into it. */
  .site-nav__item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .site-nav__toggle {
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 2rem;
    opacity: 0.7;
    transition: opacity 300ms var(--ease);
  }
  .site-nav__toggle:hover,
  .site-nav__toggle[aria-expanded="true"] { opacity: 1; }
  .site-nav__toggle svg,
  .mobile-menu__toggle svg {
    width: 0.625rem;
    height: auto;
    transition: transform 300ms var(--ease);
  }
  .site-nav__toggle[aria-expanded="true"] svg,
  .mobile-menu__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }

  .site-nav__panel {
    position: absolute;
    top: 100%;
    left: -1.25rem;
    z-index: 3;
    padding-top: 0.75rem;
  }

  /* Submenu colours, shared by the desktop panels and the mobile menu. */
  .site-header {
    --menu-bg: #234333;
    --menu-fg: #FAF8F1;
    --menu-hover: #3F604D;
  }

  /* Panel insets (0.5rem) + row insets (0.75rem) = the panel's -1.25rem
     offset, so row text lines up with the parent label. */
  .site-nav__sub {
    min-width: 15rem;
    padding: 0.5rem;
    background: var(--menu-bg);
    color: var(--menu-fg);
    box-shadow: 0 16px 32px -16px rgba(16, 43, 33, 0.45);
  }

  .site-nav__sublink {
    display: block;
    padding: 0.625rem 0.75rem;
    font-size: var(--type-nav);
    line-height: 1.4;
    white-space: nowrap;
  }

  /* Second level: a group's products open beside its row on hover or focus. */
  .site-nav__fly { position: relative; }
  .site-nav__sublink--fly { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .site-nav__fly-mark { width: 0.4rem; height: auto; opacity: 0.7; }
  .site-nav__flyout {
    position: absolute;
    top: -0.5rem;
    left: 100%;
    visibility: hidden;
    opacity: 0;
    transition: opacity 200ms var(--ease), visibility 0s linear 200ms;
  }
  .site-nav__fly:hover > .site-nav__flyout,
  .site-nav__fly:focus-within > .site-nav__flyout {
    visibility: visible;
    opacity: 1;
    transition: opacity 200ms var(--ease), visibility 0s;
  }
  .site-nav__fly:hover > .site-nav__sublink--fly,
  .site-nav__fly:focus-within > .site-nav__sublink--fly { background: var(--menu-hover); }

  /* Submenu rows: an inset, square highlight on hover and keyboard focus. */
  /* Small video mark after a link that opens a film. */
  .nav-video { display: inline-block; width: 0.95em; height: 0.95em; margin-left: 0.45em; vertical-align: -0.1em; opacity: 0.75; }

  .site-nav__sublink,
  .mobile-menu__sub a { transition: background-color 250ms var(--ease); }
  .site-nav__sublink:hover,
  .site-nav__sublink:focus-visible,
  .mobile-menu__sub a:hover,
  .mobile-menu__sub a:focus-visible { background: var(--menu-hover); }
  .site-nav__sublink:focus-visible,
  .mobile-menu__sub a:focus-visible { outline-offset: -4px; }
  .site-nav__sublink[aria-current="page"],
  .mobile-menu__sub a[aria-current="page"] { font-weight: 500; }

  /* While its dropdown is open, the parent keeps its hover state: number
     shown, underline drawn. */
  .site-nav__item.is-open .site-nav__num { opacity: 0.65; }
  .site-nav__item.is-open .site-nav__link::after { transform: scaleX(1); }

  .site-nav__num { margin-right: 0.4rem; font-size: 0.625rem; font-variant-numeric: tabular-nums; opacity: 0.65; letter-spacing: 0; }
  .site-nav__contact .site-nav__link { padding: 0.7rem 1rem; background: var(--color-forest); color: var(--color-cream); opacity: 1; }
  .site-nav__contact .site-nav__link:hover { background: var(--color-deep-green); }
  .site-nav__contact .site-nav__link::after { display: none; }

  /* Language switch: in the bar beside Liên hệ on desktop, in the menu
     panel below that. */
  .site-header__inner :global(.site-header__lang) { display: none; }

  /* Search ---------------------------------------------------------------
     A magnifier in the bar; the field opens as one quiet row beneath it. */
  .search-toggle {
    flex: none;
    margin-left: auto;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    opacity: 0.86;
    transition: opacity 300ms var(--ease);
  }
  .search-toggle:hover,
  .search-toggle[aria-expanded="true"] { opacity: 1; }
  .search-toggle svg,
  .site-search__submit svg { width: 1.125rem; height: 1.125rem; }
  .search-toggle + .desktop-contact + .menu-toggle { margin-left: 0; }
  .is-menu-open .search-toggle { visibility: hidden; }

  .site-search {
    position: relative;
    z-index: 2;
