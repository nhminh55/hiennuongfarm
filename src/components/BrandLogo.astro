---
interface Props {
  href?: string;
  class?: string;
  dark?: boolean;
  menuVariant?: boolean;
}
import { getLocale } from '../i18n';
import { site } from '../data/site';

const { href, class: className, dark = false, menuVariant = false } = Astro.props;
const home = { vi: 'Trang chủ', en: 'Home', zh: '首页' }[getLocale(Astro.url)];
const Tag = href ? 'a' : 'span';
---
<Tag
  class:list={['wordmark', { 'wordmark--menu': menuVariant, 'wordmark--dark': dark }, className]}
  href={href}
  aria-label={href ? `${site.name} — ${home}` : undefined}
>
  {dark ? (
    <img class="wordmark__full" src="/brand/logo-ngang.webp" width="900" height="291" alt={href ? '' : site.name} aria-hidden={href ? 'true' : undefined} />
  ) : (<>
  <img class="wordmark__icon" src="/brand/badge.webp" width="512" height="512" alt="" aria-hidden="true" />
  <span class="wordmark__type" aria-hidden={href ? 'true' : undefined}>
    <img class="wordmark__name" src="/brand/wordmark.webp" width="800" height="131" alt={href ? '' : site.name} />
    <span class="wordmark__sub">Nông nghiệp tuần hoàn</span>
  </span>
  </>)}
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: clamp(10rem, 13vw, 12.5rem);
    max-width: 100%;
    flex-shrink: 0;
    vertical-align: middle;
    color: inherit;
    text-decoration: none;
  }
  .wordmark--dark { color: var(--color-cream); }
  .wordmark__full { display: block; width: 100%; height: auto; }
  .wordmark__icon { display: block; width: 28%; height: auto; flex: none; }
  .wordmark__type { display: flex; flex-direction: column; gap: 0.3em; min-width: 0; flex: 1; container-type: inline-size; color: var(--color-earth); }
  .wordmark__name { display: block; width: 100%; height: auto; }
  /* Tagline set as text so its diacritics stay correct and crisp. */
  .wordmark__sub { display: flex; align-items: center; gap: 0.5em; font-family: var(--font-body); font-size: 5.3cqi; font-weight: 600; line-height: 1; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; }
  .wordmark__sub::before, .wordmark__sub::after { content: ""; flex: 1 0 0.8em; height: 1px; background: currentColor; }
  /* Without the original's light outline, the lettering turns cream on dark grounds. */
  .wordmark--dark .wordmark__type,
  :global(.site-header.is-menu-open) .wordmark__type { color: var(--color-cream); }
  .wordmark--dark .wordmark__name,
  :global(.site-header.is-menu-open) .wordmark__name { filter: brightness(0) invert(0.95) sepia(0.12); }

</style>
