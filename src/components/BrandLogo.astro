---
interface Props {
  href?: string;
  class?: string;
  dark?: boolean;
  menuVariant?: boolean;
}
import { getLocale } from '../i18n';
import { site } from '../data/site';

const { href, class: className, dark = false, menuVariant = false } = Astro.props;
const home = { vi: 'Trang chủ', en: 'Home', zh: '首页' }[getLocale(Astro.url)];
const Tag = href ? 'a' : 'span';
---
<Tag
  class:list={['wordmark', { 'wordmark--menu': menuVariant, 'wordmark--dark': dark }, className]}
  href={href}
  aria-label={href ? `${site.name} — ${home}` : undefined}
>
  <img class="wordmark__icon" src="/app_icon.png" width="512" height="512" alt="" aria-hidden="true" />
  <span class="wordmark__type" aria-hidden={href ? 'true' : undefined}>
    <span class="wordmark__name">NƯƠNG</span>
    <span class="wordmark__sub">FARM</span>
  </span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: clamp(9rem, 12vw, 11rem);
    max-width: 100%;
    flex-shrink: 0;
    vertical-align: middle;
    color: inherit;
    text-decoration: none;
  }
  .wordmark--dark { color: var(--color-cream); }
  .wordmark__icon { display: block; width: 30%; height: auto; flex: none; border-radius: 50%; }
  .wordmark__type { display: flex; flex-direction: column; align-items: center; white-space: nowrap; }
  .wordmark__name { font-family: var(--font-display); font-size: 1.2rem; font-weight: 500; line-height: 1.25; letter-spacing: 0.04em; }
  .wordmark__sub { margin-top: 0.15rem; font-size: 0.6rem; font-weight: 500; line-height: 1.25; letter-spacing: 0.35em; padding-left: 0.35em; }
</style>
