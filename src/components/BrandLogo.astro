---
interface Props {
  href?: string;
  class?: string;
  dark?: boolean;
  menuVariant?: boolean;
}
import { getLocale } from '../i18n';
import { site } from '../data/site';

const { href, class: className, dark = false, menuVariant = false } = Astro.props;
const home = { vi: 'Trang chủ', en: 'Home', zh: '首页' }[getLocale(Astro.url)];
const Tag = href ? 'a' : 'span';
---
<Tag
  class:list={['wordmark', { 'wordmark--menu': menuVariant, 'wordmark--dark': dark }, className]}
  href={href}
  aria-label={href ? `${site.name} — ${home}` : undefined}
>
  <img class="wordmark__icon" src="/brand/badge.webp" width="512" height="512" alt="" aria-hidden="true" />
  <img class="wordmark__type" src="/brand/wordmark.webp" width="353" height="83" alt={href ? '' : site.name} aria-hidden={href ? 'true' : undefined} />
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: clamp(10rem, 13vw, 12.5rem);
    max-width: 100%;
    flex-shrink: 0;
    vertical-align: middle;
    color: inherit;
    text-decoration: none;
  }
  .wordmark--dark { color: var(--color-cream); }
  .wordmark__icon { display: block; width: 28%; height: auto; flex: none; }
  .wordmark__type { display: block; min-width: 0; flex: 1; height: auto; transition: filter 400ms var(--ease); }
  /* The official lettering is brown; on dark grounds it turns cream. */
  .wordmark--dark .wordmark__type,
  :global(.site-header.is-menu-open) .wordmark__type { filter: brightness(0) invert(0.95) sepia(0.12); }
</style>
