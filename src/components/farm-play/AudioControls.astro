---
import { dataFile } from '../../data/copy';
// Text: src/content/choi-cung-nong-trai/am-thanh.md (also read by scripts/farm-play/audio.js).
const t = dataFile('choi-cung-nong-trai/am-thanh');
---
<div class="play-audio" data-play-audio role="group" aria-label="Tùy chọn âm thanh">
 <div class="audio-buttons"><button type="button" data-sound-toggle aria-pressed="false" disabled>{t.sound}: {t.off}</button><button type="button" data-music-toggle aria-pressed="false" disabled>{t.music}: {t.off}</button></div>
 <p class="play-small" data-audio-status role="status" aria-live="polite">{t.note}</p>
</div>
