---
import AudioControls from './AudioControls.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dataFile } from '../../data/copy';
import '../../styles/farm-play.css';
interface Props {title:string; intro:string; activity?:string; duration?:string;}
const {title,intro,activity,duration} = Astro.props;
// Shared farm-play text: src/content/choi-cung-nong-trai/chung.md.
const t = dataFile('choi-cung-nong-trai/chung');
const activities: {slug:string; title:string}[] = t.activities;
---
<BaseLayout title={title} description={intro}>
 <div class="farm-play">
  <div class="play-container">
   <nav class="play-breadcrumb" aria-label="Đường dẫn"><a href="/">{t.home}</a><span aria-hidden="true">/</span>{activity ? <a href="/choi-cung-nong-trai/">{t.section}</a> : <span>{t.section}</span>}</nav>
   <header class:list={['play-heading',{'play-heading--collection':!activity}]}>
    <p class="play-eyebrow">{activity ? t.section : t.eyebrow}</p>
    <h1>{title}</h1><p class="play-intro">{intro}</p>
    {duration && <p class="play-meta">{duration} · {t.no_login}</p>}
   </header>
   {activity && <AudioControls />}
   <slot />
   <nav class="play-related" aria-label="Các hoạt động khác">
    <a href="/choi-cung-nong-trai/">{t.all_activities}</a>
    {activities.filter(a=>a.slug!==activity).map(a=><a href={'/choi-cung-nong-trai/'+a.slug+'/'}>{a.title}</a>)}
   </nav>
  </div>
 </div>
</BaseLayout>
