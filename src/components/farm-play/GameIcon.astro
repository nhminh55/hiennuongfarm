---
/** Gamepad mark that tells a reader a link leads to a farm-play activity. */
interface Props { size?: number; class?: string }
const { size = 18, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="7" width="19" height="11" rx="5.5" /><path d="M7.5 10.5v4M5.5 12.5h4" stroke-linecap="round" /><circle cx="15.5" cy="11.5" r="0.9" fill="currentColor" stroke="none" /><circle cx="17.5" cy="13.8" r="0.9" fill="currentColor" stroke="none" /></svg>
