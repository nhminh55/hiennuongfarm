---
/**
 * Compact opening for the three Dấu ấn pages: breadcrumb, eyebrow and
 * title on the left, a quiet switch between the three pages on the right.
 * There is no Dấu ấn landing page: the crumb leads to the homepage section
 * that lists the three.
 */
import Breadcrumb from '../page/Breadcrumb.astro';
import { dauAnPages } from '../../data/dau-an';

interface Props {
  /** Path of the current page, e.g. "/dau-an/bao-chi/". */
  current: string;
  /** Set on detail pages: the page becomes a crumb, not the title. */
  title?: string;
  /** Heading level for the page title. */
  as?: 'h1' | 'p';
}

const { current, title, as: Tag = 'h1' } = Astro.props;
const page = dauAnPages.find((p) => p.href === current)!;
const crumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Dấu ấn', href: '/#dau-an' },
  title ? { label: page.title, href: page.href } : { label: page.title },
  ...(title ? [{ label: title }] : []),
];
---
<header class:list={['da-head', { 'da-head--detail': title }]}>
  <div class="container da-head__grid">
    <Breadcrumb class="da-head__crumbs" items={crumbs} />
    <div class="da-head__title-wrap">
      <p class="eyebrow">Dấu ấn</p>
      <Tag class="da-head__title" id={Tag === 'h1' ? 'page-title' : undefined}>{page.title}</Tag>
    </div>
    <nav class="da-head__nav" aria-label="Các trang Dấu ấn">
      <ul>
        {dauAnPages.map((p) => (
          <li>
            <a href={p.href} aria-current={p.href === current ? (title ? 'true' : 'page') : undefined}>{p.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .da-head {
    padding-top: clamp(1.25rem, 0.8rem + 1.6vw, 2.25rem);
    padding-bottom: clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
  }

  .da-head__grid {
    display: grid;
    row-gap: var(--space-m);
  }

  .da-head__title-wrap { margin-top: var(--space-xs); }

  .da-head__title {
    margin-top: var(--space-xs);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.75rem);
    line-height: var(--lh-display);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  /* Report and album pages: the section name steps back for the item's own title. */
  .da-head--detail .da-head__title { font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem); }
  .da-head--detail { padding-bottom: var(--space-l); }

  .da-head__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .da-head__nav a {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--color-text-muted);
    border-bottom: 1px solid transparent;
    transition: color 300ms var(--ease), border-color 300ms var(--ease);
  }
  .da-head__nav a:hover { color: var(--color-text); border-color: var(--color-line-strong); }
  .da-head__nav a[aria-current] {
    color: var(--color-text);
    font-weight: 500;
    border-color: var(--color-earth);
  }

  @media (min-width: 1024px) {
    .da-head__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: var(--space-xl);
    }
    .da-head__grid > :global(.da-head__crumbs) { grid-column: 1 / -1; }
    .da-head__nav { padding-bottom: 0.5rem; }
  }
</style>
