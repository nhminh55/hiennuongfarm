---
/**
 * Closing next step for a secondary page, in the homepage's cooperation tone.
 * Points to the homepage cooperation section until /hop-tac/ exists.
 */
import Eyebrow from '../Eyebrow.astro';
import Arrow from '../Arrow.astro';
import { getLocale, localizePath } from '../../i18n';

interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  label?: string;
}

const lang = getLocale(Astro.url);
const defaults = {
  vi: { eyebrow: 'Hợp tác cùng Hiền Nương', label: 'Liên hệ hợp tác' },
  en: { eyebrow: 'Partner with Hiền Nương', label: 'Discuss a partnership' },
  zh: { eyebrow: '与 Hiền Nương 合作', label: '洽谈合作' },
}[lang];
const {
  eyebrow = defaults.eyebrow,
  title,
  href = localizePath('/#hop-tac', lang),
  label = defaults.label,
} = Astro.props;
---
<section class="section cta-band" aria-labelledby="cta-band-title">
  <div class="container grid cta-band__grid">
    <div class="cta-band__heading" data-reveal>
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="h2 cta-band__title" id="cta-band-title">{title}</h2>
    </div>

    <div class="cta-band__body" data-reveal style="--reveal-delay: 120ms">
      <p class="body"><slot /></p>
      <a class="btn cta-band__btn" href={href}>{label} <Arrow /></a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--color-cream);
    border-top: 1px solid var(--color-line);
  }

  .cta-band__grid { row-gap: var(--space-xl); }

  .cta-band__heading,
  .cta-band__body { grid-column: 1 / -1; }

  .cta-band__title { margin-top: var(--space-l); max-width: 19ch; }

  .cta-band__body .body { max-width: 30rem; }

  .cta-band__btn { margin-top: var(--space-l); }

  @media (min-width: 1024px) {
    .cta-band__heading { grid-column: 1 / span 6; }
    .cta-band__body { grid-column: 8 / span 5; align-self: end; }
  }
</style>
