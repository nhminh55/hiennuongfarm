    // Helper to strip accents for robust matching
    function removeVietnameseTones(str: string) {
      str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
      str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
      str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
      str = str.replace(/ò|ó|ọ|ỏ|ã|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
      str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
      str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
      str = str.replace(/đ/g, "d");
      str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "A");
      str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "E");
      str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "I");
      str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "O");
      str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "U");
      str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "Y");
      str = str.replace(/Đ/g, "D");
      // Some system encode some character differently
      str = str.replace(/\u0300|\u0301|\u0309|\u0303|\u0309/g, ""); // Huyền, sắc, hỏi, ngã
      str = str.replace(/\u02C6|\u0306|\u031B/g, ""); // Â, Ă, Ơ
      return str.toLowerCase().trim();
    }

    // Toggle Chat Panel
    function toggleChat() {
      const isOpen = container.classList.contains('is-open');
      if (isOpen) {
        container.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        container.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        // Hide notification badge once opened
        const badge = trigger.querySelector('.hn-chat-trigger-badge');
        if (badge) {
          (badge as HTMLElement).style.display = 'none';
        }
        // Auto-focus input
        setTimeout(() => chatInput.focus(), 300);
      }
    }

    trigger.addEventListener('click', toggleChat);
    closeBtn.addEventListener('click', toggleChat);

    // Add Message to Box
    function addMessage(text: string, isUser = false) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `hn-message hn-message-${isUser ? 'user' : 'ai'}`;

      const bubbleDiv = document.createElement('div');
      bubbleDiv.className = 'hn-message-bubble';
      bubbleDiv.innerHTML = text;

      const timeSpan = document.createElement('span');
      timeSpan.className = 'hn-message-time';
      const now = new Date();
      timeSpan.textContent = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

      msgDiv.appendChild(bubbleDiv);
      msgDiv.appendChild(timeSpan);
      messagesContainer.appendChild(msgDiv);

      // Scroll to bottom
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    // AI Response Logic with typing simulation
    function handleResponse(userQuery: string) {
      // Show typing indicator
      typingIndicator.style.display = 'flex';
      messagesContainer.scrollTop = messagesContainer.scrollHeight;

      // Hide quick replies momentarily to focus on reading
      quickReplies.style.opacity = '0.5';

      // Normalize text for comparison
      const normalizedQuery = removeVietnameseTones(userQuery);

      // Simple score matching
      let bestResponse = "";
      let maxScore = 0;

      for (const item of KNOWLEDGE_BASE) {
        let score = 0;
        for (const kw of item.keywords) {
          if (normalizedQuery.includes(kw)) {
            // Give higher weight to exact matching keywords or longer matches
            score += kw.length;
          }
        }
        if (score > maxScore) {
          maxScore = score;
          // Pick a random answer from the matched answers array
          bestResponse = item.answers[Math.floor(Math.random() * item.answers.length)];
        }
      }

      // Fallback response if no keywords match
      if (maxScore === 0) {
        bestResponse = "Dạ, câu hỏi của bạn rất hay! Do tôi là trợ lý mô phỏng tự động, tôi chưa được cập nhật thông tin chi tiết về chủ đề này.<br/><br/>Bạn có thể tìm hiểu thêm về mô hình <strong>Nông nghiệp tuần hoàn</strong>, các dòng <strong>Sản vật nấm</strong> của trang trại, hoặc gửi thư về email <strong>hiennuongfarm@gmail.com</strong> để được chị Châu Thị Nương và đội ngũ giải đáp thấu đáo nhất nhé ạ! 🌾";
      }

      // Simulate human typing delay (600 - 1200ms)
      const delay = Math.max(600, Math.min(1200, userQuery.length * 8));
      setTimeout(() => {
        typingIndicator.style.display = 'none';
        addMessage(bestResponse, false);
        quickReplies.style.opacity = '1';
      }, delay);
    }

    // Submit form handler
    chatForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = chatInput.value.trim();
      if (!text) return;

      // User Message
      addMessage(text, true);
      chatInput.value = '';

      // AI Response
      handleResponse(text);
    });

    // Quick Reply Buttons Handler
    quickReplies.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest('.hn-quick-btn');
      if (!button) return;

      const question = button.getAttribute('data-question');
      if (question) {
        addMessage(question, true);
        handleResponse(question);
      }
    });
  });
</script>
