---
import { copy } from '../../data/copy';
/**
 * Showroom details — the tabbed information under the stage.
 *
 * One tab list and five tab panels (Giới thiệu · Thành phần · Cách dùng ·
 * Hồ sơ · Nhận xét). Every product's content is rendered here as static
 * HTML: each panel holds one block per product (data-product="slug") and
 * only the current product's block is shown. Tabs a product has no content
 * for are hidden. Nothing is filled in: empty sections are left out.
 *
 * Rendered inside <section data-showroom data-current="slug">; follows the
 * current product through `showroom:change` (details.ts).
 */
import Arrow from '../Arrow.astro';
import { tabIds, type ShowroomItem, type TabId } from '../../data/showroom';
import { getLocale } from '../../i18n';

interface Props {
  products: ShowroomItem[];
}

const { products } = Astro.props;
const lang = getLocale(Astro.url);

const t = copy('san-pham/showroom-tab', lang);

// Server-rendered state: the first product, on its first tab.
const first = products[0];
const supports = (p: ShowroomItem, tab: TabId) => p.tabs.includes(tab);
const tabId = (tab: TabId) => `showroom-tab-${tab}`;
const panelId = (tab: TabId) => `showroom-panel-${tab}`;
const isExternal = (href: string) => /^https?:/i.test(href) || /\.pdf($|[?#])/i.test(href);
---
<div class="details" data-showroom-details>
  <div class="details__tabs" role="tablist" aria-label={t.tablist}>
    {tabIds.map((tab, i) => (
      <button
        type="button"
        class="details__tab"
        role="tab"
        id={tabId(tab)}
        aria-controls={panelId(tab)}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-tab={tab}
        hidden={!supports(first, tab)}
      >{t.tabs[tab]}</button>
    ))}
  </div>

  <div class="details__panels" data-details-panels>
    {tabIds.map((tab, i) => (
      <div
        class="details__panel"
        role="tabpanel"
        id={panelId(tab)}
        aria-labelledby={tabId(tab)}
        tabindex="0"
        data-panel={tab}
        hidden={i !== 0}
      >
        {products.filter((p) => supports(p, tab)).map((p) => (
          <div class="details__block" data-product={p.slug} hidden={p.slug !== first.slug}>
            {tab === 'gioi-thieu' && (
              <section class="details__section">
                <h3 class="details__heading">{p.name}</h3>
                {p.intro.paragraphs.length > 0 && (
                  <div class="details__prose">
                    {p.intro.paragraphs.map((text) => <p>{text}</p>)}
                  </div>
                )}
                {p.intro.paragraphs.length === 0 && p.intro.facts.length === 0 && (
                  <div class="details__prose"><p>{p.summary}</p></div>
                )}
                {p.intro.facts.length > 0 && (
                  <dl class="details__facts">
                    {p.intro.facts.map((f) => (
                      <div class="details__fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>
                    ))}
                  </dl>
                )}
                {p.detail && (
                  <a class="link-arrow details__more" href={p.detail}>{t.detail} <Arrow /></a>
                )}
              </section>
            )}

            {tab === 'thanh-phan' && p.composition && (
              <section class="details__section">
                <h3 class="details__heading">{t.compositionTitle}</h3>
                {p.composition.ingredients && (
                  <div class="details__ingredients">
                    <p class="details__label">{t.ingredients}</p>
                    <p class="details__text">{p.composition.ingredients}</p>
                  </div>
                )}
                {p.composition.facts.length > 0 && (
                  <dl class="details__facts">
                    {p.composition.facts.map((f) => (
                      <div class="details__fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>
                    ))}
                  </dl>
                )}
              </section>
            )}

            {tab === 'cach-dung' && p.usage && (
              <>
                {p.usage.preparation.length > 0 && (
                  <section class="details__section">
                    <h3 class="details__heading">{t.preparation}</h3>
                    <ul class="details__list">
                      {p.usage.preparation.map((text) => <li>{text}</li>)}
                    </ul>
                  </section>
                )}
                {p.usage.storage.length > 0 && (
                  <section class="details__section">
                    <h3 class="details__heading">{t.storage}</h3>
                    <ul class="details__list">
                      {p.usage.storage.map((text) => <li>{text}</li>)}
                    </ul>
                  </section>
                )}
                {p.usage.recipes.length > 0 && (
                  <section class="details__section">
                    <h3 class="details__heading">{t.recipes}</h3>
                    <div class="recipes">
                      {p.usage.recipes.map((r) => (
                        <article class:list={['recipe', { 'recipe--photo': r.image }]}>
                          {r.image && (
                            <img
                              class="recipe__image"
                              src={r.image.src}
                              width={r.image.width}
                              height={r.image.height}
                              alt={r.image.alt}
                              loading="lazy"
                              decoding="async"
                            />
                          )}
                          <div class="recipe__body">
                            <h4 class="recipe__name">{r.name}</h4>
                            {(r.time || r.servings) && (
                              <dl class="recipe__meta">
                                {r.time && <div><dt>{t.time}</dt><dd>{r.time}</dd></div>}
                                {r.servings && <div><dt>{t.servings}</dt><dd>{r.servings}</dd></div>}
                              </dl>
                            )}
                            <div class="recipe__columns">
                              {r.ingredients.length > 0 && (
                                <div>
                                  <p class="details__label">{t.recipeIngredients}</p>
                                  <ul class="details__list details__list--plain">
                                    {r.ingredients.map((x) => <li>{x}</li>)}
                                  </ul>
                                </div>
                              )}
                              {r.steps.length > 0 && (
                                <div>
                                  <p class="details__label">{t.recipeSteps}</p>
                                  <ol class="recipe__steps">
                                    {r.steps.map((x) => <li>{x}</li>)}
                                  </ol>
                                </div>
                              )}
                            </div>
                          </div>
                        </article>
                      ))}
                    </div>
                  </section>
                )}
              </>
            )}

            {tab === 'ho-so' && p.records && (
              <section class="details__section">
                <h3 class="details__heading">{t.recordsTitle}</h3>
                <ul class="records">
                  {p.records.map((d) => {
                    const external = d.external || (!!d.href && isExternal(d.href));
                    return (
                      <li class="record">
                        <p class="details__label record__kind">{d.kind}</p>
                        <p class="record__title"><strong>{d.title}</strong></p>
                        {(d.issuer || d.reference || d.date || d.scope) && (
                          <dl class="record__meta">
                            {d.issuer && <div><dt>{t.issuer}</dt><dd>{d.issuer}</dd></div>}
                            {d.reference && <div><dt>{t.reference}</dt><dd>{d.reference}</dd></div>}
                            {d.date && <div><dt>{t.date}</dt><dd>{d.date}</dd></div>}
                            {d.scope && <div><dt>{t.scope}</dt><dd>{d.scope}</dd></div>}
                          </dl>
                        )}
                        {d.href && (external ? (
                          <a class="link-arrow record__link" href={d.href} target="_blank" rel="noopener">
                            <span>{d.linkLabel ?? t.viewDocument}<span class="sr-only"> {t.newTab}</span></span> <Arrow direction="up-right" />
                          </a>
                        ) : (
                          <a class="link-arrow record__link" href={d.href}>{d.linkLabel ?? t.viewDocument} <Arrow /></a>
                        ))}
                      </li>
                    );
                  })}
                </ul>
              </section>
            )}

            {tab === 'nhan-xet' && p.reviews && (
              <section class="details__section">
                <h3 class="details__heading">{t.reviewsTitle}</h3>
                <div class="reviews">
                  {p.reviews.map((r) => (
                    <figure class="review">
                      <blockquote class="review__quote"><p>{r.quote}</p></blockquote>
                      {(r.author || r.date || r.sourceName) && (
                        <figcaption class="review__by">
                          {[r.author, r.date, r.sourceName].filter(Boolean).join(' · ')}
                        </figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              </section>
            )}
          </div>
        ))}
      </div>
    ))}
  </div>
</div>

<script>
  import { initShowroomDetails } from './details';
  document.querySelectorAll<HTMLElement>('[data-showroom-details]').forEach(initShowroomDetails);
</script>

<style>
  .details {
    --details-min: 18rem;
    min-width: 0;
  }

  /* Tab list ---------------------------------------------------------------- */

  .details__tabs {
    position: relative;
    display: flex;
    gap: clamp(1.25rem, 0.6rem + 2.4vw, 2.75rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-bottom: 1px solid var(--color-line);
    /* Room for the focus outline inside the scroller. */
    padding-inline: 2px;
    margin-inline: -2px;
  }
  .details__tabs::-webkit-scrollbar { display: none; }
  .details__tabs[data-more="end"] {
    mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
  }
  .details__tabs[data-more="start"] {
    mask-image: linear-gradient(to left, #000 calc(100% - 2.5rem), transparent);
  }
  .details__tabs[data-more="start end"] {
    mask-image: linear-gradient(to right, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
  }

  .details__tab {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.25rem 0.125rem;
    font-family: var(--font-body);
    font-size: var(--type-nav);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--color-text-muted);
    transition: color 250ms var(--ease);
  }
  .details__tab[hidden] { display: none; }
  .details__tab::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-forest);
    transform: scaleX(0);
    transition: transform 300ms var(--ease);
  }
  .details__tab:hover { color: var(--color-text); }
  .details__tab[aria-selected="true"] {
    color: var(--color-forest);
    font-weight: 500;
  }
  .details__tab[aria-selected="true"]::after { transform: none; }
  .details__tab:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: -2px;
  }

  /* Panels ------------------------------------------------------------------ */

  .details__panels {
    /* The area never shrinks under the reader: details.ts may hold it at
       its previous height (--details-lock) when a shorter panel opens. */
    min-height: var(--details-lock, 0px);
    overflow-anchor: none;
  }

  .details__panel {
    min-height: var(--details-min);
    padding-top: clamp(1.75rem, 1.25rem + 1.6vw, 2.75rem);
    padding-bottom: var(--space-m);
  }
  .details__panel:focus-visible {
    outline: 1px solid var(--color-line-strong);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .details__tab,
    .details__tab::after { transition: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .details__block:not([hidden]) {
      animation: details-fade 220ms var(--ease);
    }
  }
  @keyframes details-fade {
    from { opacity: 0; }
  }

  /* Sections ---------------------------------------------------------------- */

  .details__section + .details__section {
    margin-top: clamp(2.25rem, 1.75rem + 1.6vw, 3.25rem);
  }

  .details__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-product);
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: var(--color-text);
    text-wrap: balance;
  }
  /* A short hairline after the last word: "Cách dùng ——". */
  .details__heading::after {
    content: "";
    display: inline-block;
    vertical-align: middle;
    width: 2.5rem;
    height: 1px;
    margin-left: 1rem;
    background: currentColor;
    opacity: 0.5;
  }

  .details__prose {
    margin-top: var(--space-s);
    max-width: 44rem;
    font-size: var(--type-body);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .details__prose p + p { margin-top: 0.9em; }

  .details__label {
    font-size: var(--type-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--color-earth);
  }

  .details__text {
    margin-top: var(--space-2xs);
    max-width: 44rem;
    font-size: var(--type-body);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .details__ingredients {
    margin-top: var(--space-m);
  }

  /* Facts: a definition table with hairlines. */
  .details__facts {
    margin-top: var(--space-m);
    max-width: 52rem;
    border-bottom: 1px solid var(--color-line);
  }
  .details__fact {
    display: grid;
    gap: 0.125rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--type-body);
    line-height: 1.6;
  }
  .details__fact dt {
    font-size: var(--type-small);
    font-weight: 500;
    color: var(--color-text);
  }
  .details__fact dd {
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
  @media (min-width: 560px) {
    .details__fact {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      column-gap: var(--space-l);
    }
    .details__fact dt { font-size: var(--type-body); padding-top: 0; }
  }

  .details__more { margin-top: var(--space-m); }

  .details__list {
    margin-top: var(--space-s);
    max-width: 44rem;
    font-size: var(--type-body);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
  }
  .details__list > li {
    position: relative;
    padding-left: 1.25rem;
    text-wrap: pretty;
  }
  .details__list > li + li { margin-top: 0.5em; }
  .details__list > li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-earth);
  }
  .details__list--plain { margin-top: var(--space-2xs); }

  /* Recipes ----------------------------------------------------------------- */

  .recipes { margin-top: var(--space-m); }

  .recipe {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-l);
    border-top: 1px solid var(--color-line);
  }
  .recipe:first-child { padding-top: var(--space-m); }
  .recipe:last-child { padding-bottom: 0; }

  .recipe__image {
    width: 100%;
    max-width: 30rem;
    height: auto;
    object-fit: cover;
  }

  .recipe__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--type-product);
    line-height: var(--lh-heading);
    color: var(--color-text);
  }

  .recipe__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: var(--space-2xs);
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .recipe__meta div { display: flex; gap: 0.4em; }
  .recipe__meta dt { color: var(--color-text); font-weight: 500; }
  .recipe__meta dt::after { content: ":"; }
  :global(:root:lang(zh)) .recipe__meta dt::after { content: "："; }

  .recipe__columns {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  .recipe__steps {
    margin-top: var(--space-2xs);
    counter-reset: step;
    font-size: var(--type-body);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
  }
  .recipe__steps li {
    position: relative;
    padding-left: 2rem;
    counter-increment: step;
    text-wrap: pretty;
  }
  .recipe__steps li + li { margin-top: 0.6em; }
  .recipe__steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-size: var(--type-small);
    font-variant-numeric: tabular-nums;
    color: var(--color-earth);
  }

  @media (min-width: 768px) {
    .recipe__columns {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      column-gap: var(--space-xl);
    }
    .recipe__columns > :only-child { grid-column: 1 / -1; max-width: 44rem; }
  }
  @media (min-width: 1024px) {
    .recipe--photo {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      column-gap: var(--space-xl);
      align-items: start;
    }
    .recipe--photo .recipe__columns { grid-template-columns: minmax(0, 1fr); }
  }

  /* Records ----------------------------------------------------------------- */

  .records {
    margin-top: var(--space-m);
    max-width: 52rem;
    border-bottom: 1px solid var(--color-line);
  }

  .record {
    padding-block: var(--space-m);
    border-top: 1px solid var(--color-line);
  }

  .record__title {
    margin-top: 0.375rem;
    font-size: var(--type-body);
    line-height: 1.55;
    color: var(--color-text);
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .record__title strong { font-weight: 500; }

  .record__meta {
    display: grid;
    gap: 0.125rem;
    margin-top: var(--space-2xs);
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .record__meta div {
    display: grid;
    grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
    column-gap: var(--space-s);
  }
  .record__meta dt { color: var(--color-text); }
  .record__meta dd { overflow-wrap: anywhere; }

  .record__link { margin-top: var(--space-s); }

  /* Reviews ----------------------------------------------------------------- */

  .reviews {
    display: grid;
    margin-top: var(--space-m);
    max-width: 48rem;
  }

  .review {
    padding-block: var(--space-m);
    border-top: 1px solid var(--color-line);
  }
  .review:first-child { border-top: 0; padding-top: 0; }

  .review__quote {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--type-lead);
    line-height: 1.6;
    color: var(--color-text);
    text-wrap: pretty;
  }
  .review__quote p::before { content: "“"; }
  .review__quote p::after { content: "”"; }

  .review__by {
    margin-top: var(--space-xs);
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .review__by::before { content: "— "; }
</style>
