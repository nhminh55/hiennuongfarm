---
/**
 * The /san-pham/ showroom: a list of the 12 products and a stage that shows
 * the selected one. The selection lives in the URL hash (/san-pham/#slug).
 *
 * Stage: a wall and a stationary pedestal (top surface, lit front edge,
 * front face, a soft cast shadow). The square product photo is placed so the
 * product's base (image.base) lands on the pedestal's top surface; the
 * photo's own tabletop becomes that surface, and its bottom edge is hidden
 * behind the front face. Either side of the photo, a thin band of its own
 * outer pixel columns is stretched sideways so its wall and tabletop run on
 * without a seam: above the pedestal into the wall (fading into the photo's
 * edge colours, image.tone), on the pedestal out to its ends. All geometry
 * is a multiple of the photo size (--s), so the per-product colours below
 * hold at every breakpoint. Two layers crossfade on change; a new image is
 * shown only once decoded, and only the latest selection is ever displayed.
 *
 * Contract with ShowroomDetails (the default slot): the root carries
 * data-current="{slug}"; on every change (including the initial selection
 * from the URL) data-current is set first, then `showroom:change`
 * ({ detail: { slug } }) is dispatched on the root. Focus never moves.
 *
 * No element on the page may have an id equal to a product slug, so the
 * browser never scrolls to a product hash.
 */
import Arrow from '../Arrow.astro';
import { contact } from '../../data/site';
import { showroomHref, type ShowroomItem } from '../../data/showroom';
import { getLocale } from '../../i18n';

interface Props { products: ShowroomItem[] }
const { products } = Astro.props;
const lang = getLocale(Astro.url);

const t = {
  vi: {
    count: (n: number) => `${n} sản phẩm`,
    ask: 'Liên hệ tư vấn',
    call: 'Gọi điện',
    subject: (name: string) => `Tư vấn sản phẩm: ${name} — Hiền Nương Farm`,
  },
  en: {
    count: (n: number) => `${n} products`,
    ask: 'Ask for advice',
    call: 'Call us',
    subject: (name: string) => `Product enquiry: ${name} — Hiền Nương Farm`,
  },
  zh: {
    count: (n: number) => `${n} 款产品`,
    ask: '咨询',
    call: '致电',
    subject: (name: string) => `产品咨询：${name} — Hiền Nương Farm`,
  },
}[lang];

const total = products.length;
const pad = (n: number) => String(n).padStart(2, '0');
const mail = (name: string) => `mailto:${contact.email}?subject=${encodeURIComponent(t.subject(name))}`;

// Stage geometry, in photo sizes (--s): the product's base line and the
// pedestal's back edge, measured from the top of the scene (see CSS).
const BASE_Y = 0.9;
const BACK_Y = 0.714;

const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
const hex = (c: number[]) => `#${c.map((v) => Math.round(v).toString(16).padStart(2, '0')).join('')}`;

/** The photo's edge colour at a height (fraction of the photo), between band centres. */
const toneAt = (tone: string[], f: number) => {
  const x = Math.min(Math.max(f * tone.length - 0.5, 0), tone.length - 1);
  const i = Math.min(Math.floor(x), tone.length - 2);
  const a = rgb(tone[i]);
  const b = rgb(tone[i + 1]);
  return hex(a.map((v, k) => v + (b[k] - v) * (x - i)));
};

/**
 * Per-product stage colours. --wall runs the photo's edge colours down to
 * just above the pedestal's back edge, then holds that colour (--c), so the
 * wall beside the pedestal stays a wall.
 */
const stageVars = (image: ShowroomItem['image']) => {
  const { tone, base } = image;
  const back = base - (BASE_Y - BACK_Y) - 0.02;
  const c = toneAt(tone, back);
  const stops = tone
    .map((col, i) => [col, (i + 0.5) / tone.length] as const)
    .filter(([, f]) => f < back)
    .map(([col, f]) => `${col} ${(f * 100).toFixed(1)}%`);
  const wall = `linear-gradient(to bottom, ${[`${tone[0]} 0%`, ...stops, `${c} ${(back * 100).toFixed(1)}%`, `${c} 100%`].join(', ')})`;
  return `--b: ${base}; --t0: ${tone[0]}; --c: ${c}; --t9: ${tone[tone.length - 1]}; --wall: ${wall}`;
};

// The photo's rendered width (= --s below).
const sizes = '(min-width: 1024px) min(25vw, 400px), (min-width: 640px) 44vw, 62vw';

const data = products.map((p, i) => ({
  slug: p.slug,
  index: pad(i + 1),
  name: p.name,
  category: p.category ?? '',
  summary: p.summary,
  src: p.image.src,
  srcset: p.image.srcset,
  alt: p.image.alt,
  vars: stageVars(p.image),
  mail: mail(p.name),
}));
const json = JSON.stringify({ sizes, items: data }).replace(/</g, '\\u003c');

const first = products[0];
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const layers = [
  { image: first.image, src: first.image.src, srcset: first.image.srcset, alt: first.image.alt, current: true },
  { image: first.image, src: blank, srcset: undefined, alt: '', current: false },
];
---
<section class="showroom" data-showroom data-current={first.slug} aria-labelledby="showroom-name">
  <div class="container showroom__grid">
    <nav class="showroom__index" aria-labelledby="showroom-count" data-showroom-index>
      <p class="showroom__count" id="showroom-count">{t.count(total)}</p>
      <ol class="showroom__list" data-showroom-list>
        {products.map((p, i) => (
          <li class="showroom__item">
            <a
              class="showroom__row"
              href={showroomHref(p.slug, lang)}
              data-slug={p.slug}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="showroom__num" aria-hidden="true">{pad(i + 1)}</span>
              <img class="showroom__thumb" src={p.image.thumb} width="160" height="160" alt="" decoding="async" />
              <span class="showroom__label">{p.name}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="showroom__main">
      <div class="showroom__body">
        <div class="showroom__head">
          <p class="eyebrow showroom__eyebrow">
            <span class="eyebrow__num" data-showroom-index-text>{pad(1)} / {pad(total)}</span>
            <span class="showroom__category" data-showroom-category-group hidden={!first.category}>
              <span class="eyebrow__rule" aria-hidden="true"></span>
              <span data-showroom-category>{first.category}</span>
            </span>
          </p>
          <h2 class="showroom__name" id="showroom-name" data-showroom-name>{first.name}</h2>
        </div>

        <div class="showroom__stage" data-showroom-stage>
          <div class="showroom__scene">
            {layers.map((l, i) => (
              <div
                class:list={['showroom__layer', { 'is-current is-top': l.current }]}
                style={stageVars(l.image)}
                aria-hidden={l.current ? undefined : 'true'}
                data-showroom-layer
              >
                <div class="showroom__wall"></div>
                <span class="showroom__side showroom__side--l showroom__side--wall" aria-hidden="true">
                  <img src={l.src} srcset={l.srcset} sizes={sizes} width={l.image.width} height={l.image.height} alt="" decoding="async" />
                </span>
                <span class="showroom__side showroom__side--r showroom__side--wall" aria-hidden="true">
                  <img src={l.src} srcset={l.srcset} sizes={sizes} width={l.image.width} height={l.image.height} alt="" decoding="async" />
                </span>
                <div class="showroom__top">
                  <span class="showroom__side showroom__side--l" aria-hidden="true">
                    <img src={l.src} srcset={l.srcset} sizes={sizes} width={l.image.width} height={l.image.height} alt="" decoding="async" />
                  </span>
                  <span class="showroom__side showroom__side--r" aria-hidden="true">
                    <img src={l.src} srcset={l.srcset} sizes={sizes} width={l.image.width} height={l.image.height} alt="" decoding="async" />
                  </span>
                </div>
                <img
                  class="showroom__photo"
                  src={l.src}
                  srcset={l.srcset}
                  sizes={sizes}
                  width={l.image.width}
                  height={l.image.height}
                  alt={l.alt}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
                <span class="showroom__contact" aria-hidden="true"></span>
              </div>
            ))}
            <div class="showroom__pedestal" aria-hidden="true">
              <span class="showroom__surface"></span>
              <span class="showroom__front"></span>
              <span class="showroom__cast"></span>
            </div>
            <div class="showroom__light" aria-hidden="true"></div>
          </div>
          <div class="showroom__floor" aria-hidden="true"></div>
        </div>

        <div class="showroom__info">
          <p class="showroom__summary" data-showroom-summary>{first.summary}</p>
          <div class="showroom__actions">
            <a class="btn" href={mail(first.name)} data-showroom-mail>{t.ask} <Arrow /></a>
            <a class="link-arrow showroom__call" href={`tel:${contact.phone}`}>
              {t.call} <span class="showroom__phone">{contact.phoneDisplay}</span>
            </a>
          </div>
        </div>

        <p class="sr-only" aria-live="polite" data-showroom-live></p>

        <script type="application/json" data-showroom-data set:html={json} />
        <script is:inline>
          (() => {
            const root = document.currentScript.closest('[data-showroom]');
            if (!root) return;
            const { sizes, items } = JSON.parse(root.querySelector('[data-showroom-data]').textContent);
            const bySlug = new Map(items.map((p) => [p.slug, p]));
            const $ = (s) => root.querySelector(s);
            const index = $('[data-showroom-index]');
            const list = $('[data-showroom-list]');
            const stage = $('[data-showroom-stage]');
            const rows = [...root.querySelectorAll('[data-showroom-list] [data-slug]')];
            const layers = [...root.querySelectorAll('[data-showroom-layer]')];
            const nameEl = $('[data-showroom-name]');
            const numEl = $('[data-showroom-index-text]');
            const catEl = $('[data-showroom-category]');
            const catGroup = $('[data-showroom-category-group]');
            const summaryEl = $('[data-showroom-summary]');
            const mailEl = $('[data-showroom-mail]');
            const liveEl = $('[data-showroom-live]');
            const total = String(items.length).padStart(2, '0');
            const baseTitle = document.title;
            const desktop = window.matchMedia('(min-width: 1024px)');
            const still = window.matchMedia('(prefers-reduced-motion: reduce)');

            let current = items[0].slug;
            let front = layers[0];
            let token = 0;
            let fade = null;
            let dim = 0;

            const photoOf = (layer) => layer.querySelector('.showroom__photo');

            const slugFromHash = () => {
              try { return decodeURIComponent(location.hash.slice(1)); } catch { return ''; }
            };

            const headerBottom = () => {
              const css = getComputedStyle(document.documentElement);
              return parseFloat(css.getPropertyValue('--header-h')) * parseFloat(css.fontSize) || 0;
            };

            // Keep a row visible inside the list's own scroller; never scroll the page.
            const reveal = (row) => {
              if (desktop.matches) {
                const box = index.getBoundingClientRect();
                const head = index.firstElementChild.getBoundingClientRect().height;
                const r = row.getBoundingClientRect();
                if (r.top < box.top + head) index.scrollTop += r.top - box.top - head;
                else if (r.bottom > box.bottom) index.scrollTop += r.bottom - box.bottom;
              } else {
                const box = list.getBoundingClientRect();
                const r = row.getBoundingClientRect();
                if (r.left < box.left) list.scrollLeft += r.left - box.left;
                else if (r.right > box.right) list.scrollLeft += r.right - box.right;
              }
            };

            // After a reader's choice made far down the page, bring the stage
            // (and on phones the selector above it) back into view.
            const bringIntoView = () => {
              const target = desktop.matches ? stage : index;
              const top = target.getBoundingClientRect().top - headerBottom() - 16;
              if (top < 0) window.scrollBy({ top, behavior: still.matches ? 'auto' : 'smooth' });
            };

            const setText = (p) => {
              nameEl.textContent = p.name;
              numEl.textContent = `${p.index} / ${total}`;
              catEl.textContent = p.category;
              catGroup.hidden = !p.category;
            };

            const fill = (layer, p) => {
              layer.style.cssText = p.vars;
              layer.querySelectorAll('img').forEach((img) => {
                img.sizes = sizes;
                img.srcset = p.srcset;
                img.src = p.src;
              });
              photoOf(layer).alt = p.alt;
              layer.dataset.slug = p.slug;
            };

            const finishFade = () => {
              if (fade) { const f = fade; fade = null; f.forEach((a) => a.finish()); }
            };

            // Swap the photo once it is decoded; a newer selection cancels this
            // one. While a slow image loads, the previous product stays on the
            // stage, dimmed, so the stage is never empty.
            const show = (p, animate) => {
              const my = ++token;
              finishFade();
              clearTimeout(dim);
              if (front.dataset.slug === p.slug) { stage.classList.remove('is-loading'); return; }
              const back = layers.find((l) => l !== front);
              fill(back, p);
              const img = photoOf(back);
              dim = setTimeout(() => { if (my === token) stage.classList.add('is-loading'); }, 200);
              const loaded = (i) => (i.complete && i.naturalWidth ? Promise.resolve() : new Promise((r) => {
                i.addEventListener('load', r, { once: true });
                i.addEventListener('error', r, { once: true });
              })).then(() => (i.decode ? i.decode().catch(() => {}) : null));
              Promise.all([...back.querySelectorAll('img')].map(loaded)).then(() => {
                if (my !== token) return;
                clearTimeout(dim);
                stage.classList.remove('is-loading');
                finishFade();
                const old = front;
                front = back;
                old.classList.remove('is-top');
                old.setAttribute('aria-hidden', 'true');
                back.classList.add('is-current', 'is-top');
                back.removeAttribute('aria-hidden');
                const done = () => { if (front !== old) old.classList.remove('is-current'); };
                if (!animate || still.matches || !back.animate) { done(); return; }
                const ease = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
                const a = back.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: ease });
                const b = img.animate([{ transform: 'translateY(6px)' }, { transform: 'none' }], { duration: 300, easing: ease });
                fade = [a, b];
                a.addEventListener('finish', done);
              });
            };

            const titleFor = (p) => (bySlug.has(slugFromHash()) ? `${p.name} — ${baseTitle}` : baseTitle);

            const update = (p) => {
              current = p.slug;
              root.dataset.current = p.slug;
              rows.forEach((r) => {
                if (r.dataset.slug === p.slug) r.setAttribute('aria-current', 'true');
                else r.removeAttribute('aria-current');
              });
              setText(p);
              summaryEl.textContent = p.summary;
              mailEl.href = p.mail;
              document.title = titleFor(p);
            };

            const fire = () => root.dispatchEvent(new CustomEvent('showroom:change', { bubbles: true, detail: { slug: current } }));

            const select = (slug, announce) => {
              const p = bySlug.get(slug);
              if (!p || slug === current) return false;
              update(p);
              fire();
              show(p, true);
              const row = rows.find((r) => r.dataset.slug === slug);
              if (row) reveal(row);
              if (announce) liveEl.textContent = p.name;
              return true;
            };

            // Initial selection from the URL, applied before first paint. An
            // unknown or malformed hash falls back to product 01 and is removed
            // (unless it names another element on the page, e.g. #main).
            layers[0].dataset.slug = items[0].slug;
            const initial = slugFromHash();
            if (location.hash.length > 1 && !bySlug.has(initial) && !(initial && document.getElementById(initial))) {
              history.replaceState(history.state, '', location.pathname + location.search);
            }
            const start = bySlug.get(bySlug.has(initial) ? initial : items[0].slug);
            update(start);
            if (start !== items[0]) fill(layers[0], start);
            // Details may load after this script: it reads data-current, and the event is repeated once the page is parsed.
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fire, { once: true });
            else fire();
            requestAnimationFrame(() => {
              const row = rows.find((r) => r.dataset.slug === current);
              if (row) reveal(row);
            });

            // A product hash is a selection, not a scroll target: in-page
            // history entries keep the reader where they are. Restored to
            // 'auto' when leaving, so returning from another page still
            // restores the scroll position.
            const manual = () => { if ('scrollRestoration' in history) history.scrollRestoration = 'manual'; };
            window.addEventListener('pagehide', () => { if ('scrollRestoration' in history) history.scrollRestoration = 'auto'; });

            list.addEventListener('click', (e) => {
              const row = e.target.closest('[data-slug]');
              if (!row || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
              e.preventDefault();
              row.focus({ preventScroll: true });
              const slug = row.dataset.slug;
              if (slug === current) return;
              manual();
              history.pushState(null, '', `#${slug}`);
              select(slug, true);
              bringIntoView();
            });

            // Back/Forward and typed hashes. An unknown hash keeps the current
            // product and is replaced by that product's own hash.
            const sync = () => {
              const slug = slugFromHash();
              if (bySlug.has(slug)) select(slug, true);
              else if (location.hash.length <= 1) select(items[0].slug, true);
              else if (!document.getElementById(slug)) history.replaceState(history.state, '', `#${current}`);
              document.title = titleFor(bySlug.get(current));
            };
            window.addEventListener('popstate', sync);
            window.addEventListener('hashchange', sync);

            // Keyboard: arrows move between rows (both orientations), Home/End to the ends.
            list.addEventListener('keydown', (e) => {
              const i = rows.indexOf(document.activeElement);
              if (i < 0) return;
              const keys = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: rows.length - 1 };
              if (!(e.key in keys) || e.altKey || e.ctrlKey || e.metaKey) return;
              e.preventDefault();
              const next = rows[Math.max(0, Math.min(rows.length - 1, keys[e.key]))];
              next.focus({ preventScroll: true });
              reveal(next);
              // A row outside the viewport (list not yet sticky) is brought just into view, below the fixed header.
              const r = next.getBoundingClientRect();
              const top = headerBottom();
              if (r.top < top) window.scrollBy(0, r.top - top - 16);
              else if (r.bottom > innerHeight) window.scrollBy(0, r.bottom - innerHeight + 16);
            });

            // Warm the cache for a product the reader is about to choose.
            const warmed = new Set();
            const warm = (e) => {
              const row = e.target.closest && e.target.closest('[data-slug]');
              const p = row && bySlug.get(row.dataset.slug);
              if (!p || warmed.has(p.slug)) return;
              warmed.add(p.slug);
              const img = new Image();
              img.sizes = sizes;
              img.srcset = p.srcset;
              img.src = p.src;
            };
            list.addEventListener('pointerover', warm);
            list.addEventListener('focusin', warm);
          })();
        </script>

        <div class="showroom__details">
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .showroom {
    padding-top: clamp(0.5rem, 0.25rem + 1vw, 1.25rem);
    padding-bottom: var(--section-y);
  }

  .showroom__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-m);
  }

  /* Product index -------------------------------------------------------- */

  .showroom__index { min-width: 0; }

  .showroom__count {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: var(--lh-heading);
    padding-bottom: var(--space-xs);
  }

  .showroom__list {
    display: flex;
    gap: var(--space-2xs);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--space-2xs);
    scrollbar-width: thin;
    scrollbar-color: var(--color-line-strong) transparent;
    padding-bottom: var(--space-2xs);
  }

  .showroom__item {
    flex: none;
    width: 6rem;
    scroll-snap-align: start;
  }

  /* Phones and tablets: a strip of tiles; the selected one has a forest
     frame around its thumbnail and its name in forest green. */
  .showroom__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
    padding: var(--space-2xs) var(--space-2xs) 0.625rem;
    color: var(--color-text-muted);
    transition: background-color 250ms var(--ease), color 250ms var(--ease);
  }
  .showroom__row:hover { background: rgba(23, 61, 45, 0.06); color: var(--color-text); }
  .showroom__row:focus-visible { outline: 1px solid currentColor; outline-offset: -4px; }
  .showroom__row[aria-current='true'] {
    color: var(--color-forest);
    font-weight: 500;
  }
  .showroom__row[aria-current='true'] .showroom__thumb { outline: 2px solid var(--color-forest); outline-offset: -2px; }

  .showroom__num { display: none; }

  .showroom__thumb {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--color-cream);
  }

  .showroom__label {
    font-size: 0.75rem;
    line-height: 1.35;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  /* Main column ----------------------------------------------------------- */

  .showroom__main {
    min-width: 0;
    container: showroom / inline-size;
  }

  .showroom__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .showroom__stage { grid-row: 1; grid-column: 1; }
  .showroom__head { grid-row: 2; grid-column: 1; margin-top: var(--space-l); }
  .showroom__info { grid-row: 3; grid-column: 1; }
  .showroom__details { grid-row: 4; grid-column: 1; min-width: 0; }

  .showroom__eyebrow { gap: 0.25rem 0.75rem; flex-wrap: wrap; }
  .showroom__eyebrow > * { white-space: nowrap; }
  /* The rule travels with its category when the line wraps. */
  .showroom__category { display: inline-flex; align-items: center; gap: inherit; }
  .showroom__eyebrow [hidden] { display: none; }

  .showroom__name {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  /* Stage ------------------------------------------------------------------
     Everything is measured in photo sizes (--s), from the top of the scene:
     product base 0.9, pedestal back edge 0.714 (BASE_Y, BACK_Y in the
     script above), front edge 1.014, floor 1.144. The pedestal is 1.25
     photos wide at the front, 1.18 at the back, centred at --cx. */
  .showroom__stage {
    --s: 62cqi;
    --cx: 50cqi;
    --yb: calc(var(--s) * 0.9);
    --pt: calc(var(--s) * 0.714);
    --pf: calc(var(--s) * 1.014);
    --pwf: calc(var(--s) * 1.25);
    --pwb: calc(var(--s) * 1.18);
    --photo-l: calc(var(--cx) - var(--s) / 2);
    --photo-r: calc(100cqi - var(--cx) - var(--s) / 2);
    --feather: calc(var(--s) * 0.015);
