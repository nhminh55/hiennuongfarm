---
/**
 * The /san-pham/ showroom: a list of the 12 products and a stage that shows
 * the selected one. The selection lives in the URL hash (/san-pham/#slug).
 *
 * Stage: two stationary photographic backgrounds and decoded product cutouts.
 * Placement is measured from each image's visible alpha bounds. Selection
 * changes fade out the old product before the next one settles onto the surface.
 *
 * Contract with ShowroomDetails (the default slot): the root carries
 * data-current="{slug}"; on every change (including the initial selection
 * from the URL) data-current is set first, then `showroom:change`
 * ({ detail: { slug } }) is dispatched on the root. Focus never moves.
 *
 * No element on the page may have an id equal to a product slug, so the
 * browser never scrolls to a product hash.
 */
import Arrow from '../Arrow.astro';
import { contact } from '../../data/site';
import { showroomHref, type ShowroomItem } from '../../data/showroom';
import { getLocale } from '../../i18n';

interface Props { products: ShowroomItem[] }
const { products } = Astro.props;
const lang = getLocale(Astro.url);

const t = {
  vi: {
    count: (n: number) => `${n} sản phẩm`,
    ask: 'Liên hệ tư vấn',
    call: 'Gọi điện',
    subject: (name: string) => `Tư vấn sản phẩm: ${name} — Hiền Nương Farm`,
  },
  en: {
    count: (n: number) => `${n} products`,
    ask: 'Ask for advice',
    call: 'Call us',
    subject: (name: string) => `Product enquiry: ${name} — Hiền Nương Farm`,
  },
  zh: {
    count: (n: number) => `${n} 款产品`,
    ask: '咨询',
    call: '致电',
    subject: (name: string) => `产品咨询：${name} — Hiền Nương Farm`,
  },
}[lang];

const total = products.length;
const pad = (n: number) => String(n).padStart(2, '0');
const mail = (name: string) => `mailto:${contact.email}?subject=${encodeURIComponent(t.subject(name))}`;

const stageVars = (image: ShowroomItem['image']) => {
  const { width, x, surface, bounds } = image.placement;
  const center = (bounds[0] + bounds[2]) / 2 / image.width;
  const bottom = (bounds[3] + 1) / image.height;
  return `--product-width: ${width}%; --product-left: ${x - center * width}%; --product-top: ${surface - bottom * width * 1.5}%`;
};
const backgroundDir = '/images/products/showroom';

const data = products.map((p, i) => ({
  slug: p.slug,
  index: pad(i + 1),
  name: p.name,
  category: p.category ?? ({ vi: 'Sản phẩm', en: 'Product', zh: '产品' }[lang]),
  summary: p.summary,
  src: p.image.src,
  alt: p.image.alt,
  vars: stageVars(p.image),
  plate: p.image.plate,
  mail: mail(p.name),
}));
const json = JSON.stringify({ items: data }).replace(/</g, '\\u003c');

const first = products[0];
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const layers = [
  { image: first.image, src: first.image.src, alt: first.image.alt, current: true },
  { image: first.image, src: blank, alt: '', current: false },
];
---
<section class="showroom" data-showroom data-current={first.slug} aria-labelledby="showroom-name">
  <div class="container showroom__grid">
    <nav class="showroom__index" aria-labelledby="showroom-count" data-showroom-index>
      <p class="showroom__count" id="showroom-count">{t.count(total)}</p>
      <ol class="showroom__list" data-showroom-list>
        {products.map((p, i) => (
          <li class="showroom__item">
            <a
              class="showroom__row"
              href={showroomHref(p.slug, lang)}
              data-slug={p.slug}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="showroom__num" aria-hidden="true">{pad(i + 1)}</span>
              <img class="showroom__thumb" src={p.image.thumb} width="160" height="160" alt="" decoding="async" />
              <span class="showroom__label">{p.name}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="showroom__main">
      <div class="showroom__body">
        <div class="showroom__head">
          <p class="eyebrow showroom__eyebrow">
            <span class="showroom__category" data-showroom-category-group>
              <span data-showroom-category>{data[0].category}</span>
            </span>
          </p>
          <h2 class="showroom__name" id="showroom-name" data-showroom-name>{first.name}</h2>
        </div>

        <div class="showroom__stage" data-showroom-stage>
          <img class="showroom__background" src={`${backgroundDir}/showroom-co-dia-cay-mo.webp`} width="1536" height="1024" alt="" aria-hidden="true" decoding="async" data-showroom-background="plate" />
          <img class="showroom__background" src={`${backgroundDir}/showroom-khong-dia-cay-mo.webp`} width="1536" height="1024" alt="" aria-hidden="true" decoding="async" data-showroom-background="wood" hidden />
          {layers.map((l, i) => (
            <div class:list={['showroom__layer', { 'is-current': l.current }]} style={stageVars(l.image)} aria-hidden={l.current ? undefined : 'true'} data-showroom-layer>
              <img class="showroom__photo" src={l.src} width={l.image.width} height={l.image.height} alt={l.alt} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
            </div>
          ))}
          <span class="showroom__counter" data-showroom-index-text>{pad(1)} / {pad(total)}</span>
        </div>

        <div class="showroom__info">
          <p class="showroom__summary" data-showroom-summary>{first.summary}</p>
          <div class="showroom__actions">
            <a class="btn" href={mail(first.name)} data-showroom-mail>{t.ask} <Arrow /></a>
            <a class="link-arrow showroom__call" href={`tel:${contact.phone}`}>
              {t.call} <span class="showroom__phone">{contact.phoneDisplay}</span>
            </a>
          </div>
        </div>

        <p class="sr-only" aria-live="polite" data-showroom-live></p>

        <script type="application/json" data-showroom-data set:html={json} />
        <script is:inline>
          (() => {
            const root = document.currentScript.closest('[data-showroom]');
            if (!root) return;
            const { items } = JSON.parse(root.querySelector('[data-showroom-data]').textContent);
            const bySlug = new Map(items.map((p) => [p.slug, p]));
            const $ = (s) => root.querySelector(s);
            const index = $('[data-showroom-index]');
            const list = $('[data-showroom-list]');
            const stage = $('[data-showroom-stage]');
            const rows = [...root.querySelectorAll('[data-showroom-list] [data-slug]')];
            const layers = [...root.querySelectorAll('[data-showroom-layer]')];
            const nameEl = $('[data-showroom-name]');
            const numEl = $('[data-showroom-index-text]');
            const catEl = $('[data-showroom-category]');
            const catGroup = $('[data-showroom-category-group]');
            const summaryEl = $('[data-showroom-summary]');
            const mailEl = $('[data-showroom-mail]');
            const liveEl = $('[data-showroom-live]');
            const total = String(items.length).padStart(2, '0');
            const baseTitle = document.title;
            const desktop = window.matchMedia('(min-width: 1024px)');
            const still = window.matchMedia('(prefers-reduced-motion: reduce)');

            let current = items[0].slug;
            let front = layers[0];
            let token = 0;
            let fade = null;
            const backgrounds = [...root.querySelectorAll('[data-showroom-background]')];
            const preloaded = new Map();

            const photoOf = (layer) => layer.querySelector('.showroom__photo');

            const slugFromHash = () => {
              try { return decodeURIComponent(location.hash.slice(1)); } catch { return ''; }
            };

            const headerBottom = () => {
              const css = getComputedStyle(document.documentElement);
              return parseFloat(css.getPropertyValue('--header-h')) * parseFloat(css.fontSize) || 0;
            };

            // Keep a row visible inside the list's own scroller; never scroll the page.
            const reveal = (row) => {
              if (desktop.matches) {
                const box = index.getBoundingClientRect();
                const head = index.firstElementChild.getBoundingClientRect().height;
                const r = row.getBoundingClientRect();
                if (r.top < box.top + head) index.scrollTop += r.top - box.top - head;
                else if (r.bottom > box.bottom) index.scrollTop += r.bottom - box.bottom;
              } else {
                const box = list.getBoundingClientRect();
                const r = row.getBoundingClientRect();
                if (r.left < box.left) list.scrollLeft += r.left - box.left;
                else if (r.right > box.right) list.scrollLeft += r.right - box.right;
              }
            };

            // After a reader's choice made far down the page, bring the stage
            // (and on phones the selector above it) back into view.
            const bringIntoView = () => {
              const target = desktop.matches ? stage : index;
              const top = target.getBoundingClientRect().top - headerBottom() - 16;
              if (top < 0) window.scrollBy({ top, behavior: still.matches ? 'auto' : 'smooth' });
            };

            const setText = (p) => {
              nameEl.textContent = p.name;
              numEl.textContent = `${p.index} / ${total}`;
              catEl.textContent = p.category;
              catGroup.hidden = !p.category;
            };

            const fill = (layer, p) => {
              layer.style.cssText = p.vars;
              const img = photoOf(layer);
              img.src = p.src;
              img.alt = p.alt;
              layer.dataset.slug = p.slug;
            };

            // Cache decoding promises, rather than reusing an image with pending
            // load listeners. Rapid selections can never reveal a stale product.
            const preload = (p) => {
              if (!preloaded.has(p.slug)) {
                const img = new Image();
                const ready = new Promise((resolve, reject) => {
                  img.onload = resolve;
                  img.onerror = reject;
                  img.src = p.src;
                }).then(() => img.decode());
                preloaded.set(p.slug, ready);
                ready.catch(() => preloaded.delete(p.slug));
              }
              return preloaded.get(p.slug);
            };

            const cancelFade = () => {
              if (fade) { fade.cancel(); fade = null; }
            };
            const hide = (layer) => {
              layer.classList.remove('is-current');
              layer.setAttribute('aria-hidden', 'true');
            };
            const backgroundFor = async (p) => {
              const bg = backgrounds.find((b) => b.dataset.showroomBackground === (p.plate ? 'plate' : 'wood'));
              await bg.decode();
              return bg;
            };
            const show = async (p, animate) => {
              const my = ++token;
              const opacity = getComputedStyle(front).opacity;
              cancelFade();
              stage.setAttribute('aria-busy', 'true');
              const moving = animate && !still.matches && !!front.animate;
              const old = front;
              const outgoing = moving && old.classList.contains('is-current')
                ? (fade = old.animate([{ opacity }, { opacity: 0 }], { duration: 120, easing: 'ease-out' })).finished.catch(() => {})
                : Promise.resolve();
              if (!moving) layers.forEach(hide);
              // Hide the previous product before swapping the stationary plate.
              outgoing.then(() => { if (my === token) layers.forEach(hide); });
              try {
                const [, bg] = await Promise.all([preload(p), backgroundFor(p), outgoing]);
                if (my !== token) return;
                cancelFade();
                layers.forEach(hide);
                backgrounds.forEach((b) => { b.hidden = b !== bg; });
                const next = layers.find((l) => l !== old);
                fill(next, p);
                await photoOf(next).decode();
                if (my !== token) return;
                front = next;
                next.classList.add('is-current');
                next.removeAttribute('aria-hidden');
                stage.removeAttribute('aria-busy');
                if (moving && !still.matches) {
                  fade = next.animate([{ opacity: 0, transform: 'translateY(-24px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 450, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' });
                }
              } catch {
                if (my !== token) return;
                cancelFade();
                layers.forEach(hide);
                stage.removeAttribute('aria-busy');
                liveEl.textContent = p.name + ' — ' + ({ vi: 'Không thể tải ảnh. Vui lòng thử lại.', en: 'Image unavailable. Please try again.', zh: '图片无法加载，请重试。' }[document.documentElement.lang] || 'Image unavailable. Please try again.');
              }
            };
            still.addEventListener('change', () => { if (still.matches) cancelFade(); });

            const titleFor = (p) => (bySlug.has(slugFromHash()) ? `${p.name} — ${baseTitle}` : baseTitle);

            const update = (p) => {
              current = p.slug;
              root.dataset.current = p.slug;
              rows.forEach((r) => {
                if (r.dataset.slug === p.slug) r.setAttribute('aria-current', 'true');
                else r.removeAttribute('aria-current');
              });
              setText(p);
              summaryEl.textContent = p.summary;
              mailEl.href = p.mail;
              document.title = titleFor(p);
            };

            const fire = () => root.dispatchEvent(new CustomEvent('showroom:change', { bubbles: true, detail: { slug: current } }));

            const select = (slug, announce) => {
              const p = bySlug.get(slug);
              if (!p || slug === current) return false;
              update(p);
              fire();
              show(p, true);
              const row = rows.find((r) => r.dataset.slug === slug);
              if (row) reveal(row);
              if (announce) liveEl.textContent = p.name;
              return true;
            };

            // Initial selection from the URL, applied before first paint. An
            // unknown or malformed hash falls back to product 01 and is removed
            // (unless it names another element on the page, e.g. #main).
            layers[0].dataset.slug = items[0].slug;
            const initial = slugFromHash();
            if (location.hash.length > 1 && !bySlug.has(initial) && !(initial && document.getElementById(initial))) {
              history.replaceState(history.state, '', location.pathname + location.search);
            }
            const start = bySlug.get(bySlug.has(initial) ? initial : items[0].slug);
            update(start);
            if (start !== items[0]) show(start, false);
            else preload(start).catch(() => {});
            // Details may load after this script: it reads data-current, and the event is repeated once the page is parsed.
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fire, { once: true });
            else fire();
            const revealCurrent = () => {
              const row = rows.find((r) => r.dataset.slug === current);
              if (row) reveal(row);
            };
            requestAnimationFrame(revealCurrent);
            window.addEventListener('resize', () => requestAnimationFrame(revealCurrent), { passive: true });

            // A product hash is a selection, not a scroll target: in-page
            // history entries keep the reader where they are. Restored to
            // 'auto' when leaving, so returning from another page still
            // restores the scroll position.
            const manual = () => { if ('scrollRestoration' in history) history.scrollRestoration = 'manual'; };
            window.addEventListener('pagehide', () => { if ('scrollRestoration' in history) history.scrollRestoration = 'auto'; });

            list.addEventListener('click', (e) => {
              const row = e.target.closest('[data-slug]');
              if (!row || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
              e.preventDefault();
              row.focus({ preventScroll: true });
              const slug = row.dataset.slug;
              if (slug === current) {
                if (!stage.hasAttribute('aria-busy') && !layers.some((l) => l.classList.contains('is-current') && l.dataset.slug === slug)) show(bySlug.get(slug), true);
                return;
              }
              manual();
              history.pushState(null, '', `#${slug}`);
              select(slug, true);
              bringIntoView();
            });

            // Back/Forward and typed hashes. An unknown hash keeps the current
            // product and is replaced by that product's own hash.
            const sync = () => {
              const slug = slugFromHash();
              if (bySlug.has(slug)) select(slug, true);
              else if (location.hash.length <= 1) select(items[0].slug, true);
              else if (!document.getElementById(slug)) history.replaceState(history.state, '', `#${current}`);
              document.title = titleFor(bySlug.get(current));
            };
            window.addEventListener('popstate', sync);
            window.addEventListener('hashchange', sync);

            // Keyboard: arrows move between rows (both orientations), Home/End to the ends.
            list.addEventListener('keydown', (e) => {
              const i = rows.indexOf(document.activeElement);
              if (i < 0) return;
              const keys = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: rows.length - 1 };
              if (!(e.key in keys) || e.altKey || e.ctrlKey || e.metaKey) return;
              e.preventDefault();
              const next = rows[Math.max(0, Math.min(rows.length - 1, keys[e.key]))];
              next.focus({ preventScroll: true });
              reveal(next);
              // A row outside the viewport (list not yet sticky) is brought just into view, below the fixed header.
              const r = next.getBoundingClientRect();
              const top = headerBottom();
              if (r.top < top) window.scrollBy(0, r.top - top - 16);
              else if (r.bottom > innerHeight) window.scrollBy(0, r.bottom - innerHeight + 16);
            });

            // Warm the cache for a product the reader is about to choose.
            const warm = (e) => {
              const row = e.target.closest && e.target.closest('[data-slug]');
              const p = row && bySlug.get(row.dataset.slug);
              if (p) preload(p).catch(() => {});
            };
            list.addEventListener('pointerover', warm);
            list.addEventListener('focusin', warm);
          })();
        </script>

        <div class="showroom__details">
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .showroom {
    padding-top: clamp(0.5rem, 0.25rem + 1vw, 1.25rem);
    padding-bottom: var(--section-y);
  }

  .showroom__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-m);
  }

  /* Product index -------------------------------------------------------- */

  .showroom__index { min-width: 0; }

  .showroom__count {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: var(--lh-heading);
    padding-bottom: var(--space-xs);
  }

  .showroom__list {
    display: flex;
    gap: var(--space-2xs);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--space-2xs);
    scrollbar-width: thin;
    scrollbar-color: var(--color-line-strong) transparent;
    padding-bottom: var(--space-2xs);
  }

  .showroom__item {
    flex: none;
    width: 11.5rem;
  }

  /* Phones and tablets: compact horizontal choices above the stage. */
  .showroom__row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.625rem;
    height: 100%;
    min-height: 3.75rem;
    padding: 0.625rem;
    color: var(--color-text-muted);
    transition: background-color 250ms var(--ease), color 250ms var(--ease);
  }
  .showroom__row:hover { background: rgba(23, 61, 45, 0.06); color: var(--color-text); }
  .showroom__row:focus-visible { outline: 1px solid currentColor; outline-offset: -4px; }
  .showroom__row[aria-current='true'] {
    background: var(--color-forest);
    color: var(--color-cream);
    font-weight: 400;
  }
  .showroom__row[aria-current='true'] .showroom__thumb { outline: none; }

  .showroom__num { display: none; }

  .showroom__thumb {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    background: transparent;
  }

  .showroom__label {
    font-size: 0.8125rem;
    line-height: 1.35;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  /* Main column ----------------------------------------------------------- */

  .showroom__main {
    min-width: 0;
    container: showroom / inline-size;
  }

  .showroom__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .showroom__head {
    --title-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    grid-row: 1;
    grid-column: 1;
    min-height: calc(var(--title-size) * 2.16 + 2.75rem);
    margin-bottom: var(--space-s);
  }
  .showroom__stage { grid-row: 2; grid-column: 1; }
  .showroom__info { grid-row: 3; grid-column: 1; }
  .showroom__details { grid-row: 4; grid-column: 1; min-width: 0; }

  .showroom__category { display: inline-block; color: var(--color-forest); }
  .showroom__category::after { content: ''; display: block; width: 1.5rem; height: 1px; background: currentColor; margin-top: 0.35rem; opacity: 0.6; }
  .showroom__name {
    margin-top: var(--space-xs);
    color: var(--color-forest);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--title-size);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  .showroom__stage {
    position: relative;
    isolation: isolate;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-cream);
  }
  .showroom__background { position: absolute; inset: 0; width: 100%; height: 100%; }
  .showroom__background[hidden] { display: none; }
  .showroom__layer { position: absolute; inset: 0; opacity: 0; pointer-events: none; }
  .showroom__layer.is-current { opacity: 1; }
  .showroom__photo {
    position: absolute;
    width: var(--product-width);
    height: auto;
    max-width: none;
    left: var(--product-left);
    top: var(--product-top);
    filter: drop-shadow(0 3px 3px rgba(52, 40, 28, 0.12));
  }
  .showroom__counter {
    position: absolute;
    left: 50%;
    bottom: 2.5%;
    transform: translateX(-50%);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 1.6cqi, 0.9375rem);
    line-height: 1;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 3px rgba(32, 34, 31, 0.8);
  }

  .showroom__info {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-m);
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--color-line);
  }

  .showroom__summary {
    max-width: 40rem;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .showroom__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
  }

  .showroom__call { gap: 0.75rem; }
  .showroom__phone { color: var(--color-text-muted); letter-spacing: 0.08em; }

  .showroom__details { margin-top: var(--space-l); }

  /* On smaller stages the title stays above the image, leaving the full
     display surface available and long Vietnamese names readable. */
  @container showroom (min-width: 560px) {
    .showroom__stage { grid-row: 1; }
    .showroom__head {
      position: relative;
      z-index: 2;
      align-self: start;
      width: 30cqi;
      min-height: 0;
      margin: 0;
      padding-top: 4cqi;
      margin-left: 4.5cqi;
      text-shadow: 0 0 12px rgba(255, 251, 243, 0.6);
    }
    .showroom__eyebrow { font-size: clamp(0.625rem, 1.3cqi, 0.75rem); }
    .showroom__name { font-size: clamp(1.5rem, 4.4cqi, 2.75rem); }
  }
  @container showroom (min-width: 900px) {
    .showroom__info {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-xl);
    }
  }

  /* Desktop: list on the left, sticky with its own scroll. */
  @media (min-width: 1024px) {
    .showroom__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      column-gap: var(--col-gap);
      align-items: start;
    }

