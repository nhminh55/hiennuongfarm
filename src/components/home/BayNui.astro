---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';
import { getLocale } from '../../i18n';

const t = {
  vi: {
    alt: 'Ô ruộng lúa xanh nhìn thẳng từ trên cao, những cây thốt nốt mọc dọc bờ ruộng',
    eyebrow: 'Từ vùng Bảy Núi',
    title: ['Một vùng đất.', 'Một hệ sinh thái.', 'Một cách làm nông nghiệp.'],
    lead: 'Bảy Núi không chỉ là nơi chúng tôi bắt đầu, mà còn là nguồn cảm hứng để Hiền Nương kiến tạo những giá trị bền vững cho cộng đồng và thế hệ mai sau.',
    body: 'Bảy Núi — còn gọi là Thất Sơn — là vùng đồi núi phía tây An Giang, một trong số ít nơi núi non xuất hiện giữa đồng bằng sông Cửu Long.',
  },
  en: {
    alt: 'Green rice paddies seen straight down from above, with palmyra palms along the field banks',
    eyebrow: 'From the Bảy Núi Region',
    title: ['One land.', 'One ecosystem.', 'One way of farming.'],
    lead: 'Bảy Núi is not only where we began; it is also what inspires Hiền Nương to create lasting value for the community and for generations to come.',
    body: 'Bảy Núi — also known as Thất Sơn, the Seven Mountains — is the hill country of western An Giang, one of the few places where mountains rise from the Mekong Delta.',
  },
  zh: {
    alt: '从正上方俯瞰的绿色稻田，田埂上长着糖棕树',
    eyebrow: '来自七山地区',
    title: ['一方土地。', '一个生态系统。', '一种农业方式。'],
    lead: '七山不仅是我们起步的地方，也激励着 Hiền Nương 为社区和子孙后代创造可持续的价值。',
    body: '七山（越南语 Bảy Núi，又称 Thất Sơn）是安江省西部的丘陵山区，是湄公河三角洲少有的有山峦分布的地方之一。',
  },
}[getLocale(Astro.url)];
---
<section class="baynui" id="bay-nui" aria-labelledby="baynui-title">
  <!-- Video frame 00:00.5 (opening aerial, no subtitle). -->
  <Photo
    class="baynui__media"
    src="/images/farm/bay-nui-canh-dong.webp"
    width={1672}
    height={941}
    alt={t.alt}
  />
  <div class="baynui__scrim" aria-hidden="true"></div>

  <div class="container grid baynui__inner">
    <div class="baynui__heading" data-reveal>
      <Eyebrow num="04" class="baynui__eyebrow">{t.eyebrow}</Eyebrow>
      <h2 class="h2 baynui__title" id="baynui-title">
        {t.title.map((line) => <span>{line}</span>)}
      </h2>
    </div>

    <div class="baynui__text" data-reveal style="--reveal-delay: 120ms">
      <p class="lead baynui__lead">{t.lead}</p>
      <p class="body baynui__body">{t.body}</p>
    </div>
  </div>
</section>

<style>
  /* A panoramic break in the page: the land itself, with the words set
     into it. */
  .baynui {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 34rem;
    color: var(--color-cream);
    background: var(--color-deep-green);
    isolation: isolate;
  }

  .baynui :global(.baynui__media) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .baynui__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(16, 43, 33, 0.86) 0%, rgba(16, 43, 33, 0.55) 50%, rgba(16, 43, 33, 0.1) 100%);
  }

  .baynui__inner {
    row-gap: var(--space-l);
    padding-block: 12rem var(--space-xl);
  }

  .baynui__heading,
  .baynui__text { grid-column: 1 / -1; }

  .baynui :global(.baynui__eyebrow) { color: var(--color-cream); }

  .baynui__title { margin-top: var(--space-m); }
  .baynui__title span { display: block; }

  .baynui__lead { max-width: 30rem; }

  .baynui__body {
    max-width: 30rem;
    margin-top: var(--space-s);
    color: var(--color-text-inverse-muted);
  }

  /* Wide screens: a short, wide band — heading low on the left, the
     place described on the right. Capped by screen height so it reads as a
     panoramic break, never a second hero. */
  @media (min-width: 768px) {
    .baynui { min-height: clamp(22rem, min(4rem + 26vw, 62svh), 30rem); }

    .baynui__scrim {
      background:
        linear-gradient(to right, rgba(16, 43, 33, 0.66) 0%, rgba(16, 43, 33, 0.25) 50%, rgba(16, 43, 33, 0.6) 100%),
        linear-gradient(to top, rgba(16, 43, 33, 0.55) 0%, rgba(16, 43, 33, 0) 60%);
    }

    .baynui__inner { align-items: end; padding-block: var(--space-xl); }
    .baynui__heading { grid-column: 1 / span 7; }
    .baynui__text { grid-column: 8 / -1; }
  }

  @media (min-width: 1024px) {
    .baynui__text { grid-column: 9 / -1; }
  }
</style>
