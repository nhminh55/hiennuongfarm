---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';
import Arrow from '../Arrow.astro';
import { getLocale, pageHref } from '../../i18n';

const lang = getLocale(Astro.url);
const t = {
  vi: {
    alt: 'Ô ruộng lúa xanh nhìn thẳng từ trên cao, những cây thốt nốt mọc dọc bờ ruộng',
    eyebrow: 'Bảy Núi · An Giang',
    title: 'Từ vùng đất Bảy Núi.',
    body: 'Giữa vùng Bảy Núi, Hiền Nương nuôi dưỡng câu chuyện về con người, nông sản và cách làm nông nghiệp gắn bó với vùng đất.',
    more: 'Câu chuyện Hiền Nương',
  },
  en: {
    alt: 'Green rice paddies seen straight down from above, with palmyra palms along the field banks',
    eyebrow: 'Bảy Núi · An Giang',
    title: 'From the land of Bảy Núi.',
    body: 'In the Bảy Núi region, Hiền Nương nurtures a story of people, of farm produce, and of a way of farming bound to the land.',
    more: 'The Hiền Nương story',
  },
  zh: {
    alt: '从正上方俯瞰的绿色稻田，田埂上长着糖棕树',
    eyebrow: '七山 · 安江',
    title: '来自七山这片土地。',
    body: '在七山地区，Hiền Nương 讲述着关于人、农产品，以及与这片土地相依的农业方式的故事。',
    more: 'Hiền Nương 的故事',
  },
}[lang];

// The story's Bảy Núi chapter. The page is Vietnamese only; other
// languages go to the homepage About.
const storyHref = pageHref('/ve-chung-toi/#bay-nui', lang, '/#ve-hien-nuong');
---
<section class="baynui" id="bay-nui" aria-labelledby="baynui-title">
  <!-- Video frame 00:00.5 (opening aerial, no subtitle). -->
  <Photo
    class="baynui__media"
    src="/images/farm/bay-nui-canh-dong.webp"
    width={1672}
    height={941}
    alt={t.alt}
  />
  <div class="baynui__scrim" aria-hidden="true"></div>

  <div class="container baynui__inner">
    <div class="baynui__text" data-reveal>
      <Eyebrow class="baynui__eyebrow">{t.eyebrow}</Eyebrow>
      <h2 class="h2 baynui__title" id="baynui-title">{t.title}</h2>
      <p class="body baynui__body">{t.body}</p>
      <a class="link-arrow baynui__link" href={storyHref}>{t.more} <Arrow direction="up-right" /></a>
    </div>
  </div>
</section>

<style>
  /* A panoramic break in the page: the land itself, open on the right, with
     one short text block set low on the left. */
  .baynui {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 32rem;
    color: var(--color-cream);
    background: var(--color-deep-green);
    isolation: isolate;
  }

  .baynui :global(.baynui__media) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Phones: the text sits over the lower part of the photo. */
  .baynui__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(16, 43, 33, 0.9) 0%, rgba(16, 43, 33, 0.66) 45%, rgba(16, 43, 33, 0) 85%);
  }

  .baynui__inner { padding-block: var(--space-xl); }

  .baynui__text { max-width: 26rem; }

  .baynui :global(.baynui__eyebrow) { color: var(--color-cream); }

  .baynui__title { margin-top: var(--space-s); }

  .baynui__body {
    margin-top: var(--space-s);
    color: rgba(243, 240, 231, 0.88);
  }

  .baynui__link {
    margin-top: var(--space-m);
    border-bottom-color: rgba(243, 240, 231, 0.45);
  }
  .baynui__link:hover { border-bottom-color: var(--color-cream); }

  /* Wide screens: a short, wide band capped by screen height so it reads
     as a panoramic break, never a second hero. The shade gathers behind the
     text and clears toward the right. */
  @media (min-width: 768px) {
    .baynui { min-height: clamp(22rem, min(4rem + 26vw, 62svh), 30rem); }

    .baynui__scrim {
      background:
        linear-gradient(to right, rgba(16, 43, 33, 0.82) 0%, rgba(16, 43, 33, 0.55) 32%, rgba(16, 43, 33, 0) 62%),
        linear-gradient(to top, rgba(16, 43, 33, 0.5) 0%, rgba(16, 43, 33, 0) 60%);
    }

    .baynui__text { max-width: 28rem; }
  }
</style>
