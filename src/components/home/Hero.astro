---
import Photo from '../Photo.astro';
import Arrow from '../Arrow.astro';
const sections = [
  { id: 've-hien-nuong', label: 'Về Hiền Nương' },
  { id: 'tuan-hoan', label: 'Nông nghiệp tuần hoàn' },
  { id: 'san-vat', label: 'Sản phẩm' },
  { id: 'bay-nui', label: 'Vùng Bảy Núi' },
  { id: 'hop-tac', label: 'Hợp tác' },
];
---
<section class="hero" aria-labelledby="hero-title">
  <!-- Frame from the Hiền Nương Farm video, 00:12.8 (clean frame, no subtitle). -->
  <Photo
    class="hero__media"
    src="/images/farm/hero-bay-nui.webp"
    width={1280}
    height={720}
    loading="eager"
    alt="Cánh đồng lúa xanh điểm hàng thốt nốt, dãy núi vùng Bảy Núi phía xa, nhìn từ trên cao"
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <!-- Two phrases, one per line where width allows; a phrase that must
           wrap breaks before its last two words ("từ đất", "bền vững"). -->
      <h1 class="display hero__title" id="hero-title">
        <span>Nông nghiệp từ&nbsp;đất</span>
        <span>đến giá trị bền&nbsp;vững</span>
      </h1>
      <p class="body hero__sub">Mô hình nông nghiệp tuần hoàn tại vùng Bảy&nbsp;Núi – An&nbsp;Giang</p>
      <a class="btn hero__cta" href="#ve-hien-nuong">
        Khám phá Hiền Nương <Arrow />
      </a>
    </div>

    <nav class="hero__navigator" aria-label="Các phần trang chủ">
      {sections.map((section, i) => (
        <a href={'#' + section.id} aria-label={String(i + 1).padStart(2, '0') + ' — ' + section.label} aria-current={i === 0 ? 'location' : undefined} data-hero-section>
          {String(i + 1).padStart(2, '0')}
        </a>
      ))}
    </nav>

    <!-- Decorative cue only; the CTA above is the link to the next section. -->
    <span class="eyebrow hero__scroll" aria-hidden="true">
      <span class="hero__scroll-line"></span>
      <span>Kéo xuống</span>
    </span>
  </div>
</section>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-hero-section]')];
  const sync = () => {
    const selected = links.find(link => link.hash === window.location.hash) ?? links[0];
    links.forEach(link => {
      if (link === selected) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  window.addEventListener('hashchange', sync);
  sync();
</script>

<style>
  .hero__navigator { display: none; }
  @media (min-width: 1000px) {
    .hero__navigator { position: absolute; right: max(var(--gutter), 1.5rem); bottom: 1rem; display: flex; gap: 1.25rem; color: var(--color-cream); }
    .hero__navigator a { display: grid; place-items: center; min-width: 2rem; min-height: 2.75rem; font-size: 0.75rem; font-variant-numeric: tabular-nums; border-bottom: 1px solid transparent; opacity: 0.7; text-shadow: 0 1px 3px rgba(8, 45, 34, 0.6); }
    .hero__navigator a:hover, .hero__navigator a[aria-current] { opacity: 1; border-bottom-color: currentColor; }
  }

  /* The landscape is the canvas: one photograph, full bleed, with the
     statement set into the land rather than beside it. The frame is an
     opening, not the whole screen — the next section stays within reach. */
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: clamp(30rem, 80svh, 42rem);
    color: var(--color-deep-green);
    background: var(--color-paper);
    isolation: isolate;
  }

  .hero :global(.hero__media) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Portrait screens: a compact frame, preserving the artwork near the top. */
  @media (max-width: 767px) {
    .hero :global(.hero__media) {
      display: none;
    }
    .hero {
      /* The solid mobile header must sit above the entire image artwork. */
      margin-top: var(--header-h);
      min-height: 0;
      height: auto;
      width: 100%;
      aspect-ratio: 15 / 14;
      background-image: url('/images/farm/hero-bay-nui-mobile.webp');
      background-size: cover;
      background-position: center 60%;
      background-repeat: no-repeat;
    }
  }
  @media (min-width: 1024px) {
    /* The low frame crops mostly foreground: anchor high so the ridge sits
       clear of the navigation with sky above it. */
    .hero :global(.hero__media) { --pos: 50% 28%; }
  }

  /* Scrim removed by request to rely on pure composition for readability. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: none;
  }

  .hero__inner {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-inline: max(var(--gutter), 1.5rem);
  }

  /* Two lines: one phrase each, in sentence case — Lora (the homepage
     display serif) at the hero type role. The longer phrase measures about
     9.3em, so it holds two lines down to 320px. */
  .hero__title {
    font-size: var(--type-hero);
    font-weight: 500;
    text-transform: none;
    letter-spacing: -0.005em;
    line-height: 1.05;
  }
  .hero__title span {
    display: block;
    text-wrap: balance;
  }

  .hero__sub {
    max-width: 36rem;
    margin-top: var(--space-s);
    color: #F2E8D2;
    text-shadow: 0 1px 3px rgba(8, 45, 34, 0.35);
    text-wrap: balance;
  }

  /* Compact, editorial CTA: smaller than the site default button. */
  .hero__cta {
    align-self: flex-start;
    gap: 0.75rem;
    min-height: 2.75rem;
    margin-top: calc(var(--space-m) + 0.5rem);
    padding: 0.6rem 0.9rem 0.6rem 1rem; /* Reduced by ~15% for mobile */
  }
  .hero__cta :global(.arrow) { width: 1rem; }

  .hero__scroll { display: none; }

  @media (max-width: 767px) {
    .hero__inner {
      position: static;
    }
    .hero__content {
      position: absolute;
      top: calc(var(--header-h) + 0.75rem);
      bottom: 2rem;
      left: max(var(--gutter), 1.5rem);
      right: max(var(--gutter), 1.5rem);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .hero__title {
      font-size: clamp(1.55rem, 6.5vw, 1.75rem);
      line-height: 1.05;
      margin-bottom: auto;
      text-shadow: 0 1px 2px rgba(248, 246, 240, 0.65);
    }
    .hero__sub {
      font-size: 0.875rem;
      line-height: 1.35;
      margin-top: 0.875rem;
    }
    .hero__cta {
      width: fit-content;
      font-size: 0.825rem;
      padding: 0.75rem 1rem;
      margin-top: 1.375rem;
      min-height: 2.75rem;
    }
  }

  /* Wider screens: the statement rises into the frame, over the ridge;
     a soft scrim on the left keeps it legible. */
  @media (min-width: 768px) {
    /* Cinematic, not full screen: the About section is in view on load. */
    .hero { min-height: clamp(22rem, 59svh, 40rem); }


    .hero__scrim { background: none; }

    .hero__inner {
      justify-content: center;
      padding-top: calc(var(--header-h) + clamp(0.75rem, 2.5svh, 2rem));
      padding-bottom: clamp(3.5rem, 9svh, 5.5rem);
    }

    .hero__title {
      font-size: calc(var(--type-hero) * 0.88);
    }
    .hero__sub { margin-top: 1.375rem; }
    .hero__cta { 
      margin-top: 2.5rem; 
      gap: 0.875rem;
      min-height: 2.875rem;
      padding: 0.7rem 1.125rem 0.7rem 1.25rem;
    }

    /* Short rule at the foot of the frame: the page continues below. */
    .hero__scroll {
      position: absolute;
      left: max(var(--gutter), 1.5rem);
      bottom: clamp(1rem, 2.5svh, 1.75rem);
      display: flex;
      align-items: flex-end;
      gap: 0.875rem;
      color: var(--color-forest);
    }

    .hero__scroll-line {
      width: 1px;
      height: clamp(1.75rem, 4svh, 2.75rem);
      background: currentColor;
      opacity: 0.7;
    }
  }

  /* Laptop-height screens: the decorative cue gives way so the frame can
     stay low; the CTA already leads to the next section. */
  @media (min-width: 768px) and (max-height: 799px) {
    .hero__scroll { display: none; }
    .hero__inner { padding-bottom: clamp(2rem, 6svh, 3rem); }
  }
</style>
