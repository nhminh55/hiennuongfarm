---
import Photo from '../Photo.astro';
import Arrow from '../Arrow.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <!-- Frame from the Hiền Nương Farm video, 00:12.8 (clean frame, no subtitle). -->
  <Photo
    class="hero__media"
    src="/images/farm/hero-bay-nui.webp"
    width={1280}
    height={720}
    loading="eager"
    alt="Cánh đồng lúa xanh điểm hàng thốt nốt, dãy núi vùng Bảy Núi phía xa, nhìn từ trên cao"
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow hero__kicker">Hiền Nương Farm</p>
      <!-- Two phrases, one per line where width allows; a phrase that must
           wrap breaks before its last two words ("từ đất", "bền vững"). -->
      <h1 class="display hero__title" id="hero-title">
        <span>Nông nghiệp từ&nbsp;đất</span>
        <span>đến giá trị bền&nbsp;vững</span>
      </h1>
      <p class="body hero__sub">Mô hình nông nghiệp tuần hoàn tại vùng Bảy&nbsp;Núi – An&nbsp;Giang</p>
      <a class="btn btn--light hero__cta" href="#ve-hien-nuong">
        Khám phá Hiền Nương <Arrow />
      </a>
    </div>

    <!-- Decorative cue only; the CTA above is the link to the next section. -->
    <span class="eyebrow hero__scroll" aria-hidden="true">
      <span class="hero__scroll-line"></span>
      <span>Kéo xuống</span>
    </span>
  </div>
</section>

<style>
  /* The landscape is the canvas: one photograph, full bleed, with the
     statement set into the land rather than beside it. The frame is an
     opening, not the whole screen — the next section stays within reach. */
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: clamp(30rem, 80svh, 42rem);
    color: var(--color-cream);
    background: var(--color-deep-green);
    isolation: isolate;
  }

  .hero :global(.hero__media) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Portrait screens: shift right so the nearer hill joins the ridge. */
  .hero :global(.hero__media) { --pos: 66% 50%; }
  @media (min-width: 1024px) {
    /* The low frame crops mostly foreground: anchor high so the ridge sits
       clear of the navigation with sky above it. */
    .hero :global(.hero__media) { --pos: 50% 28%; }
  }

  /* Legibility scrim. Phones: the text sits low, so the lower edge darkens. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(16, 43, 33, 0.5) 0%, rgba(16, 43, 33, 0) 22%),
      linear-gradient(to top, rgba(16, 43, 33, 0.74) 0%, rgba(16, 43, 33, 0.44) 55%, rgba(16, 43, 33, 0.2) 80%, rgba(16, 43, 33, 0) 95%);
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-inline: max(var(--gutter), 1.5rem);
    padding-top: calc(var(--header-h) + var(--space-xl));
    padding-bottom: clamp(2.25rem, 1.5rem + 3svh, 3.5rem);
  }

  .hero__kicker {
    margin-bottom: var(--space-s);
    color: var(--color-text-inverse-muted);
  }

  /* Two lines: one phrase each, in sentence case — Lora (the homepage
     display serif) at the hero type role. The longer phrase measures about
     9.3em, so it holds two lines down to 320px. */
  .hero__title {
    font-size: var(--type-hero);
    font-weight: 500;
    text-transform: none;
    letter-spacing: -0.005em;
    line-height: 1.05;
  }
  .hero__title span {
    display: block;
    text-wrap: balance;
  }

  .hero__sub {
    max-width: 36rem;
    margin-top: var(--space-s);
    color: var(--color-text-inverse-muted);
    text-wrap: balance;
  }

  /* Compact, editorial CTA: smaller than the site default button. */
  .hero__cta {
    gap: 0.875rem;
    min-height: 2.875rem;
    margin-top: var(--space-m);
    padding: 0.7rem 1.125rem 0.7rem 1.25rem;
  }
  .hero__cta :global(.arrow) { width: 1rem; }

  .hero__scroll { display: none; }

  /* Wider screens: the statement rises into the frame, over the ridge;
     a soft scrim on the left keeps it legible. */
  @media (min-width: 768px) {
    /* Cinematic, not full screen: the About section is in view on load. */
    .hero { min-height: clamp(22rem, 59svh, 40rem); }


    .hero__scrim {
      background:
        linear-gradient(to right, rgba(16, 43, 33, 0.62) 0%, rgba(16, 43, 33, 0.3) 38%, rgba(16, 43, 33, 0) 62%),
        linear-gradient(to bottom, rgba(16, 43, 33, 0.45) 0%, rgba(16, 43, 33, 0) 24%),
        linear-gradient(to top, rgba(16, 43, 33, 0.4) 0%, rgba(16, 43, 33, 0) 26%);
    }

    .hero__inner {
      justify-content: center;
      padding-top: calc(var(--header-h) + clamp(0.75rem, 2.5svh, 2rem));
      padding-bottom: clamp(3.5rem, 9svh, 5.5rem);
    }

    .hero__kicker { margin-bottom: clamp(0.75rem, 2svh, 1.25rem); }
    .hero__sub { margin-top: clamp(0.875rem, 2.2svh, 1.375rem); }
    .hero__cta { margin-top: clamp(1.25rem, 3.2svh, 2rem); }

    /* Short rule at the foot of the frame: the page continues below. */
    .hero__scroll {
      position: absolute;
      left: max(var(--gutter), 1.5rem);
      bottom: clamp(1rem, 2.5svh, 1.75rem);
      display: flex;
      align-items: flex-end;
      gap: 0.875rem;
      color: var(--color-text-inverse-muted);
    }

    .hero__scroll-line {
      width: 1px;
      height: clamp(1.75rem, 4svh, 2.75rem);
      background: currentColor;
      opacity: 0.7;
    }
  }

  /* Laptop-height screens: the decorative cue gives way so the frame can
     stay low; the CTA already leads to the next section. */
  @media (min-width: 768px) and (max-height: 799px) {
    .hero__scroll { display: none; }
    .hero__inner { padding-bottom: clamp(2rem, 6svh, 3rem); }
  }
</style>
