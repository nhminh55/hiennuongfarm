---
import Photo from '../Photo.astro';
import Arrow from '../Arrow.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <!-- Frame from the Hiền Nương Farm video, 00:12.8 (clean frame, no subtitle). -->
  <Photo
    class="hero__media"
    src="/images/farm/hero-bay-nui.webp"
    width={1280}
    height={720}
    loading="eager"
    alt="Cánh đồng lúa xanh điểm hàng thốt nốt, dãy núi vùng Bảy Núi phía xa, nhìn từ trên cao"
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container grid hero__inner">
    <div class="hero__content">
      <p class="hero__kicker"><span>Hiền Nương Farm</span><span aria-hidden="true">·</span><span>Bảy Núi, An Giang</span></p>
      <h1 class="display hero__title" id="hero-title">
        <span>Nông nghiệp</span>
        <span>từ đất</span>
        <span>đến giá trị</span>
        <span>bền vững</span>
      </h1>
      <p class="hero__sub">Mô hình nông nghiệp tuần hoàn tại vùng Bảy&nbsp;Núi – An&nbsp;Giang.</p>
      <a class="btn btn--light hero__cta" href="#ve-hien-nuong">
        Khám phá Hiền Nương <Arrow />
      </a>
    </div>

    <!-- The land (background) and what it yields (inset): the headline told in two photographs. -->
    <!-- Video frame 01:44.97. -->
    <Photo
      class="hero__inset"
      src="/images/farm/hero-dong-trung-thu-hai.webp"
      width={576}
      height={720}
      ratio="4 / 5"
      alt="Bàn tay đeo găng cầm một khối đông trùng hạ thảo vừa thu hái, bên cạnh khay và hộp nuôi cấy"
    />
  </div>
</section>

<style>
  .hero {
    --hero-pad-bottom: clamp(2.5rem, 2rem + 4vh, 5.5rem);
    position: relative;
    z-index: 1;
    display: flex;
    min-height: max(36rem, 100svh);
    color: var(--color-cream);
    background: var(--color-deep-green);
    isolation: isolate;
  }

  .hero :global(.hero__media) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Portrait screens: shift right so the nearer hill joins the ridge. */
  .hero :global(.hero__media) { --pos: 66% 50%; }
  @media (min-width: 1024px) {
    .hero :global(.hero__media) { --pos: 50% 50%; }
  }

  /* Legibility scrim for the headline over the photograph. On phones the
     text block reaches up to the pale ridge, so the lower scrim rises higher. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(16, 43, 33, 0.5) 0%, rgba(16, 43, 33, 0) 22%),
      linear-gradient(to top, rgba(16, 43, 33, 0.72) 0%, rgba(16, 43, 33, 0.42) 55%, rgba(16, 43, 33, 0.22) 80%, rgba(16, 43, 33, 0) 95%);
  }

  .hero__inner {
    align-items: end;
    padding-top: calc(var(--header-h) + var(--space-2xl));
    padding-bottom: var(--hero-pad-bottom);
  }

  .hero__content { grid-column: 1 / -1; }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.875rem;
    margin-bottom: var(--space-m);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-inverse-muted);
  }

  .hero__kicker span { white-space: nowrap; }

  /* Narrow phones: the two parts stack, so the separator would dangle. */
  @media (max-width: 379px) {
    .hero__kicker span[aria-hidden] { display: none; }
  }

  .hero__title span { display: block; }

  .hero__sub {
    max-width: 32rem;
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--color-text-inverse-muted);
  }

  .hero__cta { margin-top: var(--space-xl); }

  .hero :global(.hero__inset) { display: none; }

  /* Wider screens: the kicker and headline sit over the pale mountain
     ridge, so the scrim also darkens the text side. */
  @media (min-width: 768px) {
    .hero__scrim {
      background:
        linear-gradient(to right, rgba(16, 43, 33, 0.5) 0%, rgba(16, 43, 33, 0) 60%),
        linear-gradient(to bottom, rgba(16, 43, 33, 0.5) 0%, rgba(16, 43, 33, 0) 22%),
        linear-gradient(to top, rgba(16, 43, 33, 0.72) 0%, rgba(16, 43, 33, 0.18) 55%, rgba(16, 43, 33, 0) 80%);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      --hero-overlap: clamp(4rem, 6vw, 6rem);
    }

    .hero__content { grid-column: 1 / span 7; }

    /* Sits on the hero's lower edge and steps down into the next section. */
    .hero :global(.hero__inset) {
      display: block;
      grid-column: 9 / span 4;
      align-self: end;
      margin-bottom: calc(-1 * (var(--hero-pad-bottom) + var(--hero-overlap)));
    }
  }
</style>
