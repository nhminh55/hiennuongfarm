---
import Arrow from '../Arrow.astro';
import { getLocale } from '../../i18n';

const lang = getLocale(Astro.url);
const t = {
  vi: {
    alts: [
      'Cánh đồng lúa xanh điểm hàng thốt nốt, dãy núi vùng Bảy Núi phía xa, nhìn từ trên cao',
      'Hai người đội mũ rộng vành kiểm tra nấm trong khay rơm, phía sau là đống giá thể trong nhà xưởng',
      'Nhân viên đội mũ trùm, đeo khẩu trang và găng tay phân loại nấm trên các khay trong khu sơ chế',
      'Các dãy nhà mái lợp tấm pin mặt trời giữa cây xanh và hàng thốt nốt, nhìn từ trên cao',
    ],
    sections: ['Về Hiền Nương', 'Nông nghiệp tuần hoàn', 'Sản phẩm', 'Vùng Bảy Núi', 'Hợp tác'],
    // Two phrases, one per line where width allows; a phrase that must
    // wrap breaks before its last two words ("từ đất", "bền vững").
    title: ['Nông nghiệp từ đất', 'đến giá trị bền vững'],
    sub: 'Mô hình nông nghiệp tuần hoàn tại vùng Bảy Núi – An Giang',
    cta: 'Khám phá Hiền Nương',
    navLabel: 'Các phần trang chủ',
    scroll: 'Kéo xuống',
  },
  en: {
    alts: [
      'Green rice fields dotted with palmyra palms, the mountains of the Bảy Núi region in the distance, seen from above',
      'Two people in wide-brimmed hats checking mushrooms in straw trays, with piles of substrate behind them in the workshop',
      'Staff in hoods, face masks and gloves sorting mushrooms on trays in the preparation area',
      'Rows of buildings roofed with solar panels among green trees and palmyra palms, seen from above',
    ],
    sections: ['About Hiền Nương', 'Circular Agriculture', 'Products', 'Bảy Núi Region', 'Partnership'],
    title: ['Farming from the soil', 'to sustainable value'],
    sub: 'A circular agriculture model in the Bảy Núi region of An Giang',
    cta: 'Discover Hiền Nương',
    navLabel: 'Homepage sections',
    scroll: 'Scroll',
  },
  zh: {
    alts: [
      '从高处俯瞰的绿色稻田，点缀着一排排糖棕树，远处是七山地区的山峦',
      '两位戴宽檐帽的人在稻草托盘中查看菌菇，身后是车间里成堆的基质',
      '戴着头套、口罩和手套的工作人员在初加工区的托盘上分拣菌菇',
      '从高处俯瞰，一排排铺着太阳能板的屋顶掩映在绿树和糖棕树之间',
    ],
    sections: ['关于 Hiền Nương', '循环农业', '产品', '七山地区', '合作'],
    title: ['始于土地的农业', '走向可持续的价值'],
    sub: '位于安江省七山地区的循环农业模式',
    cta: '探索 Hiền Nương',
    navLabel: '首页章节',
    scroll: '向下滚动',
  },
}[lang];

/* Hero slideshow: each slide pairs a wide desktop frame (2065×762 class)
   with a portrait mobile crop (1087×1447). `pos` sets the desktop crop. */
const slides = [
  {
    // Frame from the Hiền Nương Farm video, 00:12.8 (clean frame, no subtitle).
    desktop: { src: '/images/farm/hero-bay-nui.webp', width: 2065, height: 762 },
    mobile: '/images/farm/hero-bay-nui-mobile.webp',
    pos: '50% 28%',
  },
  {
    desktop: { src: '/images/farm/hero-hn-025-desktop.webp', width: 2065, height: 762 },
    mobile: '/images/farm/hero-hn-025-mobile.webp',
    pos: '50% 50%',
  },
  {
    desktop: { src: '/images/farm/hero-hn-027-desktop.webp', width: 2065, height: 762 },
    mobile: '/images/farm/hero-hn-027-mobile.webp',
    pos: '50% 50%',
  },
  {
    desktop: { src: '/images/farm/hero-hn-031-desktop.webp', width: 1672, height: 617 },
    mobile: '/images/farm/hero-hn-031-mobile.webp',
    pos: '50% 50%',
  },
].map((slide, i) => ({ ...slide, alt: t.alts[i] }));
const sections = ['ve-hien-nuong', 'tuan-hoan', 'san-vat', 'bay-nui', 'hop-tac']
  .map((id, i) => ({ id, label: t.sections[i] }));
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" data-hero-slides>
    {slides.map((slide, i) => (
      <picture class="hero__slide" data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'} style={`--pos: ${slide.pos}`}>
        <source media="(max-width: 767px)" srcset={slide.mobile} width={1087} height={1447} />
        <img
          src={slide.desktop.src}
          width={slide.desktop.width}
          height={slide.desktop.height}
          alt={slide.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'low'}
          decoding={i === 0 ? 'sync' : 'async'}
        />
      </picture>
    ))}
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <h1 class="display hero__title" id="hero-title">
        <span>{t.title[0]}</span>
        <span>{t.title[1]}</span>
      </h1>
      <p class="body hero__sub">{t.sub}</p>
      <a class="btn hero__cta" href="#ve-hien-nuong">
        {t.cta} <Arrow />
      </a>
    </div>

    <nav class="hero__navigator" aria-label={t.navLabel}>
      {sections.map((section, i) => (
        <a href={'#' + section.id} aria-label={String(i + 1).padStart(2, '0') + ' — ' + section.label} aria-current={i === 0 ? 'location' : undefined} data-hero-section>
          {String(i + 1).padStart(2, '0')}
        </a>
      ))}
    </nav>

    <!-- Decorative cue only; the CTA above is the link to the next section. -->
    <span class="eyebrow hero__scroll" aria-hidden="true">
      <span class="hero__scroll-line"></span>
      <span>{t.scroll}</span>
    </span>
  </div>
</section>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-hero-section]')];
  const sync = () => {
    const selected = links.find(link => link.hash === window.location.hash) ?? links[0];
    links.forEach(link => {
      if (link === selected) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  window.addEventListener('hashchange', sync);
  sync();

  /* Slideshow: crossfade every 5s. Holds still for reduced motion, while
     the tab is hidden, and while the pointer or focus is in the hero. */
  const INTERVAL = 5000;
  const root = document.querySelector<HTMLElement>('[data-hero-slides]');
  const slides = root ? [...root.querySelectorAll<HTMLElement>('.hero__slide')] : [];
  const hero = root?.closest<HTMLElement>('.hero');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && slides.length > 1) {
    let current = 0;
    let timer: number | undefined;
    let held = false;

    const show = (next: number) => {
      slides[current].removeAttribute('data-active');
      slides[current].setAttribute('aria-hidden', 'true');
      current = next;
      slides[current].setAttribute('data-active', '');
      slides[current].removeAttribute('aria-hidden');
    };
    const stop = () => { window.clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (held || reduced.matches || document.hidden) return;
      timer = window.setInterval(() => show((current + 1) % slides.length), INTERVAL);
    };
    const hold = (value: boolean) => { held = value; start(); };

    hero.addEventListener('pointerenter', () => hold(true));
    hero.addEventListener('pointerleave', () => hold(false));
    hero.addEventListener('focusin', () => hold(true));
    hero.addEventListener('focusout', event => {
      if (!hero.contains(event.relatedTarget as Node | null)) hold(false);
    });
    document.addEventListener('visibilitychange', start);
    reduced.addEventListener('change', start);
    start();
  }
</script>

<style>
  .hero__navigator { display: none; }
  @media (min-width: 1000px) {
    .hero__navigator { position: absolute; right: max(var(--gutter), 1.5rem); bottom: 1rem; display: flex; gap: 1.25rem; color: var(--color-cream); }
    .hero__navigator a { display: grid; place-items: center; min-width: 2rem; min-height: 2.75rem; font-size: 0.75rem; font-variant-numeric: tabular-nums; border-bottom: 1px solid transparent; opacity: 0.7; text-shadow: 0 1px 3px rgba(8, 45, 34, 0.6); }
    .hero__navigator a:hover, .hero__navigator a[aria-current] { opacity: 1; border-bottom-color: currentColor; }
  }

  /* The landscape is the canvas: one photograph, full bleed, with the
     statement set into the land rather than beside it. The frame is an
     opening, not the whole screen — the next section stays within reach. */
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: clamp(30rem, 80svh, 42rem);
    color: var(--color-deep-green);
    background: var(--color-paper);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--color-cream);
  }

  /* Slides stack in place; the active one fades up over the last. */
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s ease-in-out;
  }
  .hero__slide[data-active] { opacity: 1; }
  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__slide { transition: none; }
  }

  /* Portrait screens: a compact frame, preserving the artwork near the top. */
  @media (max-width: 767px) {
    .hero__slide img { object-position: 50% 60%; }
    .hero {
      /* The solid mobile header must sit above the entire image artwork. */
      margin-top: var(--header-h);
      min-height: 0;
      height: auto;
      width: 100%;
      aspect-ratio: 15 / 14;
    }
  }
  @media (min-width: 1024px) {
    /* The low frame crops mostly foreground: each slide sets its own anchor
       (the landscape sits high so the ridge clears the navigation). */
    .hero__slide img { object-position: var(--pos, 50% 50%); }
  }

  /* Scrim removed by request to rely on pure composition for readability. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: none;
  }

  .hero__inner {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-inline: max(var(--gutter), 1.5rem);
  }

  /* Two lines: one phrase each, in sentence case — Lora (the homepage
     display serif) at the hero type role. The longer phrase measures about
     9.3em, so it holds two lines down to 320px. */
  .hero__title {
    font-size: var(--type-hero);
    font-weight: 500;
    text-transform: none;
    letter-spacing: -0.005em;
    line-height: 1.05;
  }
  .hero__title span {
    display: block;
    text-wrap: balance;
  }

  .hero__sub {
    max-width: 36rem;
    margin-top: var(--space-s);
    color: #F2E8D2;
    text-shadow: 0 1px 3px rgba(8, 45, 34, 0.35);
    text-wrap: balance;
  }

  /* Compact, editorial CTA: smaller than the site default button. */
  .hero__cta {
    align-self: flex-start;
    gap: 0.75rem;
    min-height: 2.75rem;
    margin-top: calc(var(--space-m) + 0.5rem);
    padding: 0.6rem 0.9rem 0.6rem 1rem; /* Reduced by ~15% for mobile */
  }
  .hero__cta :global(.arrow) { width: 1rem; }

  .hero__scroll { display: none; }

  @media (max-width: 767px) {
    .hero__inner {
      position: static;
    }
    .hero__content {
      position: absolute;
      top: calc(var(--header-h) + 0.75rem);
      bottom: 2rem;
      left: max(var(--gutter), 1.5rem);
      right: max(var(--gutter), 1.5rem);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .hero__title {
      font-size: clamp(1.55rem, 6.5vw, 1.75rem);
      line-height: 1.05;
      margin-bottom: auto;
      text-shadow: 0 1px 2px rgba(248, 246, 240, 0.65);
    }
    .hero__sub {
      font-size: 0.875rem;
      line-height: 1.35;
      margin-top: 0.875rem;
    }
    .hero__cta {
      width: fit-content;
      font-size: 0.825rem;
      padding: 0.75rem 1rem;
      margin-top: 1.375rem;
      min-height: 2.75rem;
    }
  }

  /* Wider screens: the statement rises into the frame, over the ridge;
     a soft scrim on the left keeps it legible. */
  @media (min-width: 768px) {
    /* Cinematic, not full screen: the About section is in view on load. */
    .hero { min-height: clamp(22rem, 59svh, 40rem); }


    .hero__scrim { background: none; }

    .hero__inner {
      justify-content: center;
      padding-top: calc(var(--header-h) + clamp(0.75rem, 2.5svh, 2rem));
      padding-bottom: clamp(3.5rem, 9svh, 5.5rem);
    }

    .hero__title {
      font-size: calc(var(--type-hero) * 0.88);
    }
    .hero__sub { margin-top: 1.375rem; }
    .hero__cta { 
      margin-top: 2.5rem; 
      gap: 0.875rem;
      min-height: 2.875rem;
      padding: 0.7rem 1.125rem 0.7rem 1.25rem;
    }

    /* Short rule at the foot of the frame: the page continues below. */
    .hero__scroll {
      position: absolute;
      left: max(var(--gutter), 1.5rem);
      bottom: clamp(1rem, 2.5svh, 1.75rem);
      display: flex;
      align-items: flex-end;
      gap: 0.875rem;
      color: var(--color-forest);
    }

    .hero__scroll-line {
      width: 1px;
      height: clamp(1.75rem, 4svh, 2.75rem);
      background: currentColor;
      opacity: 0.7;
    }
  }

  /* Laptop-height screens: the decorative cue gives way so the frame can
     stay low; the CTA already leads to the next section. */
  @media (min-width: 768px) and (max-height: 799px) {
    .hero__scroll { display: none; }
    .hero__inner { padding-bottom: clamp(2rem, 6svh, 3rem); }
  }
</style>
