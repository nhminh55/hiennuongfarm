---
import Photo from '../Photo.astro';
import Arrow from '../Arrow.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <Photo
    class="hero__media"
    tone="deep"
    loading="eager"
    labelPosition="top-right"
    alt="Toàn cảnh vùng Bảy Núi lúc bình minh, núi phía sau, vườn và trang trại phía trước"
    brief="Toàn cảnh Bảy Núi lúc bình minh — núi phía sau, vườn trại phía trước. Ảnh ngang, tối thiểu 2400px."
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container grid hero__inner">
    <div class="hero__content">
      <p class="hero__kicker"><span>Hiền Nương Farm</span><span aria-hidden="true">·</span><span>Bảy Núi, An Giang</span></p>
      <h1 class="display hero__title" id="hero-title">
        <span>Nông nghiệp</span>
        <span>từ đất</span>
        <span>đến giá trị</span>
        <span>bền vững</span>
      </h1>
      <p class="hero__sub">Mô hình nông nghiệp tuần hoàn tại vùng Bảy&nbsp;Núi – An&nbsp;Giang.</p>
      <a class="btn btn--light hero__cta" href="#ve-hien-nuong">
        Khám phá Hiền Nương <Arrow />
      </a>
    </div>

    <!-- The land (background) and what it yields (inset): the headline told in two photographs. -->
    <Photo
      class="hero__inset"
      ratio="4 / 5"
      tone="earth"
      loading="eager"
      alt="Đôi bàn tay người làm nông nâng nấm linh chi vừa thu hái"
      brief="Cận cảnh đôi tay nâng nấm linh chi vừa thu hái, ánh sáng tự nhiên. Ảnh dọc 4:5."
    />
  </div>
</section>

<style>
  .hero {
    --hero-pad-bottom: clamp(2.5rem, 2rem + 4vh, 5.5rem);
    position: relative;
    z-index: 1;
    display: flex;
    min-height: max(36rem, 100svh);
    color: var(--color-cream);
    background: var(--color-deep-green);
    isolation: isolate;
  }

  .hero :global(.hero__media) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Pushes the placeholder label clear of the fixed header. */
  .hero :global(.hero__media .photo__label) { top: var(--header-h); }

  /* Legibility scrim for the headline over any photograph. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(16, 43, 33, 0.5) 0%, rgba(16, 43, 33, 0) 22%),
      linear-gradient(to top, rgba(16, 43, 33, 0.72) 0%, rgba(16, 43, 33, 0.18) 55%, rgba(16, 43, 33, 0) 80%);
  }

  .hero__inner {
    align-items: end;
    padding-top: calc(var(--header-h) + var(--space-2xl));
    padding-bottom: var(--hero-pad-bottom);
  }

  .hero__content { grid-column: 1 / -1; }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.875rem;
    margin-bottom: var(--space-m);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-inverse-muted);
  }

  .hero__kicker span { white-space: nowrap; }

  /* Narrow phones: the two parts stack, so the separator would dangle. */
  @media (max-width: 379px) {
    .hero__kicker span[aria-hidden] { display: none; }
  }

  .hero__title span { display: block; }

  .hero__sub {
    max-width: 32rem;
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--color-text-inverse-muted);
  }

  .hero__cta { margin-top: var(--space-xl); }

  .hero :global(.hero__inset) { display: none; }

  @media (min-width: 1024px) {
    .hero {
      --hero-overlap: clamp(4rem, 6vw, 6rem);
    }

    .hero__content { grid-column: 1 / span 7; }

    /* Sits on the hero's lower edge and steps down into the next section. */
    .hero :global(.hero__inset) {
      display: block;
      grid-column: 9 / span 4;
      align-self: end;
      margin-bottom: calc(-1 * (var(--hero-pad-bottom) + var(--hero-overlap)));
    }
  }
</style>
