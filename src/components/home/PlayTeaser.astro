---
/**
 * "Ghé chơi một chút?": the three farm-play activities, before the footer.
 * Titles, lines and images are those of /choi-cung-nong-trai/. The
 * activities are Vietnamese only, so the block renders nothing in other
 * languages.
 */
import Eyebrow from '../Eyebrow.astro';
import Arrow from '../Arrow.astro';
import { getLocale } from '../../i18n';

const lang = getLocale(Astro.url);
const activities = [
  { slug: 'mot-vong-nong-trai', title: 'Một vòng nông trại', text: 'Từ phụ phẩm đến vườn cây. Ghép năm mảnh nhỏ để khám phá cách những giá trị được tiếp nối.', image: '/images/farm-play/farm.webp' },
  { slug: 'hom-nay-an-nam-gi', title: 'Hôm nay ăn nấm gì?', text: 'Bếp đang có gì, bạn thích vị nào? Tìm một gợi ý món nấm vừa với thời gian của mình.', image: '/images/farm-play/soup.webp' },
  { slug: 'ban-hieu-nam-toi-dau', title: 'Bạn hiểu nấm tới đâu?', text: 'Năm câu hỏi nhẹ nhàng về nấm và vòng tuần hoàn tại trang trại.', image: '/images/farm-play/quiz.webp' },
];
---
{lang === 'vi' && (
  <section class="play-teaser" id="choi-cung-nong-trai" aria-labelledby="play-teaser-title">
    <div class="container">
      <div class="play-teaser__head" data-reveal>
        <div>
          <Eyebrow>Chơi cùng nông trại</Eyebrow>
          <h2 class="play-teaser__title" id="play-teaser-title">Ghé chơi một chút?</h2>
        </div>
        <a class="link-arrow play-teaser__link" href="/choi-cung-nong-trai/">Chơi cùng nông trại <Arrow /></a>
      </div>

      <ul class="play-teaser__list" role="list">
        {activities.map((a, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <a class="play-teaser__card" href={`/choi-cung-nong-trai/${a.slug}/`}>
              <img src={a.image} alt="" width="720" height="480" loading="lazy" decoding="async" />
              <span class="play-teaser__copy">
                <span class="play-teaser__name">{a.title}</span>
                <span class="small play-teaser__text">{a.text}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  /* A small aside before the footer: thumbnails, not a full section. */
  .play-teaser {
    background: var(--color-cream);
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-xl);
  }

  .play-teaser__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
  }

  .play-teaser__title {
    margin-top: var(--space-xs);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .play-teaser__list {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .play-teaser__card {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-s);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .play-teaser__card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .play-teaser__copy { display: grid; gap: 0.2rem; }

  .play-teaser__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .play-teaser__card:hover .play-teaser__name,
  .play-teaser__card:focus-visible .play-teaser__name { text-decoration: underline; text-underline-offset: 0.2em; }

  .play-teaser__text { color: var(--color-text-muted); }

  @media (min-width: 900px) {
    .play-teaser__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-l); }
  }
</style>
