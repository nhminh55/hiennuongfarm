---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';
import Arrow from '../Arrow.astro';
import { localizedProducts } from '../../data/products';
import { showroomHref } from '../../data/showroom';
import { getLocale, localizePath } from '../../i18n';

const lang = getLocale(Astro.url);
const t = {
  vi: {
    linhChi: 'Nấm Linh Chi Tai To',
    additional: [
      'Nấm Mối Đen Sấy Thăng Hoa',
      'Snack Nấm Mối Đen',
      'Snack Nấm Bào Ngư',
      'Đông Trùng Hạ Thảo Sấy Thăng Hoa',
      'Trà Hòa Tan Linh Chi',
      'Trà Hòa Tan Linh Chi Trùng Thảo',
      'Bào Tử Nấm Linh Chi',
      'Đông Trùng Hạ Thảo Ngâm Mật Ong',
    ],
    // Owner-supplied homepage descriptions, in carousel order.
    descriptions: [
      'Nấm tươi nuôi trồng tại trang trại Hiền Nương.',
      'Dòng linh chi được nuôi trồng và thu hái tại trang trại.',
      'Đông trùng hạ thảo được nuôi cấy tại Hiền Nương Farm.',
      'Nấm tươi được nuôi trồng theo quy trình của trang trại.',
      'Nấm mối đen chế biến bằng phương pháp sấy thăng hoa.',
      'Sản phẩm chế biến từ nấm mối đen của Hiền Nương.',
      'Sản phẩm chế biến từ nấm bào ngư của Hiền Nương.',
      'Đông trùng hạ thảo chế biến bằng phương pháp sấy thăng hoa.',
      'Sản phẩm trà hòa tan được phát triển từ nấm linh chi.',
      'Trà hòa tan kết hợp linh chi và đông trùng hạ thảo.',
      'Sản phẩm từ bào tử của nấm linh chi tại Hiền Nương.',
      'Sự kết hợp giữa đông trùng hạ thảo và mật ong.',
    ],
    eyebrow: 'Sản vật từ trang trại',
    title: 'Tinh hoa từ những loại nấm quý',
    intro: 'Bốn dòng nấm chính được nuôi trồng tại trang trại — nấm mối đen, nấm linh chi, đông trùng hạ thảo và nấm bào ngư — cùng tám sản phẩm chế biến từ chúng: nấm sấy thăng hoa, snack nấm, trà hòa tan, bào tử linh chi và đông trùng hạ thảo ngâm mật ong.',
    all: 'Xem tất cả sản phẩm',
    carousel: 'băng chuyền',
    list: 'Danh sách 12 sản phẩm',
    details: 'Chi tiết',
    detailsOf: (name: string) => `Chi tiết ${name}`,
    prev: 'Sản phẩm trước',
    next: 'Sản phẩm tiếp theo',
  },
  en: {
    linhChi: 'Large-Cap Lingzhi Mushroom',
    additional: [
      'Freeze-Dried Black Termite Mushroom',
      'Black Termite Mushroom Snack',
      'Oyster Mushroom Snack',
      'Freeze-Dried Cordyceps',
      'Instant Lingzhi Tea',
      'Instant Lingzhi & Cordyceps Tea',
      'Lingzhi Spores',
      'Cordyceps in Honey',
    ],
    descriptions: [
      'Fresh mushrooms grown at the Hiền Nương farm.',
      'Lingzhi grown and harvested on the farm.',
      'Cordyceps cultivated at Hiền Nương Farm.',
      'Fresh mushrooms grown following the farm’s own process.',
      'Black termite mushroom, processed by freeze-drying.',
      'Made from Hiền Nương’s black termite mushrooms.',
      'Made from Hiền Nương’s oyster mushrooms.',
      'Cordyceps, processed by freeze-drying.',
      'An instant tea developed from lingzhi.',
      'An instant tea combining lingzhi and cordyceps.',
      'Made from the spores of Hiền Nương’s lingzhi.',
      'Cordyceps paired with honey.',
    ],
    eyebrow: 'Produce from the Farm',
    title: 'The essence of prized mushrooms',
    intro: 'Four main mushroom lines are grown on the farm — black termite mushroom, lingzhi, cordyceps and oyster mushroom — alongside eight products made from them: freeze-dried mushrooms, mushroom snacks, instant teas, lingzhi spores and cordyceps in honey.',
    all: 'View all products',
    carousel: 'carousel',
    list: 'List of 12 products',
    details: 'Details',
    detailsOf: (name: string) => `Details: ${name}`,
    prev: 'Previous product',
    next: 'Next product',
  },
  zh: {
    linhChi: '大朵灵芝',
    additional: [
      '冻干黑皮鸡枞菌',
      '黑皮鸡枞菌零食',
      '平菇零食',
      '冻干蛹虫草',
      '灵芝速溶茶',
      '灵芝虫草速溶茶',
      '灵芝孢子',
      '蜂蜜浸蛹虫草',
    ],
    descriptions: [
      '在 Hiền Nương 农场种植的新鲜菌菇。',
      '在农场种植和采收的灵芝。',
      '在 Hiền Nương Farm 培育的蛹虫草。',
      '按照农场自己的流程种植的新鲜菌菇。',
      '采用冷冻干燥工艺加工的黑皮鸡枞菌。',
      '以 Hiền Nương 的黑皮鸡枞菌加工而成。',
      '以 Hiền Nương 的平菇加工而成。',
      '采用冷冻干燥工艺加工的蛹虫草。',
      '以灵芝开发的速溶茶。',
      '灵芝与蛹虫草搭配的速溶茶。',
      '取自 Hiền Nương 灵芝孢子的产品。',
      '蛹虫草与蜂蜜的结合。',
    ],
    eyebrow: '农场物产',
    title: '珍贵菌菇的精华',
    intro: '农场主要种植四类菌菇——黑皮鸡枞菌、灵芝、蛹虫草和平菇，并以此制成八款产品：冻干菌菇、菌菇零食、速溶茶、灵芝孢子和蜂蜜浸蛹虫草。',
    all: '查看全部产品',
    carousel: '轮播',
    list: '12 款产品列表',
    details: '详情',
    detailsOf: (name: string) => `${name}详情`,
    prev: '上一个产品',
    next: '下一个产品',
  },
}[lang];

// Studio illustrations for all 12 products (design-reference/HIEN_NUONG_12_STUDIO_WEBP),
// AI-edited from reference photos. Product names are owner-supplied.
const studio = (slug: string) => ({
  src: `/images/products/studio/${slug}-1254.webp`,
  srcset: `/images/products/studio/${slug}-640.webp 640w, /images/products/studio/${slug}-1254.webp 1254w`,
  width: 1254,
  height: 1254,
});

const additional = [
  'nam-moi-den-say-thang-hoa',
  'snack-nam-moi-den',
  'snack-nam-bao-ngu',
  'dong-trung-ha-thao-say-thang-hoa',
  'tra-hoa-tan-linh-chi',
  'tra-hoa-tan-linh-chi-trung-thao',
  'bao-tu-nam-linh-chi',
  'dong-trung-ha-thao-ngam-mat-ong',
].map((slug, i) => [slug, t.additional[i]]);
const descriptions = t.descriptions;
const items = [
  ...localizedProducts(lang).map((p) => {
    const name = p.slug === 'nam-linh-chi' ? t.linhChi : p.name;
    return { ...p, name, href: showroomHref(p.slug, lang), photo: { ...studio(p.slug), alt: name } };
  }),
  ...additional.map(([slug, name]) => ({
    slug, name, note: name, detail: undefined, href: showroomHref(slug, lang),
    photo: { ...studio(slug), alt: name },
  })),
];
---
<section class="section products" id="san-vat" aria-labelledby="products-title">
  <div class="container products__grid">
    <header class="products__head" data-reveal>
      <Eyebrow num="03">{t.eyebrow}</Eyebrow>
      <h2 class="h2 products__title" id="products-title">{t.title}</h2>
      <p class="body products__intro">{t.intro}</p>
      <a class="link-arrow products__all" href={localizePath('/san-pham/', lang)}>{t.all} <Arrow /></a>
    </header>

    <div class="products__carousel" role="region" aria-roledescription={t.carousel} aria-label={t.eyebrow}>
    <ol class="catalogue" id="product-catalogue" tabindex="0" aria-label={t.list}>
      {items.map((item, i) => (
        <li class="entry">
          <Photo
            class="entry__photo"
            src={item.photo.src}
            width={item.photo.width}
            height={item.photo.height}
            srcset={item.photo.srcset}
            sizes="(min-width: 1000px) 25vw, (min-width: 640px) 50vw, 86vw"
            alt={item.photo.alt}
          />
          <span class="eyebrow entry__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="entry__name">{item.name}</h3>
          <div class="entry__description"><p class="small entry__note">{descriptions[i] ?? item.note}</p></div>
          <a class="link-arrow cta-label entry__link entry__more" href={item.href} aria-label={t.detailsOf(item.name)}>{t.details} <Arrow /></a>
        </li>
      ))}
    </ol>
    <button class="products__arrow products__arrow--prev" type="button" aria-label={t.prev} aria-controls="product-catalogue"><span aria-hidden="true"></span></button>
    <button class="products__arrow products__arrow--next" type="button" aria-label={t.next} aria-controls="product-catalogue"><span aria-hidden="true"></span></button>
    </div>
  </div>
</section>

<style>
  .products { background: var(--color-paper); }
  .products__title { margin-top: var(--space-m); max-width: 14ch; }
  .products__intro { margin-top: var(--space-m); max-width: 26rem; }
  .products__intro::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-bottom: var(--space-m);
    background: var(--color-earth);
  }
  .products__all { margin-top: var(--space-m); }
  .products__carousel {
    --card-gap: 0.75rem;
    --photo-h: 86cqw;
    container-type: inline-size;
    position: relative;
    min-width: 0;
    margin-top: var(--space-xl);
  }
  .catalogue {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    grid-template-rows: auto auto auto auto auto;
    column-gap: var(--card-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    scroll-behavior: smooth;
    padding-bottom: 4px;
  }
  .catalogue::-webkit-scrollbar { display: none; }
  .catalogue:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }
  .entry {
    position: relative;
    display: grid;
    grid-template-rows: subgrid;
    grid-row: 1 / span 5;
    min-width: 0;
    scroll-snap-align: start;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: var(--space-l);
  }
  .entry__link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .entry__link:focus-visible { outline: none; }
  .entry:has(.entry__link:focus-visible) { outline: 1px solid currentColor; outline-offset: -1px; }
  .entry :global(.entry__photo) {
    flex: none;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: var(--space-s);
  }
  .entry :global(.entry__photo img) { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease); }
  @media (prefers-reduced-motion: no-preference) {
    .entry:hover :global(.entry__photo img) { transform: scale(1.03); }
  }
  .entry__num { font-variant-numeric: tabular-nums; }
  .entry__name {
    margin-top: 0.125rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-product);
    line-height: 1.15;
    text-wrap: balance;
  }
  .entry__description {
    margin-top: 0.5rem;
  }
  .entry__description::before {
    content: "";
    display: block;
    width: 1rem;
    height: 1px;
    margin-bottom: 0.625rem;
    background: var(--color-earth);
  }
  .entry__note {
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    line-height: 1.5;
  }
  .entry__more { display: inline-flex; align-items: center; gap: 0.625rem; margin-top: 1rem; justify-self: start; align-self: start; }
  .entry__more :global(.arrow) { width: 0.875rem; }
  .products .entry__more { border-bottom: 0; }
  .products__arrow {
    position: absolute;
    top: calc(var(--photo-h) / 2);
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: transparent;
    color: var(--color-charcoal);
    font-size: 1.25rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .products__arrow--prev { left: -0.625rem; }
  .products__arrow--next { left: calc(var(--photo-h) - 2.5rem + 0.625rem); }
  .products__arrow span { width: 0.625rem; height: 0.875rem; background: currentColor; clip-path: polygon(0 50%, 100% 0, 100% 100%); }
  .products__arrow--next span { transform: rotate(180deg); }
  .products__carousel:has(.products__arrow:hover) .products__arrow,
  .products__carousel:has(.products__arrow:focus-visible) .products__arrow { opacity: 1; }
  .products__arrow:focus-visible { outline: 2px solid var(--color-forest); outline-offset: 3px; }
  @media (hover: none) { .products__arrow { opacity: 0.9; } }
  @media (min-width: 640px) {
    .products__carousel { --photo-h: calc((100cqw - var(--card-gap)) / 2); }
    .products__arrow--next { left: auto; right: -0.625rem; }
    .catalogue { grid-auto-columns: calc((100% - var(--card-gap)) / 2); }
  }
  @media (min-width: 1000px) {
    .products__head {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
      column-gap: var(--space-xl);
      align-items: end;
    }
    .products__title { max-width: 18ch; grid-column: 1; }
    .products__head > :global(.eyebrow) { grid-column: 1 / -1; }
    .products__intro { grid-column: 2; grid-row: 2; margin-top: 0; }
    .products__all { grid-column: 2; margin-top: var(--space-s); justify-self: start; }
    .products__carousel {
      --photo-h: calc((100cqw - 3 * var(--card-gap)) / 4);
      --card-gap: 0.75rem;
      margin-top: var(--space-l);
      padding-top: var(--space-l);
      border-top: 1px solid var(--color-line);
    }
    .catalogue { grid-auto-columns: calc((100% - 3 * var(--card-gap)) / 4); }
    .entry { padding: 0; border: 0; }
    .entry :global(.entry__photo) { margin-bottom: var(--space-m); }
    .products__arrow { top: calc(var(--space-l) + var(--photo-h) / 2); }
  }
  @media (min-width: 1280px) {
    .products__grid { display: grid; grid-template-columns: minmax(22.5rem, 3.5fr) minmax(0, 8.5fr); }
    .products__head { display: block; padding-right: var(--space-xl); border-right: 1px solid var(--color-line); }
    .products__title { max-width: none; }
    .products__intro { margin-top: var(--space-m); }
    .products__all { margin-top: var(--space-l); }
    .products__carousel { margin-top: 0; margin-left: var(--space-xl); padding-top: 0; border: 0; }
    .products__arrow { top: calc(var(--photo-h) / 2); }
    .entry { scroll-snap-align: none; }
    .entry:nth-child(4n + 1) { scroll-snap-align: start; }
  }
  @media (min-width: 1024px) and (max-width: 1365px) {
    .products__carousel { --card-gap: 0.75rem; }
  }
  @media (min-width: 1280px) and (max-width: 1365px) {
    .products__grid { grid-template-columns: minmax(0, 1fr) minmax(46.75rem, 2.4fr); }
    .products__head { padding-right: var(--space-l); }
    .products__carousel { margin-left: var(--space-l); }
  }
  @media (prefers-reduced-motion: reduce) {
    .catalogue { scroll-behavior: auto; }
    .products__arrow { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.products__carousel').forEach((carousel) => {
    const list = carousel.querySelector<HTMLOListElement>('.catalogue')!;
    const entries = Array.from(list.querySelectorAll<HTMLElement>('.entry'));
    const desktop = window.matchMedia('(min-width: 1280px)');
    const move = (direction: number) => {
      const step = desktop.matches ? 4 : window.matchMedia('(min-width: 1000px)').matches ? 4 : window.matchMedia('(min-width: 640px)').matches ? 2 : 1;
      const stride = entries[1].offsetLeft - entries[0].offsetLeft;
      const current = Math.round(list.scrollLeft / stride);
      const last = entries.length - step;
      const target = direction > 0 ? (current >= last ? 0 : Math.min(last, current + step)) : (current <= 0 ? last : Math.max(0, current - step));
      list.scrollTo({ left: target * stride });
    };
    carousel.querySelector('.products__arrow--prev')!.addEventListener('click', () => move(-1));
    carousel.querySelector('.products__arrow--next')!.addEventListener('click', () => move(1));
    list.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        move(event.key === 'ArrowRight' ? 1 : -1);
      }
    });
    // Resize back onto a complete four-product slide when entering desktop.
    const align = () => {
      const stride = entries[1].offsetLeft - entries[0].offsetLeft;
      const index = Math.round(list.scrollLeft / stride);
      list.scrollTo({ left: (desktop.matches ? Math.floor(index / 4) * 4 : index) * stride, behavior: 'instant' });
    };
    new ResizeObserver(align).observe(list);
  });
</script>
