---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';
import Arrow from '../Arrow.astro';
import { products, productHref } from '../../data/products';

// The four main mushroom lines (CONTENT_EVIDENCE_BANK.md §3), linked to their
// entries on /san-pham/. The homepage uses its own, larger photographs (from
// the photo collection, HN-xxx, or the video for Nấm Bào Ngư); each note
// describes only what its photograph shows — no product or health claims.
const photos: Record<string, { src: string; width: number; height: number; pos?: string; alt: string; note: string }> = {
  'nam-moi-den': {
    // HN-017
    src: '/images/farm/product-nam-moi-den-bich-phoi.webp',
    width: 1000,
    height: 750,
    alt: 'Nhiều cây nấm mối đen mũ nâu xám, thân trắng, mọc lên từ các bịch giá thể',
    note: 'Nấm mối đen mọc lên từ bịch giá thể, được nuôi trồng tại trang trại.',
  },
  'nam-linh-chi': {
    // HN-024, cropped to 4:5
    src: '/images/farm/product-linh-chi-luong-nuoi.webp',
    width: 720,
    height: 900,
    pos: '50% 70%',
    alt: 'Những hàng nấm linh chi mọc từ bịch phôi đặt trên luống đất, kéo dài theo lối đi trong nhà nuôi',
    note: 'Những hàng nấm linh chi mọc từ bịch phôi trên luống trong nhà nuôi.',
  },
  'dong-trung-ha-thao': {
    // HN-003, cropped to 4:5
    src: '/images/farm/product-dong-trung-ha-thao-thu-hoach.webp',
    width: 720,
    height: 900,
    pos: '50% 62%',
    alt: 'Bàn tay đeo găng cầm một khối đông trùng hạ thảo màu cam vừa thu hái, phía sau là các hộp đông trùng hạ thảo',
    note: 'Những sợi đông trùng hạ thảo được nuôi cấy và thu hái tại trang trại.',
  },
  'nam-bao-ngu': {
    src: '/images/farm/product-nam-bao-ngu.webp',
    width: 576,
    height: 720,
    pos: '50% 72%',
    alt: 'Chùm nấm bào ngư trắng xám mọc từ bịch phôi trong nhà trồng',
    note: 'Chùm nấm bào ngư mọc từ bịch phôi xếp trên kệ trong nhà trồng.',
  },
};

const items = products.map((p) => ({ ...p, href: productHref(p), photo: photos[p.slug] }));
---
<section class="section products" id="san-vat" aria-labelledby="products-title">
  <div class="container products__grid">
    <header class="products__head" data-reveal>
      <Eyebrow num="03">Sản vật từ trang trại</Eyebrow>
      <h2 class="h2 products__title" id="products-title">Tinh hoa từ những loại nấm quý</h2>
      <p class="body products__intro">
        Bốn dòng nấm chính được nuôi trồng tại trang trại: nấm mối đen, nấm linh chi,
        đông trùng hạ thảo và nấm bào ngư.
      </p>
      <a class="link-arrow products__all" href="/san-pham/">Xem tất cả sản phẩm <Arrow /></a>
    </header>

    <ol class="catalogue">
      {items.map((item, i) => (
        <li class:list={['entry', { 'entry--lead': i === 0 }]} data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <Photo
            class="entry__photo"
            src={item.photo.src}
            width={item.photo.width}
            height={item.photo.height}
            position={item.photo.pos}
            alt={item.photo.alt}
          />
          <span class="eyebrow entry__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="entry__name"><a class="entry__link" href={item.href}>{item.name}</a></h3>
          <p class="small entry__note">{item.photo.note}</p>
          <span class="cta-label entry__more" aria-hidden="true">{item.detail ? 'Xem sản phẩm' : 'Tìm hiểu thêm'} <Arrow /></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .products { background: var(--color-paper); }

  .products__title { margin-top: var(--space-m); max-width: 14ch; }
  .products__intro { margin-top: var(--space-m); max-width: 26rem; }
  .products__all { margin-top: var(--space-m); }

  /* Phones: the lead product in full, the other three as a ledger of
     thumbnail rows. */
  .catalogue {
    display: grid;
    margin-top: var(--space-xl);
    border-top: 1px solid var(--color-line);
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
    column-gap: var(--space-m);
    align-content: start;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--color-line);
  }

  /* The name is the link; its hit area stretches over the whole entry. */
  .entry__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .entry__link:focus-visible { outline: none; }
  .entry:has(.entry__link:focus-visible) { outline: 1px solid currentColor; outline-offset: 4px; }

  .entry :global(.entry__photo) {
    grid-row: 1 / span 4;
    aspect-ratio: 1;
    align-self: start;
  }
  .entry :global(.entry__photo img) { transition: transform 900ms var(--ease); }

  .entry__num { font-variant-numeric: tabular-nums; }

  .entry__name {
    margin-top: 0.125rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-product);
    line-height: 1.15;
    text-wrap: balance;
  }

  .entry__note {
    margin-top: 0.375rem;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .entry__more {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: var(--space-xs);
    justify-self: start;
  }
  .entry__more :global(.arrow) { width: 0.875rem; }
  .entry:hover .entry__more :global(.arrow) { transform: translateX(4px); }

  @media (prefers-reduced-motion: no-preference) {
    .entry:hover :global(.entry__photo img) { transform: scale(1.03); }
  }

  .entry--lead { grid-template-columns: minmax(0, 1fr); }
  .entry--lead :global(.entry__photo) {
    grid-row: auto;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-s);
  }

  /* Tablet: two by two, columns divided by a hairline. */
  @media (min-width: 640px) {
    .catalogue {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--col-gap);
      border-top: 0;
    }

    .entry,
    .entry--lead {
      display: flex;
      flex-direction: column;
      padding-block: var(--space-m) var(--space-l);
      border-bottom: 1px solid var(--color-line);
    }

    .entry :global(.entry__photo),
    .entry--lead :global(.entry__photo) {
      align-self: stretch;
      aspect-ratio: 3 / 2;
      margin-bottom: var(--space-s);
    }
  }

  /* Laptop: the four entries in one catalogue row, Nấm Mối Đen widest;
     all four photographs share one height. The introduction is a compact
     band above: headline left, description and link right. */
  @media (min-width: 1000px) {
    .products__head {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
      column-gap: var(--space-xl);
      align-items: end;
    }
    .products__title { max-width: 18ch; }
    .products__head > :global(.eyebrow) { grid-column: 1 / -1; }
    .products__title { grid-column: 1; }
    .products__intro { grid-column: 2; grid-row: 2; margin-top: 0; }
    .products__all { grid-column: 2; margin-top: var(--space-s); justify-self: start; }

    .catalogue {
      --photo-h: clamp(11rem, 3rem + 13vw, 17rem);
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      column-gap: var(--space-l);
      margin-top: var(--space-l);
      padding-top: var(--space-l);
      border-top: 1px solid var(--color-line);
    }

    .entry,
    .entry--lead {
      padding: 0;
      border: 0;
    }

    .entry :global(.entry__photo),
    .entry--lead :global(.entry__photo) {
      aspect-ratio: auto;
      height: var(--photo-h);
      margin-bottom: var(--space-m);
    }

    .entry__more { margin-top: auto; padding-top: var(--space-m); }
  }

  /* Desktop: the introduction moves beside the catalogue, the two divided
     by a single vertical rule. */
  @media (min-width: 1280px) {
    .products__grid {
      display: grid;
      grid-template-columns: minmax(22.5rem, 3.5fr) minmax(0, 8.5fr);
    }

    .products__head {
      display: block;
      padding-right: var(--space-xl);
      border-right: 1px solid var(--color-line);
    }
    .products__title { max-width: none; }
    .products__intro { margin-top: var(--space-m); }
    .products__all { margin-top: var(--space-l); }

    .catalogue {
      margin-top: 0;
      padding: 0 0 0 var(--space-xl);
      border-top: 0;
    }
  }

  /* Laptops (1024–1365): the catalogue takes priority. Each entry is held
     wide enough for its link on one line and its name in two; the
     introduction gives up width and the gaps tighten. */
  @media (min-width: 1024px) and (max-width: 1365px) {
    .catalogue { column-gap: var(--space-m); }
    .entry__more { gap: 0.5rem; }
  }

  /* 1280–1365: the label still fits the narrower introduction column. */
  @media (min-width: 1280px) and (max-width: 1365px) {
    .products__grid { grid-template-columns: minmax(0, 1fr) minmax(46.75rem, 2.4fr); }
    .products__head { padding-right: var(--space-l); }

    .catalogue {
      grid-template-columns: minmax(10.125rem, 1.25fr) repeat(3, minmax(10rem, 1fr));
      padding-left: var(--space-l);
    }
  }

</style>
