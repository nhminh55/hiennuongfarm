---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';
import Arrow from '../Arrow.astro';

// VERIFY: product names are from the design mockup. Descriptions are pending
// from Hiền Nương — no product or health claims should be added without a source.
const lead = {
  name: 'Nấm Linh Chi Tai To',
  alt: 'Những tai nấm linh chi lớn đặt trên mặt gỗ',
  brief: 'Nấm linh chi tai to đặt trên nền gỗ mộc hoặc vải thô, ánh sáng cửa sổ. Ảnh ngang 5:4.',
};

const others = [
  {
    name: 'Nấm Mối Đen',
    tone: 'deep' as const,
    alt: 'Nấm mối đen sau thu hoạch',
    brief: 'Nấm mối đen sau thu hoạch, chụp từ trên xuống. Ảnh dọc 4:5.',
  },
  {
    name: 'Đông Trùng Hạ Thảo',
    tone: 'clay' as const,
    alt: 'Đông trùng hạ thảo nuôi cấy',
    brief: 'Đông trùng hạ thảo trong bình nuôi hoặc sau sấy. Ảnh dọc 4:5.',
  },
  {
    name: 'Trà Linh Chi',
    tone: 'moss' as const,
    alt: 'Trà linh chi đóng gói bên tách trà',
    brief: 'Bao bì trà linh chi cạnh tách trà, trên bàn gỗ. Ảnh dọc 4:5.',
  },
];
---
<section class="section products" id="san-vat" aria-labelledby="products-title">
  <div class="container grid products__grid">
    <header class="products__head" data-reveal>
      <Eyebrow num="03">Sản vật từ trang trại</Eyebrow>
      <h2 class="h2 products__title" id="products-title">Tinh hoa từ những loại nấm quý</h2>
      <p class="body products__intro">
        Mỗi sản phẩm là kết tinh của thiên nhiên, kinh nghiệm và sự tận tâm của người nông dân
        Hiền Nương.
      </p>
    </header>

    <Photo
      class="products__feature-photo"
      ratio="5 / 4"
      tone="earth"
      alt={lead.alt}
      brief={lead.brief}
    />

    <div class="products__feature-text" data-reveal>
      <span class="products__num">01</span>
      <h3 class="products__feature-name">{lead.name}</h3>
      <p class="tbd">Mô tả sản phẩm đang được cập nhật.</p>
    </div>

    <ol class="products__more">
      {others.map((item, i) => (
        <li class="more" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
          <Photo class="more__photo" ratio="4 / 5" tone={item.tone} alt={item.alt} brief={item.brief} />
          <div class="more__text">
            <span class="products__num">{String(i + 2).padStart(2, '0')}</span>
            <h3 class="h3 more__name">{item.name}</h3>
            <p class="tbd">Mô tả sản phẩm đang được cập nhật.</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="products__foot" data-reveal>
      <a class="link-arrow" href="#hop-tac">Liên hệ về sản phẩm <Arrow /></a>
    </div>
  </div>
</section>

<style>
  .products { background: var(--color-paper); }

  .products__grid { row-gap: var(--space-xl); }

  .products__head,
  .products__feature-text,
  .products__more,
  .products__foot,
  .products__grid > :global(.products__feature-photo) { grid-column: 1 / -1; }

  .products__title { margin-top: var(--space-l); max-width: 14ch; }
  .products__intro { margin-top: var(--space-m); max-width: 28rem; }

  .products__num {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-earth);
    font-variant-numeric: tabular-nums;
  }

  .products__feature-text { margin-top: calc(-1 * var(--space-m)); }

  .products__feature-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .products__feature-text .tbd,
  .more__text .tbd { margin-top: 0.5rem; }

  /* Secondary products — phones: compact list with thumbnails. */
  .products__more {
    margin-top: var(--space-m);
    border-top: 1px solid var(--color-line);
  }

  .more {
    display: grid;
    grid-template-columns: minmax(0, 6rem) minmax(0, 1fr);
    gap: var(--space-m);
    align-items: center;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--color-line);
  }

  .products__foot { padding-top: var(--space-s); }

  @media (min-width: 480px) {
    .more { grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr); }
  }

  /* Tablet and up: secondary products become a row of photographs. */
  @media (min-width: 768px) {
    .products__head { grid-column: 1 / span 8; }

    .products__more {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--col-gap);
      margin-top: var(--space-xl);
      border-top: 0;
    }

    .more {
      display: block;
      padding: 0;
      border: 0;
    }

    .more__text { margin-top: var(--space-m); }
  }

  /* Desktop: a spread. Large feature image on the right; title, intro and
     the feature's name share the left column. Secondary products below,
     smaller and staggered on the same column lines. */
  @media (min-width: 1024px) {
    .products__grid { row-gap: 0; }

    .products__head { grid-column: 1 / span 5; grid-row: 1; }

    .products__grid > :global(.products__feature-photo) {
      grid-column: 6 / span 7;
      grid-row: 1 / span 2;
    }

    .products__feature-text {
      grid-column: 1 / span 5;
      grid-row: 2;
      align-self: end;
      margin-top: var(--space-xl);
      padding-top: var(--space-l);
      border-top: 1px solid var(--color-line);
    }

    .products__more {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      margin-top: var(--space-3xl);
    }

    .more:nth-child(1) { grid-column: 1 / span 3; }
    .more:nth-child(2) { grid-column: 6 / span 3; margin-top: var(--space-3xl); }
    .more:nth-child(3) { grid-column: 10 / span 3; margin-top: var(--space-xl); }

    .products__foot {
      grid-column: 1 / span 4;
      margin-top: calc(-1 * var(--space-2xl));
      align-self: end;
    }
  }
</style>
