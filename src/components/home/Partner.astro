---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';
import Arrow from '../Arrow.astro';
import { contact } from '../../data/site';
import { getLocale } from '../../i18n';

const lang = getLocale(Astro.url);
const t = {
  vi: {
    subject: 'Hợp tác cùng Hiền Nương Farm',
    eyebrow: 'Hợp tác cùng Hiền Nương',
    title: 'Cùng tạo nên những giá trị bền vững từ nông nghiệp.',
    body: 'Chúng tôi chào đón những kết nối trong sản xuất, phân phối và chia sẻ kiến thức về nông nghiệp bền vững. Cùng Hiền Nương đưa sản phẩm từ trang trại đến gần hơn với người tiêu dùng, nâng tầm giá trị nông sản Việt. Mỗi sự đồng hành là cơ hội để cùng học hỏi và phát triển lâu dài.',
    cta: 'Khám phá hợp tác',
    alt: 'Lễ ký kết hợp tác truyền thông giữa Trang trại Hiền Nương và sinh viên FPT Cần Thơ; chị Châu Thị Nương mặc áo dài đỏ ngồi ký văn bản, xung quanh là các đại biểu chụp ảnh chung',
    caption: 'Ký kết hợp tác truyền thông với sinh viên FPT Cần Thơ · 26.06.2025',
  },
  en: {
    subject: 'Partnering with Hiền Nương Farm',
    eyebrow: 'Partner with Hiền Nương',
    title: 'Creating lasting value from agriculture, together.',
    body: 'We welcome connections in production, distribution and the sharing of knowledge about sustainable agriculture. Join Hiền Nương in bringing farm produce closer to consumers and raising the value of Vietnamese agricultural products. Every partnership is a chance to learn together and grow for the long term.',
    cta: 'Explore a partnership',
    alt: 'Signing ceremony for a media partnership between Hiền Nương Farm and FPT Cần Thơ students; Châu Thị Nương, in a red áo dài, sits signing the agreement among a group of delegates',
    caption: 'Media partnership signing with FPT Cần Thơ students · 26.06.2025',
  },
  zh: {
    subject: '与 Hiền Nương Farm 合作',
    eyebrow: '与 Hiền Nương 合作',
    title: '携手从农业中创造可持续的价值。',
    body: '我们欢迎在生产、分销以及可持续农业知识分享方面的合作。与 Hiền Nương 一起，让农场的产品更贴近消费者，提升越南农产品的价值。每一次同行，都是共同学习、长远发展的机会。',
    cta: '探索合作',
    alt: 'Hiền Nương 农场与 FPT 芹苴大学生媒体合作签约仪式；身穿红色奥黛的 Châu Thị Nương 坐着签署文件，周围是合影的代表们',
    caption: '与 FPT 芹苴大学生签署媒体合作协议 · 2025.06.26',
  },
}[lang];
const subject = encodeURIComponent(t.subject);
---
<section class="section partner" id="hop-tac" aria-labelledby="partner-title">
  <div class="container partner__grid">
    <div class="partner__text" data-reveal>
      <Eyebrow num="06">{t.eyebrow}</Eyebrow>
      <h2 class="h2 partner__title" id="partner-title">{t.title}</h2>
      <p class="body partner__body">{t.body}</p>
      <a class="link-arrow partner__cta" href={`mailto:${contact.email}?subject=${subject}`}>
        {t.cta} <Arrow />
      </a>
    </div>

    <!-- Original event photograph (FPT Cần Thơ signing, 26.06.2025), as supplied. -->
    <figure class="partner__fig" data-reveal style="--reveal-delay: 120ms">
      <Photo
        class="partner__photo"
        src="/images/farm/hop-tac-ky-ket-fpt-800.webp"
        sizes="(min-width: 1000px) 56vw, 100vw"
        width={800}
        height={565}
        alt={t.alt}
      />
      <figcaption class="small partner__cap">{t.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  /* Quiet close: an invitation beside one photograph of a partnership in practice. */
  .partner {
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
    padding-block: clamp(2.75rem, 1.5rem + 2.5vw, 4.25rem);
  }

  .partner__grid {
    display: grid;
    row-gap: var(--space-l);
  }

  .partner__title { margin-top: var(--space-m); max-width: 20ch; }
  .partner__body { margin-top: var(--space-m); max-width: 28rem; }
  .partner__cta { margin-top: var(--space-l); }

  .partner :global(.partner__photo) { --ratio: 800 / 565; }
  .partner__cap { margin-top: var(--space-xs); color: var(--color-text-muted); }

  @media (min-width: 1000px) {
    .partner__grid {
      grid-template-columns: 5fr 7fr;
      column-gap: var(--space-xl);
      align-items: center;
    }

    /* Photo is about 10% shorter than the Dấu ấn photo cluster above (~423px). */
    .partner__fig { width: min(100%, 37.35rem); justify-self: end; }
  }
</style>
