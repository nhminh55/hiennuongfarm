---
import { copy, fill } from '../../data/copy';
import Photo from '../Photo.astro';
import Arrow from '../Arrow.astro';
import Eyebrow from '../Eyebrow.astro';
import { getLocale } from '../../i18n';

const lang = getLocale(Astro.url);

// Dấu ấn is a group of pages, not a page: the three cards open its sections
// directly. The pages are Vietnamese only, so every language links to the
// Vietnamese page. Titles and notes: the `groups` list in
// src/content/trang-chu/07-dau-an.md, in the same order.
const t = copy('trang-chu/07-dau-an', lang);
const groups = [
  {
    href: '/dau-an/bao-chi/',
    // Dân Việt feature, 2025; cropped clear of the outlet watermark.
    photo: {
      src: '/images/farm/dau-an-bao-chi-dan-viet-1024.webp',
      srcset: '/images/farm/dau-an-bao-chi-dan-viet-640.webp 640w, /images/farm/dau-an-bao-chi-dan-viet-1024.webp 1024w',
      width: 1024,
      height: 768,
      position: '50% 40%',
      alt: {
        vi: 'Chị Châu Thị Nương áo hồng, quàng khăn rằn, đeo găng tay chăm sóc phôi nấm trên kệ trong nhà nuôi',
        en: 'Châu Thị Nương, in pink with a khăn rằn scarf and gloves, tending mushroom bags on racks in a grow room',
        zh: 'Châu Thị Nương 身穿粉色上衣、围着格子头巾，戴着手套在菇房的层架间照料菌包',
      },
    },
  },
  {
    href: '/dau-an/giai-thuong/',
    photo: {
      src: '/images/farm/dau-an-cup-chung-nhan-2025-1024.webp',
      srcset: '/images/farm/dau-an-cup-chung-nhan-2025-640.webp 640w, /images/farm/dau-an-cup-chung-nhan-2025-1024.webp 1024w',
      width: 1024,
      height: 768,
      alt: {
        vi: 'Cúp pha lê và giấy chứng nhận ghi tên Châu Thị Nương đạt danh hiệu Nông dân Việt Nam xuất sắc 2025',
        en: 'A crystal trophy and a certificate naming Châu Thị Nương an Outstanding Vietnamese Farmer 2025',
        zh: '水晶奖杯与证书，证书写明 Châu Thị Nương 获得 2025 年越南优秀农民称号',
      },
    },
  },
  {
    href: '/dau-an/su-kien/',
    photo: {
      src: '/images/farm/dau-an-chi-nuong-phat-bieu-960.webp',
      srcset: '/images/farm/dau-an-chi-nuong-phat-bieu-960.webp 960w, /images/farm/dau-an-chi-nuong-phat-bieu-1440.webp 1440w',
      width: 960,
      height: 838,
      position: '50% 30%',
      alt: {
        vi: 'Chị Châu Thị Nương mặc áo dài đỏ, quàng khăn rằn, đứng cầm tài liệu phát biểu trước micro tại một buổi lễ',
        en: 'Châu Thị Nương in a red áo dài and a checked khăn rằn scarf, standing to speak at a microphone with papers in hand at a ceremony',
        zh: 'Châu Thị Nương 身穿红色奥黛、围着格子头巾，手持文稿在仪式上对着麦克风发言',
      },
    },
  },
].map((g, i) => ({
  ...g,
  title: t.groups[i].title,
  note: t.groups[i].note,
  photo: { ...g.photo, alt: g.photo.alt[lang] },
}));
---
<section class="section marks" id="dau-an" aria-labelledby="marks-title">
  <div class="container">
    <header class="marks__head" data-reveal>
      <Eyebrow num="04">{t.eyebrow}</Eyebrow>
      <h2 class="h2 marks__title" id="marks-title">{t.title}</h2>
      <p class="body marks__intro">{t.intro}</p>
    </header>

    <ol class="marks__list">
      {groups.map((g, i) => (
        <li class="mark" data-reveal>
          <Photo
            class="mark__photo"
            src={g.photo.src}
            srcset={g.photo.srcset}
            sizes="(min-width: 1024px) 31vw, (min-width: 640px) 50vw, 100vw"
            width={g.photo.width}
            height={g.photo.height}
            position={g.photo.position}
            alt={g.photo.alt}
          />
          <span class="eyebrow mark__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mark__title">{g.title}</h3>
          <p class="small mark__note">{g.note}</p>
          <a
            class="link-arrow cta-label mark__more"
            href={g.href}
            hreflang={lang === 'vi' ? undefined : 'vi'}
            aria-label={fill(t.moreOf, { title: g.title })}
          >{t.more} <Arrow /></a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Dấu ấn: a short introduction over three editorial cards, one per page in
     the group. Each card is a single link (the "Xem chi tiết" link, stretched
     over the card), as in the Sản vật catalogue. */
  .marks { background: var(--color-cream); }

  .marks__title { margin-top: var(--space-m); max-width: 16ch; text-wrap: balance; }

  .marks__intro { margin-top: var(--space-m); max-width: 30rem; }
  .marks__intro::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-bottom: var(--space-m);
    background: var(--color-earth);
  }

  .marks__list {
    display: grid;
    row-gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .mark {
    position: relative;
    display: grid;
    align-content: start;
    min-width: 0;
  }

  .mark :global(.mark__photo) { --ratio: 4 / 3; margin-bottom: var(--space-m); }
  .mark :global(.mark__photo img) { transition: transform 900ms var(--ease); }
  @media (prefers-reduced-motion: no-preference) {
    .mark:hover :global(.mark__photo img) { transform: scale(1.03); }
  }

  .mark__num { font-variant-numeric: tabular-nums; }

  .mark__title {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-product);
    line-height: 1.2;
    text-wrap: balance;
  }

  .mark__note {
    margin-top: var(--space-xs);
    max-width: 34ch;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .mark__more { margin-top: var(--space-m); justify-self: start; align-self: end; }
  .mark__more::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .mark__more :global(.arrow) { width: 0.875rem; }
  /* The whole card answers hover as its link does. */
  .mark:hover .mark__more { border-color: currentColor; }
  .mark:hover .mark__more :global(.arrow) { transform: translateX(4px); }
  .mark__more:focus-visible { outline: none; }
  .mark:has(.mark__more:focus-visible) { outline: 1px solid currentColor; outline-offset: 6px; }

  /* Tablet: each card a row, photograph beside its text. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .marks__list { row-gap: 0; border-bottom: 1px solid var(--color-line); }
    .mark {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      /* The text sits centred beside the photograph. */
      grid-template-rows: 1fr repeat(4, auto) 1fr;
      column-gap: var(--space-l);
      padding-block: var(--space-l);
      border-top: 1px solid var(--color-line);
    }
    .mark :global(.mark__photo) { grid-column: 1; grid-row: 1 / -1; margin-bottom: 0; }
    .mark__num { grid-column: 2; grid-row: 2; }
    .mark__title { grid-column: 2; grid-row: 3; }
    .mark__note { grid-column: 2; grid-row: 4; }
    .mark__more { grid-column: 2; grid-row: 5; }
  }

  /* Wide screens: title beside the introduction, three equal columns below.
     The cards share rows, so titles, notes and links line up across them. */
  @media (min-width: 1024px) {
    .marks__head {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
      column-gap: var(--space-xl);
      align-items: end;
    }
    .marks__head > :global(.eyebrow) { grid-column: 1 / -1; }
    .marks__title { grid-column: 1; }
    .marks__intro { grid-column: 2; grid-row: 2; margin-top: 0; }
    /* The hairline under the heading does the rule's work here. */
    .marks__intro::before { display: none; }

    .marks__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(5, auto);
      row-gap: 0;
      column-gap: clamp(var(--space-m), 2.5vw, var(--space-xl));
      margin-top: var(--space-l);
      padding-top: var(--space-l);
      border-top: 1px solid var(--color-line);
    }
    .mark { grid-template-rows: subgrid; grid-row: span 5; }

    /* Cards enter one after another, as the list comes into view. */
    .mark:nth-child(2) { --reveal-delay: 100ms; }
    .mark:nth-child(3) { --reveal-delay: 200ms; }
  }
</style>
