---
import Photo from '../Photo.astro';
import Arrow from '../Arrow.astro';
import Eyebrow from '../Eyebrow.astro';
import { getLocale, localizePath } from '../../i18n';

const lang = getLocale(Astro.url);

// Verified press coverage: each article names chị Châu Thị Nương and the farm.
// Headlines and publication months are as published; other languages show
// a translated headline and say the article is in Vietnamese.
const articles = [
  {
    outlet: { vi: 'VnExpress', en: 'VnExpress', zh: 'VnExpress' },
    date: '12/2025',
    headline: {
      vi: 'Làm giàu từ nấm sạch',
      en: 'Prospering from clean mushrooms',
      zh: '靠洁净菌菇致富',
    },
    href: 'https://vnexpress.net/lam-giau-tu-nam-sach-4996984.html',
  },
  {
    outlet: { vi: 'Cổng TTĐT tỉnh An Giang', en: 'An Giang Provincial Portal', zh: '安江省电子信息门户' },
    date: '10/2025',
    headline: {
      vi: 'Nữ nông dân xuất sắc vùng Bảy Núi An Giang',
      en: 'An outstanding woman farmer of An Giang’s Bảy Núi region',
      zh: '安江省七山地区的优秀女农民',
    },
    href: 'https://angiang.gov.vn/vi/nu-nong-dan-xuat-sac-vung-bay-nui-an-giang',
  },
  {
    outlet: { vi: 'TTXVN / Báo Tin tức', en: 'VNA / Tin tức', zh: '越通社 / 新闻报' },
    date: '05/2025',
    headline: {
      vi: 'Biến giấc mơ “NetZero” từ trang trại nấm',
      en: 'Turning a “Net Zero” dream into reality on a mushroom farm',
      zh: '在菌菇农场实现“净零”梦想',
    },
    href: 'https://baotintuc.vn/bien-giac-mo-netzero-tu-trang-trai-nam-post1379079.html',
  },
  {
    outlet: { vi: 'Nhân Dân', en: 'Nhân Dân', zh: '人民报' },
    date: '06/2024',
    headline: {
      vi: 'Nấm mối nàng Nương',
      en: 'Nàng Nương’s termite mushrooms',
      zh: '“Nương 姑娘”的鸡枞菌',
    },
    href: 'https://nhandan.vn/nam-moi-nang-nuong-post816923.html',
  },
].map((a) => ({ ...a, outlet: a.outlet[lang], headline: a.headline[lang] }));

const t = {
  vi: {
    eyebrow: 'Dấu ấn',
    title: 'Những câu chuyện được kể lại.',
    body: 'Hành trình của Hiền Nương đã được nhiều cơ quan báo chí ghi nhận — qua những câu chuyện về nông nghiệp sạch, kinh tế tuần hoàn và con người Bảy Núi. Mỗi bài viết, mỗi thước phim là một dấu ấn đáng nhớ, góp phần lan tỏa khát vọng phát triển nông nghiệp bền vững trên quê hương An Giang.',
    more: 'Báo chí & truyền thông',
    altMain: 'Chị Châu Thị Nương mặc áo dài đỏ, quàng khăn rằn, đứng cầm tài liệu phát biểu trước micro tại một buổi lễ',
    altGroup: 'Ảnh chụp chung các đại biểu nông dân tại Phòng Khánh Tiết; chị Châu Thị Nương mặc áo dài đỏ, quàng khăn rằn, đứng ở phía bên phải',
    altAward: 'Cúp pha lê và giấy chứng nhận ghi tên Châu Thị Nương đạt danh hiệu Nông dân Việt Nam xuất sắc 2025',
    capGroup: 'Gặp mặt nông dân tiêu biểu',
    capAward: 'Nông dân Việt Nam xuất sắc 2025',
    articleLang: '',
    newTab: '(mở trong thẻ mới)',
  },
  en: {
    eyebrow: 'Press',
    title: 'Stories, retold.',
    body: 'Hiền Nương’s journey has been covered by a number of news outlets — through stories of clean farming, the circular economy and the people of Bảy Núi. Each article and each film is a memorable mark, helping to spread the ambition of developing sustainable agriculture in the farm’s home province of An Giang.',
    more: 'Press & media',
    altMain: 'Châu Thị Nương in a red áo dài and a checked khăn rằn scarf, standing to speak at a microphone with papers in hand at a ceremony',
    altGroup: 'Group photograph of farmer delegates in the State Hall; Châu Thị Nương, in a red áo dài and khăn rằn scarf, stands towards the right',
    altAward: 'A crystal trophy and a certificate naming Châu Thị Nương an Outstanding Vietnamese Farmer 2025',
    capGroup: 'Meeting with outstanding farmers',
    capAward: 'Outstanding Vietnamese Farmer 2025',
    articleLang: 'In Vietnamese',
    newTab: '(opens in a new tab)',
  },
  zh: {
    eyebrow: '媒体报道',
    title: '被讲述的故事。',
    body: 'Hiền Nương 的历程已获多家媒体报道——通过清洁农业、循环经济以及七山人的故事。每一篇报道、每一部影片都是一个值得铭记的印记，助力在家乡安江传播发展可持续农业的志向。',
    more: '媒体报道',
    altMain: 'Châu Thị Nương 身穿红色奥黛、围着格子头巾，手持文稿在仪式上对着麦克风发言',
    altGroup: '农民代表在国宾厅的合影；身穿红色奥黛、围着格子头巾的 Châu Thị Nương 站在右侧',
    altAward: '水晶奖杯与证书，证书写明 Châu Thị Nương 获得 2025 年越南优秀农民称号',
    capGroup: '与优秀农民代表会面',
    capAward: '2025 年越南优秀农民',
    articleLang: '越南语',
    newTab: '（在新标签页中打开）',
  },
}[lang];
---
<section class="section press" id="dau-an" aria-labelledby="press-title">
  <div class="container press__grid">
    <div class="press__intro" data-reveal>
      <Eyebrow num="05">{t.eyebrow}</Eyebrow>
      <h2 class="h2 press__title" id="press-title">{t.title}</h2>
      <span class="press__rule" aria-hidden="true"></span>
      <p class="body press__body">{t.body}</p>
      <!-- Points at this section until a /bao-chi/ page exists. -->
      <a class="link-arrow press__more" href={localizePath('/#dau-an', lang)}>{t.more} <Arrow /></a>
    </div>

    <!-- Original event photographs (Nông dân Việt Nam xuất sắc 2025), as supplied. -->
    <div class="press__photos">
      <Photo
        class="press__main"
        src="/images/farm/dau-an-chi-nuong-phat-bieu-1440.webp"
        srcset="/images/farm/dau-an-chi-nuong-phat-bieu-960.webp 960w, /images/farm/dau-an-chi-nuong-phat-bieu-1440.webp 1440w"
        sizes="(min-width: 1024px) 33vw, (min-width: 768px) 46vw, 100vw"
        width={1440}
        height={1257}
        alt={t.altMain}
      />
      <figure class="press__fig">
        <Photo
          class="press__small press__small--group"
          src="/images/farm/dau-an-gap-mat-nong-dan-1024.webp"
          srcset="/images/farm/dau-an-gap-mat-nong-dan-640.webp 640w, /images/farm/dau-an-gap-mat-nong-dan-1024.webp 1024w"
          sizes="(min-width: 1024px) 17vw, (min-width: 480px) 46vw, 100vw"
          width={1024}
          height={683}
          alt={t.altGroup}
        />
        <figcaption class="small press__cap">{t.capGroup}</figcaption>
      </figure>
      <figure class="press__fig">
        <Photo
          class="press__small press__small--award"
          src="/images/farm/dau-an-cup-chung-nhan-2025-1024.webp"
          srcset="/images/farm/dau-an-cup-chung-nhan-2025-640.webp 640w, /images/farm/dau-an-cup-chung-nhan-2025-1024.webp 1024w"
          sizes="(min-width: 1024px) 17vw, (min-width: 480px) 46vw, 100vw"
          width={1024}
          height={768}
          alt={t.altAward}
        />
        <figcaption class="small press__cap">{t.capAward}</figcaption>
      </figure>
    </div>

    <ol class="press__list" data-reveal style="--reveal-delay: 100ms">
      {articles.map((a) => (
        <li>
          <a class="press__item" href={a.href} target="_blank" rel="noopener noreferrer">
            <span class="press__meta">
              <span class="eyebrow press__outlet">{a.outlet}</span>
              <span class="small press__date">{a.date}{t.articleLang && ` · ${t.articleLang}`}</span>
            </span>
            <span class="press__headline">{a.headline}</span>
            <svg class="press__ext" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <path d="M2 10 10.5 1.5M4 1.5h6.5V8" />
            </svg>
            <span class="sr-only">{t.newTab}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Press notices: a short introduction, a small cluster of event photographs, and the
     articles set as an index — outlet and month, headline, a hairline. */
  .press { background: var(--color-cream); }

  .press__grid {
    display: grid;
    row-gap: var(--space-xl);
  }

  .press__title { margin-top: var(--space-m); max-width: 14ch; }

  .press__rule {
    display: block;
    width: 1.75rem;
    height: 1px;
    margin-block: var(--space-l) var(--space-m);
    background: var(--color-earth);
    opacity: 0.7;
  }

  .press__body { max-width: 24rem; }

  .press .press__more { margin-top: var(--space-l); white-space: nowrap; }

  /* One large photograph above two equal smaller ones. */
  .press__photos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
  }

  .press :global(.press__main) { grid-column: 1 / -1; --ratio: 8 / 7; }

  .press__fig { margin: 0; display: grid; gap: var(--space-2xs); align-content: start; }

  .press :global(.press__small) { --ratio: 4 / 3; }
  /* Keep chị Nương (red áo dài, right of centre) in frame. */
  .press :global(.press__small--group) { --pos: 72% 50%; }
  /* Trophy and certificate are shown whole, never cropped. */
  .press :global(.press__small--award img) { object-fit: contain; }

  .press__cap { color: var(--color-text-muted); }

  @media (min-width: 480px) {
    .press__photos { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .press__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .press__list li { border-bottom: 1px solid var(--color-line); }

  .press__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-m);
    row-gap: var(--space-2xs);
    padding-block: var(--space-m);
  }

  .press__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-s);
    row-gap: var(--space-3xs);
  }

  .press__date {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .press__headline {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: var(--type-lead);
    line-height: 1.4;
    text-wrap: pretty;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 400ms var(--ease);
  }

  .press__ext {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
    width: 0.875rem;
    height: 0.875rem;
    margin-top: 0.25rem;
    color: var(--color-earth);
    transition: transform 300ms var(--ease);
  }

  .press__item:hover .press__headline,
  .press__item:focus-visible .press__headline { background-size: 100% 1px; }
  .press__item:hover .press__ext { transform: translate(2px, -2px); }

  /* Tablet: introduction beside the photograph, the index below. */
  @media (min-width: 768px) {
    .press__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-xl);
      align-items: center;
    }
    .press__list { grid-column: 1 / -1; }
  }

  /* Wide screens: three columns — introduction, photograph, index. */
  @media (min-width: 1024px) {
    .press__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr) minmax(0, 1.5fr);
      column-gap: clamp(var(--space-l), 3vw, var(--space-2xl));
    }

    .press__intro { align-self: center; }

    /* The photographs span exactly the height of the index beside them:
       the main one takes whatever the two smaller ones leave. */
    .press__photos {
      align-self: stretch;
      grid-template-rows: minmax(0, 1fr) auto;
    }
    .press :global(.press__main) {
      --ratio: auto;
      --pos: 50% 35%;
      min-height: 14rem;
    }
    .press :global(.press__main img) { position: absolute; inset: 0; }

    .press__list { grid-column: auto; }
  }

  /* Wider still: the index sets outlet and month beside each headline. */
  @media (min-width: 1400px) {
    .press__item {
      grid-template-columns: 9.5rem minmax(0, 1fr) auto;
      column-gap: var(--space-l);
      padding-block: var(--space-l);
    }

    .press__meta {
      flex-direction: column;
      align-items: flex-start;
      row-gap: var(--space-2xs);
    }

    .press__headline { grid-column: 2; }
    .press__ext { grid-column: 3; grid-row: 1; }
  }
</style>
