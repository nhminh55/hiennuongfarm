---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';
import Arrow from '../Arrow.astro';
import { getLocale, pageHref } from '../../i18n';

const lang = getLocale(Astro.url);
const t = {
  vi: {
    steps: ['Phụ phẩm\nnông nghiệp', 'Chuẩn bị\ngiá thể', 'Cấy meo\n& ủ phôi', 'Nuôi trồng\n& thu hoạch', 'Giá thể nuôi\ntrùn quế', 'Phân trùn\nbón cây'],
    eyebrow: 'Nông nghiệp tuần hoàn',
    title: 'Hướng đi bền vững cùng thiên nhiên',
    body: 'Chúng tôi tận dụng rơm, trấu, cám và mùn cưa địa phương làm giá thể trồng nấm, rồi tái sử dụng giá thể sau thu hoạch trong sản xuất nông nghiệp, giảm lãng phí và tiếp nối vòng tuần hoàn từ đất — trở về với đất.',
    more: 'Tìm hiểu thêm',
    motto: ['Từ đất,', 'trở về đất.'],
    stepsLabel: 'Chu trình nông nghiệp tuần hoàn, sáu giai đoạn nối tiếp thành một vòng',
    alt: 'Chùm nấm bào ngư mọc từ bịch phôi trên kệ sắt trong nhà nuôi nấm. Dòng chữ trên ảnh: “Nông nghiệp tuần hoàn là cách chúng tôi trả lại sự cân bằng cho đất.”',
  },
  en: {
    steps: ['Agricultural\nby-products', 'Preparing\nthe substrate', 'Spawning\n& incubation', 'Growing\n& harvesting', 'Substrate for\nred worms', 'Worm castings\nfor crops'],
    eyebrow: 'Circular Agriculture',
    title: 'A sustainable path, working with nature',
    body: 'We use local rice straw, husks, bran and sawdust as a substrate for growing mushrooms, then reuse the substrate after harvest in farming — reducing waste and continuing the cycle from the soil, back to the soil.',
    more: 'Learn more',
    motto: ['From the soil,', 'back to the soil.'],
    stepsLabel: 'The circular agriculture cycle: six stages that join into a loop',
    alt: 'A cluster of oyster mushrooms growing from a spawn bag on a steel shelf in a mushroom house. Text on the photo, in Vietnamese: “Circular agriculture is how we give balance back to the soil.”',
  },
  zh: {
    steps: ['农业\n副产品', '制备\n基质', '接种\n与养菌', '种植\n与采收', '养殖红蚯蚓\n基质', '蚯蚓粪\n施肥'],
    eyebrow: '循环农业',
    title: '与自然同行的可持续之路',
    body: '我们利用当地的稻草、稻壳、米糠和木屑作为种菇基质，采收后再将基质用于农业生产，减少浪费，让循环延续——源于土地，回归土地。',
    more: '了解更多',
    motto: ['源于土地，', '回归土地。'],
    stepsLabel: '循环农业流程：六个阶段首尾相连，形成一个循环',
    alt: '一簇平菇从菇房铁架上的菌袋中长出。照片上的越南语文字：“循环农业，是我们让土地重获平衡的方式。”',
  },
}[lang];

// The six steps of the circular page (nong-nghiep-tuan-hoan), with its
// round pictures. Inputs: rơm (CONTENT_EVIDENCE_BANK.md §2); trấu, cám,
// mùn cưa (Hiền Nương video, 00:41).
// x / y place each icon's centre in the diagram: a hexagon from 30°, so
// steps 1–3 sit on the right with their names outside, 4–6 on the left.
const steps = [
  { icon: '01-phu-pham', x: 67.95, y: 18.91 },
  { icon: '02-gia-the', x: 85.9, y: 50 },
  { icon: '03-cay-meo-u-phoi', x: 67.95, y: 81.09 },
  { icon: '04-nuoi-trong-thu-hoach', x: 32.05, y: 81.09 },
  { icon: '05-gia-the-nuoi-trun', x: 14.1, y: 50 },
  { icon: '06-phan-trun-bon-cay', x: 32.05, y: 18.91 },
].map((step, i) => ({ ...step, name: t.steps[i] }));

// Clockwise arrows between the stages, drawn in a square around
// the diagram's centre: [from°, to°, radius].
const W = 585;
const H = 585;
const C = { x: W / 2, y: H / 2 };
const at = (deg: number, r: number) => {
  const rad = (deg * Math.PI) / 180;
  return `${(C.x + r * Math.sin(rad)).toFixed(1)} ${(C.y - r * Math.cos(rad)).toFixed(1)}`;
};
const arrows = [
  [50, 70, 210],
  [110, 130, 210],
  [170, 190, 210],
  [230, 250, 210],
  [290, 310, 210],
  [350, 370, 210],
].map(([a, b, r]) => `M${at(a, r)} A${r} ${r} 0 0 1 ${at(b, r)}`);
---
<section class="section cycle" id="tuan-hoan" aria-labelledby="cycle-title">
  <div class="container">
    <Eyebrow num="02" class="cycle__eyebrow">{t.eyebrow}</Eyebrow>

    <div class="grid cycle__grid">
      <!-- The eyebrow already names the section; the heading carries its line. -->
      <div class="cycle__head" data-reveal>
        <h2 class="h2 cycle__title" id="cycle-title">{t.title}</h2>
      </div>

      <div class="cycle__copy" data-reveal style="--reveal-delay: 80ms">
        <p class="body">{t.body}</p>
        <!-- The circular page is Vietnamese only; other languages stay on this section. -->
        <a class="link-arrow cycle__cta" href={pageHref('/nong-nghiep-tuan-hoan/', lang, '/#tuan-hoan')}>{t.more} <Arrow /></a>
      </div>

      <div class="cycle__diagram" data-reveal style="--reveal-delay: 120ms">
        <div class="ring">
          <svg class="ring__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
            <defs>
              <marker id="cycle-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="13" markerHeight="13" markerUnits="userSpaceOnUse" orient="auto">
                <path d="M1 1 L8 5 L1 9" />
              </marker>
            </defs>
            {arrows.map((d) => <path d={d} marker-end="url(#cycle-arrow)" />)}
            <g class="ring__tracker">
              <circle class="ring__tracker-dot" cx={W / 2} cy={H / 2 - 210} r="5" />
            </g>
          </svg>

          <p class="ring__motto" aria-hidden="true">{t.motto[0]}<br />{t.motto[1]}</p>

          <ol class="ring__steps" aria-label={t.stepsLabel}>
            {steps.map((step, i) => (
              <li class="ring__step" style={`--x: ${step.x}%; --y: ${step.y}%`}>
                <span class="ring__num">{String(i + 1).padStart(2, '0')}</span>
                <img
                  class="ring__icon"
                  src={`/images/circular/steps/${step.icon}-cartoon.webp`}
                  alt=""
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
                <span class="ring__name">{step.name}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <figure class="cycle__figure">
        <!-- Editorial plate with its line set into the photograph; the caption
             sits bottom left, so crops only ever trim the right edge.
             VERIFY: provenance of this photograph before launch. -->
        <Photo
          class="cycle__photo"
          src="/images/farm/circular-nam-bao-ngu-doc.webp"
          width={1122}
          height={1402}
          ratio="4 / 5"
          position="0% 50%"
          alt={t.alt}
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .cycle {
    --cycle-bg: var(--color-cream);
    --cycle-line: rgba(32, 34, 31, 0.55);
    background: var(--cycle-bg);
    border-block: 1px solid var(--color-line);
    overflow: hidden;
  }

  .cycle :global(.cycle__eyebrow) { margin-bottom: var(--space-m); }

  .cycle__grid { row-gap: var(--space-xl); }

  .cycle__head,
  .cycle__copy,
  .cycle__diagram,
  .cycle__figure { grid-column: 1 / -1; }

  .cycle__title { max-width: 20ch; text-wrap: balance; }

  .cycle__copy { max-width: 34rem; margin-top: calc(var(--space-m) - var(--space-xl)); }
  .cycle .cycle__cta { margin-top: var(--space-m); text-transform: uppercase; }
  .cycle__copy::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-bottom: var(--space-m);
    background: var(--color-earth);
  }
  .cycle__copy .cycle__more {
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line);
  }

  .cycle__figure { max-width: 26rem; }

  /* --- Diagram ---------------------------------------------------------
     The six stages are set around a loop of arrows at every width. All
     sizes follow the ring's own width (it is the container), so the
     composition scales as one. */

  .ring {
    --icon: 21cqi;
    --num-h: 4.4cqi;
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 36.5rem;
    margin-inline: auto;
    aspect-ratio: 1;
  }

  .ring__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--cycle-line);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ring__tracker {
    transform-origin: 50% 50%;
    animation: cycle-tracker 14s linear infinite;
  }
  .ring__tracker-dot {
    fill: var(--color-forest);
    stroke: var(--cycle-bg);
    stroke-width: 2;
  }
  @keyframes cycle-tracker {
    from { transform: rotate(50deg); }
    to { transform: rotate(410deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring__tracker { animation: none; transform: rotate(50deg); }
  }

  .ring__motto {
    position: absolute;
    top: 49.6%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-style: italic;
    font-size: max(1.25rem, 6cqi);
    line-height: 1.25;
    text-align: center;
    white-space: nowrap;
    color: var(--color-forest);
  }

  /* Each stage hangs from its icon's centre, with its name outside the loop. */
  .ring__step {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, calc(-1 * (var(--num-h) + var(--icon) / 2)));
    display: flex;
    flex-direction: column;
    align-items: center;
    width: max-content;
    text-align: center;
  }

  .ring__num {
    height: var(--num-h);
    font-size: max(0.6875rem, 2.9cqi);
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--color-earth);
    font-variant-numeric: tabular-nums;
  }

  .ring__icon {
    width: var(--icon);
    height: var(--icon);
    border-radius: 50%;
  }

  .ring__name {
    position: absolute;
    left: calc(100% + 0.5rem);
    top: calc(var(--num-h) + var(--icon) / 2);
    transform: translateY(-50%);
    width: 5rem;
    margin-top: 0;
    font-family: var(--font-display);
    font-size: max(0.875rem, 3.5cqi);
    line-height: 1.3;
    white-space: normal;
    text-align: left;
    text-wrap: balance;
  }

  .ring__step:nth-child(n + 4) .ring__name {
    left: auto;
    right: calc(100% + 0.5rem);
    text-align: right;
  }

  .ring__note {
    white-space: pre-line;
    margin-top: 0.4cqi;
    font-size: max(0.75rem, 2.5cqi);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  /* Phones: the ring reaches into the side margins (its widest labels
     hang a little to the right), and its labels follow its width alone,
     so nothing collides on a narrow screen. */
  @media (max-width: 639px) {
    .ring {
      width: calc(100% + 2 * var(--gutter));
      max-width: none;
      margin-inline: calc(-1 * var(--gutter));
    }
    .ring__motto { font-size: 6cqi; }
    .ring__num { font-size: 2.9cqi; }
    .ring__name { font-size: 3.6cqi; }
    .ring__note { font-size: 3.15cqi; }
    .ring__step:nth-child(2) .ring__name {
      /* Twice the distance from this stage's centre (84.44%) to the edge. */
      max-width: 31.12cqi;
      white-space: normal;
      text-wrap: balance;
    }
  }

  /* Tablet: the introduction in two columns, then the
     photograph beside the diagram. */
  @media (min-width: 768px) {
    .cycle :global(.cycle__eyebrow) { margin-bottom: var(--space-l); }
    .cycle__grid { row-gap: var(--space-2xl); }

    .cycle__head { grid-column: 1 / span 5; grid-row: 1; }
    .cycle__copy { grid-column: 7 / -1; grid-row: 1; margin-top: 0; }

    .cycle__figure { grid-column: 1 / span 5; grid-row: 2; max-width: none; align-self: center; }
    .cycle__diagram { grid-column: 6 / -1; grid-row: 2; align-self: center; }

    .ring { max-width: 33rem; margin-inline: auto 0; }
  }

  /* Desktop: photograph, diagram and text side by side, as one spread. */
  @media (min-width: 1024px) {
    .cycle__grid {
      /* Outer 1fr rows centre the text column when it is shorter than
         the photograph and diagram; they collapse when it is taller. */
      grid-template-rows: 1fr auto auto 1fr;
      row-gap: 0;
      align-items: start;
    }

    /* A smaller whole portrait and a wider text column keep this spread
       at the same scale as the neighboring About and Products sections. */
    .cycle__grid { grid-template-columns: minmax(0, 2.8fr) minmax(0, 5.7fr) minmax(0, 3.5fr); }
    .cycle__figure { grid-column: 1; grid-row: 1 / -1; align-self: center; }
    .cycle__head { grid-column: 3; grid-row: 2; }
    .cycle__copy { grid-column: 3; grid-row: 3; margin-top: var(--space-l); }

    /* The diagram takes the height of the row (the photograph's) and sets
       its own width from it; it adds no height of its own. Its labels
       follow its width, so the composition scales as one. */
    .cycle__diagram {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: stretch;
      contain: size;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* 94.5%: the top number and bottom notes hang just outside the ring's
       box, so the drawing as a whole spans the photograph's height. */
    .ring {
      container-type: inline-size;
      width: auto;
      height: 94.5%;
      max-width: 100%;
    }
    .ring__motto { font-size: 6cqi; }
    .ring__num { font-size: 2.9cqi; }
    .ring__name { font-size: 3.6cqi; }
    .ring__note { font-size: 3.15cqi; }

    .cycle__title { max-width: 22ch; }
  }

  @media (min-width: 1280px) {
    .ring__num { font-size: max(11px, 2.9cqi); }
    .ring__name { font-size: max(14px, 3.6cqi); }
    .ring__note { font-size: max(11px, 3.15cqi); line-height: 1.3; }
    .ring__step:nth-child(2) .ring__name {
      max-width: 31.12cqi;
      white-space: normal;
      text-wrap: balance;
    }
  }

  /* Small laptops: tied to the photograph's height the ring would be too
     small to read here, so it takes the full width of a wider middle
     track instead (a little taller than the photograph, which centres
     against it). Same order, same geometry. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .cycle__grid { grid-template-columns: minmax(0, 3.5fr) minmax(0, 4.4fr) minmax(0, 4.1fr); }

    .cycle__diagram {
      align-self: center;
      contain: none;
      display: block;
    }
    .ring {
      width: 100%;
      height: auto;
      max-width: none;
    }

    .cycle__copy { margin-top: var(--space-m); }
    .ring__name { font-size: max(14px, 3.6cqi); }
    .ring__step:nth-child(2) .ring__name {
      max-width: 31.12cqi;
      white-space: normal;
      text-wrap: balance;
    }
    .ring__note { font-size: max(12px, 3.15cqi); }
    .ring__step:nth-child(5) .ring__name {
      max-width: var(--icon);
      white-space: normal;
      text-wrap: balance;
    }
    .cycle__copy .cycle__more { margin-top: var(--space-s); padding-top: var(--space-s); }
  }
  /* Reserve space on both sides for the names, including on phones. */
  .ring {
    width: calc(100% - 8rem);
    height: auto;
    max-width: 22rem;
    margin-inline: auto;
  }
  .ring__name {
    width: max-content;
    font-size: 0.875rem;
    white-space: pre;
    line-height: 1.35;
  }
  .ring__step:nth-child(2) .ring__name,
  .ring__step:nth-child(5) .ring__name { max-width: none; white-space: pre; }

  @media (min-width: 1280px) {
    .ring { max-width: 26rem; }
  }
</style>
