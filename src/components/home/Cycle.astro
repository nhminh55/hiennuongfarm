---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';

// By-products → substrate → mushrooms → organic fertiliser → soil:
// CONTENT_EVIDENCE_BANK.md §2 (VERIFIED). Inputs: rơm (§2); trấu, cám,
// mùn cưa (Hiền Nương video, 00:41).
// Icons are illustrations (design-reference/source), not farm photographs.
// x / y place each icon's centre in the diagram, after the section mockup.
const steps = [
  { name: 'Phụ phẩm nông nghiệp', note: 'Tận dụng phụ phẩm\nđịa phương', icon: 'phu-pham', x: 50, y: 12.33 },
  { name: 'Giá thể trồng nấm', note: 'Chế biến thành giá thể', icon: 'gia-the', x: 84.44, y: 34.89 },
  { name: 'Thu hoạch nấm', note: 'Tạo ra nấm tươi', icon: 'thu-hoach', x: 74, y: 78.35 },
  { name: 'Chế biến', note: 'Giá thể sau thu hoạch\nđược ủ thành phân hữu cơ', icon: 'u-phan', x: 26, y: 78.35 },
  { name: 'Trở về đất', note: 'Bổ sung dinh dưỡng\ncho đất', icon: 'tro-ve-dat', x: 15.56, y: 34.89 },
];

// Clockwise arrows between the stages, drawn in a 585 × 665 box around
// the diagram's centre: [from°, to°, radius].
const W = 585;
const H = 665;
const C = { x: W / 2, y: 330 };
const at = (deg: number, r: number) => {
  const rad = (deg * Math.PI) / 180;
  return `${(C.x + r * Math.sin(rad)).toFixed(1)} ${(C.y - r * Math.cos(rad)).toFixed(1)}`;
};
const arrows = [
  [22, 43, 251],
  [103, 122, 245],
  [167, 191, 228],
  [236, 251, 238],
  [317, 337, 252],
].map(([a, b, r]) => `M${at(a, r)} A${r} ${r} 0 0 1 ${at(b, r)}`);
---
<section class="section cycle" id="tuan-hoan" aria-labelledby="cycle-title">
  <div class="container">
    <Eyebrow num="02" class="cycle__eyebrow">Nông nghiệp tuần hoàn</Eyebrow>

    <div class="grid cycle__grid">
      <div class="cycle__head" data-reveal>
        <h2 class="h2 cycle__title" id="cycle-title">Nông nghiệp tuần hoàn</h2>
        <p class="lead cycle__sub">Hướng đi bền vững <br />cùng thiên nhiên</p>
      </div>

      <div class="cycle__copy" data-reveal style="--reveal-delay: 80ms">
        <p class="body">
          Chúng tôi tận dụng phụ phẩm nông nghiệp tại địa phương như rơm, trấu, cám và mùn cưa
          để làm giá thể trồng nấm. Sau thu hoạch, giá thể được tiếp tục tái sử dụng thay vì
          bỏ đi.
        </p>
        <p class="body cycle__more">
          Phụ phẩm sau trồng nấm trở lại sản xuất nông nghiệp, góp phần giảm lãng phí và nối
          tiếp một vòng tuần hoàn từ đất — rồi trở về với đất.
        </p>
      </div>

      <div class="cycle__diagram" data-reveal style="--reveal-delay: 120ms">
        <div class="ring">
          <svg class="ring__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
            <defs>
              <marker id="cycle-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto">
                <path d="M1 1 L8 5 L1 9" />
              </marker>
            </defs>
            {arrows.map((d) => <path d={d} marker-end="url(#cycle-arrow)" />)}
          </svg>

          <p class="ring__motto" aria-hidden="true">Từ đất,<br />trở về đất.</p>

          <ol class="ring__steps" aria-label="Chu trình nông nghiệp tuần hoàn, năm giai đoạn nối tiếp thành một vòng">
            {steps.map((step, i) => (
              <li class="ring__step" style={`--x: ${step.x}%; --y: ${step.y}%`}>
                <span class="ring__num">{String(i + 1).padStart(2, '0')}</span>
                <img
                  class="ring__icon"
                  src={`/images/farm/circular-icon-${step.icon}.webp`}
                  alt=""
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
                <span class="ring__name">{step.name}</span>
                <span class="ring__note">{step.note}</span>
              </li>
            ))}
          </ol>
          <p class="ring__loop">Sau giai đoạn 05, vòng quay trở lại 01.</p>
        </div>
      </div>

      <figure class="cycle__figure">
        <!-- Editorial plate with its line set into the photograph; the caption
             sits bottom left, so crops only ever trim the right edge.
             VERIFY: provenance of this photograph before launch. -->
        <Photo
          class="cycle__photo"
          src="/images/farm/circular-nam-bao-ngu-doc.webp"
          width={1122}
          height={1402}
          ratio="4 / 5"
          position="0% 50%"
          alt="Chùm nấm bào ngư mọc từ bịch phôi trên kệ sắt trong nhà nuôi nấm. Dòng chữ trên ảnh: “Nông nghiệp tuần hoàn là cách chúng tôi trả lại sự cân bằng cho đất.”"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .cycle {
    --cycle-bg: var(--color-cream);
    --cycle-line: rgba(32, 34, 31, 0.55);
    background: var(--cycle-bg);
    border-block: 1px solid var(--color-line);
    overflow: hidden;
  }

  .cycle :global(.cycle__eyebrow) { margin-bottom: var(--space-m); }

  .cycle__grid { row-gap: var(--space-xl); }

  .cycle__head,
  .cycle__copy,
  .cycle__diagram,
  .cycle__figure { grid-column: 1 / -1; }

  .cycle__title { max-width: 12ch; }
  .cycle__sub { margin-top: var(--space-s); color: var(--color-text); }

  .cycle__copy { max-width: 34rem; margin-top: calc(var(--space-m) - var(--space-xl)); }
  .cycle__copy .cycle__more {
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line);
  }

  .cycle__figure { max-width: 26rem; }

  /* --- Diagram ---------------------------------------------------------
     Small screens: a numbered vertical sequence with small icons.
     ≥ 640px: the five stages are set around a loop of arrows. */

  .ring { position: relative; }

  .ring__svg,
  .ring__motto { display: none; }

  .ring__steps { border-top: 1px solid var(--color-line); }

  .ring__step {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    grid-template-rows: auto auto 1fr;
    column-gap: var(--space-s);
    align-items: start;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-line);
  }

  .ring__icon {
    grid-column: 1;
    grid-row: 1 / -1;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    border: 1px solid rgba(120, 130, 103, 0.45);
  }

  .ring__num {
    grid-column: 2;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    color: var(--color-earth);
    font-variant-numeric: tabular-nums;
  }

  .ring__name {
    grid-column: 2;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .ring__note {
    grid-column: 2;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .ring__loop {
    padding: 0.875rem 0 0 calc(3.5rem + var(--space-s));
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    /* Sizes follow the diagram's width so the composition holds together. */
    .cycle__diagram { container-type: inline-size; }

    .ring {
      --icon: 24cqi;
      --num-h: 4.4cqi;
      width: 100%;
      max-width: 36.5rem;
      margin-inline: auto;
      aspect-ratio: 585 / 665;
    }

    .ring__loop { display: none; }

    .ring__svg {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      fill: none;
      stroke: var(--cycle-line);
      stroke-width: 1.1;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .ring__motto {
      display: block;
      position: absolute;
      top: 49.6%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--font-display);
      font-style: italic;
      font-size: max(1.25rem, 6cqi);
      line-height: 1.25;
      text-align: center;
      white-space: nowrap;
      color: var(--color-forest);
    }

    .ring__steps { border: 0; }

    /* Each stage hangs from its icon's centre: number above, text below. */
    .ring__step {
      position: absolute;
      left: var(--x);
      top: var(--y);
      transform: translate(-50%, calc(-1 * (var(--num-h) + var(--icon) / 2)));
      display: flex;
      flex-direction: column;
      align-items: center;
      width: max-content;
      padding: 0;
      border: 0;
      text-align: center;
    }

    .ring__num {
      height: var(--num-h);
      font-size: max(0.6875rem, 2.9cqi);
      line-height: 1;
    }

    .ring__icon {
      width: var(--icon);
      height: var(--icon);
      border-color: rgba(120, 130, 103, 0.5);
    }

    .ring__name {
      margin-top: 1.4cqi;
      font-size: max(0.875rem, 3.5cqi);
      white-space: nowrap;
    }

    .ring__note {
      white-space: pre-line;
      margin-top: 0.4cqi;
      font-size: max(0.75rem, 2.5cqi);
      line-height: 1.45;
    }
  }

  /* Tablet: the introduction in two columns, then the
     photograph beside the diagram. */
  @media (min-width: 768px) {
    .cycle :global(.cycle__eyebrow) { margin-bottom: var(--space-l); }
    .cycle__grid { row-gap: var(--space-2xl); }

    .cycle__head { grid-column: 1 / span 5; grid-row: 1; }
    .cycle__copy { grid-column: 7 / -1; grid-row: 1; margin-top: 0; }

    .cycle__figure { grid-column: 1 / span 5; grid-row: 2; max-width: none; align-self: center; }
    .cycle__diagram { grid-column: 6 / -1; grid-row: 2; align-self: center; }

    .ring { max-width: 33rem; margin-inline: auto 0; }
  }

  /* Desktop: photograph, diagram and text side by side, as one spread. */
  @media (min-width: 1024px) {
    .cycle__grid {
      /* Outer 1fr rows centre the text column when it is shorter than
         the photograph and diagram; they collapse when it is taller. */
      grid-template-rows: 1fr auto auto 1fr;
      row-gap: 0;
      align-items: start;
    }

    /* Three tracks: the photograph (4:5, shown whole) sets the height;
       the diagram's track fits a diagram of that height; the text takes
       the rest. Widths: photograph 4 of 12 columns, as before. */
    .cycle__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 4.4fr) minmax(0, 3.6fr); }
    .cycle__figure { grid-column: 1; grid-row: 1 / -1; align-self: center; }
    .cycle__head { grid-column: 3; grid-row: 2; }
    .cycle__copy { grid-column: 3; grid-row: 3; margin-top: var(--space-l); }

    /* The diagram takes the height of the row (the photograph's) and sets
       its own width from it; it adds no height of its own. Its labels
       follow its width, so the composition scales as one. */
    .cycle__diagram {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: stretch;
      contain: size;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* 94.5%: the top number and bottom notes hang just outside the ring's
       box, so the drawing as a whole spans the photograph's height. */
    .ring {
      container-type: inline-size;
      width: auto;
      height: 94.5%;
      max-width: 100%;
    }
    .ring__motto { font-size: 6cqi; }
    .ring__num { font-size: 2.9cqi; }
    .ring__name { font-size: 3.6cqi; }
    .ring__note { font-size: 3.15cqi; }

    /* The heading and subtitle take one line each where they fit. */
    .cycle__title { max-width: none; }
    .cycle__sub br { display: none; }
  }

  /* Small laptops: the photograph keeps its 3.5 share; the text column
     takes a wider one, and its spacing tightens. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .cycle__grid { grid-template-columns: minmax(0, 3.5fr) minmax(0, 3.9fr) minmax(0, 4.6fr); }

    .cycle__sub { margin-top: var(--space-xs); }
    .cycle__copy { margin-top: var(--space-m); }
    .cycle__copy .cycle__more { margin-top: var(--space-s); padding-top: var(--space-s); }
  }
</style>
