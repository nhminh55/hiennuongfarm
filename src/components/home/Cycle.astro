---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';

// Inputs named in the Hiền Nương video (00:41): rice husks, bran and sawdust.
// By-product → organic fertiliser: CONTENT_EVIDENCE_BANK.md §2 (VERIFIED).
const steps = [
  { name: 'Nguyên liệu', note: 'Trấu, cám, mùn cưa' },
  { name: 'Trồng', note: 'Nấm & dược liệu' },
  { name: 'Thu hoạch', note: 'Sản phẩm tươi' },
  { name: 'Chế biến', note: 'Tăng giá trị' },
  { name: 'Phụ phẩm', note: 'Phân hữu cơ' },
  { name: 'Tái sử dụng', note: 'Trở về đất' },
];

// Direction chevrons sit midway between steps on the ring (clockwise).
const chevrons = steps.map((_, i) => {
  const deg = 30 + i * 60;
  const rad = (deg * Math.PI) / 180;
  return { x: 50 + 50 * Math.sin(rad), y: 50 - 50 * Math.cos(rad), deg };
});
---
<section class="section cycle" id="tuan-hoan" aria-labelledby="cycle-title">
  <div class="container grid cycle__grid">
    <div class="cycle__text" data-reveal>
      <Eyebrow num="02">Nông nghiệp tuần hoàn</Eyebrow>
      <h2 class="h2 cycle__title" id="cycle-title">Vòng tuần hoàn khép kín từ thiên nhiên</h2>
      <p class="body cycle__body">
        Phụ phẩm nông nghiệp của địa phương như trấu, cám và mùn cưa được tận dụng làm giá thể
        trồng nấm. Sau thu hoạch, giá thể đã qua sử dụng tiếp tục quay lại phục vụ nông nghiệp —
        để mỗi vụ mùa nuôi dưỡng vụ mùa tiếp theo.
      </p>
    </div>

    <div class="cycle__diagram" data-reveal style="--reveal-delay: 120ms">
      <div class="ring">
        <svg class="ring__svg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="50" />
          {chevrons.map((c) => (
            <path d="M-1.4 -1.6 L0.2 0 L-1.4 1.6" transform={`translate(${c.x.toFixed(2)} ${c.y.toFixed(2)}) rotate(${c.deg})`} />
          ))}
        </svg>
        <div class="ring__orbit" aria-hidden="true"><span></span></div>
        <div class="ring__center" aria-hidden="true">
          <p class="ring__motto">Từ đất,<br />trở về đất.</p>
        </div>

        <ol class="ring__steps" aria-label="Chu trình nông nghiệp tuần hoàn, sáu giai đoạn nối tiếp thành một vòng">
          {steps.map((step, i) => (
            <li class="ring__step" style={`--i: ${i}`}>
              <span class="ring__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="ring__name">{step.name}</span>
              <span class="ring__note">{step.note}</span>
            </li>
          ))}
        </ol>
        <p class="ring__loop">Sau giai đoạn 06, vòng quay trở lại 01.</p>
      </div>
    </div>

    <figure class="cycle__figure">
      <!-- Photo collection HN-011, cropped to remove a pillar (left) and a
           Nhân Dân watermark (bottom right). VERIFY: publication rights. -->
      <Photo
        class="cycle__photo"
        src="/images/farm/circular-day-bich-gia-the.webp"
        width={1280}
        height={680}
        alt="Hàng trăm bịch giá thể xếp sát nhau thành từng dãy trên nền nhà trồng nấm, miệng bịch lộ lớp giá thể màu nâu đỏ"
      />
      <figcaption class="cycle__caption">
        Giá thể từ phụ phẩm nông nghiệp được đóng bịch, chuẩn bị cho một vụ nấm mới.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /* A quieter paper tone than the sections either side: the diagram is
     drawn into the page in fine line, not set in a box. */
  .cycle {
    --cycle-bg: var(--color-cream);
    --cycle-line: rgba(32, 34, 31, 0.28);
    background: var(--cycle-bg);
    border-block: 1px solid var(--color-line);
    overflow: hidden;
  }

  .cycle__grid { row-gap: var(--space-xl); }

  .cycle__text,
  .cycle__diagram,
  .cycle__figure { grid-column: 1 / -1; }

  .cycle__title { margin-top: var(--space-m); max-width: 14ch; }
  .cycle__body { margin-top: var(--space-m); max-width: 30rem; }

  /* The photograph supports the diagram as a short landscape crop.
     Phones and tablets: it closes the section edge to edge, the caption set
     into its foot. */
  .cycle__figure {
    position: relative;
    margin-inline: calc(-1 * var(--gutter));
    margin-bottom: calc(-1 * var(--section-y));
  }

  .cycle__figure :global(.cycle__photo) {
    aspect-ratio: 3 / 2;
    --pos: 50% 62%;
  }

  .cycle__figure::after {
    content: "";
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(to top, rgba(16, 43, 33, 0.78), rgba(16, 43, 33, 0));
    pointer-events: none;
  }

  .cycle__caption {
    position: absolute;
    z-index: 1;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--space-m);
    max-width: 24rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-cream);
  }

  /* --- Ring diagram ----------------------------------------------------
     Small screens: a numbered vertical sequence (the ring is hidden).
     ≥ 640px: steps are placed around a circle with CSS trigonometry. */

  .ring { position: relative; }

  .ring__svg,
  .ring__orbit,
  .ring__center { display: none; }

  .ring__steps { border-top: 1px solid var(--color-line); }

  .ring__step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    gap: 0.125rem var(--space-s);
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-line);
  }

  .ring__num {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-earth);
    font-variant-numeric: tabular-nums;
  }

  .ring__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .ring__note {
    grid-column: 2;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .ring__loop {
    padding: 0.875rem 0 0 calc(2.5rem + var(--space-s));
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .ring {
      --ring-pad-x: 5rem;
      --ring-pad-y: 2.5rem;
      width: 100%;
      max-width: 34rem;
      margin-inline: auto;
      padding: var(--ring-pad-y) var(--ring-pad-x);
    }

    /* The square the circle is drawn in. */
    .ring::before {
      content: "";
      display: block;
      aspect-ratio: 1;
    }

    .ring__loop { display: none; }

    .ring__svg,
    .ring__orbit,
    .ring__steps {
      display: block;
      position: absolute;
      top: var(--ring-pad-y);
      left: var(--ring-pad-x);
      right: var(--ring-pad-x);
      bottom: var(--ring-pad-y);
    }

    .ring__svg {
      width: auto;
      height: auto;
      overflow: visible;
      fill: none;
      stroke: var(--cycle-line);
      stroke-width: 1;
    }
    .ring__svg :is(circle, path) { vector-effect: non-scaling-stroke; }
    .ring__svg path { stroke: var(--color-charcoal); stroke-opacity: 0.7; }

    /* A single point travelling clockwise: the cycle never stops. */
    .ring__orbit span {
      position: absolute;
      top: 0;
      left: 50%;
      width: 7px;
      height: 7px;
      margin: -3.5px 0 0 -3.5px;
      border-radius: 50%;
      background: var(--color-forest);
    }

    @media (prefers-reduced-motion: no-preference) {
      .ring__orbit { animation: orbit 40s linear infinite; }
      @keyframes orbit { to { transform: rotate(360deg); } }
    }

    .ring__center {
      display: block;
      position: absolute;
      top: 50%;
      left: 50%;
      width: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
    }

    .ring__motto {
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(1.25rem, 0.9rem + 0.9vw, 1.75rem);
      line-height: 1.25;
      color: var(--color-forest);
    }

    .ring__steps { border: 0; }

    .ring__step {
      --a: calc(var(--i) * 60deg);
      position: absolute;
      left: calc(50% + 50% * sin(var(--a)));
      top: calc(50% - 50% * cos(var(--a)));
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.0625rem;
      width: max-content;
      max-width: 10rem;
      padding: 0.5rem 0.75rem;
      border: 0;
      background: var(--cycle-bg);
      text-align: center;
    }

    .ring__num { font-size: 0.6875rem; }
    .ring__name { font-size: 1.0625rem; white-space: nowrap; }
    .ring__note { font-size: 0.75rem; line-height: 1.4; text-align: center; }

    /* The ring's column sets its size; in a narrow column the labels step
       down so neighbouring stages never overlap. */
    .cycle__diagram { container-type: inline-size; }
  }

  @container (max-width: 25.5rem) {
    .ring__step { padding: 0.25rem 0.375rem; }
    .ring__num { font-size: 0.625rem; }
    .ring__name { font-size: 0.9375rem; }
    .ring__note { font-size: 0.6875rem; line-height: 1.35; }
    .ring__motto { font-size: 1.125rem; }
  }

  /* Tablet: text beside the ring; the photograph closes the section as a
     wide strip, edge to edge. */
  @media (min-width: 768px) {
    .cycle__grid { row-gap: var(--space-l); align-items: center; }
    .cycle__text { grid-column: 1 / span 5; grid-row: 1; }
    .cycle__diagram { grid-column: 6 / -1; grid-row: 1; }

    .cycle__figure { grid-row: 2; }
    .cycle__figure :global(.cycle__photo) { aspect-ratio: 21 / 8; }

    .ring { --ring-pad-x: 4rem; --ring-pad-y: 1.75rem; max-width: 26rem; margin-inline: auto 0; }
    .ring__step { padding: 0.3125rem 0.5rem; }
  }

  /* Desktop: introduction, diagram, photograph. The ring is the focus — the
     largest element, centred; the photograph is a small landscape plate set
     low in the right column. The ring is sized to read whole on a laptop. */
  @media (min-width: 1000px) {
    .cycle__grid { row-gap: 0; }

    .cycle__text { grid-column: 1 / span 4; }
    .cycle__diagram { grid-column: 5 / span 5; }

    .cycle__figure {
      grid-column: 10 / -1;
      grid-row: 1;
      align-self: end;
      margin: 0;
    }
    .cycle__figure::after { display: none; }
    .cycle__figure :global(.cycle__photo) { aspect-ratio: 4 / 3; --pos: 50% 60%; }

    /* Desktop: a plate with its caption beneath, not over it. */
    .cycle__caption {
      position: static;
      margin-top: var(--space-s);
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }

    .ring { --ring-pad-x: 4rem; --ring-pad-y: 1.75rem; max-width: 27rem; margin-inline: auto; }
    .ring__step { padding: 0.3125rem 0.5rem; }
  }
</style>
