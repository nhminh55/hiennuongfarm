---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';

const steps = [
  { name: 'Nguyên liệu', note: 'Phụ phẩm nông nghiệp' },
  { name: 'Trồng', note: 'Nấm & dược liệu' },
  { name: 'Thu hoạch', note: 'Sản phẩm tươi' },
  { name: 'Chế biến', note: 'Tăng giá trị' },
  { name: 'Phụ phẩm', note: 'Phân hữu cơ' },
  { name: 'Tái sử dụng', note: 'Trở về đất' },
];

// Direction chevrons sit midway between steps on the ring (clockwise).
const chevrons = steps.map((_, i) => {
  const deg = 30 + i * 60;
  const rad = (deg * Math.PI) / 180;
  return { x: 50 + 50 * Math.sin(rad), y: 50 - 50 * Math.cos(rad), deg };
});
---
<section class="section cycle" id="tuan-hoan" aria-labelledby="cycle-title">
  <div class="container grid cycle__grid">
    <div class="cycle__text" data-reveal>
      <Eyebrow num="02">Nông nghiệp tuần hoàn</Eyebrow>
      <h2 class="h2 cycle__title" id="cycle-title">Vòng tuần hoàn khép kín từ thiên nhiên</h2>
      <p class="body cycle__body">
        Chúng tôi theo đuổi mô hình nông nghiệp tuần hoàn: biến phụ phẩm thành tài nguyên,
        giảm thiểu tác động đến môi trường, và để mỗi vụ mùa nuôi dưỡng vụ mùa tiếp theo.
      </p>
    </div>

    <div class="cycle__diagram" data-reveal style="--reveal-delay: 120ms">
      <div class="ring">
        <svg class="ring__svg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="50" />
          {chevrons.map((c) => (
            <path d="M-1.4 -1.6 L0.2 0 L-1.4 1.6" transform={`translate(${c.x.toFixed(2)} ${c.y.toFixed(2)}) rotate(${c.deg})`} />
          ))}
        </svg>
        <div class="ring__orbit" aria-hidden="true"><span></span></div>
        <p class="ring__center">Từ đất,<br />trở về đất.</p>

        <ol class="ring__steps" aria-label="Chu trình nông nghiệp tuần hoàn">
          {steps.map((step, i) => (
            <li class="ring__step" style={`--i: ${i}`}>
              <span class="ring__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="ring__name">{step.name}</span>
              <span class="ring__note">{step.note}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <figure class="cycle__figure" data-reveal style="--reveal-delay: 200ms">
      <Photo
        ratio="3 / 4"
        tone="forest"
        alt="Những chùm nấm đang phát triển trên giá thể trong nhà nuôi trồng"
        brief="Nấm đang lên trên giá thể trong nhà trồng. Ảnh dọc 3:4."
      />
      <figcaption class="cycle__caption">
        Nông nghiệp tuần hoàn là cách chúng tôi trả lại sự cân bằng cho đất.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .cycle { background: var(--color-cream); }

  .cycle__grid { row-gap: var(--space-2xl); }

  .cycle__text,
  .cycle__diagram,
  .cycle__figure { grid-column: 1 / -1; }

  .cycle__title { margin-top: var(--space-l); max-width: 14ch; }
  .cycle__body { margin-top: var(--space-l); max-width: 30rem; }

  .cycle__caption {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 24rem;
  }

  /* --- Ring diagram ----------------------------------------------------
     Small screens: a numbered vertical sequence (the ring is hidden).
     ≥ 640px: steps are placed around a circle with CSS trigonometry. */

  .ring { position: relative; }

  .ring__svg,
  .ring__orbit,
  .ring__center { display: none; }

  .ring__steps {
    border-top: 1px solid var(--color-line);
    counter-reset: step;
  }

  .ring__step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    gap: 0.125rem var(--space-s);
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .ring__num {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-earth);
    font-variant-numeric: tabular-nums;
  }

  .ring__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .ring__note {
    font-size: 0.8125rem;
    grid-column: 2;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .ring {
      --ring-pad-x: clamp(4.5rem, 10vw, 6rem);
      --ring-pad-y: 2.5rem;
      width: 100%;
      max-width: 34rem;
      margin-inline: auto;
      padding: var(--ring-pad-y) var(--ring-pad-x);
    }

    /* The square the circle is drawn in. */
    .ring::before {
      content: "";
      display: block;
      aspect-ratio: 1;
    }

    .ring__svg,
    .ring__orbit {
      display: block;
      position: absolute;
      top: var(--ring-pad-y);
      left: var(--ring-pad-x);
      right: var(--ring-pad-x);
      bottom: var(--ring-pad-y);
      width: auto;
      height: auto;
    }

    .ring__svg {
      overflow: visible;
      fill: none;
      stroke: var(--color-line-strong);
      stroke-width: 1;
    }
    .ring__svg :is(circle, path) { vector-effect: non-scaling-stroke; }
    .ring__svg path { stroke: var(--color-earth); }

    /* A single point travelling clockwise: the cycle never stops. */
    .ring__orbit span {
      position: absolute;
      top: 0;
      left: 50%;
      width: 7px;
      height: 7px;
      margin: -3.5px 0 0 -3.5px;
      border-radius: 50%;
      background: var(--color-forest);
    }

    @media (prefers-reduced-motion: no-preference) {
      .ring__orbit { animation: orbit 36s linear infinite; }
      @keyframes orbit { to { transform: rotate(360deg); } }
    }

    .ring__center {
      display: block;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(1.125rem, 0.9rem + 0.8vw, 1.5rem);
      line-height: 1.35;
      text-align: center;
      color: var(--color-earth);
    }

    .ring__steps {
      position: absolute;
      top: var(--ring-pad-y);
      left: var(--ring-pad-x);
      right: var(--ring-pad-x);
      bottom: var(--ring-pad-y);
      border: 0;
    }

    .ring__step {
      --a: calc(var(--i) * 60deg);
      position: absolute;
      left: calc(50% + 50% * sin(var(--a)));
      top: calc(50% - 50% * cos(var(--a)));
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.125rem;
      width: max-content;
      max-width: 9.5rem;
      padding: 0.5rem 0.75rem;
      border: 0;
      background: var(--color-cream);
      text-align: center;
    }

    .ring__name { font-size: 1.0625rem; white-space: nowrap; }
    .ring__note { font-size: 0.75rem; line-height: 1.4; text-align: center; }
  }

  @media (min-width: 768px) {
    .cycle__text { grid-column: 1 / span 6; }
    .cycle__figure { grid-column: 8 / span 5; grid-row: 1; }
    .cycle__diagram { grid-column: 1 / -1; }
  }

  @media (min-width: 1024px) {
    .cycle__text { grid-column: 1 / span 6; grid-row: 1; }
    .cycle__diagram { grid-column: 1 / span 7; grid-row: 2; }
    .cycle__figure { grid-column: 8 / span 5; grid-row: 1 / span 2; align-self: center; }
  }

  @media (min-width: 1200px) {
    .cycle__grid { align-items: center; }
    .cycle__figure { grid-row: 1; }
    .cycle__text { grid-column: 1 / span 4; }
    .cycle__diagram { grid-column: 5 / span 5; grid-row: 1; }
    .cycle__figure { grid-column: 10 / span 3; }
    .ring { --ring-pad-x: 4.25rem; }
  }
</style>
