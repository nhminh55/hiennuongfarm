---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';

// VERIFY: all four facts are taken from the design mockup and need confirmation.
const facts = [
  { value: '2020', label: 'Năm thành lập' },
  { value: 'Bảy Núi', label: 'An Giang' },
  { value: 'Nông nghiệp tuần hoàn', label: 'Mô hình cốt lõi' },
  { value: 'HTX Tà Đảnh', label: 'Liên kết phát triển' },
];
---
<section class="section about" id="ve-hien-nuong" aria-labelledby="about-title">
  <div class="container grid about__grid">
    <div class="about__text" data-reveal>
      <Eyebrow num="01">Về Hiền Nương</Eyebrow>
      <h2 class="h2 about__title" id="about-title">
        Chúng tôi tin rằng nông nghiệp tốt không chỉ tạo ra sản phẩm tốt.
      </h2>
      <p class="lead about__lead">Nó còn trả lại giá trị cho đất, cho người và cho vùng quê.</p>
      <!-- VERIFY: founding year and founders' names are from the design mockup. -->
      <p class="body about__body">
        Hiền Nương Farm được hình thành từ năm 2020 bởi chị Châu Thị Nương và anh Trần Phương Hiền,
        với mong muốn kiến tạo một mô hình nông nghiệp bền vững, dựa trên nền tảng nông nghiệp
        tuần hoàn và giá trị tự nhiên của vùng Bảy Núi.
      </p>
    </div>

    <figure class="about__figure" data-reveal style="--reveal-delay: 120ms">
      <Photo
        ratio="4 / 5"
        tone="earth"
        alt="Đôi bàn tay người nông dân nâng những tai nấm linh chi vừa thu hái"
        brief="Cận cảnh đôi tay nâng nấm linh chi vừa thu hái. Ảnh dọc 4:5, ánh sáng tự nhiên."
      />
      <blockquote class="about__quote">
        <p>“Từ tình yêu với đất, chúng tôi bắt đầu Hiền Nương Farm.”</p>
      </blockquote>
    </figure>

    <dl class="about__facts" data-reveal style="--reveal-delay: 240ms">
      {facts.map((fact) => (
        <div class="about__fact">
          <dt class="about__fact-value">{fact.value}</dt>
          <dd class="about__fact-label">{fact.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about { background: var(--color-paper); }

  .about__grid { row-gap: var(--space-2xl); }

  .about__text,
  .about__figure,
  .about__facts { grid-column: 1 / -1; }

  .about__title { margin-top: var(--space-l); max-width: 18ch; }
  .about__lead { margin-top: var(--space-m); max-width: 28ch; }
  .about__body { margin-top: var(--space-l); max-width: 34rem; }

  .about__figure { position: relative; }

  .about__quote {
    margin-top: var(--space-m);
    padding-left: var(--space-m);
    border-left: 1px solid var(--color-earth);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 26rem;
  }

  .about__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--col-gap);
    border-top: 1px solid var(--color-line);
  }

  .about__fact {
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--color-line);
  }

  .about__fact-value {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1875rem, 1rem + 0.9vw, 1.375rem);
    line-height: 1.25;
  }

  .about__fact-label {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .about__text { grid-column: 1 / span 6; align-self: center; }
    .about__figure { grid-column: 8 / span 5; }
    .about__facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .about__text { grid-column: 1 / span 5; align-self: start; }
    .about__figure { grid-column: 6 / span 5; }
    .about__facts {
      grid-column: 11 / span 2;
      grid-template-columns: 1fr;
      align-self: start;
      border-top: 0;
    }
    .about__fact { padding-block: var(--space-m) var(--space-l); }
    .about__fact:first-child { padding-top: 0; }
  }
</style>
