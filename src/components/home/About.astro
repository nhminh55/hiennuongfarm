---
import { copy } from '../../data/copy';
import Photo from '../Photo.astro';
import Arrow from '../Arrow.astro';
import Eyebrow from '../Eyebrow.astro';
import BrandFilm from './BrandFilm.astro';
import { getLocale, pageHref } from '../../i18n';

// 2020 and the co-founders: OWNER-VERIFIED; Bảy Núi / Tà Đảnh and the
// circular model: VERIFIED (CONTENT_EVIDENCE_BANK.md §1–2). The HTX
// relationship stays off the page until confirmed (§7).
// Founding year and co-founders: OWNER-VERIFIED (CONTENT_EVIDENCE_BANK.md §1).
// Always name them in this order: chị Châu Thị Nương, then anh Trần Phương Hiền.
// Tà Đảnh and the by-product substrate: VERIFIED (§1–2).
const lang = getLocale(Astro.url);
const t = copy('trang-chu/02-ve-hien-nuong', lang);
---
<section class="section about" id="ve-hien-nuong" aria-labelledby="about-title">
  <div class="container">
    <Eyebrow num="01" class="about__eyebrow">{t.eyebrow}</Eyebrow>

    <div class="grid about__grid">
      <BrandFilm />
      <div class="about__text" data-reveal>
        <h2 class="h2 about__title" id="about-title">{t.title}</h2>
        <p class="body about__body">{t.body}</p>
        <!-- The story page is Vietnamese only; other languages stay on this section. -->
        <a class="link-arrow about__more" href={pageHref('/ve-chung-toi/', lang, '/#ve-hien-nuong')}>{t.more} <Arrow /></a>
      </div>

      <figure class="about__figure" data-reveal style="--reveal-delay: 120ms">
        <!-- Chị Châu Thị Nương in the mushroom growing room, with the brand's
             handwritten line set into the photograph. Narrow columns use a
             square crop anchored left, which keeps the handwriting and chị Nương
             and trims only the shelves on the right; desktop shows it whole. -->
        <Photo
          class="about__photo"
          src="/images/farm/about-chi-nuong-phong-nam.webp"
          width={1448}
          height={1086}
          ratio="1 / 1"
          position="0% 50%"
          alt={t.alt}
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .about { background: var(--color-paper); }

  .about__grid { row-gap: var(--space-xl); }
  .about__grid :global(.brand-film) { grid-column: 1 / -1; order: 3; }

  .about__text,
  .about__figure { grid-column: 1 / -1; }

  .about__title { margin-top: var(--space-m); max-width: 20ch; }
  .about__body {
    margin-top: var(--space-m);
    max-width: 30rem;
  }
  .about__body::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-bottom: var(--space-m);
    background: var(--color-earth);
  }

  .about .about__more { margin-top: var(--space-m); text-transform: uppercase; }

  /* Phones: the photograph runs to the screen edges. */
  .about__figure { margin-inline: calc(-1 * var(--gutter)); }

  /* Tablet: text beside the photograph. As in the sections that follow,
     the label runs above both, and the photograph's top meets the
     heading's. */
  @media (min-width: 768px) {
    .about :global(.about__eyebrow) { margin-bottom: var(--space-l); }
    .about__grid { align-items: start; }
    .about__title { margin-top: 0; }
    .about__text { grid-column: 1 / span 6; }
    .about__figure { grid-column: 7 / span 6; margin-inline: 0; }
  }

  /* Desktop: film, existing story, and photograph in one editorial row. */
  @media (min-width: 1000px) {
    .about__grid { grid-template-columns: minmax(0, 35fr) minmax(0, 30fr) minmax(0, 35fr); align-items: center; }
    .about__grid :global(.brand-film) { grid-column: 1; order: 0; }
    .about__text { grid-column: 2; }
    .about__title { max-width: 22ch; }
    .about__figure { grid-column: 3; }
    .about__grid :global(.brand-film__media),
    .about__figure :global(.about__photo) { aspect-ratio: 1448 / 1086; }
  }
</style>
