---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';

// VERIFY: all four facts are taken from the design mockup and need confirmation.
const facts = [
  { value: '2020', label: 'Năm thành lập' },
  { value: 'Bảy Núi', label: 'An Giang' },
  { value: 'Nông nghiệp tuần hoàn', label: 'Mô hình cốt lõi' },
  { value: 'HTX Tà Đảnh', label: 'Liên kết phát triển' },
];
---
<section class="section about" id="ve-hien-nuong" aria-labelledby="about-title">
  <div class="container grid about__grid">
    <header class="about__head" data-reveal>
      <Eyebrow num="01">Về Hiền Nương</Eyebrow>
      <h2 class="h2 about__title" id="about-title">
        Chúng tôi tin rằng nông nghiệp tốt không chỉ tạo ra sản phẩm tốt.
      </h2>
    </header>

    <figure class="about__figure" data-reveal style="--reveal-delay: 120ms">
      <!-- Photo collection HN-023, square crop. VERIFY: identity of the person is not stated in the source. -->
      <Photo
        class="about__photo"
        src="/images/farm/about-phong-nuoi-nam.webp"
        width={1050}
        height={1050}
        ratio="1 / 1"
        alt="Người phụ nữ mặc áo hồng, quàng khăn rằn, đứng giữa hai dãy kệ bịch phôi trong phòng nuôi nấm, tay đeo găng chạm vào một bịch phôi"
      />
      <!-- From the video's own narration (00:22–00:24). -->
      <figcaption class="about__quote">
        Bắt đầu từ con số không, với nguồn tài nguyên sẵn có của quê hương.
      </figcaption>
    </figure>

    <div class="about__story" data-reveal style="--reveal-delay: 200ms">
      <p class="lead about__lead">Nó còn trả lại giá trị cho đất, cho người và cho vùng quê.</p>
      <!-- VERIFY: founding year and founders' names are from the design mockup. -->
      <p class="body about__body">
        Hiền Nương Farm được hình thành từ năm 2020 bởi chị Châu Thị Nương và anh Trần Phương Hiền,
        với mong muốn kiến tạo một mô hình nông nghiệp bền vững, dựa trên nền tảng nông nghiệp
        tuần hoàn và giá trị tự nhiên của vùng Bảy Núi.
      </p>

      <dl class="about__facts">
        {facts.map((fact) => (
          <div class="about__fact">
            <dt class="about__fact-label">{fact.label}</dt>
            <dd class="about__fact-value">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about { background: var(--color-paper); }

  .about__grid { row-gap: var(--space-xl); }

  .about__head,
  .about__figure,
  .about__story { grid-column: 1 / -1; }

  .about__title { margin-top: var(--space-l); max-width: 22ch; }

  .about__quote {
    margin-top: var(--space-m);
    padding-left: var(--space-m);
    border-left: 1px solid var(--color-earth);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 26rem;
  }

  .about__lead { max-width: 26ch; }
  .about__body { margin-top: var(--space-m); max-width: 34rem; }

  /* Facts close the story: label above value, like an entry in a farm record. */
  .about__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--col-gap);
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--color-line);
  }

  .about__fact-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .about__fact-value {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1875rem, 1rem + 0.9vw, 1.5rem);
    line-height: 1.25;
  }

  @media (min-width: 768px) {
    .about__grid { row-gap: var(--space-2xl); }
    .about__figure { grid-column: 1 / span 6; }
    .about__story { grid-column: 7 / span 6; align-self: end; }
  }

  @media (min-width: 1024px) {
    .about__head { grid-column: 1 / span 8; }

    .about__figure { grid-column: 1 / span 5; }

    /* The photograph bleeds off the left edge of the page; its caption stays on the grid. */
    .about__figure :global(.about__photo) {
      margin-left: calc(-1 * max(var(--gutter), (100vw - var(--container)) / 2));
    }

    /* Story spans the figure: lead aligns with its top edge, facts with its bottom. */
    .about__story {
      grid-column: 7 / span 5;
      align-self: stretch;
      display: flex;
      flex-direction: column;
    }
    .about__facts { margin-top: auto; }
  }
</style>
