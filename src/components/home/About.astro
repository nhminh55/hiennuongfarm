---
import Photo from '../Photo.astro';
import Eyebrow from '../Eyebrow.astro';

// 2020: OWNER-VERIFIED; Bảy Núi / Tà Đảnh and the circular model: VERIFIED
// (CONTENT_EVIDENCE_BANK.md §1–2). The HTX relationship stays off the page
// until confirmed (§7).
const facts = [
  { value: '2020', label: 'Hiền Nương Farm hình thành' },
  { value: 'Bảy Núi', label: 'Tà Đảnh · An Giang' },
  { value: 'Nông nghiệp tuần hoàn', label: 'Hướng phát triển cốt lõi' },
];
---
<section class="section about" id="ve-hien-nuong" aria-labelledby="about-title">
  <div class="container grid about__grid">
    <div class="about__text" data-reveal>
      <Eyebrow num="01">Về Hiền Nương</Eyebrow>
      <h2 class="h2 about__title" id="about-title">
        Từ Bảy Núi, một hành trình nông nghiệp bắt đầu.
      </h2>
      <!-- Brand belief line, set as the section's secondary statement. -->
      <p class="about__lead">
        Nông nghiệp tốt không chỉ tạo ra sản phẩm tốt, mà còn trả lại giá trị cho đất, cho người
        và cho vùng quê.
      </p>
      <!-- Founding year and co-founders: OWNER-VERIFIED (CONTENT_EVIDENCE_BANK.md §1).
           Always name them in this order: chị Châu Thị Nương, then anh Trần Phương Hiền.
           Tà Đảnh and the by-product substrate: VERIFIED (§1–2). -->
      <p class="body about__body">
        Hiền Nương Farm được thành lập năm 2020 bởi hai vợ chồng chị Châu Thị Nương
        và anh Trần Phương Hiền, tận dụng phụ phẩm nông nghiệp tại Tà Đảnh để tạo giá
        thể trồng nấm.
      </p>
    </div>

    <figure class="about__figure" data-reveal style="--reveal-delay: 120ms">
      <!-- Photo collection HN-023, square crop: stands about as tall as the text beside it on desktop. VERIFY: identity of the person is not stated in the source. -->
      <Photo
        class="about__photo"
        src="/images/farm/about-phong-nuoi-nam.webp"
        width={1050}
        height={1050}
        ratio="1 / 1"
        alt="Người phụ nữ mặc áo hồng, quàng khăn rằn, đứng giữa hai dãy kệ bịch phôi trong phòng nuôi nấm, tay đeo găng chạm vào một bịch phôi"
      />
      <!-- From the video's own narration (00:22–00:24). -->
      <figcaption class="about__quote">
        “Bắt đầu từ con số không, với nguồn tài nguyên sẵn có của quê hương.”
      </figcaption>
    </figure>

    <dl class="about__facts" data-reveal style="--reveal-delay: 200ms">
      {facts.map((fact) => (
        <div class="about__fact">
          <dt class="about__fact-label">{fact.label}</dt>
          <dd class="about__fact-value">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about { background: var(--color-paper); }

  .about__grid { row-gap: var(--space-xl); }

  .about__text,
  .about__figure,
  .about__facts { grid-column: 1 / -1; }

  .about__title { margin-top: var(--space-m); max-width: 20ch; }
  /* A quieter serif statement under the title, then a compact note. */
  .about__lead {
    margin-top: var(--space-m);
    max-width: 30rem;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .about__body {
    margin-top: var(--space-m);
    max-width: 30rem;
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  /* Phones: the photograph runs to the screen edges. */
  .about__figure { margin-inline: calc(-1 * var(--gutter)); }
  .about__quote { padding-inline: var(--gutter); }

  .about__quote {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 28rem;
  }

  /* Facts read like a farm ledger: value in serif, its note beneath,
     entries divided by hairlines. */
  .about__facts {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .about__fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--color-line);
  }

  .about__fact-value {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.85rem + 0.45vw, 1.25rem);
    line-height: 1.25;
  }

  .about__fact-label {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  /* Tablet: text beside the photograph, the ledger across the foot. */
  @media (min-width: 768px) {
    .about__text { grid-column: 1 / span 6; align-self: center; }
    .about__figure { grid-column: 7 / span 6; margin-inline: 0; }
    .about__quote { padding-inline: 0; }

    .about__facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--col-gap);
      border-bottom: 1px solid var(--color-line);
    }
    .about__fact { border-bottom: 0; padding-block: var(--space-m); padding-right: var(--space-s); }
    .about__fact + .about__fact {
      padding-left: var(--col-gap);
      margin-left: calc(-1 * var(--col-gap) / 2);
      border-left: 1px solid var(--color-line);
    }
  }

  /* Desktop: a three-part spread — manifesto, photograph, ledger. */
  @media (min-width: 1000px) {
    .about__grid { align-items: start; }

    .about__text { grid-column: 1 / span 5; align-self: start; }
    .about__title { max-width: 22ch; }
    .about__figure { grid-column: 6 / span 4; }

    /* The ledger is a compact table set against the top of the photograph,
       each entry ruled off — not stretched down the column. */
    .about__facts {
      grid-column: 10 / span 3;
      grid-template-columns: 1fr;
      align-self: start;
      margin-left: var(--space-s);
      border-top: 1px solid var(--color-line);
      border-bottom: 0;
    }

    .about__fact,
    .about__fact + .about__fact {
      justify-content: flex-start;
      padding: var(--space-m) 0;
      margin: 0;
      border: 0;
      border-bottom: 1px solid var(--color-line);
    }
  }

  /* Small laptops: the photo column is narrow, so a portrait crop keeps the
     photograph at least as tall as the text. */
  @media (min-width: 1000px) and (max-width: 1199px) {
    .about__figure :global(.about__photo) {
      aspect-ratio: 4 / 5;
      --pos: 50% 30%;
    }
  }
</style>
