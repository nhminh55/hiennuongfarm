---
/**
 * "Kết quả kiểm nghiệm mẫu" — sample-specific laboratory results, kept
 * visually apart from product copy. Values come only from
 * src/data/lab-reports.ts and are shown as reported, with no pass/fail
 * reading. Each report keeps its own metadata and table.
 *
 * The default slot takes a page-specific note (e.g. how the sample is named).
 */
import Eyebrow from '../Eyebrow.astro';
import type { LabReport, LabResult } from '../../data/lab-reports';
import { getLocale } from '../../i18n';

interface Props {
  reports: LabReport[];
}

const { reports } = Astro.props;
const lang = getLocale(Astro.url);
const t = {
  vi: {
    eyebrow: 'Kiểm nghiệm',
    title: 'Kết quả kiểm nghiệm mẫu',
    intro: 'Các chỉ tiêu và kết quả dưới đây được trình bày theo báo cáo thử nghiệm của mẫu đã gửi kiểm nghiệm.',
    report: 'Báo cáo',
    sample: 'Mẫu thử',
    lab: 'Đơn vị thử nghiệm',
    customer: 'Đơn vị gửi mẫu',
    testedOn: 'Ngày thử nghiệm',
    code: 'Mã báo cáo',
    param: 'Chỉ tiêu',
    result: 'Kết quả',
    notes: [
      'Kết quả trên áp dụng cho mẫu thử được nêu trong báo cáo và không được hiểu là thông số cố định cho mọi lô sản phẩm.',
      'Kết quả được trình bày theo báo cáo, không kèm đánh giá đạt hay không đạt theo một tiêu chuẩn cụ thể.',
    ],
  },
  en: {
    eyebrow: 'Testing',
    title: 'Sample test results',
    intro: 'The parameters and results below are presented as stated in the test report for the sample submitted for testing.',
    report: 'Report',
    sample: 'Sample',
    lab: 'Testing laboratory',
    customer: 'Submitted by',
    testedOn: 'Test date',
    code: 'Report no.',
    param: 'Parameter',
    result: 'Result',
    notes: [
      'These results apply to the sample named in the report and should not be read as fixed specifications for every product batch.',
      'Results are presented as reported, without a pass/fail assessment against any particular standard.',
    ],
  },
  zh: {
    eyebrow: '检测',
    title: '样品检测结果',
    intro: '以下检测项目及结果依据送检样品的检测报告列出。',
    report: '报告',
    sample: '样品',
    lab: '检测机构',
    customer: '送检单位',
    testedOn: '检测日期',
    code: '报告编号',
    param: '检测项目',
    result: '结果',
    notes: [
      '以上结果仅适用于报告所列样品，不应视为所有批次产品的固定指标。',
      '结果按报告原样列出，未依据任何特定标准作合格与否的判定。',
    ],
  },
}[lang];
// Parameter name in this language; Vietnamese and Chinese also show the
// English name printed on the report. Sample and customer stay as written.
const paramName = (r: LabResult) => ({ vi: r.name, en: r.en, zh: r.zh })[lang];
---
<section class="section lab" id="kiem-nghiem" aria-labelledby="lab-title">
  <div class="container grid lab__grid">
    <div class="lab__head">
      <Eyebrow>{t.eyebrow}</Eyebrow>
      <h2 class="h2 lab__title" id="lab-title">{t.title}</h2>
      <p class="body lab__intro">{t.intro}</p>
      {Astro.slots.has('default') && <p class="body lab__intro"><slot /></p>}
    </div>

    <div class="lab__reports">
      {reports.map((report) => (
        <article class="lab__report" aria-label={`${t.report} ${report.id}`}>
          <dl class="lab__meta">
            <div>
              <dt>{t.sample}</dt>
              <dd lang="vi">{report.sample}</dd>
            </div>
            <div>
              <dt>{t.lab}</dt>
              <dd>{report.lab}</dd>
            </div>
            <div>
              <dt>{t.customer}</dt>
              <dd lang="vi">{report.customer}</dd>
            </div>
            <div>
              <dt>{t.testedOn}</dt>
              <dd>{report.testedOn}</dd>
            </div>
            <div>
              <dt>{t.code}</dt>
              <dd class="lab__code">{report.id}</dd>
            </div>
          </dl>

          <table class="lab__table">
            <caption class="lab__caption">{report.group[lang]}</caption>
            <thead>
              <tr>
                <th scope="col">{t.param}</th>
                <th scope="col">{t.result}</th>
              </tr>
            </thead>
            <tbody>
              {report.results.map((r) => (
                <tr>
                  <th scope="row">
                    <span class:list={['lab__param', { italic: r.scientific && paramName(r) === r.en }]}>{paramName(r)}</span>
                    {r.en !== paramName(r) && <span class:list={['lab__param-en', { italic: r.scientific }]} lang="en">{r.en}</span>}
                  </th>
                  <td>
                    <span class="lab__value">{r.value}{r.exp && <sup>{r.exp}</sup>}</span>
                    {r.unit && <span class="lab__unit"> {r.unit}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </article>
      ))}

      <div class="lab__notes">
        {t.notes.map((note) => <p>{note}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .lab {
    background: var(--color-cream);
    border-top: 1px solid var(--color-line);
  }

  .lab__grid { row-gap: var(--space-xl); }

  .lab__head,
  .lab__reports { grid-column: 1 / -1; }

  .lab__title { margin-top: var(--space-l); max-width: 14ch; }
  .lab__intro { margin-top: var(--space-m); max-width: 26rem; font-size: var(--type-small); line-height: 1.65; }
  .lab__intro + .lab__intro { margin-top: var(--space-s); }

  .lab__report + .lab__report { margin-top: var(--space-2xl); }

  /* Report record: label above value, as on the homepage facts. */
  .lab__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m) var(--col-gap);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line-strong);
  }

  .lab__meta dt {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .lab__meta dd {
    margin-top: 0.25rem;
    font-size: var(--type-small);
    line-height: 1.5;
    font-weight: 400;
  }

  .lab__code { font-variant-numeric: tabular-nums; letter-spacing: 0.02em; white-space: nowrap; }

  /* Phones: the report code gets a full row so it never breaks. */
  .lab__meta > div:last-child { grid-column: 1 / -1; }

  .lab__table {
    width: 100%;
    margin-top: var(--space-xl);
    border-collapse: collapse;
    font-size: var(--type-small);
    line-height: 1.5;
  }

  .lab__caption {
    padding-bottom: var(--space-s);
    text-align: left;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .lab__table thead th {
    padding-block: 0.625rem;
    border-top: 1px solid var(--color-line-strong);
    border-bottom: 1px solid var(--color-line-strong);
    text-align: left;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .lab__table tbody th,
  .lab__table tbody td {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
    text-align: left;
  }

  .lab__table tbody th { padding-right: var(--space-m); font-weight: 400; }

  .lab__table td { width: 36%; white-space: nowrap; }

  .lab__param { display: block; color: var(--color-text); }
  .lab__param-en {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .lab__value {
    font-size: 1rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .lab__value sup { font-size: 0.65em; line-height: 0; }

  .lab__unit { color: var(--color-text-muted); }

  .lab__notes {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-l);
    padding-left: var(--space-m);
    border-left: 1px solid var(--color-earth);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 38rem;
  }

  @media (min-width: 640px) {
    .lab__meta { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lab__meta > div:last-child { grid-column: auto; }
  }

  @media (min-width: 1024px) {
    .lab__head { grid-column: 1 / span 4; }
    .lab__reports { grid-column: 6 / span 7; padding-top: 2.75rem; }
  }
</style>
