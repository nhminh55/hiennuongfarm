---
import { copy } from '../data/copy';
import { footerNav, contact, business } from '../data/site';
import { getLocale, isTranslated, localizePath, pageHref } from '../i18n';
import BrandLogo from './BrandLogo.astro';
import Arrow from './Arrow.astro';
import '../styles/desktop-footer-layout.css';

// Zalo opens a chat with the contact phone (zalo.me takes the local number).
const zalo = {
  href: `https://zalo.me/${contact.phone.replace(/^\+84/, '0')}`,
  path: 'M12 2C6.5 2 2 5.9 2 10.7c0 2.6 1.3 4.9 3.4 6.5L4.5 21l4.2-2.1c1 .3 2.1.4 3.3.4 5.5 0 10-3.9 10-8.6S17.5 2 12 2Zm0 1.8c-4.6 0-8.2 3.1-8.2 6.9 0 2.1 1.1 4 3 5.3l-.4 1.9 2.1-1.1c1.1.4 2.3.6 3.5.6 4.6 0 8.2-3.1 8.2-6.9S16.6 3.8 12 3.8ZM8.5 7.5h7v1.6l-4.6 4.8h4.6v1.6h-7v-1.6l4.6-4.8H8.5Z',
};
// No verified social destinations are available yet.
const social = [
  { label: 'Facebook', path: 'M14 21v-8h3l.5-4H14V7c0-1 .3-2 2-2h2V1.5A25 25 0 0 0 15 1c-3 0-5 2-5 5v3H7v4h3v8z' },
  { label: 'YouTube', path: 'M21 6c-.2-1-1-2-2-2-4-.5-10-.5-14 0-1 0-1.8 1-2 2-.5 3-.5 9 0 12 .2 1 1 2 2 2 4 .5 10 .5 14 0 1 0 1.8-1 2-2 .5-3 .5-9 0-12ZM10 8l6 4-6 4z' },
  { label: 'TikTok', path: 'M14 2h3c.3 2 1.6 3.5 4 4v3c-1.5 0-3-.5-4-1.3V16a6 6 0 1 1-6-6v3a3 3 0 1 0 3 3z' },
];
const year = new Date().getFullYear();
const lang = getLocale(Astro.url);
const t = copy('chung/footer', lang);
---
<footer class="site-footer">
  <svg class="site-footer__landscape" viewBox="0 0 1440 240" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 220C90 218 130 190 190 183S260 150 320 160 410 78 470 94 520 133 565 128 645 34 700 54 760 119 810 110 875 68 920 83 995 156 1045 145 1120 108 1170 125 1280 213 1440 207V240H0Z" fill="currentColor" />
  </svg>
  <div class="container">
    <div class="site-footer__top">
      <img class="site-footer__mountains" src="/mountain.png" width="356" height="142" alt="" aria-hidden="true" />
      <div class="site-footer__brand">
        <BrandLogo href={localizePath('/', lang)} dark />
        <p class="site-footer__line">
          {t.line[0]}<br />{t.line[1]}
        </p>
        <div class="site-footer__business" lang="vi">
          <p class="site-footer__business-name">{business.name[0]}<br />{business.name[1]}</p>
          <p class="site-footer__business-code">{business.code}</p>
        </div>
      </div>

      <nav class="site-footer__col site-footer__col--nav" aria-label={t.navLabel}>
        <p class="site-footer__heading">{t.explore}</p>
        <ul class="site-footer__list">
          {footerNav.filter((item) => lang === 'vi' || item.fallback || isTranslated(item.href)).map((item) => (
            <li><a href={pageHref(item.href, lang, item.fallback)}>{item.label[lang]}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__col site-footer__col--contact">
        <p class="site-footer__heading">{t.contact}</p>
        <address class="site-footer__list">
          {contact.locations.map(loc => (
            <a class="site-footer__address" href={loc.mapUrl} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="12" cy="10" r="2.25" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              <span><strong>{loc.name[lang]}</strong> {loc.address[lang]}</span>
              <svg class="site-footer__external" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1.5 8.5 8.5 1.5M3 1.5h5.5V7" fill="none" stroke="currentColor" stroke-width="1" /></svg>
            </a>
          ))}
          <a href={`mailto:${contact.email}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="5.5" width="17" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
            {contact.email}
          </a>
          <span class="site-footer__phones">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8.5 4h-3A1.5 1.5 0 0 0 4 5.6C4.6 13.4 10.6 19.4 18.4 20a1.5 1.5 0 0 0 1.6-1.5v-3l-3.6-1.4-2 2a11 11 0 0 1-5.1-5.1l2-2Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
            <a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a>
            <span aria-hidden="true">/</span>
            <a href={`tel:${contact.phone2}`}>{contact.phone2Display}</a>
          </span>
        </address>
      </div>
      <div class="site-footer__col site-footer__col--social">
        <ul class="site-footer__list">
          <li><a class="site-footer__social" href={zalo.href} target="_blank" rel="noopener" aria-label="Zalo">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={zalo.path} fill="currentColor" fill-rule="evenodd" /></svg>
            Zalo
          </a></li>
          {social.map(item => (
            <li><span class="site-footer__social" role="link" aria-disabled="true" aria-label={`${item.label} — ${t.noLink}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={item.path} fill="currentColor" fill-rule="evenodd" /></svg>
              {item.label}
            </span></li>
          ))}
        </ul>
        <a class="site-footer__mobile-top" href="#top" aria-label={t.top}><Arrow direction="up" /></a>
      </div>
    </div>

    <img class="site-footer__mobile-mountains" src="/mountain.png" width="356" height="142" alt="" aria-hidden="true" />
    <div class="site-footer__bottom">
      <div class="site-footer__legal" lang="vi">
        <p>{business.registration.map((item, i) => <>{i > 0 && <span class="site-footer__sep" aria-hidden="true"> · </span>}<span class="site-footer__reg">{item}</span></>)}</p>
        <p>{business.issuer}</p>
        <p lang={lang}>© {year} Hiền Nương Farm. {t.rights}</p>
      </div>
      <a class="site-footer__top-link" href="#top">
        {t.top} <Arrow direction="up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; isolation: isolate; overflow: hidden; }
  .site-footer__landscape { position: absolute; inset: auto 0 0; width: 100%; height: 15rem; color: var(--color-cream); opacity: 0.035; z-index: -1; pointer-events: none; }
  .site-footer__mountains { display: none; }
  .site-footer__social { display: inline-flex; align-items: center; gap: 0.75rem; min-height: 2.75rem; color: var(--color-text-inverse-muted); }
  .site-footer__social svg { width: 1rem; height: 1rem; flex: none; }
  .site-footer__list a { display: inline-flex; align-items: center; min-height: 2.75rem; }

  /* Dense, quiet close: one band of brand, links and contact over a hairline. */
  .site-footer {
    background: var(--color-deep-green);
    color: var(--color-cream);
    font-size: var(--type-small);
    font-weight: 400;
    line-height: 1.55;
  }

  .site-footer__top {
    /* One gap between a column's label (wordmark or heading) and its content. */
    --footer-label-gap: var(--space-xs);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .site-footer__line {
    margin-top: var(--footer-label-gap);
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-inverse-muted);
  }

  .site-footer__business {
    margin-top: var(--space-s);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-inverse-muted);
  }
  .site-footer__business-name { line-height: 1.6; }
  .site-footer__business-code { margin-top: 0.5rem; }

  .site-footer__heading {
    margin-bottom: var(--footer-label-gap);
    font-size: var(--type-eyebrow);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-inverse-muted);
  }

  .site-footer__list {
    display: grid;
    gap: 0.375rem;
    font-style: normal;
  }

  .site-footer__list a {
    transition: color 300ms var(--ease);
  }
  .site-footer__list a:hover { color: var(--color-text-inverse-muted); }

  .site-footer__col--nav .site-footer__list {
    grid-template-columns: repeat(2, max-content);
    column-gap: var(--space-l);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2xs) var(--space-l);
    padding-block: var(--space-xs);
    border-top: 1px solid var(--color-line-inverse);
    color: var(--color-text-inverse-muted);
    font-size: 0.75rem;
  }

  .site-footer__legal { line-height: 1.7; }
  .site-footer__legal span { white-space: pre; }
  /* Phones and tablets: one registration item per line instead of a wrapped run. */
  @media (max-width: 1023px) {
    .site-footer__sep { display: none; }
    .site-footer__reg { display: block; }
  }

  .site-footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    color: var(--color-cream);
  }
  .site-footer__top-link :global(.arrow) { width: 0.875rem; }

  @media (min-width: 768px) {
    .site-footer__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }
    .site-footer__brand { grid-column: 1 / span 12; }
    .site-footer__col--nav { grid-column: 1 / span 6; }
    .site-footer__col--contact { grid-column: 7 / span 6; }
    .site-footer__col--social { grid-column: 1 / span 6; }
  }

</style>
