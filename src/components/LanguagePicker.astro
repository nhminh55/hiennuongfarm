---
// One compact button for the header below desktop: the current language's
// flag and code; it opens the three languages. Desktop keeps the
// "VI | EN | CH" row (LanguageSwitch).
import { getLocale, isTranslated, languages, locales, localizePath, stripLocale, type Locale } from '../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const lang = getLocale(Astro.url);
const path = stripLocale(Astro.url.pathname);
const label = { vi: 'Ngôn ngữ', en: 'Language', zh: '语言' }[lang];
// Some published pages (viOnlyPaths) exist in Vietnamese only.
const untranslated = !isTranslated(path);

// Flags as small inline SVGs (3:2). English uses the United Kingdom flag.
const flags: Record<Locale, string> = {
  vi: '<rect width="30" height="20" fill="#DA251D"/><path d="M15 4.2l1.35 4.15h4.36l-3.53 2.56 1.35 4.15L15 12.5l-3.53 2.56 1.35-4.15-3.53-2.56h4.36z" fill="#FFFF00"/>',
  en: '<rect width="30" height="20" fill="#012169"/><path d="M0 0l30 20M30 0L0 20" stroke="#FFF" stroke-width="4"/><path d="M0 0l30 20M30 0L0 20" stroke="#C8102E" stroke-width="1.6"/><path d="M15 0v20M0 10h30" stroke="#FFF" stroke-width="6"/><path d="M15 0v20M0 10h30" stroke="#C8102E" stroke-width="3.4"/>',
  zh: '<rect width="30" height="20" fill="#EE1C25"/><path d="M5 2.4l.9 2.75h2.9L6.45 6.85l.9 2.75L5 7.9 2.65 9.6l.9-2.75L1.2 5.15h2.9z" fill="#FFFF00"/><circle cx="10" cy="2" r=".75" fill="#FFFF00"/><circle cx="12" cy="4" r=".75" fill="#FFFF00"/><circle cx="12" cy="7" r=".75" fill="#FFFF00"/><circle cx="10" cy="9" r=".75" fill="#FFFF00"/>',
};
---
<div class:list={['lang-pick', className]} data-lang-pick>
  <button class="lang-pick__button" type="button" aria-expanded="false" aria-controls="lang-pick-list" aria-label={`${label}: ${languages[lang].name}`} data-lang-pick-toggle>
    <svg class="lang-pick__flag" viewBox="0 0 30 20" aria-hidden="true" focusable="false" set:html={flags[lang]} />
    <span class="lang-pick__code">{languages[lang].label}</span>
    <svg class="lang-pick__chev" viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1" /></svg>
  </button>
  <ul class="lang-pick__list" id="lang-pick-list" aria-label={label} data-lang-pick-list hidden>
    {locales.map((code) => (
      <li>
        {untranslated && code !== lang ? (
          <span class="lang-pick__item lang-pick__item--off" lang={languages[code].htmlLang} aria-disabled="true">
            <svg class="lang-pick__flag" viewBox="0 0 30 20" aria-hidden="true" focusable="false" set:html={flags[code]} />
            <span class="lang-pick__code">{languages[code].label}</span>
            <span class="lang-pick__name">{languages[code].name}</span>
          </span>
        ) : (
          <a
            class="lang-pick__item"
            href={localizePath(path, code)}
            hreflang={languages[code].htmlLang}
            lang={languages[code].htmlLang}
            aria-current={code === lang ? 'true' : undefined}
          >
            <svg class="lang-pick__flag" viewBox="0 0 30 20" aria-hidden="true" focusable="false" set:html={flags[code]} />
            <span class="lang-pick__code">{languages[code].label}</span>
            <span class="lang-pick__name">{languages[code].name}</span>
          </a>
        )}
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-pick]').forEach((pick) => {
    const button = pick.querySelector<HTMLButtonElement>('[data-lang-pick-toggle]');
    const list = pick.querySelector<HTMLElement>('[data-lang-pick-list]');
    if (!button || !list) return;
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      list.hidden = !open;
    };
    button.addEventListener('click', () => set(list.hidden));
    document.addEventListener('click', (event) => {
      if (!list.hidden && !pick.contains(event.target as Node)) set(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || list.hidden) return;
      set(false);
      button.focus();
    });
  });
</script>

<style>
  .lang-pick { position: relative; }

  .lang-pick__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    /* Same width for VI, EN and CH, so the logo beside it never shifts. */
    width: 4.5rem;
    min-height: 2.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .lang-pick__flag {
    flex: none;
    width: 1.375rem;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(16, 43, 33, 0.12);
  }

  .lang-pick__chev {
    width: 0.5rem;
    height: auto;
    opacity: 0.7;
    transition: transform 300ms var(--ease);
  }
  .lang-pick__button[aria-expanded="true"] .lang-pick__chev { transform: rotate(180deg); }

  .lang-pick__list {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 3;
    min-width: 10.5rem;
    padding: 0.375rem;
    background: var(--color-paper);
    color: var(--color-charcoal);
    border: 1px solid var(--color-line);
    box-shadow: 0 16px 32px -16px rgba(16, 43, 33, 0.35);
  }

  .lang-pick__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.3;
    white-space: nowrap;
    transition: background-color 250ms var(--ease);
  }
  a.lang-pick__item:hover,
  a.lang-pick__item:focus-visible { background: var(--color-line); }
  .lang-pick__item .lang-pick__code { min-width: 1.5rem; font-weight: 500; letter-spacing: 0.06em; }
  .lang-pick__name { opacity: 0.7; }
  .lang-pick__item[aria-current] { font-weight: 500; }
  .lang-pick__item[aria-current] .lang-pick__name { opacity: 1; }
  .lang-pick__item--off { opacity: 0.35; cursor: default; }
</style>
