---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import { getLocale, languages, locales, localizePath, stripLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Transparent header over a full-bleed hero. */
  overlayHeader?: boolean;
  /** Keep the page out of search engines (unpublished scaffold pages). */
  noindex?: boolean;
}

const lang = getLocale(Astro.url);
const { title, description = site.description[lang], overlayHeader = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The same page in every language, for search engines.
const basePath = stripLocale(Astro.url.pathname);
const alternates = locales.map((l) => ({ hreflang: languages[l].htmlLang, href: new URL(localizePath(basePath, l), Astro.site) }));
const skipLabel = { vi: 'Bỏ qua đến nội dung chính', en: 'Skip to main content', zh: '跳到主要内容' }[lang];
---
<!doctype html>
<html lang={languages[lang].htmlLang} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <link rel="icon" type="image/png" href="/fav.png" />
    <meta name="theme-color" content="#173D2D" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600&family=Noto+Serif+Display:ital,wght@0,300..600;1,300..500&family=Lora:ital,wght@0,400..600;1,400..500&display=swap"
    />
    <!-- Chinese pages: the Latin faces above have no Chinese glyphs (see global.css :lang(zh)). -->
    {lang === 'zh' && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600&family=Noto+Serif+SC:wght@400;500;600&display=swap"
      />
    )}

    <script is:inline>
      let recovered = false;
      const recover = () => {
        recovered = true;
        clearTimeout(timer);
        document.documentElement.classList.remove('js');
      };
      const timer = setTimeout(recover, 3000);
      window.__hnReveal = {
        recover,
        complete: () => clearTimeout(timer),
        get recovered() { return recovered; },
      };
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <SiteHeader overlay={overlayHeader} />
    <main id="main" class:list={[{ 'main--offset': !overlayHeader }]}>
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Reveal-on-scroll for elements marked with [data-reveal].
      const reveal = (window as typeof window & {
        __hnReveal?: { recover: () => void; complete: () => void; readonly recovered: boolean };
      }).__hnReveal;
      if (reveal && !reveal.recovered) {
        let observer: IntersectionObserver | undefined;
        try {
          const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
          if ('IntersectionObserver' in window) {
            observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer?.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
            );
            targets.forEach((el) => observer!.observe(el));
          } else {
            targets.forEach((el) => el.classList.add('is-visible'));
          }
          reveal.complete();
        } catch {
          try {
            observer?.disconnect();
          } finally {
            reveal.recover();
          }
        }
      }
    </script>
  </body>
</html>
