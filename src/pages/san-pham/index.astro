---
/**
 * Sản phẩm — the showroom of the 12 products (src/data/showroom.ts).
 * One page; a product is selected by its slug in the URL hash
 * (/san-pham/#snack-nam-bao-ngu), so every product has a shareable link.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/page/Breadcrumb.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Arrow from '../../components/Arrow.astro';
import GameIcon from '../../components/farm-play/GameIcon.astro';
import Showroom from '../../components/showroom/Showroom.astro';
import ShowroomDetails from '../../components/showroom/ShowroomDetails.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import { showroomProducts } from '../../data/showroom';
import { getLocale, localizePath, pageHref } from '../../i18n';

const lang = getLocale(Astro.url);
const products = showroomProducts(lang);
const contactHref = pageHref('/hop-tac/', lang, '/#hop-tac');

const t = {
  vi: {
    pageTitle: 'Sản phẩm',
    home: 'Trang chủ',
    eyebrow: 'Sản vật từ trang trại',
    description: 'Mười hai sản phẩm của Hiền Nương Farm: bốn dòng nấm chính nuôi trồng tại vùng Bảy Núi, An Giang, cùng các sản phẩm chế biến từ chúng.',
    ctaTitle: 'Trao đổi về sản phẩm và hợp tác.',
    ctaBody: 'Liên hệ với Hiền Nương để trao đổi về sản phẩm, phân phối và các hình thức hợp tác từ những dòng nấm của trang trại.',
  },
  en: {
    pageTitle: 'Products',
    home: 'Home',
    eyebrow: 'Produce from the Farm',
    description: 'The twelve products of Hiền Nương Farm: four main mushroom lines grown in the Bảy Núi region of An Giang, Vietnam, and the products made from them.',
    ctaTitle: 'Talk with us about our products and partnership.',
    ctaBody: 'Contact Hiền Nương to discuss products, distribution and ways of partnering around the farm’s mushroom lines.',
  },
  zh: {
    pageTitle: '产品',
    home: '首页',
    eyebrow: '农场物产',
    description: 'Hiền Nương Farm 的十二款产品：种植于越南安江省七山地区的四类主要菌菇，以及由它们制成的产品。',
    ctaTitle: '洽谈产品与合作事宜。',
    ctaBody: '欢迎联系 Hiền Nương，洽谈产品、分销以及围绕农场菌菇的各种合作方式。',
  },
}[lang];
---
<BaseLayout title={t.pageTitle} description={t.description}>
  <header class="intro">
    <div class="container intro__grid">
      <Breadcrumb class="intro__crumbs" items={[{ label: t.home, href: localizePath('/', lang) }, { label: t.pageTitle }]} />
      <div class="intro__head">
        <Eyebrow>{t.eyebrow}</Eyebrow>
        <h1 class="sr-only" id="page-title">{t.pageTitle}</h1>
      </div>
      <div class="intro__text">
        {lang === 'vi' && (
          <a class="link-arrow intro__play" href="/choi-cung-nong-trai/hom-nay-an-nam-gi/" style="display:inline-flex;align-items:center;gap:0.5rem;white-space:nowrap"><GameIcon /> Ghé chơi: Hôm nay ăn nấm gì? <Arrow /></a>
        )}
      </div>
    </div>
  </header>

  <Showroom products={products}>
    <ShowroomDetails products={products} />
  </Showroom>

  <CtaBand title={t.ctaTitle} href={contactHref}>{t.ctaBody}</CtaBand>
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(1.25rem, 0.75rem + 1.5vw, 2.25rem);
    padding-bottom: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-s);
  }

  .intro__head { margin-top: var(--space-2xs); }

  @media (min-width: 1280px) {
    .intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      column-gap: var(--col-gap);
      align-items: center;
    }
    .intro__grid > :global(.intro__crumbs) { grid-column: 1 / -1; }
  }
</style>
