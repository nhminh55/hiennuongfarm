---
import { copy } from '../../data/copy';
/**
 * Sản phẩm — the showroom of the 12 products (src/data/showroom.ts).
 * One page; a product is selected by its slug in the URL hash
 * (/san-pham/#snack-nam-bao-ngu), so every product has a shareable link.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/page/Breadcrumb.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Arrow from '../../components/Arrow.astro';
import GameIcon from '../../components/farm-play/GameIcon.astro';
import Showroom from '../../components/showroom/Showroom.astro';
import ShowroomDetails from '../../components/showroom/ShowroomDetails.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import { showroomProducts } from '../../data/showroom';
import { getLocale, localizePath, pageHref } from '../../i18n';

const lang = getLocale(Astro.url);
const products = showroomProducts(lang);
const contactHref = pageHref('/hop-tac/', lang, '/#hop-tac');

const t = copy('san-pham/trang-san-pham', lang);
---
<BaseLayout title={t.pageTitle} description={t.description}>
  <header class="intro">
    <div class="container intro__grid">
      <Breadcrumb class="intro__crumbs" items={[{ label: t.home, href: localizePath('/', lang) }, { label: t.pageTitle }]} />
      <div class="intro__head">
        <Eyebrow>{t.eyebrow}</Eyebrow>
        <h1 class="sr-only" id="page-title">{t.pageTitle}</h1>
      </div>
      <div class="intro__text">
        {lang === 'vi' && (
          <a class="link-arrow intro__play" href="/choi-cung-nong-trai/hom-nay-an-nam-gi/" style="display:inline-flex;align-items:center;gap:0.5rem;white-space:nowrap"><GameIcon /> {t.play} <Arrow /></a>
        )}
      </div>
    </div>
  </header>

  <Showroom products={products}>
    <ShowroomDetails products={products} />
  </Showroom>

  <CtaBand title={t.ctaTitle} href={contactHref}>{t.ctaBody}</CtaBand>
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(1.25rem, 0.75rem + 1.5vw, 2.25rem);
    padding-bottom: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-s);
  }

  .intro__head { margin-top: var(--space-2xs); }

  @media (min-width: 1280px) {
    .intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      column-gap: var(--col-gap);
      align-items: center;
    }
    .intro__grid > :global(.intro__crumbs) { grid-column: 1 / -1; }
  }
</style>
