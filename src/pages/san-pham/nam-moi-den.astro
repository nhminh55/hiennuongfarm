---
/**
 * Nấm Mối Đen — canonical product page (Phase 2, Gate A).
 *
 * Copy follows CONTENT_EVIDENCE_BANK.md. The process photographs are frames
 * from the Hiền Nương Farm video and show the farm's general process, not
 * steps specific to this mushroom; the section says so. No technical
 * parameters, durations or yields are given because none are verified.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductHero from '../../components/product/ProductHero.astro';
import LabResults from '../../components/product/LabResults.astro';
import RelatedProducts from '../../components/product/RelatedProducts.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { products } from '../../data/products';
import { labReports } from '../../data/lab-reports';

const product = products.find((p) => p.slug === 'nam-moi-den')!;
const reports = labReports[product.slug] ?? [];

// Video frames (s): 96.0, 49.6, 68.6. Cropped above the burned-in subtitles
// (and, for 68.6, clear of the split-screen seam).
const steps = [
  {
    title: 'Chuẩn bị giá thể',
    text: 'Rơm và các phụ phẩm nông nghiệp tại địa phương được tận dụng để tạo giá thể trồng nấm.',
    ratio: '32 / 15',
    image: {
      src: '/images/farm/process-gia-the.webp',
      width: 1280,
      height: 600,
      alt: 'Những người làm nấm ngồi quanh một đống giá thể màu nâu trong xưởng, bên cạnh các bịch giá thể đang được đóng',
    },
  },
  {
    title: 'Đóng bịch',
    text: 'Giá thể được đóng vào bịch, đậy nắp và xếp vào khay sắt.',
    ratio: '4 / 3',
    image: {
      src: '/images/farm/process-dong-bich.webp',
      width: 800,
      height: 600,
      alt: 'Đôi tay đặt một bịch giá thể vào khay sắt cùng các bịch đã đậy nắp xanh',
    },
  },
  {
    title: 'Nuôi trồng trên kệ',
    text: 'Các bịch được xếp thành từng dãy trên kệ trong nhà trồng.',
    ratio: '4 / 5',
    image: {
      src: '/images/farm/process-ke-nuoi.webp',
      width: 380,
      height: 475,
      alt: 'Những dãy bịch nấm có nắp xanh xếp kín trên các tầng kệ sắt trong nhà trồng',
    },
  },
  {
    title: 'Chăm sóc và thu hái',
    text: 'Người làm nấm theo dõi các bịch trên kệ cho đến khi nấm được thu hái.',
  },
  {
    title: 'Tái sử dụng giá thể',
    text: 'Sau mỗi vòng trồng nấm, giá thể tiếp tục được tận dụng trong các công đoạn nông nghiệp khác, như nuôi trùn quế và tạo phân hữu cơ.',
  },
];

const num = (i: number) => String(i + 1).padStart(2, '0');
---
<BaseLayout
  title="Nấm Mối Đen"
  description="Nấm mối đen — một trong bốn dòng nấm chính của Hiền Nương Farm, nuôi trồng tại vùng Bảy Núi, An Giang."
>
  <ProductHero product={product} origin="Nuôi trồng tại trang trại Hiền Nương, vùng Bảy Núi – An Giang.">
    Một trong bốn dòng nấm chính của Hiền Nương, nấm mối đen được nuôi trồng từ bịch giá thể tại
    trang trại, trong mô hình nông nghiệp gắn với nguồn nguyên liệu của địa phương.
  </ProductHero>

  <!-- Introduction ------------------------------------------------------>
  <section class="section intro" id="gioi-thieu" aria-labelledby="intro-title">
    <div class="container grid intro__grid">
      <figure class="intro__figure">
        <!-- Video frame 01:17.5. -->
        <Photo
          class="intro__photo"
          src="/images/farm/process-cham-soc.webp"
          width={800}
          height={600}
          ratio="4 / 3"
          alt="Hai người mặc áo blouse trắng cùng xem một bịch giá thể giữa các kệ bịch nấm trong nhà trồng"
        />
        <figcaption class="intro__caption">Kiểm tra bịch nấm trong nhà trồng của trang trại.</figcaption>
      </figure>

      <div class="intro__story">
        <div data-reveal>
          <Eyebrow>Giới thiệu</Eyebrow>
          <h2 class="h2 intro__title" id="intro-title">Một trong bốn dòng nấm chính của trang trại.</h2>
          <p class="body intro__body">
            Bên cạnh nấm linh chi, đông trùng hạ thảo và nấm bào ngư, nấm mối đen là một trong bốn
            dòng nấm chính mà Hiền Nương nuôi trồng tại vùng Bảy Núi, An Giang.
          </p>
          <p class="body">
            Từ vùng Bảy Núi, chị Châu Thị Nương phát triển mô hình trồng nấm gắn với nguồn nguyên
            liệu nông nghiệp tại địa phương.
          </p>
        </div>

        <dl class="facts" data-reveal>
          <div>
            <dt class="facts__label">Dòng sản phẩm</dt>
            <dd class="facts__value">Một trong bốn dòng nấm chính</dd>
          </div>
          <div>
            <dt class="facts__label">Vùng nuôi trồng</dt>
            <dd class="facts__value">Bảy Núi, An Giang</dd>
          </div>
          <div>
            <dt class="facts__label">Mô hình</dt>
            <dd class="facts__value">Nông nghiệp tuần hoàn</dd>
          </div>
          <div>
            <dt class="facts__label">Kiểm nghiệm mẫu</dt>
            <dd class="facts__value"><a href="#kiem-nghiem">VietLabs, 2023</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Process ------------------------------------------------------------>
  <section class="section process" id="quy-trinh" aria-labelledby="process-title">
    <div class="container grid process__grid">
      <div class="process__head" data-reveal>
        <Eyebrow class="process__eyebrow">Quy trình tại trang trại</Eyebrow>
        <h2 class="h2 process__title" id="process-title">Từ phụ phẩm nông nghiệp đến những bịch nấm trên kệ.</h2>
      </div>

      <ol class="steps">
        {steps.map((step, i) => (
          <li class:list={['step', `step--${i + 1}`, { 'step--text': !step.image }]}>
            {step.image && (
              <Photo
                class="step__photo"
                src={step.image.src}
                width={step.image.width}
                height={step.image.height}
                ratio={step.ratio}
                alt={step.image.alt}
              />
            )}
            <div class="step__text" data-reveal>
              <span class="step__num">{num(i)}</span>
              <h3 class="h3 step__title">{step.title}</h3>
              <p class="step__body">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="process__note">
        Hình ảnh trích từ video giới thiệu của Hiền Nương Farm, ghi lại quy trình chung tại trang
        trại.
      </p>
    </div>
  </section>

  <!-- People ------------------------------------------------------------->
  <section class="section people" aria-labelledby="people-title">
    <div class="container grid people__grid">
      <div class="people__head" data-reveal>
        <Eyebrow>Con người</Eyebrow>
        <h2 class="h2 people__title" id="people-title">Qua bàn tay của những người làm nấm.</h2>
        <p class="body people__body">
          Từ đóng bịch đến chăm sóc trên kệ, mỗi công đoạn tại trang trại đều qua bàn tay của
          người làm nấm.
        </p>
      </div>

      <!-- Video frames 02:06.0 and 02:00.0. -->
      <Photo
        class="people__photo people__photo--a"
        src="/images/farm/people-nguoi-lam-nam.webp"
        width={480}
        height={600}
        ratio="4 / 5"
        alt="Một người phụ nữ đội nón xanh, mặc áo lao động xanh đậm, mỉm cười khi làm việc trong xưởng"
      />
      <Photo
        class="people__photo people__photo--b"
        src="/images/farm/people-xuong-phoi.webp"
        width={480}
        height={600}
        ratio="4 / 5"
        alt="Một người đàn ông lớn tuổi đội mũ lưỡi trai, mặc áo xanh đậm, ngồi trước các giá sắt trong xưởng"
      />
    </div>
  </section>

  {reports.length > 0 && (
    <LabResults reports={reports}>
      Tên mẫu ghi trên báo cáo là “Nấm mối”.
    </LabResults>
  )}

  <RelatedProducts current={product.slug} />

  <CtaBand title="Trao đổi về nấm mối đen và hợp tác.">
    Liên hệ với Hiền Nương để trao đổi về sản phẩm, phân phối và các hình thức hợp tác từ những
    dòng nấm của trang trại.
  </CtaBand>
</BaseLayout>

<style>
  /* Introduction -------------------------------------------------------- */

  .intro { border-top: 1px solid var(--color-line); }

  .intro__grid { row-gap: var(--space-xl); }

  .intro__figure,
  .intro__story { grid-column: 1 / -1; }

  .intro__caption {
    margin-top: var(--space-s);
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .intro__title { margin-top: var(--space-l); max-width: 16ch; }
  .intro__body { margin-top: var(--space-m); }
  .intro__story .body { max-width: 32rem; }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--col-gap);
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--color-line);
  }

  .facts__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .facts__value {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1875rem, 1rem + 0.9vw, 1.5rem);
    line-height: 1.25;
  }

  .facts__value a {
    border-bottom: 1px solid var(--color-line-strong);
    transition: border-color 300ms var(--ease);
  }
  .facts__value a:hover { border-color: currentColor; }

  @media (min-width: 768px) {
    .intro__figure { grid-column: 1 / span 9; }
  }

  /* Photograph bleeds off the left edge, mirroring the hero. */
  @media (min-width: 1024px) {
    .intro__figure { grid-column: 1 / span 6; }
    .intro__figure :global(.intro__photo) {
      margin-left: calc(-1 * max(var(--gutter), (100vw - var(--container)) / 2));
    }
    .intro__story {
      grid-column: 8 / span 5;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);
    }
    .facts { margin-top: auto; }
  }

  /* Process ------------------------------------------------------------- */

  .process {
    background: var(--color-forest);
    color: var(--color-cream);
  }

  .process :global(.process__eyebrow) { color: var(--color-text-inverse-muted); }

  .process__grid { row-gap: var(--space-2xl); }

  .process__head,
  .steps,
  .process__note { grid-column: 1 / -1; }

  .process__title { margin-top: var(--space-l); max-width: 18ch; }

  .steps {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: var(--space-2xl);
  }

  .step { grid-column: 1 / -1; }

  .step__text { margin-top: var(--space-m); }

  /* Below desktop the wide first frame is cropped taller, on the people and the pile. */
  .step--1 :global(.step__photo) {
    aspect-ratio: 3 / 2;
    --pos: 42% 50%;
  }

  .step__num {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-text-inverse-muted);
    font-variant-numeric: tabular-nums;
  }

  .step__title { margin-top: 0.5rem; }

  .step__body {
    margin-top: var(--space-xs);
    max-width: 28rem;
    color: var(--color-text-inverse-muted);
    text-wrap: pretty;
  }

  /* Steps without a photograph close the sequence under a thin rule. */
  .step--text { padding-top: var(--space-m); border-top: 1px solid var(--color-line-inverse); }
  .step--text .step__text { margin-top: 0; }

  .process__note {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-text-inverse-muted);
  }

  @media (min-width: 768px) {
    .step--2 { grid-column: 1 / span 6; }
    .step--3 { grid-column: 7 / span 6; margin-top: var(--space-2xl); }
    .step--4 { grid-column: 1 / span 6; }
    .step--5 { grid-column: 7 / span 6; }
  }

  @media (min-width: 1024px) {
    .process__head { grid-column: 1 / span 7; }

    /* The first step is a wide spread: photograph left, text set low right. */
    .step--1 {
      display: grid;
      grid-template-columns: subgrid;
      align-items: end;
    }
    .step--1 :global(.step__photo) { grid-column: 1 / span 8; aspect-ratio: 32 / 15; }
    .step--1 .step__text { grid-column: 9 / span 4; margin-top: 0; }

    .step--2 { grid-column: 2 / span 5; }
    .step--3 { grid-column: 8 / span 4; margin-top: var(--space-3xl); }

    .step--4 { grid-column: 2 / span 5; }
    .step--5 { grid-column: 8 / span 5; }

    .process__note { grid-column: 2 / span 8; }
  }

  /* People -------------------------------------------------------------- */

  .people__grid { row-gap: var(--space-xl); }

  .people__head { grid-column: 1 / -1; }
  .people__title { margin-top: var(--space-l); max-width: 14ch; }
  .people__body { margin-top: var(--space-m); max-width: 26rem; }

  /* Phones and tablets: the two portraits side by side, the second set lower. */
  .people__grid > :global(.people__photo--a) { grid-column: 1 / span 6; }
  .people__grid > :global(.people__photo--b) { grid-column: 7 / span 6; margin-top: var(--space-xl); }

  @media (min-width: 1024px) {
    .people__head { grid-column: 1 / span 4; grid-row: 1; align-self: end; }
    .people__grid > :global(.people__photo--a) { grid-column: 6 / span 3; grid-row: 1; }
    .people__grid > :global(.people__photo--b) {
      grid-column: 10 / span 3;
      grid-row: 1;
      margin-top: var(--space-3xl);
    }
  }
</style>
