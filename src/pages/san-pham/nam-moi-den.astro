---
/**
 * Nấm Mối Đen — canonical product page (Phase 2, Gate A).
 *
 * Copy follows CONTENT_EVIDENCE_BANK.md. The process photographs are frames
 * from the Hiền Nương Farm video and show the farm's general process, not
 * steps specific to this mushroom; the section says so. No technical
 * parameters, durations or yields are given because none are verified.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductHero from '../../components/product/ProductHero.astro';
import LabResults from '../../components/product/LabResults.astro';
import RelatedProducts from '../../components/product/RelatedProducts.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { localizedProducts } from '../../data/products';
import { labReports } from '../../data/lab-reports';
import { getLocale } from '../../i18n';

const lang = getLocale(Astro.url);
const product = localizedProducts(lang).find((p) => p.slug === 'nam-moi-den')!;
const reports = labReports[product.slug] ?? [];

const t = {
  vi: {
    steps: [
      ['Chuẩn bị giá thể', 'Rơm và các phụ phẩm nông nghiệp tại địa phương được tận dụng để tạo giá thể trồng nấm.'],
      ['Đóng bịch', 'Giá thể được đóng vào bịch, đậy nắp và xếp vào khay sắt.'],
      ['Nuôi trồng trên kệ', 'Các bịch được xếp thành từng dãy trên kệ trong nhà trồng.'],
      ['Chăm sóc và thu hái', 'Người làm nấm theo dõi các bịch trên kệ cho đến khi nấm được thu hái.'],
      ['Tái sử dụng giá thể', 'Sau mỗi vòng trồng nấm, giá thể tiếp tục được tận dụng trong các công đoạn nông nghiệp khác, như nuôi trùn quế và tạo phân hữu cơ.'],
    ],
    stepAlts: [
      'Những người làm nấm ngồi quanh một đống giá thể màu nâu trong xưởng, bên cạnh các bịch giá thể đang được đóng',
      'Đôi tay đặt một bịch giá thể vào khay sắt cùng các bịch đã đậy nắp xanh',
      'Những dãy bịch nấm có nắp xanh xếp kín trên các tầng kệ sắt trong nhà trồng',
    ],
    description: 'Nấm mối đen — một trong bốn dòng nấm chính của Hiền Nương Farm, nuôi trồng tại vùng Bảy Núi, An Giang.',
    origin: 'Nuôi trồng tại trang trại Hiền Nương, vùng Bảy Núi – An Giang.',
    heroBody: 'Một trong bốn dòng nấm chính của Hiền Nương, nấm mối đen được nuôi trồng từ bịch giá thể tại trang trại, trong mô hình nông nghiệp gắn với nguồn nguyên liệu của địa phương.',
    introAlt: 'Hai người mặc áo blouse trắng cùng xem một bịch giá thể giữa các kệ bịch nấm trong nhà trồng',
    introCaption: 'Kiểm tra bịch nấm trong nhà trồng của trang trại.',
    introEyebrow: 'Giới thiệu',
    introTitle: 'Một trong bốn dòng nấm chính của trang trại.',
    introBody: [
      'Bên cạnh nấm linh chi, đông trùng hạ thảo và nấm bào ngư, nấm mối đen là một trong bốn dòng nấm chính mà Hiền Nương nuôi trồng tại vùng Bảy Núi, An Giang.',
      'Từ vùng Bảy Núi, chị Châu Thị Nương phát triển mô hình trồng nấm gắn với nguồn nguyên liệu nông nghiệp tại địa phương.',
    ],
    facts: ['Dòng sản phẩm', 'Một trong bốn dòng nấm chính', 'Vùng nuôi trồng', 'Bảy Núi, An Giang', 'Mô hình', 'Nông nghiệp tuần hoàn', 'Kiểm nghiệm mẫu', 'VietLabs, 2023'],
    processEyebrow: 'Quy trình tại trang trại',
    processTitle: 'Từ phụ phẩm nông nghiệp đến những bịch nấm trên kệ.',
    processNote: 'Hình ảnh trích từ video giới thiệu của Hiền Nương Farm, ghi lại quy trình chung tại trang trại.',
    peopleEyebrow: 'Con người',
    peopleTitle: 'Qua bàn tay của những người làm nấm.',
    peopleBody: 'Từ đóng bịch đến chăm sóc trên kệ, mỗi công đoạn tại trang trại đều qua bàn tay của người làm nấm.',
    peopleAlts: [
      'Những người làm nấm mặc áo lao động xanh đậm, đeo găng tay hồng, ngồi trên nền xưởng đóng giá thể vào bịch',
      'Một người phụ nữ mặc áo hồng, quàng khăn rằn, đeo găng tay đặt tay lên các bịch nấm trên kệ trong nhà trồng',
    ],
    labNote: 'Tên mẫu ghi trên báo cáo là “Nấm mối”.',
    ctaTitle: 'Trao đổi về nấm mối đen và hợp tác.',
    ctaBody: 'Liên hệ với Hiền Nương để trao đổi về sản phẩm, phân phối và các hình thức hợp tác từ những dòng nấm của trang trại.',
  },
  en: {
    steps: [
      ['Preparing the substrate', 'Rice straw and other local agricultural by-products are used to make the substrate for growing mushrooms.'],
      ['Bagging', 'The substrate is packed into bags, capped and set in steel trays.'],
      ['Growing on shelves', 'The bags are lined up in rows on shelves in the grow house.'],
      ['Tending and harvesting', 'The growers watch over the bags on the shelves until the mushrooms are harvested.'],
      ['Reusing the substrate', 'After each growing cycle, the substrate goes on to be used in other farm work, such as raising earthworms and making organic fertiliser.'],
    ],
    stepAlts: [
      'Mushroom growers sitting around a pile of brown substrate in a workshop, beside substrate bags being filled',
      'Hands placing a substrate bag into a steel tray with other bags already closed with green caps',
      'Rows of green-capped mushroom bags packed onto tiers of steel shelving in a grow house',
    ],
    description: 'Black termite mushroom — one of Hiền Nương Farm’s four main mushroom lines, grown in the Bảy Núi region of An Giang, Vietnam.',
    origin: 'Grown at the Hiền Nương farm, in the Bảy Núi region of An Giang.',
    heroBody: 'One of Hiền Nương’s four main mushroom lines, black termite mushroom is grown from substrate bags on the farm, in a farming model tied to local materials.',
    introAlt: 'Two people in white coats looking at a substrate bag together between shelves of mushroom bags in a grow house',
    introCaption: 'Checking mushroom bags in the farm’s grow house.',
    introEyebrow: 'Introduction',
    introTitle: 'One of the farm’s four main mushroom lines.',
    introBody: [
      'Alongside lingzhi, cordyceps and oyster mushroom, black termite mushroom is one of the four main mushroom lines Hiền Nương grows in the Bảy Núi region of An Giang.',
      'From the Bảy Núi region, Ms. Châu Thị Nương has developed a way of growing mushrooms tied to local agricultural materials.',
    ],
    facts: ['Product line', 'One of four main mushroom lines', 'Growing region', 'Bảy Núi, An Giang', 'Model', 'Circular agriculture', 'Sample testing', 'VietLabs, 2023'],
    processEyebrow: 'Process at the farm',
    processTitle: 'From agricultural by-products to mushroom bags on the shelf.',
    processNote: 'Images are taken from Hiền Nương Farm’s introductory video and show the farm’s general process.',
    peopleEyebrow: 'People',
    peopleTitle: 'Through the hands of the mushroom growers.',
    peopleBody: 'From bagging to tending the shelves, every stage at the farm passes through the hands of the people who grow the mushrooms.',
    peopleAlts: [
      'Mushroom growers in dark green work clothes and pink gloves, sitting on the workshop floor packing substrate into bags',
      'A woman in a pink shirt and a checked khăn rằn scarf, wearing gloves, resting her hands on mushroom bags on a shelf in a grow house',
    ],
    labNote: 'The sample name on the report is “Nấm mối” (termite mushroom).',
    ctaTitle: 'Talk with us about black termite mushroom and partnership.',
    ctaBody: 'Contact Hiền Nương to discuss products, distribution and ways of partnering around the farm’s mushroom lines.',
  },
  zh: {
    steps: [
      ['制备基质', '利用当地的稻草和其他农业副产品制作种菇基质。'],
      ['装袋', '将基质装入菌袋，盖好盖子，放进铁托盘。'],
      ['上架培育', '菌袋在种植棚内的架子上排成一列列。'],
      ['照料与采收', '种菇人照看架上的菌袋，直到菌菇采收。'],
      ['基质再利用', '每一季种菇结束后，基质继续用于其他农业环节，如养殖蚯蚓和制作有机肥。'],
    ],
    stepAlts: [
      '种菇人围坐在车间里一堆褐色基质旁，旁边是正在装填的基质袋',
      '双手将一个基质袋放进铁托盘，旁边是已盖上绿色盖子的菌袋',
      '种植棚内层层铁架上摆满了绿色盖子的菌袋',
    ],
    description: '黑皮鸡枞菌——Hiền Nương Farm 四类主要菌菇之一，种植于越南安江省七山地区。',
    origin: '种植于安江省七山地区的 Hiền Nương 农场。',
    heroBody: '黑皮鸡枞菌是 Hiền Nương 四类主要菌菇之一，在农场以基质袋种植，所采用的农业模式与当地原料紧密相连。',
    introAlt: '两位身穿白大褂的人在种植棚的菌袋架之间一起查看一个基质袋',
    introCaption: '在农场种植棚内检查菌袋。',
    introEyebrow: '简介',
    introTitle: '农场四类主要菌菇之一。',
    introBody: [
      '除灵芝、蛹虫草和平菇外，黑皮鸡枞菌也是 Hiền Nương 在安江省七山地区种植的四类主要菌菇之一。',
      'Châu Thị Nương 女士在七山地区发展了与当地农业原料相结合的种菇模式。',
    ],
    facts: ['产品类别', '四类主要菌菇之一', '种植地区', '安江省七山', '模式', '循环农业', '样品检测', 'VietLabs，2023'],
    processEyebrow: '农场流程',
    processTitle: '从农业副产品到架上的菌袋。',
    processNote: '图片截取自 Hiền Nương Farm 的介绍影片，记录的是农场的一般流程。',
    peopleEyebrow: '人物',
    peopleTitle: '经由种菇人之手。',
    peopleBody: '从装袋到架上照料，农场的每一道工序都经由种菇人亲手完成。',
    peopleAlts: [
      '身穿深绿色工作服、戴粉色手套的种菇人坐在车间地上，将基质装入菌袋',
      '一位身穿粉色上衣、围着格子头巾、戴着手套的女士，把手放在种植棚架子上的菌袋上',
    ],
    labNote: '报告上的样品名称为“Nấm mối”。',
    ctaTitle: '洽谈黑皮鸡枞菌与合作事宜。',
    ctaBody: '欢迎联系 Hiền Nương，洽谈产品、分销以及围绕农场菌菇的各种合作方式。',
  },
}[lang];

// Video frames (s): 96.0, 49.6, 68.6. Cropped above the burned-in subtitles
// (and, for 68.6, clear of the split-screen seam).
const images = [
  { ratio: '32 / 15', src: '/images/farm/process-gia-the.webp', width: 1280, height: 600 },
  { ratio: '4 / 3', src: '/images/farm/process-dong-bich.webp', width: 800, height: 600 },
  { ratio: '4 / 5', src: '/images/farm/process-ke-nuoi.webp', width: 380, height: 475 },
];
const steps = t.steps.map(([title, text], i) => {
  const img = images[i];
  return {
    title,
    text,
    ratio: img?.ratio,
    image: img && { src: img.src, width: img.width, height: img.height, alt: t.stepAlts[i] },
  };
});

const num = (i: number) => String(i + 1).padStart(2, '0');
---
<BaseLayout
  title={product.name}
  description={t.description}
>
  <ProductHero product={product} origin={t.origin}>{t.heroBody}</ProductHero>

  <!-- Introduction ------------------------------------------------------>
  <section class="section intro" id="gioi-thieu" aria-labelledby="intro-title">
    <div class="container grid intro__grid">
      <figure class="intro__figure">
        <!-- Video frame 01:17.5. -->
        <Photo
          class="intro__photo"
          src="/images/farm/process-cham-soc.webp"
          width={800}
          height={600}
          ratio="4 / 3"
          alt={t.introAlt}
        />
        <figcaption class="intro__caption">{t.introCaption}</figcaption>
      </figure>

      <div class="intro__story">
        <div data-reveal>
          <Eyebrow>{t.introEyebrow}</Eyebrow>
          <h2 class="h2 intro__title" id="intro-title">{t.introTitle}</h2>
          <p class="body intro__body">{t.introBody[0]}</p>
          <p class="body">{t.introBody[1]}</p>
        </div>

        <dl class="facts" data-reveal>
          <div>
            <dt class="facts__label">{t.facts[0]}</dt>
            <dd class="facts__value">{t.facts[1]}</dd>
          </div>
          <div>
            <dt class="facts__label">{t.facts[2]}</dt>
            <dd class="facts__value">{t.facts[3]}</dd>
          </div>
          <div>
            <dt class="facts__label">{t.facts[4]}</dt>
            <dd class="facts__value">{t.facts[5]}</dd>
          </div>
          <div>
            <dt class="facts__label">{t.facts[6]}</dt>
            <dd class="facts__value"><a href="#kiem-nghiem">{t.facts[7]}</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Process ------------------------------------------------------------>
  <section class="section process" id="quy-trinh" aria-labelledby="process-title">
    <div class="container grid process__grid">
      <div class="process__head" data-reveal>
        <Eyebrow class="process__eyebrow">{t.processEyebrow}</Eyebrow>
        <h2 class="h2 process__title" id="process-title">{t.processTitle}</h2>
      </div>

      <ol class="steps">
        {steps.map((step, i) => (
          <li class:list={['step', `step--${i + 1}`, { 'step--text': !step.image }]}>
            {step.image && (
              <Photo
                class="step__photo"
                src={step.image.src}
                width={step.image.width}
                height={step.image.height}
                ratio={step.ratio}
                alt={step.image.alt}
              />
            )}
            <div class="step__text" data-reveal>
              <span class="step__num">{num(i)}</span>
              <h3 class="h3 step__title">{step.title}</h3>
              <p class="step__body">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="process__note">{t.processNote}</p>
    </div>
  </section>

  <!-- People ------------------------------------------------------------->
  <section class="section people" aria-labelledby="people-title">
    <div class="container grid people__grid">
      <div class="people__head" data-reveal>
        <Eyebrow>{t.peopleEyebrow}</Eyebrow>
        <h2 class="h2 people__title" id="people-title">{t.peopleTitle}</h2>
        <p class="body people__body">{t.peopleBody}</p>
      </div>

      <!-- Collection photos HN-033 (filling bags) and HN-023 (grow-room shelves),
           in the order of the copy above. HN-023 is cropped above its watermark. -->
      <Photo
        class="people__photo people__photo--a"
        src="/images/farm/people-dong-bich.webp"
        width={720}
        height={900}
        ratio="4 / 5"
        alt={t.peopleAlts[0]}
      />
      <Photo
        class="people__photo people__photo--b"
        src="/images/farm/people-nha-trong.webp"
        width={720}
        height={900}
        ratio="4 / 5"
        alt={t.peopleAlts[1]}
      />
    </div>
  </section>

  {reports.length > 0 && (
    <LabResults reports={reports}>{t.labNote}</LabResults>
  )}

  <RelatedProducts current={product.slug} />

  <CtaBand title={t.ctaTitle}>{t.ctaBody}</CtaBand>
</BaseLayout>

<style>
  /* Introduction -------------------------------------------------------- */

  .intro { border-top: 1px solid var(--color-line); }

  .intro__grid { row-gap: var(--space-xl); }

  .intro__figure,
  .intro__story { grid-column: 1 / -1; }

  .intro__caption {
    margin-top: var(--space-s);
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .intro__title { margin-top: var(--space-l); max-width: 16ch; }
  .intro__body { margin-top: var(--space-m); }
  .intro__story .body { max-width: 32rem; }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--col-gap);
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--color-line);
  }

  .facts__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .facts__value {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1875rem, 1rem + 0.9vw, 1.5rem);
    line-height: 1.25;
  }

  .facts__value a {
    border-bottom: 1px solid var(--color-line-strong);
    transition: border-color 300ms var(--ease);
  }
  .facts__value a:hover { border-color: currentColor; }

  @media (min-width: 768px) {
    .intro__figure { grid-column: 1 / span 9; }
  }

  /* Photograph bleeds off the left edge, mirroring the hero. */
  @media (min-width: 1024px) {
    .intro__figure { grid-column: 1 / span 6; }
    .intro__figure :global(.intro__photo) {
      margin-left: calc(-1 * max(var(--gutter), (100vw - var(--container)) / 2));
    }
    .intro__story {
      grid-column: 8 / span 5;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);
    }
    .facts { margin-top: auto; }
  }

  /* Process ------------------------------------------------------------- */

  .process {
    background: var(--color-forest);
    color: var(--color-cream);
  }

  .process :global(.process__eyebrow) { color: var(--color-text-inverse-muted); }

  .process__grid { row-gap: var(--space-2xl); }

  .process__head,
  .steps,
  .process__note { grid-column: 1 / -1; }

  .process__title { margin-top: var(--space-l); max-width: 18ch; }

  .steps {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: var(--space-2xl);
  }

  .step { grid-column: 1 / -1; }

  .step__text { margin-top: var(--space-m); }

  /* Below desktop the wide first frame is cropped taller, on the people and the pile. */
  .step--1 :global(.step__photo) {
    aspect-ratio: 3 / 2;
    --pos: 42% 50%;
  }

  .step__num {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-text-inverse-muted);
    font-variant-numeric: tabular-nums;
  }

  .step__title { margin-top: 0.5rem; }

  .step__body {
    margin-top: var(--space-xs);
    max-width: 28rem;
    color: var(--color-text-inverse-muted);
    text-wrap: pretty;
  }

  /* Steps without a photograph close the sequence under a thin rule. */
  .step--text { padding-top: var(--space-m); border-top: 1px solid var(--color-line-inverse); }
  .step--text .step__text { margin-top: 0; }

  .process__note {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-text-inverse-muted);
  }

  @media (min-width: 768px) {
    .step--2 { grid-column: 1 / span 6; }
    .step--3 { grid-column: 7 / span 6; margin-top: var(--space-2xl); }
    .step--4 { grid-column: 1 / span 6; }
    .step--5 { grid-column: 7 / span 6; }
  }

  @media (min-width: 1024px) {
    .process__head { grid-column: 1 / span 7; }

    /* The first step is a wide spread: photograph left, text set low right. */
    .step--1 {
      display: grid;
      grid-template-columns: subgrid;
      align-items: end;
    }
    .step--1 :global(.step__photo) { grid-column: 1 / span 8; aspect-ratio: 32 / 15; }
    .step--1 .step__text { grid-column: 9 / span 4; margin-top: 0; }

    .step--2 { grid-column: 2 / span 5; }
    .step--3 { grid-column: 8 / span 4; margin-top: var(--space-3xl); }

    .step--4 { grid-column: 2 / span 5; }
    .step--5 { grid-column: 8 / span 5; }

    .process__note { grid-column: 2 / span 8; }
  }

  /* People -------------------------------------------------------------- */

  .people__grid { row-gap: var(--space-xl); }

  .people__head { grid-column: 1 / -1; }
  .people__title { margin-top: var(--space-l); max-width: 14ch; }
  .people__body { margin-top: var(--space-m); max-width: 26rem; }

  /* Phones and tablets: the two portraits side by side, the second set lower. */
  .people__grid > :global(.people__photo--a) { grid-column: 1 / span 6; }
  .people__grid > :global(.people__photo--b) { grid-column: 7 / span 6; margin-top: var(--space-xl); }

  @media (min-width: 1024px) {
    .people__head { grid-column: 1 / span 4; grid-row: 1; align-self: end; }
    .people__grid > :global(.people__photo--a) { grid-column: 6 / span 3; grid-row: 1; }
    .people__grid > :global(.people__photo--b) {
      grid-column: 10 / span 3;
      grid-row: 1;
      margin-top: var(--space-3xl);
