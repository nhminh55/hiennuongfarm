---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import Cycle from '../components/home/Cycle.astro';
import Products from '../components/home/Products.astro';
import BayNui from '../components/home/BayNui.astro';
import Partner from '../components/home/Partner.astro';
---
<BaseLayout overlayHeader>
  <div class="home">
    <Hero />
    <About />
    <Cycle />
    <Products />
    <BayNui />
    <Partner />
  </div>
</BaseLayout>

<style>
  /* Homepage section spacing, set for 100% browser zoom on laptop screens. */
  .home {
    /* Homepage display serif: Lora (Vietnamese subset via Google Fonts) — a
       calmer, contemporary serif with clean stacked diacritics. */
    --font-display: var(--font-editorial);
    --section-y: clamp(3rem, 1.5rem + 4vw, 5.5rem);
  }

  @media (min-width: 1024px) {
    .home { --section-y: clamp(3rem, 1rem + 3vw, 4.5rem); }
  }

  .home :global(section[id]) {
    scroll-margin-top: calc(var(--header-h) + var(--space-m));
  }

  /* Type roles. Sizes are the --type-* tokens (global.css); each role's
     line height, weight and tracking are set once here. Product titles and
     the hero headline have one element each and take their tokens in
     Products.astro and Hero.astro. */
  .home :global(.h2) {
    font-size: var(--type-h2);
    line-height: 1.12;
    font-weight: 500;
  }

  .home :global(.lead) {
    font-family: var(--font-display);
    font-size: var(--type-lead);
    line-height: 1.45;
    font-weight: 400;
  }

  .home :global(.body) {
    font-size: var(--type-body);
    line-height: 1.65;
    font-weight: 400;
  }

  .home :global(.small) {
    font-size: var(--type-small);
    line-height: 1.55;
    font-weight: 400;
  }

  .home :global(.eyebrow) {
    font-family: var(--font-body);
    font-size: var(--type-eyebrow);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  @media (max-width: 479px) {
    .home :global(.eyebrow) { letter-spacing: 0.16em; }
  }

  .home :global(:is(.btn, .link-arrow, .cta-label)) {
    font-family: var(--font-body);
    font-size: var(--type-cta);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
