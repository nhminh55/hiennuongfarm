---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import Cycle from '../components/home/Cycle.astro';
import Products from '../components/home/Products.astro';
import BayNui from '../components/home/BayNui.astro';
import Partner from '../components/home/Partner.astro';
import Press from '../components/home/Press.astro';
---
<BaseLayout overlayHeader>
  <div class="home">
    <Hero />
    <About />
    <Cycle />
    <Products />
    <BayNui />
    <Press />
    <Partner />
  </div>
</BaseLayout>

<style>
  /* Homepage text keeps the body defaults; sections set each type role
     (global.css). */
  .home {
    font-size: var(--fs-body);
    font-weight: 300;
    line-height: var(--lh-body);
  }

  .home :global(section[id]) {
    scroll-margin-top: calc(var(--header-h) + var(--space-m));
  }
</style>
