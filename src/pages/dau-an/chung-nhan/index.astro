---
/**
 * /dau-an/chung-nhan/: Chứng nhận sản phẩm. The three OCOP products as
 * Báo An Giang names them (26.10.2025), one row each: the studio photograph
 * on the left; on the right the name, the showroom summary, the product's
 * own certificate (OCOP 3 sao, UBND huyện Tri Tôn, 18.12.2024), shown whole
 * and opening in the photo viewer, and a link to the showroom. Data:
 * ocopProducts in src/data/dau-an.ts, summaries from src/data/showroom.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DauAnHead from '../../../components/dau-an/DauAnHead.astro';
import Lightbox from '../../../components/dau-an/Lightbox.astro';
import Arrow from '../../../components/Arrow.astro';
import { dauAnPages, dauAnText as t, ocopProducts, ocopSource, type Pic } from '../../../data/dau-an';
import { showroomProducts } from '../../../data/showroom';

const img = (slug: string, w: number) => `/images/products/studio/${slug}-${w}.webp`;
const captionOf = (p: Pic) => `${p.caption ?? p.alt} ${t.anh} ${p.credit}.`;
const showroom = showroomProducts('vi');
const summaryOf = (slug: string) => showroom.find((s) => s.slug === slug)?.summary;
---
<BaseLayout
  title={dauAnPages.find((p) => p.href === '/dau-an/chung-nhan/')!.title}
  description={t.chung_nhan_mo_ta}
>
  <DauAnHead current="/dau-an/chung-nhan/" />

  <section class="ocop" aria-labelledby="ocop-title">
    <div class="container">
      <div class="ocop__intro">
        <p class="eyebrow"><img class="eyebrow__icon" src="/brand/icons/chat-luong.webp" width="128" height="128" alt="" />{t.chung_nhan_nhan}</p>
        <h2 class="ocop__title" id="ocop-title">{t.chung_nhan_tieu_de}</h2>
        <p class="ocop__lead">{t.chung_nhan_dan}</p>
      </div>

      <ul class="ocop__list">
        {ocopProducts.map((p) => (
          <li class="ocop__item" data-reveal>
            <a class="ocop__photo" href={`/san-pham/#${p.slug}`} tabindex="-1" aria-hidden="true">
              <img
                src={img(p.slug, 640)}
                srcset={`${img(p.slug, 640)} 640w, ${img(p.slug, 1254)} 1254w`}
                sizes="(min-width: 1024px) 45vw, (min-width: 768px) 50vw, 100vw"
                width="640"
                height="640"
                alt={p.alt}
                loading="lazy"
                decoding="async"
              />
            </a>

            <div class="ocop__body">
              <p class="ocop__badge">{t.chung_nhan_huy_hieu}</p>
              <h3 class="ocop__name">{p.name}</h3>
              <p class="ocop__brand">{t.chung_nhan_thuong_hieu}</p>
              {summaryOf(p.slug) && <p class="ocop__summary">{summaryOf(p.slug)}</p>}

              <a
                class="ocop__cert"
                href={p.certificate.full}
                data-lightbox="ocop"
                data-caption={captionOf(p.certificate)}
                data-width={p.certificate.width}
                data-height={p.certificate.height}
              >
                <span class="ocop__cert-photo">
                  <img
                    src={p.certificate.src}
                    srcset={p.certificate.srcset}
                    sizes="10rem"
                    width={p.certificate.width}
                    height={p.certificate.height}
                    alt={p.certificate.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="ocop__cert-text">
                  <span class="ocop__cert-caption">{p.certificate.caption}</span>
                  <span class="ocop__cert-more">{t.chung_nhan_xem_giay} <span aria-hidden="true">↗</span></span>
                </span>
              </a>

              <a class="ocop__more" href={`/san-pham/#${p.slug}`}>
                {t.chung_nhan_xem_san_pham}<span class="sr-only">: {p.name}</span> <Arrow />
              </a>
            </div>
          </li>
        ))}
      </ul>

      <p class="ocop__note">{t.chung_nhan_giay_dan}</p>
      <p class="ocop__source">
        {t.nguon}{' '}
        <a href={ocopSource.href} target="_blank" rel="noopener">{ocopSource.label}<span class="sr-only"> (mở trong thẻ mới)</span></a>
      </p>
    </div>
  </section>

  <Lightbox closeLabel={t.xem_anh_dong} />
</BaseLayout>

<style>
  .ocop { padding-bottom: var(--section-y); }

  .ocop__intro { max-width: 40rem; }
  .ocop__title {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-h2);
    line-height: 1.12;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .ocop__lead {
    margin-top: var(--space-s);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* One row per product, divided by hairlines. */
  .ocop__list { margin-top: var(--space-xl); border-top: 1px solid var(--color-line); }
  .ocop__item {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-line);
  }

  .ocop__photo {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-cream);
  }
  .ocop__photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease); }
  .ocop__photo:hover img { transform: scale(1.03); }

  .ocop__body { display: grid; justify-items: start; align-content: center; }
  .ocop__badge {
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--color-earth);
    border: 1px solid currentColor;
  }
  .ocop__name {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-h2);
    line-height: 1.12;
    text-wrap: balance;
  }
  .ocop__brand { margin-top: var(--space-2xs); font-size: var(--type-small); color: var(--color-text-muted); }
  .ocop__summary { margin-top: var(--space-s); max-width: 34rem; color: var(--color-text-muted); text-wrap: pretty; }

  /* The certificate, whole (never cropped); the block opens the viewer. */
  .ocop__cert {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-m);
    align-items: center;
    margin-top: var(--space-m);
    max-width: 30rem;
  }
  .ocop__cert-photo { display: block; }
  .ocop__cert-photo img { width: 100%; height: auto; transition: opacity 300ms var(--ease); }
  .ocop__cert:hover .ocop__cert-photo img { opacity: 0.9; }
  .ocop__cert-text { display: grid; justify-items: start; gap: var(--space-s); }
  .ocop__cert-caption { font-size: var(--type-small); color: var(--color-text-muted); text-wrap: pretty; }
  .ocop__cert-more {
    font-size: var(--type-small);
    color: var(--color-earth);
    border-bottom: 1px solid currentColor;
  }

  .ocop__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-m);
    font-size: var(--type-small);
    border-bottom: 1px solid var(--color-line-strong);
  }
  .ocop__more :global(.arrow) { width: 0.875rem; }
  .ocop__more:hover { border-color: currentColor; }

  /* The decision behind all three certificates, then the source: small print. */
  .ocop__note {
    max-width: 40rem;
    margin-top: var(--space-m);
    font-size: var(--type-small);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .ocop__source {
    margin-top: var(--space-2xs);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .ocop__source a { color: var(--color-text); border-bottom: 1px solid var(--color-line-strong); }
  .ocop__source a:hover { border-color: currentColor; }

  @media (min-width: 768px) {
    .ocop__item {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .ocop__cert { grid-template-columns: 9rem minmax(0, 1fr); }
  }
  @media (min-width: 1024px) {
    .ocop__item { grid-template-columns: minmax(0, 7fr) minmax(0, 8fr); gap: var(--space-2xl); }
  }
</style>
