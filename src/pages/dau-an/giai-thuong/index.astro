---
/**
 * /dau-an/giai-thuong/: Giải thưởng & Ghi nhận, "một dấu mốc, một câu
 * chuyện". Only recognitions with a source and a certificate, trophy or
 * ceremony photograph: press mentions and attendance are not awards.
 * Newest first, five to a page (perPage in src/data/dau-an.ts; later
 * pages at /dau-an/giai-thuong/trang/2/ and on, trang/[page].astro).
 * Photograph and text change sides from one to the next.
 * Each recognition has an anchor (#id) to share; its evidence opens in
 * the photo viewer. Data and provenance: src/data/dau-an.ts.
 *
 * Product certifications (OCOP) belong to the Chứng nhận sản phẩm
 * page and are not listed here.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DauAnHead from '../../../components/dau-an/DauAnHead.astro';
import Lightbox from '../../../components/dau-an/Lightbox.astro';
import Pager from '../../../components/dau-an/Pager.astro';
import Arrow from '../../../components/Arrow.astro';
import { activities, awards, dauAnPages, dauAnText as t, listingPage, type Award, type ListingPage, type Pic } from '../../../data/dau-an';

interface Props {
  /** Set by trang/[page].astro; the first page otherwise. */
  page?: ListingPage<Award>;
}

const { page = listingPage('giai-thuong', awards) } = Astro.props;
const title = dauAnPages.find((p) => p.href === '/dau-an/giai-thuong/')!.title;

const captionOf = (p: Pic) => `${p.caption ?? p.alt} ${t.anh} ${p.credit}.`;
// A document photographed flat is shown whole within the frame.
const isDocument = (p: Pic) => p.document ?? p.width < 600;
---
<BaseLayout
  title={page.currentPage === 1 ? title : `${title} · ${t.trang} ${page.currentPage}`}
  description={t.giai_thuong_mo_ta}
>
  <DauAnHead current="/dau-an/giai-thuong/" />

  {page.currentPage === 1 && (
    <div class="container awards-hero">
      <img
        src="/images/dau-an/giai-thuong-hero-1280.webp"
        srcset="/images/dau-an/giai-thuong-hero-640.webp 640w, /images/dau-an/giai-thuong-hero-1280.webp 1280w, /images/dau-an/giai-thuong-hero-1672.webp 1672w"
        sizes="(min-width: 1440px) 1280px, 92vw"
        width="1672"
        height="941"
        alt="Các bằng khen, giấy chứng nhận và cúp của Hiền Nương Farm bày cạnh nhau: chứng nhận Top 10 Sáng kiến ESG Việt Nam 2023, chứng nhận và cúp Nông dân Việt Nam xuất sắc 2025, bằng khen của Hội Liên hiệp Phụ nữ Việt Nam và của Hội Nông dân Việt Nam, cúp Giải Nhất Dự án GRAISEA 2, giấy chứng nhận Phụ nữ Việt tự tin làm kinh tế năm 2025"
        fetchpriority="high"
      />
    </div>
  )}

  <div class="awards">
    {page.data.map((a, i) => {
      const related = activities.find((act) => act.award === a.id);
      const doc = isDocument(a.photo);
      return (
        <article
          class:list={['award', { 'award--flip': i % 2 === 1, 'award--document': doc }]}
          id={a.id}
          aria-labelledby={`${a.id}-title`}
        >
          <div class="container award__grid">
            <div class="award__text" data-reveal>
              <p class="award__year">{a.year}</p>
              <p class="eyebrow award__by">{a.by}</p>
              <h2 class="award__name" id={`${a.id}-title`}>{a.name}</h2>
              <p class="award__recipient">{a.recipient}</p>
              {a.significance.split(/\n\s*\n/).map((para) => (
                <p class="award__significance">{para.trim()}</p>
              ))}

              {(a.sources.length > 0 || related) && (
              <div class="award__links">
                {a.sources.length > 0 && (
                <p class="award__sources">
                  {t.nguon}{' '}
                  {a.sources.map((s, j) => (
                    <>
                      {j > 0 && ' · '}
                      <a href={s.href} target="_blank" rel="noopener">{s.label}<span class="sr-only"> (mở trong thẻ mới)</span></a>
                    </>
                  ))}
                </p>
                )}
                {related && (
                  <a class="link-arrow award__related" href={`/dau-an/su-kien/${related.slug}/`}>
                    {t.giai_thuong_xem_hoat_dong} <Arrow />
                  </a>
                )}
              </div>
              )}
            </div>

            <figure class="award__figure" data-reveal>
              <a
                class="award__photo"
                href={a.photo.full}
                data-lightbox={a.id}
                data-caption={captionOf(a.photo)}
                data-width={a.photo.width}
                data-height={a.photo.height}
              >
                <img
                  src={a.photo.src}
                  srcset={a.photo.srcset}
                  sizes="(min-width: 1024px) 56vw, 100vw"
                  width={a.photo.width}
                  height={a.photo.height}
                  alt={a.photo.alt}
                  style={a.photo.position ? `object-position: ${a.photo.position}` : undefined}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 && page.currentPage > 1 ? 'high' : undefined}
                />
              </a>
              <figcaption class="award__caption">{a.photo.caption} <span class="award__credit">{t.anh} {a.photo.credit}</span></figcaption>

              {a.evidence.length > 0 && (
                <ul class="award__evidence" aria-label="Giấy chứng nhận và tư liệu">
                  {a.evidence.map((e) => (
                    <li>
                      <a
                        class:list={{ 'is-document': isDocument(e) }}
                        href={e.full}
                        data-lightbox={a.id}
                        data-caption={captionOf(e)}
                        data-width={e.width}
                        data-height={e.height}
                      >
                        <img src={e.srcset.split(' ')[0]} width={e.width} height={e.height} alt={e.alt} loading="lazy" decoding="async" />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </figure>
          </div>
        </article>
      );
    })}
    <div class="container">
      <Pager listing="giai-thuong" currentPage={page.currentPage} lastPage={page.lastPage} />
    </div>
  </div>

  <Lightbox closeLabel={t.xem_anh_dong} />
</BaseLayout>

<style>
  /* The certificates and trophies together, page 1 only. */
  .awards-hero { margin-bottom: var(--space-2xl); }
  .awards-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-cream);
  }
  @media (min-width: 768px) {
    .awards-hero img { aspect-ratio: 2 / 1; object-position: 50% 45%; }
  }

  .awards { padding-bottom: var(--section-y); }

  .award + .award .award__grid {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-line);
  }
  .award + .award { margin-top: var(--space-2xl); }

  .award__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    align-items: center;
  }

  /* Every main photograph takes the same frame: 3:2, at most 440px high.
     People are cropped around their focal point (photo.position). */
  .award__photo {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: 440px;
    overflow: hidden;
    cursor: zoom-in;
    background: var(--color-cream);
  }
  .award__photo img { width: 100%; height: 100%; object-fit: cover; }

  /* A certificate or trophy stands whole on a cream ground within that frame. */
  .award--document .award__photo { padding: clamp(var(--space-s), 3vw, var(--space-xl)); }
  .award--document .award__photo img { object-fit: contain; filter: drop-shadow(0 1px 0 var(--color-line)); }

  .award__caption {
    margin-top: var(--space-xs);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .award__credit { white-space: nowrap; }

  .award__year {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-title);
    line-height: 1;
    font-variant-numeric: lining-nums;
  }
  .award__year::after {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-top: var(--space-m);
    background: var(--color-earth);
  }

  .award__by { margin-top: var(--space-m); line-height: 1.6; }

  .award__name {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-h2);
    line-height: 1.12;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .award__recipient {
    margin-top: var(--space-s);
    font-weight: 400;
    color: var(--color-text);
  }

  .award__significance {
    margin-top: var(--space-s);
    max-width: 34rem;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* The other photographs: one row of equal 96×72 frames, scrolling
     sideways when there are many. */
  .award__evidence {
    display: flex;
    gap: 12px;
    margin-top: var(--space-s);
    overflow-x: auto;
    scrollbar-width: thin;
    padding: 3px;
    margin-inline: -3px;
  }
  .award__evidence li { flex: none; }
  .award__evidence a {
    display: block;
    width: 96px;
    height: 72px;
    overflow: hidden;
    cursor: zoom-in;
    background: var(--color-cream);
    outline-offset: 2px;
  }
  .award__evidence img { width: 100%; height: 100%; object-fit: cover; transition: opacity 300ms var(--ease); }
  .award__evidence a.is-document img { object-fit: contain; padding: 4px; }
  .award__evidence a:hover img { opacity: 0.85; }

  .award__links {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-line);
  }
  .award__sources { font-size: 0.8125rem; line-height: 1.7; color: var(--color-text-muted); }
  .award__sources a { color: var(--color-text); border-bottom: 1px solid var(--color-line-strong); }
  .award__sources a:hover { border-color: currentColor; }
  .award__related :global(.arrow) { width: 0.875rem; }

  /* Desktop: text 44%, photographs 56%, 48px apart; sides alternate. */
  @media (min-width: 1024px) {
    .award__grid {
      grid-template-columns: minmax(0, 56fr) minmax(0, 44fr);
      column-gap: 48px;
    }
    .award__figure { grid-row: 1; grid-column: 1; }
    .award__text { grid-row: 1; grid-column: 2; }
    .award--flip .award__grid { grid-template-columns: minmax(0, 44fr) minmax(0, 56fr); }
    .award--flip .award__text { grid-column: 1; }
    .award--flip .award__figure { grid-column: 2; }
  }
</style>
