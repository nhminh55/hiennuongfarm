---
/**
 * /dau-an/giai-thuong/: Giải thưởng & Ghi nhận, "một dấu mốc, một câu
 * chuyện". Only recognitions with a source and a certificate, trophy or
 * ceremony photograph: press mentions and attendance are not awards.
 * Newest first, five to a page (perPage in src/data/dau-an.ts; later
 * pages at /dau-an/giai-thuong/trang/2/ and on, trang/[page].astro).
 * Photograph and text change sides from one to the next.
 * Each recognition has an anchor (#id) to share; its evidence opens in
 * the photo viewer. Data and provenance: src/data/dau-an.ts.
 *
 * Product certifications (OCOP) belong to the Chứng nhận sản phẩm
 * page and are not listed here.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DauAnHead from '../../../components/dau-an/DauAnHead.astro';
import Lightbox from '../../../components/dau-an/Lightbox.astro';
import Pager from '../../../components/dau-an/Pager.astro';
import Arrow from '../../../components/Arrow.astro';
import { activities, awards, dauAnPages, dauAnText as t, formatDate, listingPage, type Award, type ListingPage, type Pic } from '../../../data/dau-an';

interface Props {
  /** Set by trang/[page].astro; the first page otherwise. */
  page?: ListingPage<Award>;
}

const { page = listingPage('giai-thuong', awards) } = Astro.props;
const title = dauAnPages.find((p) => p.href === '/dau-an/giai-thuong/')!.title;

const captionOf = (p: Pic) => `${p.caption ?? p.alt} ${t.anh} ${p.credit}.`;
// A document photographed flat is shown whole within the frame.
const isDocument = (p: Pic) => p.document ?? p.width < 600;
---
<BaseLayout
  title={page.currentPage === 1 ? title : `${title} · ${t.trang} ${page.currentPage}`}
  description={t.giai_thuong_mo_ta}
>
  <DauAnHead current="/dau-an/giai-thuong/" />

  {page.currentPage === 1 && (
    <div class="container awards-hero">
      <img
        src="/images/dau-an/giai-thuong-hero-1280.webp"
        srcset="/images/dau-an/giai-thuong-hero-640.webp 640w, /images/dau-an/giai-thuong-hero-1280.webp 1280w, /images/dau-an/giai-thuong-hero-1672.webp 1672w"
        sizes="(min-width: 1440px) 1280px, 92vw"
        width="1672"
        height="941"
        alt="Các bằng khen, giấy chứng nhận và cúp của Hiền Nương Farm bày cạnh nhau: chứng nhận Top 10 Sáng kiến ESG Việt Nam 2023, chứng nhận và cúp Nông dân Việt Nam xuất sắc 2025, bằng khen của Hội Liên hiệp Phụ nữ Việt Nam và của Hội Nông dân Việt Nam, cúp Giải Nhất Dự án GRAISEA 2, giấy chứng nhận Phụ nữ Việt tự tin làm kinh tế năm 2025"
        fetchpriority="high"
      />
    </div>
  )}

  <div class="awards">
    {page.data.map((a, i) => {
      const related = activities.find((act) => act.award === a.id);
      const doc = isDocument(a.photo);
      const photos = [a.photo, ...a.evidence];
      return (
        <article
          class:list={['award', { 'award--flip': i % 2 === 1, 'award--document': doc }]}
          id={a.id}
          aria-labelledby={`${a.id}-title`}
        >
          <div class="container award__grid">
            <div class="award__text" data-reveal>
              <p class="award__year">{a.year}</p>
              <p class="eyebrow award__by">{a.by}</p>
              <h2 class="award__name" id={`${a.id}-title`}>
                {a.name}
                <time class="award__date" datetime={a.date ?? a.year}>{formatDate(a.date ?? a.year)}</time>
              </h2>
              <p class="award__recipient">{a.recipient}</p>
              {a.significance.split(/\n\s*\n/).map((para) => (
                <p class="award__significance">{para.trim()}</p>
              ))}

              {(a.sources.length > 0 || related) && (
              <div class="award__links">
                {a.sources.length > 0 && (
                <p class="award__sources">
                  {t.nguon}{' '}
                  {a.sources.map((s, j) => (
                    <>
                      {j > 0 && ' · '}
                      <a href={s.href} target="_blank" rel="noopener">{s.label}<span class="sr-only"> (mở trong thẻ mới)</span></a>
                    </>
                  ))}
                </p>
                )}
                {related && (
                  <a class="link-arrow award__related" href={`/dau-an/su-kien/${related.slug}/`}>
                    {t.giai_thuong_xem_hoat_dong} <Arrow />
                  </a>
                )}
              </div>
              )}
            </div>

            <figure class="award__figure" data-reveal data-award-gallery>
              <div class="award__frame">
              <a
                class:list={["award__photo", { "is-document": doc }]}
                data-gallery-main
                data-lightbox-trigger={`${a.id}-photo-0`}
                href={a.photo.full}
                data-caption={captionOf(a.photo)}
                data-width={a.photo.width}
                data-height={a.photo.height}
              >
                <img
                  src={a.photo.src}
                  srcset={a.photo.srcset}
                  sizes="(min-width: 1024px) 56vw, 100vw"
                  width={a.photo.width}
                  height={a.photo.height}
                  alt={a.photo.alt}
                  style={a.photo.position ? `object-position: ${a.photo.position}` : undefined}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 && page.currentPage > 1 ? 'high' : undefined}
                />
              </a>
              {photos.length > 1 && <>
                <button type="button" class="award__nav award__nav--prev" data-gallery-prev aria-label="Ảnh trước"><Arrow /></button>
                <button type="button" class="award__nav award__nav--next" data-gallery-next aria-label="Ảnh sau"><Arrow /></button>
              </>}
              </div>
              <figcaption class="award__caption" aria-live="polite" aria-atomic="true"><span data-gallery-caption>{a.photo.caption}</span> <span class="award__credit" data-gallery-credit>{t.anh} {a.photo.credit}</span></figcaption>

              {photos.length === 1 && <a hidden id={`${a.id}-photo-0`} href={a.photo.full} data-lightbox={a.id} data-caption={captionOf(a.photo)} data-width={a.photo.width} data-height={a.photo.height}><img src={a.photo.src} alt={a.photo.alt} /></a>}
              {photos.length > 1 && (
                <ul class="award__evidence" aria-label="Giấy chứng nhận và tư liệu">
                  {photos.map((e, index) => (
                    <li>
                      <a
                        class:list={{ 'is-document': isDocument(e) }}
                        id={`${a.id}-photo-${index}`}
                        data-gallery-thumb
                        aria-current={index === 0 ? 'true' : 'false'}
                        aria-label={`Chọn ảnh ${index + 1}: ${e.alt}`}
                        data-src={e.src}
                        data-srcset={e.srcset}
                        data-alt={e.alt}
                        data-photo-caption={e.caption ?? e.alt}
                        data-credit={e.credit}
                        data-position={e.position ?? '50% 50%'}
                        data-document={isDocument(e)}
                        href={e.full}
                        data-lightbox={a.id}
                        data-caption={captionOf(e)}
                        data-width={e.width}
                        data-height={e.height}
                      >
                        <img src={e.srcset.split(' ')[0]} width={e.width} height={e.height} alt={e.alt} loading="lazy" decoding="async" />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </figure>
          </div>
        </article>
      );
    })}
    <div class="container">
      <Pager listing="giai-thuong" currentPage={page.currentPage} lastPage={page.lastPage} />
    </div>
  </div>

  <Lightbox closeLabel={t.xem_anh_dong} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-award-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLAnchorElement>('[data-gallery-main]')!;
    const image = main.querySelector('img')!;
    const thumbs = Array.from(gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]'));
    if (!thumbs.length) return;
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]')!;
    const credit = gallery.querySelector<HTMLElement>('[data-gallery-credit]')!;
    const creditPrefix = credit.textContent!.slice(0, credit.textContent!.indexOf(thumbs[0].dataset.credit!));
    let selected = 0;
    const select = (index: number) => {
      selected = (index + thumbs.length) % thumbs.length;
      const thumb = thumbs[selected];
      main.href = thumb.href;
      main.dataset.lightboxTrigger = thumb.id;
      main.classList.toggle('is-document', thumb.dataset.document === 'true');
      image.srcset = thumb.dataset.srcset!;
      image.src = thumb.dataset.src!;
      image.alt = thumb.dataset.alt!;
      image.width = Number(thumb.dataset.width);
      image.height = Number(thumb.dataset.height);
      image.style.objectPosition = thumb.dataset.position!;
      caption.textContent = thumb.dataset.photoCaption!;
      credit.textContent = creditPrefix + thumb.dataset.credit!;
      thumbs.forEach((item, i) => item.setAttribute('aria-current', String(i === selected)));
      // Keep the selected thumbnail visible without moving the page vertically.
      const list = thumb.closest('ul')!;
      if (thumb.offsetLeft < list.scrollLeft) list.scrollLeft = thumb.offsetLeft;
      else if (thumb.offsetLeft + thumb.offsetWidth > list.scrollLeft + list.clientWidth)
        list.scrollLeft = thumb.offsetLeft + thumb.offsetWidth - list.clientWidth;
    };
    thumbs.forEach((thumb, i) => thumb.addEventListener('click', (event) => {
      event.preventDefault();
      select(i);
    }));
    gallery.querySelector('[data-gallery-prev]')?.addEventListener('click', () => select(selected - 1));
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => select(selected + 1));
    gallery.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      select(selected + (event.key === 'ArrowLeft' ? -1 : 1));
    });
    let start: { x: number; y: number; id: number } | undefined;
    let swiped = false;
    main.addEventListener('pointerdown', (event) => {
      swiped = false;
      if (event.pointerType !== 'touch' || !event.isPrimary) return;
      start = { x: event.clientX, y: event.clientY, id: event.pointerId };
      main.setPointerCapture(event.pointerId);
    });
    main.addEventListener('pointerup', (event) => {
      if (!start || start.id !== event.pointerId) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      start = undefined;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        swiped = true;
        select(selected + (dx < 0 ? 1 : -1));
      }
    });
    main.addEventListener('pointercancel', () => { start = undefined; });
    main.addEventListener('click', (event) => {
      if (!swiped) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      swiped = false;
    }, true);
    main.addEventListener('dragstart', (event) => event.preventDefault());
  });
</script>

<style>
  .award__frame { position: relative; aspect-ratio: 3 / 2; max-height: 440px; }
  .award__photo { touch-action: pan-y; }
  .award__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-line-strong);
    background: var(--color-cream);
    color: var(--color-deep-green);
    cursor: pointer;
  }
  .award__nav--prev { left: 8px; }
  .award__nav--next { right: 8px; }
  .award__nav--prev :global(.arrow) { transform: rotate(180deg); }
  .award__nav:hover { border-color: currentColor; }
  .award__evidence a[aria-current="true"] { outline: 3px solid var(--color-deep-green); outline-offset: -3px; }
  .award__figure :focus-visible { outline: 3px solid var(--color-deep-green); outline-offset: 2px; }

  /* The certificates and trophies together, page 1 only. */
  .awards-hero { margin-bottom: var(--space-2xl); }
  .awards-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-cream);
  }
  @media (min-width: 768px) {
    .awards-hero img { aspect-ratio: 2 / 1; object-position: 50% 45%; }
  }

  .awards { padding-bottom: var(--section-y); }

  .award + .award .award__grid {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-line);
  }
  .award + .award { margin-top: var(--space-2xl); }

  .award__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    align-items: center;
  }

  /* Every main photograph takes the same frame: 3:2, at most 440px high.
     People are cropped around their focal point (photo.position). */
  .award__photo {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: zoom-in;
    background: var(--color-cream);
  }
  .award__photo img { width: 100%; height: 100%; object-fit: cover; }

  /* A certificate or trophy stands whole on a cream ground within that frame. */
  .award__photo.is-document { padding: clamp(var(--space-s), 3vw, var(--space-xl)); }
  .award__photo.is-document img { object-fit: contain; filter: drop-shadow(0 1px 0 var(--color-line)); }

  .award__caption {
    margin-top: var(--space-xs);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .award__credit { white-space: nowrap; }

  .award__year {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-title);
    line-height: 1;
    font-variant-numeric: lining-nums;
  }
  .award__year::after {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-top: var(--space-m);
    background: var(--color-earth);
  }

  .award__by { margin-top: var(--space-m); line-height: 1.6; }

  .award__name {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-h2);
    line-height: 1.12;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .award__date {
    display: block;
    margin-top: var(--space-xs);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
    color: var(--color-text-muted);
  }

  .award__recipient {
    margin-top: var(--space-s);
    font-weight: 400;
    color: var(--color-text);
  }

  .award__significance {
    margin-top: var(--space-s);
    max-width: 34rem;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* The other photographs: one row of equal 96×72 frames, scrolling
     sideways when there are many. */
  .award__evidence {
    position: relative;
    display: flex;
    gap: 12px;
    margin-top: var(--space-s);
    overflow-x: auto;
    scrollbar-width: thin;
    padding: 3px;
    margin-inline: -3px;
  }
  .award__evidence li { flex: none; }
  .award__evidence a {
    display: block;
    width: 96px;
    height: 72px;
    overflow: hidden;
    cursor: pointer;
    background: var(--color-cream);
    outline-offset: 2px;
  }
  .award__evidence img { width: 100%; height: 100%; object-fit: cover; transition: opacity 300ms var(--ease); }
  .award__evidence a.is-document img { object-fit: contain; padding: 4px; }
  .award__evidence a:hover img { opacity: 0.85; }

  .award__links {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-line);
  }
  .award__sources { font-size: 0.8125rem; line-height: 1.7; color: var(--color-text-muted); }
  .award__sources a { color: var(--color-text); border-bottom: 1px solid var(--color-line-strong); }
  .award__sources a:hover { border-color: currentColor; }
  .award__related :global(.arrow) { width: 0.875rem; }

  /* Desktop: text 44%, photographs 56%, 48px apart; sides alternate. */
  @media (min-width: 1024px) {
    .award__grid {
      grid-template-columns: minmax(0, 56fr) minmax(0, 44fr);
      column-gap: 48px;
    }
    .award__figure { grid-row: 1; grid-column: 1; }
    .award__text { grid-row: 1; grid-column: 2; }
    .award--flip .award__grid { grid-template-columns: minmax(0, 44fr) minmax(0, 56fr); }
    .award--flip .award__text { grid-column: 1; }
    .award--flip .award__figure { grid-column: 2; }
  }
</style>
