---
/**
 * /dau-an/bao-chi/tu-lieu/: Kho tư liệu báo chí.
 *
 * Every entry of pressArchive (src/data/dau-an.ts), grouped by year, newest
 * first; entries without a date close the list under "Khác". Each headline
 * opens the original in a new tab. Search (headline and outlet, without
 * diacritics or case) and the year and outlet filters run in the page and
 * combine; a year with no match is hidden, in the list and in the year rail.
 * Without JavaScript the whole list is still there.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import DauAnHead from '../../../../components/dau-an/DauAnHead.astro';
import { dauAnText as t, pressArchive } from '../../../../data/dau-an';
import { fold } from '../../../../scripts/fold';

const entries = [...pressArchive].sort((a, b) =>
  a.date && b.date ? b.date.localeCompare(a.date) : a.date ? -1 : b.date ? 1 : a.headline.localeCompare(b.headline, 'vi'),
);
const year = (date?: string) => date?.slice(0, 4) ?? 'none';
const groups = [...new Set(entries.map((e) => year(e.date)))].map((y) => ({
  key: y,
  label: y === 'none' ? t.tu_lieu_khac : y,
  entries: entries.filter((e) => year(e.date) === y),
}));
const years = groups.flatMap((g) => (g.key === 'none' ? [] : [g.key]));
const outlets = [...new Set(entries.map((e) => e.outlet))].sort((a, b) => a.localeCompare(b, 'vi'));

// Day and month only: the year is the group's heading.
const dayMonth = (date?: string) => {
  const [, m, d] = date?.split('-') ?? [];
  return d ? `${d}.${m}` : m ? `Tháng ${Number(m)}` : '';
};
const domain = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
<BaseLayout
  title={t.tu_lieu_tieu_de}
  description={t.tu_lieu_mo_ta}
>
  <DauAnHead current="/dau-an/bao-chi/" title={t.tu_lieu_tieu_de} as="p" />

  <section class="archive" aria-labelledby="archive-title">
    <div class="container">
      <header class="archive__intro">
        <div class="archive__heading">
          <h1 class="archive__title" id="archive-title">{t.tu_lieu_tieu_de}</h1>
          <p class="archive__lede">{t.tu_lieu_dan}</p>
        </div>
        <p class="archive__total">
          <span class="archive__number">{entries.length}</span>
          <span class="archive__unit" set:html={t.tu_lieu_don_vi} />
          <span class="archive__span">
            {years.length > 0 && <>{years.at(-1)} – {years[0]} · </>}{`${outlets.length} ${t.tu_lieu_nguon}`}
          </span>
        </p>
      </header>

      <form class="filters" role="search" aria-label="Tìm trong kho tư liệu" data-filters>
        <div class="filters__q">
          <label class="sr-only" for="f-q">Tìm kiếm</label>
          <input id="f-q" name="q" type="search" placeholder={t.tu_lieu_tim} autocomplete="off" spellcheck="false" />
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.4" /></svg>
        </div>
        <button class="filters__toggle" type="button" aria-expanded="false" aria-controls="f-more" data-toggle>
          {t.tu_lieu_loc}<span data-active></span>
        </button>
        <div class="filters__more" id="f-more">
          <label class="sr-only" for="f-year">Năm</label>
          <select id="f-year" name="year">
            <option value="">{t.tu_lieu_tat_ca_nam}</option>
            {groups.map((g) => <option value={g.key}>{g.label}</option>)}
          </select>
          <label class="sr-only" for="f-outlet">Nguồn</label>
          <select id="f-outlet" name="outlet">
            <option value="">{t.tu_lieu_tat_ca_nguon}</option>
            {outlets.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
        <p class="sr-only" role="status" data-count></p>
      </form>

      <div class="body">
        <nav class="rail" aria-label="Các năm">
          <ol>
            {groups.map((g) => (
              <li data-rail={g.key}>
                <a href={`#nam-${g.key}`}>{g.label}<span data-n>{g.entries.length}</span></a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="years" data-list>
          {groups.map((g) => (
            <section class="year" id={`nam-${g.key}`} data-group={g.key} aria-labelledby={`nam-${g.key}-title`}>
              <header class="year__head">
                <h2 class="year__title" id={`nam-${g.key}-title`}>{g.label}</h2>
                <p class="year__count"><span data-n>{g.entries.length}</span> {t.tu_lieu_muc}</p>
              </header>
              <ol class="list">
                {g.entries.map((e) => (
                  <li class="row" data-search={fold(`${e.headline} ${e.outlet}`)} data-year={g.key} data-outlet={e.outlet}>
                    <span class="row__date">{e.date && <time datetime={e.date}>{dayMonth(e.date)}</time>}</span>
                    <span class="row__title">
                      {e.kind === 'video' && <span class="row__kind">{t.phong_su_truyen_hinh}</span>}
                      {e.kind === 'audio' && <span class="row__kind">{t.tu_lieu_phat_thanh}</span>}
                      <a href={e.url} target="_blank" rel="noopener noreferrer">
                        {e.headline}<span class="sr-only"> (mở trong thẻ mới)</span>
                      </a>
                    </span>
                    <span class="row__outlet">
                      {e.outlet}
                      <span class="row__domain" aria-hidden="true">{domain(e.url)}</span>
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </div>

      <p class="empty" hidden data-empty>
        {t.tu_lieu_khong_co}
        <button type="button" data-reset>{t.tu_lieu_xoa_loc}</button>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { fold } from '../../../../scripts/fold';

  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-list]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const count = document.querySelector<HTMLElement>('[data-count]');

  if (form && list && empty && count) {
    const q = form.elements.namedItem('q') as HTMLInputElement;
    const year = form.elements.namedItem('year') as HTMLSelectElement;
    const outlet = form.elements.namedItem('outlet') as HTMLSelectElement;
    const toggle = form.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const active = toggle.querySelector<HTMLElement>('[data-active]')!;
    const groups = [...list.querySelectorAll<HTMLElement>('[data-group]')];
    const rail = new Map([...document.querySelectorAll<HTMLElement>('[data-rail]')].map((li) => [li.dataset.rail!, li]));
    const rows = [...list.querySelectorAll<HTMLElement>('[data-search]')];
    const total = rows.length;

    // On a phone the year and outlet fields fold behind "Lọc".
    form.classList.add('is-ready');
    toggle.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
    });

    const apply = () => {
      const terms = fold(q.value).split(' ').filter(Boolean);
      let shown = 0;
      for (const row of rows) {
        row.hidden = !(
          terms.every((t) => row.dataset.search!.includes(t)) &&
          (!year.value || row.dataset.year === year.value) &&
          (!outlet.value || row.dataset.outlet === outlet.value)
        );
        if (!row.hidden) shown++;
      }
      // A year with no match leaves the list and the rail.
      for (const group of groups) {
        const n = group.querySelectorAll('[data-search]:not([hidden])').length;
        const item = rail.get(group.dataset.group!)!;
        group.hidden = item.hidden = n === 0;
        for (const el of [group, item]) el.querySelector('[data-n]')!.textContent = String(n);
      }
      const filters = Number(Boolean(year.value)) + Number(Boolean(outlet.value));
      active.textContent = filters ? ` · ${filters}` : '';
      const on = Boolean(q.value.trim() || filters);
      count.textContent = on ? `Tìm thấy ${shown} trong ${total} bài` : `${total} bài viết và phóng sự`;
      list.hidden = shown === 0;
      empty.hidden = shown !== 0;
      markCurrent();
    };

    // The rail lights the year being read: the last one whose heading has
    // passed below the sticky bar.
    const markCurrent = () => {
      const line = form.getBoundingClientRect().bottom + 24;
      const visible = groups.filter((g) => !g.hidden);
      const current = visible.filter((g) => g.getBoundingClientRect().top <= line).at(-1) ?? visible[0];
      for (const [key, item] of rail) {
        const link = item.querySelector('a')!;
        if (key === current?.dataset.group) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          markCurrent();
          ticking = false;
        });
      },
      { passive: true },
    );

    form.addEventListener('input', apply);
    form.addEventListener('submit', (event) => event.preventDefault());
    empty.querySelector('[data-reset]')!.addEventListener('click', () => {
      form.reset();
      apply();
      q.focus();
    });
    // A restored page (back/forward) keeps its field values.
    apply();
  }
</script>

<style>
  .archive { padding-bottom: var(--section-y); }

  /* Opening: title and one line on the left, the size of the archive on
     the right. */
  .archive__intro {
    display: grid;
    gap: var(--space-m);
    align-items: end;
  }
  .archive__heading { display: grid; gap: var(--space-xs); }
  .archive__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-title);
    line-height: 1.1;
    letter-spacing: -0.005em;
  }
  .archive__lede { color: var(--color-text-muted); text-wrap: pretty; }

  .archive__total {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-s);
    align-items: end;
  }
  .archive__number {
    grid-row: span 2;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 3.25rem;
    line-height: 0.9;
    font-variant-numeric: lining-nums;
    color: var(--color-forest);
  }
  .archive__unit { font-family: var(--font-display); font-size: 1.0625rem; line-height: 1.3; }
  .archive__span {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-earth);
  }

  /* Search and filters: bordered fields, no labels on screen. ----------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
    padding-block: var(--space-s);
    background: var(--color-paper);
  }
  .filters__q { position: relative; flex: 1 1 12rem; min-width: 0; }
  .filters__q svg {
    position: absolute;
    right: 0.875rem;
    top: 50%;
    width: 1.125rem;
    height: 1.125rem;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .filters__more { display: flex; flex-wrap: wrap; gap: var(--space-xs); flex: 1 1 100%; }
  .filters__more select { flex: 1 1 10rem; min-width: 0; }

  .filters input,
  .filters select,
  .filters__toggle {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-line-strong);
    border-radius: 2px;
    transition: border-color 300ms var(--ease);
  }
  .filters input { padding-right: 2.75rem; }
  .filters select {
    appearance: none;
    padding-right: 2.25rem;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: calc(100% - 1.1rem) 55%, calc(100% - 0.75rem) 55%;
    background-size: 0.35rem 0.35rem;
    background-repeat: no-repeat;
    text-overflow: ellipsis;
    cursor: pointer;
  }
  .filters input::placeholder { color: var(--color-text-muted); opacity: 0.8; }
  .filters input:hover,
  .filters select:hover,
  .filters__toggle:hover { border-color: var(--color-text); }
  .filters input:focus-visible,
  .filters select:focus-visible,
  .filters__toggle:focus-visible {
    outline: none;
    border-color: var(--color-forest);
    box-shadow: inset 0 0 0 1px var(--color-forest);
  }

  .filters__toggle { display: none; width: auto; flex: none; }
  /* Phone: search and "Lọc" share a line, the two fields open below. */
  @media (max-width: 767px) {
    .filters.is-ready .filters__toggle { display: inline-flex; align-items: center; }
    .filters.is-ready .filters__more { display: none; }
    .filters.is-ready:has([aria-expanded='true']) .filters__more { display: flex; }
  }

  /* Year rail and the list. -------------------------------------------- */
  .rail { display: none; }

  .year { padding-top: var(--space-l); }
  .year[hidden] { display: none; }
  .year__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    padding-bottom: 1.125rem;
  }
  .year__title {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-forest);
  }
  .year__title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.875rem;
    width: 2.5rem;
    height: 2px;
    background: var(--color-earth);
  }
  .year__count {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-line);
  }
  .row {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'title title' 'date outlet';
    column-gap: 0.375rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    transition: background-color 300ms var(--ease), box-shadow 300ms var(--ease);
  }
  .row[hidden] { display: none; }

  .row__date {
    grid-area: date;
    font-size: var(--type-small);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-earth);
  }
  .row__date:has(time)::after { content: ' ·'; }

  .row__title { grid-area: title; margin-bottom: 0.125rem; }
  .row__title a {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.35;
    text-wrap: pretty;
    color: var(--color-text);
  }
  .row__title a::after { content: ''; position: absolute; inset: 0; }
  .row { position: relative; }

  .row__kind {
    display: inline-block;
    margin-right: 0.5rem;
    padding: 0.0625rem 0.375rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.5;
    vertical-align: 0.15em;
    color: var(--color-earth);
    border: 1px solid var(--color-earth);
    border-radius: 2px;
  }

  .row__outlet {
    grid-area: outlet;
    font-size: var(--type-small);
    line-height: 1.5;
    color: var(--color-forest);
  }
  .row__domain { display: none; }

  /* Hover: the row takes a forest tint, the outlet's address appears. */
  .row:hover,
  .row:focus-within {
    --tint: rgba(23, 61, 45, 0.08);
    background: var(--tint);
    box-shadow: -0.75rem 0 0 var(--tint), 0.75rem 0 0 var(--tint);
  }

  .empty {
    padding-block: var(--space-l);
    border-top: 1px solid var(--color-line-strong);
    color: var(--color-text-muted);
  }
  .empty button {
    margin-left: 0.5rem;
    padding-block: 0.375rem;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-line-strong);
    transition: border-color 300ms var(--ease);
  }
  .empty button:hover { border-color: currentColor; }

  @media (min-width: 768px) {
    .archive__intro { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-xl); }
    .archive__total {
      grid-template-columns: auto;
      justify-items: end;
      padding-left: var(--space-xl);
      text-align: right;
      border-left: 1px solid var(--color-line-strong);
    }
    .archive__number { grid-row: auto; font-size: 5rem; margin-bottom: 0.5rem; }

    /* The bar stays under the header while the list scrolls. */
    .filters {
      position: sticky;
      top: var(--header-h);
      z-index: 2;
      flex-wrap: nowrap;
    }
    .filters__q { flex: 2 1 0; }
    .filters__more { display: contents; }
    .filters__more select { flex: 1 1 0; }

    .row {
      grid-template-columns: 4rem minmax(0, 1fr) 30%;
      grid-template-areas: 'date title outlet';
      column-gap: var(--col-gap);
      align-items: baseline;
    }
    .row__date::after { content: none !important; }
    .row__title { margin: 0; }
    .row:hover .row__domain,
    .row:focus-within .row__domain {
      display: block;
      font-size: 0.75rem;
      color: var(--color-earth);
    }

    .year__title { font-size: 3.5rem; }
    .year { scroll-margin-top: calc(var(--header-h) + 4.75rem); }
  }

  @media (min-width: 1024px) {
    .body {
      display: grid;
      grid-template-columns: 12rem minmax(0, 1fr);
      column-gap: var(--space-2xl);
    }
    .rail {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 5.5rem);
      align-self: start;
      padding-top: var(--space-l);
    }
    .rail ol { list-style: none; padding: 0; margin: 0; }
    .rail li[hidden] { display: none; }
    .rail a {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 0.3125rem 0 0.3125rem 0.875rem;
      font-family: var(--font-display);
      font-size: 1.0625rem;
      color: var(--color-text-muted);
      opacity: 0.6;
      border-left: 2px solid transparent;
      transition: color 300ms var(--ease), opacity 300ms var(--ease), border-color 300ms var(--ease);
    }
    .rail a span { font-family: var(--font-body); font-size: 0.75rem; font-variant-numeric: tabular-nums; }
    .rail a:hover { opacity: 1; }
    .rail a[aria-current] { color: var(--color-forest); font-weight: 600; opacity: 1; border-color: var(--color-forest); }

    .row { grid-template-columns: 4rem minmax(0, 1fr) 15rem; }
  }
</style>
