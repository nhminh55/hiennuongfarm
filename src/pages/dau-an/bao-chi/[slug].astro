---
/**
 * /dau-an/bao-chi/<slug>/: one report. The outlet's headline and date,
 * the photograph and short opening from the article, a link to read or
 * watch the original. A television report is embedded (YouTube allows it
 * for this video); it never plays by itself. Data: src/data/dau-an.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DauAnHead from '../../../components/dau-an/DauAnHead.astro';
import Lightbox from '../../../components/dau-an/Lightbox.astro';
import Arrow from '../../../components/Arrow.astro';
import { formatDate, press, type PressItem } from '../../../data/dau-an';

export const getStaticPaths = () =>
  press.map((item, i) => ({
    params: { slug: item.slug },
    props: { item, prev: press[i - 1], next: press[i + 1] },
  }));

interface Props {
  item: PressItem;
  prev?: PressItem;
  next?: PressItem;
}

const { item, prev, next } = Astro.props;
const photos = [item.photo, ...(item.gallery ?? [])].filter((p) => p !== undefined);
const domain = new URL(item.url).hostname.replace(/^www\./, '');
const isVideo = item.kind === 'video';
const action = isVideo ? 'Xem phóng sự' : 'Đọc bài gốc';
const href = (p: PressItem) => `/dau-an/bao-chi/${p.slug}/`;
---
<BaseLayout title={item.headline} description={`${item.outlet}, ${formatDate(item.date)}: ${item.intro}`}>
  <DauAnHead current="/dau-an/bao-chi/" title={item.headline} as="p" />

  <article class="report" aria-labelledby="report-title">
    <div class="container report__grid">
      <header class="report__head">
        <p class="eyebrow">{isVideo ? `Phóng sự truyền hình · ${item.outlet}` : item.outlet}</p>
        <h1 class:list={['report__title', { 'report__title--long': item.headline.length > 70 }]} id="report-title">{item.headline}</h1>
        <p class="report__meta">
          <time datetime={item.date}>{isVideo ? `Đăng tải ${formatDate(item.date)}` : formatDate(item.date)}</time>
          {item.byline && <span>{item.byline}</span>}
        </p>
      </header>

      <div class="report__media">
        {item.youtube ? (
          <div class="report__video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${item.youtube}?rel=0`}
              title={`${item.headline} (YouTube)`}
              loading="lazy"
              allow="encrypted-media; picture-in-picture; fullscreen"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        ) : photos.length > 0 ? (
          <figure class="report__figure">
            <a class="report__photo" href={photos[0].full} data-lightbox="bai" data-caption={`${photos[0].caption ?? photos[0].alt} Ảnh: ${photos[0].credit}.`} data-width={photos[0].width} data-height={photos[0].height}>
              <img
                src={photos[0].src}
                srcset={photos[0].srcset}
                sizes="(min-width: 1024px) 58vw, 100vw"
                width={photos[0].width}
                height={photos[0].height}
                alt={photos[0].alt}
                fetchpriority="high"
              />
            </a>
            <figcaption class="report__caption">
              {photos[0].caption && <span>{photos[0].caption}</span>} <span class="report__credit">Ảnh: {photos[0].credit}</span>
            </figcaption>
          </figure>
        ) : (
          <div class="report__clipping" aria-hidden="true">
            <span class="eyebrow">{item.outlet}</span>
            <span class="report__clipping-title">{item.headline}</span>
            <span class="report__clipping-date">{formatDate(item.date)}</span>
          </div>
        )}

        {photos.length > 1 && (
          <ul class="report__thumbs" aria-label="Ảnh khác trong bài">
            {photos.slice(1).map((p) => (
              <li>
                <a href={p.full} data-lightbox="bai" data-caption={`${p.caption ?? p.alt} Ảnh: ${p.credit}.`} data-width={p.width} data-height={p.height}>
                  <img src={`${p.srcset.split(' ')[0]}`} width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="report__text">
        <p class="report__intro">{item.intro}</p>

        {item.lede && (
          <figure class="report__lede">
            <blockquote><p>{item.lede}</p></blockquote>
            <figcaption>Trích phần mở đầu bài viết</figcaption>
          </figure>
        )}

        {item.quote && (
          <figure class="report__quote">
            <blockquote><p>“{item.quote}”</p></blockquote>
            <figcaption>Chị Châu Thị Nương</figcaption>
          </figure>
        )}

        {item.points && (
          <div class="report__points">
            <h2 class="eyebrow">Những điểm chính trong bài</h2>
            <ul>
              {item.points.map((p) => <li>{p}</li>)}
            </ul>
            <p class="report__points-note">Theo {item.outlet}, {formatDate(item.date)}.</p>
          </div>
        )}

        <div class="report__source">
          <a class="btn report__cta" href={item.url} target="_blank" rel="noopener">
            {action}
            <Arrow direction="up-right" />
            <span class="sr-only">(mở trong thẻ mới)</span>
          </a>
          <p class="report__attr">Nguồn: {item.outlet} · {domain}</p>
        </div>
      </div>
    </div>
  </article>

  <nav class="pager container" aria-label="Bài khác">
    <div class="pager__inner">
      {prev ? (
        <a class="pager__link" href={href(prev)} rel="prev">
          <span class="pager__label"><Arrow direction="right" /> Bài mới hơn</span>
          <span class="pager__title">{prev.headline}</span>
        </a>
      ) : <span />}
      <a class="pager__all" href="/dau-an/bao-chi/">Tất cả bài viết</a>
      {next ? (
        <a class="pager__link pager__link--next" href={href(next)} rel="next">
          <span class="pager__label">Bài trước đó <Arrow /></span>
          <span class="pager__title">{next.headline}</span>
        </a>
      ) : <span />}
    </div>
  </nav>

  {photos.length > 0 && <Lightbox />}
</BaseLayout>

<style>
  .report { padding-bottom: var(--space-2xl); }

  .report__grid {
    display: grid;
    gap: var(--space-l);
    grid-template-areas: "head" "media" "text";
  }
  .report__head { grid-area: head; }
  .report__media { grid-area: media; min-width: 0; }
  .report__text { grid-area: text; }

  .report__title {
    margin-top: var(--space-s);
    max-width: 26ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.875rem, 1.3rem + 2.2vw, 3.125rem);
    line-height: var(--lh-display);
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .report__title--long { font-size: clamp(1.625rem, 1.2rem + 1.5vw, 2.375rem); line-height: 1.15; }

  .report__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: var(--space-s);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .report__photo { display: block; cursor: zoom-in; background: var(--color-cream); }
  .report__photo img { width: 100%; height: auto; }

  .report__caption {
    margin-top: var(--space-xs);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .report__credit { white-space: nowrap; }

  .report__video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-deep-green);
  }
  .report__video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .report__clipping {
    display: grid;
    gap: var(--space-s);
    align-content: center;
    min-height: 16rem;
    padding: var(--space-xl) var(--space-l);
    background: var(--color-cream);
    border-top: 2px solid var(--color-forest);
  }
  .report__clipping-title {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.15;
    text-wrap: balance;
  }
  .report__clipping-date { font-size: var(--fs-small); color: var(--color-text-muted); }

  .report__thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: var(--space-2xs);
    margin-top: var(--space-m);
  }
  .report__thumbs a { display: block; aspect-ratio: 4 / 3; overflow: hidden; cursor: zoom-in; background: var(--color-cream); }
  .report__thumbs img { width: 100%; height: 100%; object-fit: cover; transition: opacity 300ms var(--ease); }
  .report__thumbs a:hover img { opacity: 0.85; }

  .report__intro {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .report__lede,
  .report__quote {
    margin-top: var(--space-l);
    padding-left: var(--space-m);
    border-left: 1px solid var(--color-earth);
  }
  .report__lede p { color: var(--color-text-muted); text-wrap: pretty; }
  .report__quote p {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.4;
    text-wrap: pretty;
  }
  .report__lede figcaption,
  .report__quote figcaption {
    margin-top: var(--space-2xs);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .report__points { margin-top: var(--space-xl); }
  .report__points ul {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-s);
  }
  .report__points li {
    position: relative;
    padding-left: var(--space-m);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .report__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.625rem;
    height: 1px;
    background: var(--color-earth);
  }
  .report__points-note {
    margin-top: var(--space-s);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .report__source {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line);
  }
  .report__cta :global(.arrow) { width: 0.875rem; }
  .report__attr { margin-top: var(--space-s); font-size: 0.8125rem; color: var(--color-text-muted); }

  @media (min-width: 1024px) {
    .report__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: "media head" "media text";
      grid-template-rows: auto 1fr;
      column-gap: clamp(var(--space-l), 4vw, var(--space-3xl));
      row-gap: var(--space-l);
    }
    .report__head { padding-top: var(--space-2xs); }
  }

  /* Previous / next ----------------------------------------------------- */
  .pager { padding-bottom: var(--section-y); }
  .pager__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line-strong);
  }
  .pager__link { display: grid; gap: var(--space-2xs); }
  .pager__label {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-earth);
  }
  .pager__label :global(.arrow) { width: 0.875rem; }
  .pager__link:first-child .pager__label :global(.arrow) { rotate: 180deg; }
  .pager__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 1.3;
    text-wrap: balance;
  }
  .pager__link:hover .pager__title { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  .pager__all {
    justify-self: start;
    font-size: var(--fs-small);
    border-bottom: 1px solid var(--color-line-strong);
  }
  .pager__all:hover { border-color: currentColor; }

  @media (min-width: 768px) {
    .pager__inner { grid-template-columns: 1fr auto 1fr; align-items: start; column-gap: var(--space-xl); }
    .pager__all { justify-self: center; align-self: center; }
    .pager__link--next { text-align: right; justify-items: end; }
  }
</style>
