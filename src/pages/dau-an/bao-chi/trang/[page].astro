---
// /dau-an/bao-chi/trang/2/ and on: the press listing's later pages, laid out
// by ../index.astro. Page size: perPage in src/data/dau-an.ts.
import type { GetStaticPaths } from 'astro';
import Page from '../index.astro';
import { perPage, press } from '../../../../data/dau-an';

export const getStaticPaths = (({ paginate }) =>
  paginate(press, { pageSize: perPage['bao-chi'] }).slice(1)) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<Page page={page} />
