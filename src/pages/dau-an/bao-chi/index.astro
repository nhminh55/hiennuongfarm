---
/**
 * /dau-an/bao-chi/: Báo chí & Truyền thông, "bức tường báo chí".
 *
 * Vietnamese only (viOnlyPrefixes in src/i18n.ts). Content and provenance:
 * src/data/dau-an.ts. Every piece shows its outlet, original headline and
 * publication date, and opens its own page with the link to the original.
 *
 * Newest first, nine to a page (perPage in src/data/dau-an.ts); later
 * pages are /dau-an/bao-chi/trang/2/ and on (trang/[page].astro).
 * 1 · Lead, first page only: the newest report across two thirds, the next
 *     two stacked beside it.
 * 2 · The wall: the other reports as photographs, or headline cards for
 *     pieces without a usable photograph.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DauAnHead from '../../../components/dau-an/DauAnHead.astro';
import Pager from '../../../components/dau-an/Pager.astro';
import Arrow from '../../../components/Arrow.astro';
import { dauAnPages, dauAnText as txt, formatDate, listingPage, press, type FeaturedPress, type ListingPage } from '../../../data/dau-an';

interface Props {
  /** Set by trang/[page].astro; the first page otherwise. */
  page?: ListingPage<FeaturedPress>;
}

const { page = listingPage('bao-chi', press) } = Astro.props;
const first = page.currentPage === 1;
const [featured, ...rest] = first ? page.data : [];
const side = rest.slice(0, 2);
const tiles = first ? rest.slice(2) : page.data;
const href = (p: FeaturedPress) => `/dau-an/bao-chi/${p.slug}/`;
const title = dauAnPages.find((p) => p.href === '/dau-an/bao-chi/')!.title;

const meta = (p: FeaturedPress) => `${p.outlet} · ${formatDate(p.date)}`;
---
<BaseLayout
  title={first ? title : `${title} · ${txt.trang} ${page.currentPage}`}
  description={txt.bao_chi_mo_ta}
>
  <DauAnHead current="/dau-an/bao-chi/" />

  {featured && (
  <section class="press-lead" aria-label="Bài nổi bật">
    <div class="container press-feature__grid">
      <article class="feature">
        <a class="feature__media" href={href(featured)} tabindex="-1" aria-hidden="true">
          {featured.photo && (
          <img
            src={featured.photo.src}
            srcset={featured.photo.srcset}
            sizes="(min-width: 1024px) 62vw, 100vw"
            width={featured.photo.width}
            height={featured.photo.height}
            alt={featured.photo.alt}
            style={featured.photo.position ? `object-position: ${featured.photo.position}` : undefined}
            fetchpriority="high"
          />
          )}
        </a>
        <p class="eyebrow feature__meta">{meta(featured)}</p>
        <h2 class="feature__title"><a href={href(featured)}>{featured.headline}</a></h2>
        <p class="feature__intro">{featured.intro}</p>
        <a class="link-arrow feature__more" href={href(featured)} aria-label={`${txt.bao_chi_xem_bai}: ${featured.headline}`}>{txt.bao_chi_xem_bai} <Arrow /></a>
      </article>

      {side.length > 0 && (
      <div class="press-feature__side">
        {side.map((p) => (
          <article class="side">
            {p.photo && (
            <a class="side__media" href={href(p)} tabindex="-1" aria-hidden="true">
              <img
                src={p.photo.src}
                srcset={p.photo.srcset}
                sizes="(min-width: 1024px) 30vw, 100vw"
                width={p.photo.width}
                height={p.photo.height}
                alt={p.photo.alt}
                style={p.photo.position ? `object-position: ${p.photo.position}` : undefined}
              />
            </a>
            )}
            <p class="eyebrow side__meta">{meta(p)}</p>
            <h2 class="side__title"><a class="stretch" href={href(p)}>{p.headline}</a></h2>
            <p class="side__intro">{p.intro}</p>
          </article>
        ))}
      </div>
      )}
    </div>
  </section>
  )}

  <section class:list={['wall', { 'wall--more': !first }]} aria-labelledby="wall-title">
    <div class="container">
      {tiles.length > 0 && (<>
      <h2 class="eyebrow wall__head" id="wall-title">{first ? txt.bao_chi_bai_khac : `${txt.trang} ${page.currentPage}`}</h2>
      <ol class="wall__grid">
        {tiles.map((p) => (
          <li class:list={['tile', p.photo ? 'tile--photo' : p.kind === 'video' ? 'tile--video' : 'tile--text']} data-reveal>
            <article>
              {p.photo && (
                <div class="tile__media">
                  <img
                    src={p.photo.src}
                    srcset={p.photo.srcset}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
                    width={p.photo.width}
                    height={p.photo.height}
                    alt={p.photo.alt}
                    style={p.photo.position ? `object-position: ${p.photo.position}` : undefined}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <p class="eyebrow tile__meta">{p.kind === 'video' ? `${txt.phong_su_truyen_hinh} · ${p.outlet}` : p.outlet}</p>
              <h3 class="tile__title"><a class="stretch" href={href(p)}>{p.headline}</a></h3>
              <p class="tile__date">{p.kind === 'video' ? `${txt.dang_tai} ${formatDate(p.date)}` : formatDate(p.date)}</p>
              {!p.photo && <p class="tile__intro">{p.intro}</p>}
              {p.kind === 'video' && <p class="tile__cue" aria-hidden="true"><span class="tile__play"></span>{txt.xem_phong_su}</p>}
            </article>
          </li>
        ))}
      </ol>
      </>)}

      <Pager listing="bao-chi" currentPage={page.currentPage} lastPage={page.lastPage} />

      <p class="wall__archive">
        <a class="link-arrow" href="/dau-an/bao-chi/tu-lieu/">{txt.bao_chi_xem_toan_bo} <Arrow /></a>
        <span>{txt.bao_chi_tra_cuu}</span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Lead --------------------------------------------------------------- */
  .press-lead { padding-bottom: var(--space-2xl); }

  .press-feature__grid { display: grid; gap: var(--space-xl); }

  .feature { position: relative; display: grid; align-content: start; }

  .feature__media,
  .side__media,
  .tile__media {
    display: block;
    overflow: hidden;
    background: var(--color-cream);
  }
  .feature__media img,
  .side__media img,
  .tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }
  .feature__media { aspect-ratio: 3 / 2; }

  .feature__meta { margin-top: var(--space-m); }

  .feature__title {
    margin-top: var(--space-s);
    max-width: 20ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-h2);
    line-height: 1.12;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .feature__intro {
    margin-top: var(--space-s);
    max-width: 38rem;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .feature__more { margin-top: var(--space-m); justify-self: start; }
  .feature__more :global(.arrow) { width: 0.875rem; }

  .press-feature__side { display: grid; gap: var(--space-xl); align-content: start; }

  .side { position: relative; display: grid; align-content: start; }
  .side__media { aspect-ratio: 16 / 10; }
  .side__meta { margin-top: var(--space-s); }
  .side__title {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-product);
    line-height: 1.15;
    text-wrap: balance;
  }
  .side__intro {
    margin-top: var(--space-2xs);
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* Whole card is the link; the headline holds it. */
  .stretch::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .stretch:focus-visible { outline: none; }
  .side:has(.stretch:focus-visible),
  .tile:has(.stretch:focus-visible) { outline: 1px solid currentColor; outline-offset: 6px; }

  .feature__title a,
  .side__title a,
  .tile__title a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 500ms var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .feature:hover .feature__media img,
    .side:hover .side__media img,
    .tile:hover .tile__media img { transform: scale(1.03); }
  }
  .feature:hover .feature__title a,
  .side:hover .side__title a,
  .tile:hover .tile__title a { background-size: 100% 1px; }

  @media (min-width: 1024px) {
    .press-feature__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      column-gap: clamp(var(--space-l), 3vw, var(--space-2xl));
    }
  }

  /* Wall --------------------------------------------------------------- */
  .wall { padding-bottom: var(--section-y); }

  .wall__head {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line-strong);
  }

  .wall__grid {
    display: grid;
    gap: var(--space-xl) var(--col-gap);
    margin-top: var(--space-l);
  }

  .tile { position: relative; min-width: 0; }
  .tile article { display: grid; align-content: start; }

  .tile__media { aspect-ratio: var(--ratio, 4 / 3); margin-bottom: var(--space-s); }

  .tile__meta { font-size: 0.6875rem; }

  .tile__title {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-product);
    line-height: 1.15;
    text-wrap: balance;
  }

  .tile__date {
    margin-top: var(--space-2xs);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .tile__intro {
    margin-top: var(--space-s);
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* Headline cards: a typeset clipping on a cream field, no photograph. */
  .tile--text article,
  .tile--video article {
    padding: var(--space-m) var(--space-m) var(--space-l);
    background: var(--color-cream);
    border-top: 2px solid var(--color-forest);
  }
  .tile--text .tile__title,
  .tile--video .tile__title { font-size: var(--type-product); line-height: 1.15; }

  .tile--video article {
    background: var(--color-deep-green);
    color: var(--color-cream);
    border-top-color: var(--color-earth);
  }
  .tile--video .tile__meta { color: #C9B48F; }
  .tile--video .tile__date,
  .tile--video .tile__intro { color: var(--color-text-inverse-muted); }
  .tile__cue {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--space-m);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .tile__play {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0.4rem 0 0.4rem 0.65rem;
    border-color: transparent transparent transparent currentColor;
  }

  /* The way into the full archive: a quiet line under the wall. */
  .wall__archive {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line);
  }
  .wall__archive span {
    font-size: var(--type-small);
    color: var(--color-text-muted);
  }

  /* Later pages open on the wall. */
  .wall--more .wall__head { border-top: 0; padding-top: 0; }

  /* Tablet: two columns. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .wall__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  }

  /* Desktop: three columns; photographs share one ratio so rows line up. */
  @media (min-width: 1024px) {
    .wall__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      row-gap: var(--space-2xl);
    }
  }
</style>
