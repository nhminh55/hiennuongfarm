---
/**
 * Placeholder pages (src/data/drafts.ts), Vietnamese only.
 */
import DraftPage from '../components/draft/DraftPage.astro';
import { draftPages } from '../data/drafts';

export const getStaticPaths = () =>
  draftPages.map((page) => ({ params: { draft: page.path.slice(1, -1) }, props: { page } }));

const { page } = Astro.props;
---
<DraftPage page={page} />
