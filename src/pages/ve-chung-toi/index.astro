---
/**
 * /ve-chung-toi/ (and /en/, /zh/): the Hiền Nương story in six chapters.
 *
 * Copy: src/data/about.ts (Vietnamese from docs/HIEN_NUONG_ABOUT_VI.md).
 * Layout: design-reference/"Hiền Nương Farm chapter showcase.png".
 *
 * The chapters are ordinary stacked sections. On wide screens the script
 * below pins them into one stage (photograph left, text right) and lets
 * the scroll position choose the chapter, but only after measuring that
 * every chapter's text fits the screen; otherwise, and without script,
 * the stacked sections stay.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/page/Breadcrumb.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Arrow from '../../components/Arrow.astro';
import { aboutCopy, chapterMedia, peaksSource } from '../../data/about';
import { getLocale, localizePath, pageHref } from '../../i18n';

const lang = getLocale(Astro.url);
const t = aboutCopy[lang];

// The circular agriculture page is Vietnamese only for now; other
// languages go to the homepage section. Contact: the cooperation page's
// contact section (Vietnamese only; the homepage section elsewhere).
const circularHref = pageHref('/nong-nghiep-tuan-hoan/', lang, '/#tuan-hoan');
const contactHref = pageHref('/hop-tac/#lien-he', lang, '/#hop-tac');

const chapters = chapterMedia.map((media, i) => ({ ...media, ...t.chapters[i] }));

// Title phrases, split after a comma ("," or "，") so that a line never
// breaks inside a phrase ("thốt nốt").
const phrases = (title: string) => title.split(/(?<=[,，])\s*/);

const num = (i: number) => String(i + 1).padStart(2, '0');
---
<BaseLayout title={t.pageTitle} description={t.description}>
  <div class="about-page">
    <header class="intro">
      <div class="container intro__inner">
        <Breadcrumb items={[{ label: t.home, href: localizePath('/', lang) }, { label: t.pageTitle }]} />
        <div class="intro__head">
          <Eyebrow>{t.eyebrow}</Eyebrow>
          <h1 class="intro__title">{t.title}</h1>
        </div>
        <div class="intro__aside">
          <p class="intro__lead">{t.lead}</p>
          <p class="intro__cue" aria-hidden="true">{t.cue}</p>
        </div>
      </div>
    </header>

    <section class="story" aria-label={t.storyLabel} data-story>
      <div class="story__stage" data-story-stage>
        <nav class="story__nav" aria-label={t.navLabel}>
          <ol class="story__nav-list">
            {chapters.map((chapter, i) => (
              <li>
                <a class="story__nav-link" href={`#${chapter.id}`} data-chapter-link aria-current={i === 0 ? 'true' : undefined}>
                  <span class="story__nav-num">{num(i)}</span>
                  <span class="story__nav-label">{chapter.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        {chapters.map((chapter, i) => (
          <article
            class:list={['chapter', { 'is-active': i === 0 }]}
            id={chapter.id}
            aria-labelledby={`${chapter.id}-title`}
            data-chapter
          >
            <figure class="chapter__media">
              <div class="chapter__photo">
                <img
                  src={chapter.photo.src}
                  width={chapter.photo.width}
                  height={chapter.photo.height}
                  srcset={`${chapter.photo.src.replace('.webp', '-800.webp')} 800w, ${chapter.photo.src} ${chapter.photo.width}w`}
                  sizes="(min-width: 1024px) 58vw, (min-width: 768px) 50vw, 100vw"
                  alt={chapter.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  style={chapter.photo.position ? `--pos: ${chapter.photo.position}` : undefined}
                />
              </div>
              {chapter.caption && <figcaption class="chapter__caption">{chapter.caption}</figcaption>}
            </figure>

            <div class="chapter__text" data-chapter-text>
              <div class="chapter__content">
                <p class="chapter__kicker">
                  <span class="chapter__num">{num(i)}</span>
                  <span class="chapter__rule" aria-hidden="true"></span>
                  <span class="chapter__label">{chapter.label}</span>
                </p>
                <h2 class="chapter__title" id={`${chapter.id}-title`}>{phrases(chapter.title).map((phrase, j, all) => (
                  <>{j > 0 && !all[j - 1].endsWith('，') && ' '}<span class="chapter__phrase">{phrase}</span></>
                ))}</h2>

                <div class="chapter__body">
                  {chapter.body.map((p) => <p>{p}</p>)}
                </div>

                {chapter.facts.length > 0 && (
                  <dl class="chapter__facts">
                    {chapter.facts.map((fact) => (
                      <div class="fact">
                        <dt class="fact__value">{fact.pre && <span class="fact__pre">{fact.pre} </span>}{fact.value}</dt>
                        <dd class="fact__label">{fact.label}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                {chapter.more && (
                  <details class="more">
                    <summary class="more__summary">
                      <svg class="more__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" /><path d="M8 7.25v4.25M8 4.6v.3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                      <span class="more__label">{chapter.more.summary}</span>
                      <span class="more__sign" aria-hidden="true"></span>
                    </summary>
                    <div class="more__body">
                      <p>{chapter.more.intro}</p>
                      <ul class="more__list">
                        {chapter.more.items.map(([name, alt]) => (
                          <li><span class="more__name">{name}</span> — {alt}</li>
                        ))}
                      </ul>
                      <p class="more__source">
                        <a href={peaksSource} target="_blank" rel="noopener">{t.sourceLabel}: vannghe.angiang.gov.vn <span aria-hidden="true">↗</span><span class="sr-only"> ({t.newTab})</span></a>
                      </p>
                    </div>
                  </details>
                )}

                {chapter.steps && (
                  <ol class="chapter__steps">
                    {chapter.steps.map((step) => <li>{step}</li>)}
                  </ol>
                )}

                {chapter.linkLabel && (
                  <a class="link-arrow chapter__link" href={circularHref}>{chapter.linkLabel} <Arrow /></a>
                )}
              </div>
            </div>
          </article>
        ))}

      </div>
    </section>

    <section class="section closing" aria-labelledby="closing-title">
      <div class="container closing__grid">
        <div class="closing__heading" data-reveal>
          <Eyebrow>{t.closing.eyebrow}</Eyebrow>
          <h2 class="closing__title" id="closing-title">{t.closing.title}</h2>
        </div>
        <div class="closing__body" data-reveal style="--reveal-delay: 120ms">
          {t.closing.body.map((p) => <p>{p}</p>)}
          <a class="btn closing__btn" href={contactHref}>{t.closing.button} <Arrow /></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /**
   * Chapter stage. Wide screens pin the chapters into one stage whose
   * chapter follows the scroll position (no snapping, no autoplay); the
   * chapter links scroll to the same positions, so both stay in step in
   * either direction. The stage is used only when every chapter's text
   * fits it; otherwise the stacked sections stay and the links mark the
   * chapter being read.
   */
  const story = document.querySelector<HTMLElement>('[data-story]');
  const stage = story?.querySelector<HTMLElement>('[data-story-stage]');

  if (story && stage) {
    const chapters = [...story.querySelectorAll<HTMLElement>('[data-chapter]')];
    const links = [...story.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]')];
    const wide = window.matchMedia('(min-width: 1024px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Scroll distance per chapter, as a share of the stage height.
    const STEP = 0.85;

    let staged = false;
    let measured = false;
    let active = 0;
    let start = 0;
    let step = 1;

    const stickyTop = () => parseFloat(getComputedStyle(stage).top) || 0;

    const setActive = (index: number) => {
      chapters.forEach((chapter, i) => {
        if (i !== index && i === active) chapter.classList.add('is-leaving');
        else if (i === index || index !== active) chapter.classList.remove('is-leaving');
        chapter.classList.toggle('is-active', i === index);
      });
      links.forEach((link, i) => {
        if (i === index) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      active = index;
    };

    // The chapter being read: in the stage, by scroll distance; stacked,
    // the last chapter whose top has passed the upper third of the screen.
    const currentIndex = () => {
      if (staged) {
        const i = Math.round((window.scrollY - start) / step);
        return Math.min(chapters.length - 1, Math.max(0, i));
      }
      const line = window.innerHeight * 0.35;
      let index = 0;
      chapters.forEach((chapter, i) => {
        if (chapter.getBoundingClientRect().top <= line) index = i;
      });
      return index;
    };

    const positionOf = (index: number) => {
      if (staged) return start + index * step;
      const chapter = chapters[index];
      const margin = parseFloat(getComputedStyle(chapter).scrollMarginTop) || 0;
      return chapter.getBoundingClientRect().top + window.scrollY - margin;
    };

    const goTo = (index: number, smooth: boolean) => {
      window.scrollTo({
        top: Math.ceil(positionOf(index)),
        behavior: smooth && !reduce.matches ? 'smooth' : 'instant',
      });
    };

    // Each chapter's text must fit beside its photograph; with a
    // disclosure open, it may run below the photograph but must still fit
    // the stage above the chapter list.
    const disclosures = [...story.querySelectorAll<HTMLDetailsElement>('details')];
    const nav = story.querySelector<HTMLElement>('.story__nav');
    const contentHeights = () =>
      chapters.map((chapter) => chapter.querySelector<HTMLElement>('.chapter__content')?.offsetHeight ?? 0);
    const fits = () => {
      const wasOpen = disclosures.map((d) => d.open);
      disclosures.forEach((d) => { d.open = false; });
      const panel = chapters[0].querySelector<HTMLElement>('[data-chapter-text]')?.clientHeight ?? 0;
      const closed = contentHeights();
      disclosures.forEach((d) => { d.open = true; });
      const open = contentHeights();
      disclosures.forEach((d, i) => { d.open = wasOpen[i]; });
      const style = getComputedStyle(stage);
      const room = stage.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom) - (nav?.offsetHeight ?? 0);
      // 16px: the open text's bottom padding above the chapter list.
      return closed.every((h) => h <= panel + 1) && open.every((h) => h + 16 <= room + 1);
    };

    const measure = () => {
      if (!staged) {
        story.style.height = '';
        return;
      }
      step = Math.round(stage.offsetHeight * STEP);
      // One stage height, one step per further chapter, and a short dwell
      // on the last chapter before the stage scrolls away.
      story.style.height = `${stage.offsetHeight + (chapters.length - 1) * step + Math.round(step * 0.35)}px`;
      start = story.getBoundingClientRect().top + window.scrollY - stickyTop();
    };

    const layout = () => {
      const reading = active;
      const box = story.getBoundingClientRect();
      const inView = box.top < window.innerHeight && box.bottom > 0;
      const was = staged;
      // Re-measuring resets the story's height, which can pull the scroll
      // position back while the stage is pinned.
      const pinned = was && window.scrollY >= start - 1 && box.bottom > window.innerHeight;
      story.style.height = '';
      story.classList.remove('is-compact');
      story.classList.add('is-staged');
      staged = wide.matches && fits();
      // Screens a little short for the text try a tighter type step first.
      if (wide.matches && !staged) {
        story.classList.add('is-compact');
        staged = fits();
        if (!staged) story.classList.remove('is-compact');
      }
      story.classList.toggle('is-staged', staged);
      measure();
      // Keep the reader on the same chapter when the layout changes.
      if (measured && (pinned || (staged !== was && inView))) goTo(reading, false);
      measured = true;
      setActive(currentIndex());
    };

    let frame = 0;
    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        setActive(currentIndex());
      });
    };

    links.forEach((link, i) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        goTo(i, true);
        history.replaceState(null, '', `#${chapters[i].id}`);
      });
    });

    // Tabbing into a chapter that is not on screen brings it in.
    story.addEventListener('focusin', (event) => {
      if (!staged) return;
      const chapter = (event.target as HTMLElement).closest<HTMLElement>('[data-chapter]');
      const index = chapter ? chapters.indexOf(chapter) : -1;
      if (index >= 0 && index !== active) goTo(index, false);
    });

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(layout, 150);
    });
    window.addEventListener('scroll', onScroll, { passive: true });

    layout();
    story.classList.add('is-ready');

    // A link to a chapter (/ve-chung-toi/#bay-nui) opens on that chapter,
    // on load or from a link on this page (the header dropdown).
    const hashIndex = () => chapters.findIndex((chapter) => `#${chapter.id}` === window.location.hash);
    const target = hashIndex();
    if (target >= 0) goTo(target, false);
    window.addEventListener('hashchange', () => {
      const index = hashIndex();
      if (index >= 0) goTo(index, false);
    });

    // Text height depends on the web fonts.
    document.fonts?.ready.then(() => {
      layout();
      if (target >= 0 && staged) goTo(target, false);
    });
  }
</script>

<style>
  .about-page {
    /* Homepage display serif (Lora), as on the homepage. */
    --font-display: var(--font-editorial);
  }

  /* Opening ---------------------------------------------------------------- */

  .intro {
    padding-top: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    padding-bottom: clamp(2rem, 1.25rem + 3vw, 3.5rem);
  }

  .intro__inner {
    display: grid;
    row-gap: var(--space-m);
  }

  /* The pinned stage centres itself, which already leaves space above. */
  .intro:has(+ .story.is-staged) { padding-bottom: 0; }

  .intro__head { margin-top: clamp(1rem, 0.5rem + 2.5vw, 2.5rem); }

  .intro__title {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--color-deep-green);
  }

  .intro__lead {
    max-width: 30rem;
    text-wrap: balance;
    font-family: var(--font-display);
    font-size: var(--type-lead);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .intro__cue {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: var(--space-m);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .intro__cue::before {
    content: "";
    width: 1px;
    height: 1.25rem;
    background: var(--color-earth);
  }

  @media (min-width: 1024px) {
    .intro__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--col-gap);
      align-items: end;
    }
    .intro__inner > :global(.breadcrumb) { grid-column: 1 / -1; }
    .intro__aside { justify-self: end; padding-bottom: 0.4rem; }
  }

  /* Chapters: stacked (phones, tablets, short screens, no script) ---------- */

  .story { --nav-h: 0px; }

  .story__stage {
    display: flex;
    flex-direction: column;
    padding-inline: var(--gutter);
  }

  .story__nav {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .story__nav-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
  }

  .story__nav-link {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding-block: 0.75rem;
    font-size: var(--type-small);
    line-height: 1.4;
    color: var(--color-text-muted);
    transition: color 300ms var(--ease);
  }
  .story__nav-link:hover { color: var(--color-text); }

  .story__nav-num {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  /* Active chapter: an earth rule under the label. */
  .story__nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-earth);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease);
  }
  .story.is-ready .story__nav-link[aria-current]::after { transform: none; }
  .story.is-ready .story__nav-link[aria-current] { color: var(--color-text); }
  /* Without script nothing tracks the reading position; on phones the
     list is not held on screen, so it marks nothing either. */
  .story:not(.is-ready) .story__nav-link::after { display: none; }
  @media (max-width: 767px) {
    .story__nav-link::after { display: none; }
  }

  .chapter {
    padding-block: var(--space-2xl);
    scroll-margin-top: calc(var(--header-h) + var(--nav-h));
  }
  .chapter + .chapter { border-top: 1px solid var(--color-line); }

  .chapter__media {
    position: relative;
    margin-inline: calc(-1 * var(--gutter));
  }

  .chapter__photo {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-cream);
  }

  .chapter__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
  }

  .chapter__caption {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.625rem 1rem;
    background: var(--color-paper);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--color-text);
  }

  .chapter__text { margin-top: var(--space-l); }

  .chapter__content {
    --gap: var(--space-m);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 36rem;
  }
  .chapter__content > * + * { margin-top: var(--gap); }

  .chapter__kicker {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--color-earth);
  }

  .chapter__num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .chapter__rule {
    width: 2.75rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .chapter__label {
    font-size: var(--type-eyebrow);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .chapter__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem);
    line-height: 1.14;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--color-deep-green);
  }

  /* Keep each phrase of a comma title on one line where it fits. */
  .chapter__phrase { display: inline-block; }

  .chapter__body {
    font-size: var(--type-body);
    line-height: 1.68;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .chapter__body p + p { margin-top: 0.8em; }

  .chapter__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
  }

  /* Large value with its label underneath, as in the reference. */
  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fact__value {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 3rem + 2vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-earth);
    white-space: nowrap;
  }

  .fact__pre {
    margin-right: 0.15em;
    font-size: 0.5em;
    letter-spacing: 0.02em;
  }

  /* A thin rule keeps each value with its own label. */
  .fact + .fact {
    padding-left: var(--space-l);
    border-left: 1px solid var(--color-line);
  }

  .fact__label {
    max-width: 16rem;
    text-wrap: balance;
    font-size: var(--type-small);
    line-height: 1.45;
    color: var(--color-text);
  }

  /* By-product → substrate → harvest → worm feed → fertiliser → back to growing. */
  .chapter__steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-line);
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--color-text);
  }
  .chapter__steps li:not(:last-child)::after {
    content: "→" / "";
    margin-inline: 0.625rem;
    color: var(--color-earth);
  }

  .chapter__link { text-transform: uppercase; }

  /* "Bảy Núi gồm những ngọn nào?": a quiet inline disclosure. */
  .more { width: 100%; }

  .more__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    font-size: var(--type-small);
    line-height: 1.4;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }
  .more__summary::-webkit-details-marker { display: none; }

  .more__icon {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--color-earth);
  }

  .more__label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.3em;
    transition: text-decoration-color 300ms var(--ease);
  }
  .more__summary:hover .more__label { text-decoration-color: currentColor; }

  /* Plus that turns into a minus when open. */
  .more__sign {
    position: relative;
    width: 0.625rem;
    height: 0.625rem;
    margin-left: 0.25rem;
    flex: none;
    color: var(--color-earth);
  }
  .more__sign::before,
  .more__sign::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: currentColor;
  }
  .more__sign::after { transform: rotate(90deg); transition: transform 300ms var(--ease); }
  .more[open] .more__sign::after { transform: rotate(90deg) scaleX(0); }

  .more__body {
    padding: 0.5rem 0 0 1.5rem;
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .more__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    gap: 0.25rem var(--space-m);
    margin-top: 0.625rem;
    line-height: 1.5;
  }
  .more__name { color: var(--color-text); }

