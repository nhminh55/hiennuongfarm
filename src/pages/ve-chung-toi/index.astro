---
/**
 * /ve-chung-toi/ (and /en/, /zh/): the Hiền Nương story, one continuous
 * page in six chapters.
 *
 * Copy: the six Markdown files in src/content/about/ (Vietnamese), read by
 * src/data/about.ts; every paragraph is rendered once, in order.
 * Layout: design-reference/About/"Hiền Nương Farm_ From Soil to Community.png"
 * (editorial direction only; its text and photographs are placeholders).
 *
 * The page scrolls as a normal document. A chapter bar under the header
 * links to the chapters (#cau-chuyen … #con-nguoi) with ordinary anchors,
 * so direct links and Back/Forward work as usual; the script only marks
 * the chapter being read.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/page/Breadcrumb.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Arrow from '../../components/Arrow.astro';
import AboutPhoto from '../../components/about/AboutPhoto.astro';
import { aboutCopy, photos, storyChapters } from '../../data/about';
import { getLocale, localizePath, pageHref } from '../../i18n';

const lang = getLocale(Astro.url);
const t = aboutCopy[lang];
const m = t.media;

// The circular agriculture page is Vietnamese only for now; other
// languages go to the homepage section. Contact: the cooperation page's
// contact section (Vietnamese only; the homepage section elsewhere).
const circularHref = pageHref('/nong-nghiep-tuan-hoan/', lang, '/#tuan-hoan');
const contactHref = pageHref('/hop-tac/#lien-he', lang, '/#hop-tac');

const [story, region, sites, energy, cycle, people] = storyChapters(lang);

// 01: the founders and ông Tư Phú open beside the photograph; the rest of
// the chapter continues below. The quotation is lifted beside its paragraph.
const storyOpen = story.paragraphs.slice(0, 2);
const storyRest = story.paragraphs.slice(2);
const quoteAt = t.quote ? storyRest.findIndex((p) => p.includes(t.quote!)) : -1;
if (t.quote && quoteAt < 0) throw new Error('about: the 01 quotation is not in the chapter text');

// 03: the two sites open beside their photographs.
const sitesOpen = sites.paragraphs.slice(0, 2);
const sitesRest = sites.paragraphs.slice(2);

// 06 (Vietnamese): chị Quách Thị Hồng Liên's story, paragraphs 3–4 of the
// file, is set apart from the paragraphs around it.
const feature = lang === 'vi' ? [2, 4] : null;
if (feature && !people.paragraphs[feature[0]].includes('Quách Thị Hồng Liên')) {
  throw new Error('about: 06 no longer has chị Liên’s story at paragraph 3; update `feature`');
}
const peopleBefore = feature ? people.paragraphs.slice(0, feature[0]) : people.paragraphs;
const peopleFeature = feature ? people.paragraphs.slice(feature[0], feature[1]) : [];
const peopleAfter = feature ? people.paragraphs.slice(feature[1]) : [];

// Title phrases, split after a comma ("," or "，") so that a line never
// breaks inside a phrase ("thốt nốt").
const phrases = (title: string) => title.split(/(?<=[,，])\s*/);

// The film's name without its closing full stop, for its button and player.
const filmName = t.film.title.replace(/[.。]$/, '');

const half = '(min-width: 1200px) 45vw, 100vw';
---
<BaseLayout title={t.pageTitle} description={t.description}>
  <div class="about-page">
    <header class="hero">
      <div class="hero__text">
        <Breadcrumb items={[{ label: t.home, href: localizePath('/', lang) }, { label: t.pageTitle }]} />
        <div class="hero__head">
          <Eyebrow>{t.eyebrow}</Eyebrow>
          <h1 class="hero__title">{t.title}</h1>
          <p class="hero__lead">{t.lead}</p>
        </div>
      </div>
      <AboutPhoto class="hero__photo" photo={photos.hero} alt={t.heroAlt} ratio="auto" sizes="(min-width: 768px) 60vw, 100vw" eager />
    </header>

    <div class="story">
      <nav class="chapter-nav" aria-label={t.navLabel} data-chapter-nav>
        <ol class="chapter-nav__list" data-chapter-list>
          {[story, region, sites, energy, cycle, people].map((chapter, i) => (
            <li>
              <a class="chapter-nav__link" href={`#${chapter.id}`} data-chapter-link>
                <span class="chapter-nav__num">{chapter.num}</span>
                <span class="chapter-nav__label">{t.nav[i]}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- 01 · Câu chuyện: photograph beside the opening, narrative below. -->
      <section class="chapter chapter--story" id={story.id} aria-labelledby={`${story.id}-title`} data-chapter>
        <div class="container chapter__grid">
          <AboutPhoto class="chapter__media" photo={photos.founders} alt={m.founders.alt} ratio="4 / 3" sizes={half} />
          <div class="chapter__head">
            <p class="chapter__kicker"><span class="chapter__num">{story.num}</span><span class="chapter__rule" aria-hidden="true"></span><span class="chapter__label">{story.label}</span></p>
            <h2 class="chapter__title" id={`${story.id}-title`}>{story.title}</h2>
            <div class="prose">{storyOpen.map((p) => <p>{p}</p>)}</div>
          </div>
          <div class="chapter__body prose">
            {storyRest.map((p, i) => i === quoteAt ? (
              <div class="quoted">
                <blockquote class="pullquote" aria-hidden="true"><p>{t.quote}</p></blockquote>
                <p>{p}</p>
              </div>
            ) : <p>{p}</p>)}
          </div>
        </div>
      </section>

      <!-- 02 · Bảy Núi: the landscape first, then the region and its peaks. -->
      <section class="chapter chapter--region" id={region.id} aria-labelledby={`${region.id}-title`} data-chapter>
        <AboutPhoto class="chapter__panorama" photo={photos.bayNui} alt={m.bayNui.alt} ratio="auto" sizes="100vw" />
        <div class="container chapter__grid">
          <div class="chapter__head">
            <p class="chapter__kicker"><span class="chapter__num">{region.num}</span><span class="chapter__rule" aria-hidden="true"></span><span class="chapter__label">{region.label}</span></p>
            <h2 class="chapter__title" id={`${region.id}-title`}>{phrases(region.title).map((phrase, j, all) => (
              <>{j > 0 && !all[j - 1].endsWith('，') && ' '}<span class="chapter__phrase">{phrase}</span></>
            ))}</h2>
          </div>
          <div class="chapter__body">
            <div class="prose">{region.paragraphs.map((p) => <p>{p}</p>)}</div>
            {region.more && (
              <details class="more">
                <summary class="more__summary">
                  <svg class="more__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" /><path d="M8 7.25v4.25M8 4.6v.3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                  <span class="more__label">{region.more.summary}</span>
                  <span class="more__sign" aria-hidden="true"></span>
                </summary>
                <div class="more__body">
                  <p>{region.more.intro}</p>
                  <table class="more__table">
                    {region.more.head && (
                      <thead><tr><th scope="col">{region.more.head[0]}</th><th scope="col">{region.more.head[1]}</th></tr></thead>
                    )}
                    <tbody>
                      {region.more.rows.map(([name, alt]) => (
                        <tr><th scope="row">{name}</th><td>{alt}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            )}
          </div>
        </div>
      </section>

      <!-- 03 · Hai cơ sở: text beside the two sites' photographs. -->
      <section class="chapter chapter--sites" id={sites.id} aria-labelledby={`${sites.id}-title`} data-chapter>
        <div class="container chapter__grid">
          <div class="chapter__head">
            <p class="chapter__kicker"><span class="chapter__num">{sites.num}</span><span class="chapter__rule" aria-hidden="true"></span><span class="chapter__label">{sites.label}</span></p>
            <h2 class="chapter__title" id={`${sites.id}-title`}>{sites.title}</h2>
            <div class="prose">{sitesOpen.map((p) => <p>{p}</p>)}</div>
          </div>
          <div class="chapter__media">
            <div class="chapter__media-hold sites-photos">
              <AboutPhoto photo={photos.thoiSon} alt={m.thoiSon.alt} caption={m.thoiSon.caption} ratio="4 / 5" sizes="(min-width: 1200px) 22vw, (min-width: 560px) 50vw, 100vw" />
              <AboutPhoto photo={photos.taDanh} alt={m.taDanh.alt} caption={m.taDanh.caption} ratio="4 / 5" sizes="(min-width: 1200px) 22vw, (min-width: 560px) 50vw, 100vw" />
            </div>
          </div>
          <div class="chapter__body prose">{sitesRest.map((p) => <p>{p}</p>)}</div>
        </div>
      </section>

      <!-- 04 · Năng lượng: the solar roofs, to the edge of the screen. -->
      <section class="chapter chapter--energy" id={energy.id} aria-labelledby={`${energy.id}-title`} data-chapter>
        <div class="container chapter__grid">
          <div class="chapter__media">
            <div class="chapter__media-hold">
              <AboutPhoto photo={photos.solar} alt={m.solar.alt} ratio="4 / 3" sizes={half} />
            </div>
          </div>
          <div class="chapter__head">
            <p class="chapter__kicker"><span class="chapter__num">{energy.num}</span><span class="chapter__rule" aria-hidden="true"></span><span class="chapter__label">{energy.label}</span></p>
            <h2 class="chapter__title" id={`${energy.id}-title`}>{energy.title}</h2>
            <div class="prose">{energy.paragraphs.map((p) => <p>{p}</p>)}</div>
          </div>
        </div>
      </section>

      <!-- 05 · Tuần hoàn: narrative beside the substrate photographs. -->
      <section class="chapter chapter--cycle" id={cycle.id} aria-labelledby={`${cycle.id}-title`} data-chapter>
        <div class="container chapter__grid">
          <div class="chapter__head">
            <p class="chapter__kicker"><span class="chapter__num">{cycle.num}</span><span class="chapter__rule" aria-hidden="true"></span><span class="chapter__label">{cycle.label}</span></p>
            <h2 class="chapter__title" id={`${cycle.id}-title`}>{phrases(cycle.title).map((phrase, j, all) => (
              <>{j > 0 && !all[j - 1].endsWith('，') && ' '}<span class="chapter__phrase">{phrase}</span></>
            ))}</h2>
            <div class="prose">{cycle.paragraphs.map((p) => <p>{p}</p>)}</div>
            <a class="link-arrow chapter__link" href={circularHref}>{t.circularLink} <Arrow /></a>
          </div>
          <div class="chapter__media">
            <div class="chapter__media-hold cycle-photos">
              <AboutPhoto photo={photos.substrate} alt={m.substrate.alt} caption={m.substrate.caption} ratio="3 / 2" sizes={half} />
              <AboutPhoto class="cycle-photos__detail" photo={photos.bags} alt={m.bags.alt} caption={m.bags.caption} ratio="4 / 3" sizes="(min-width: 1200px) 25vw, 60vw" />
            </div>
          </div>
        </div>
      </section>

      <!-- 06 · Con người: the people at work, then their story. -->
      <section class="chapter chapter--people" id={people.id} aria-labelledby={`${people.id}-title`} data-chapter>
        <div class="container">
          <div class="people-photos">
            <AboutPhoto photo={photos.team} alt={m.team.alt} caption={m.team.caption} ratio="3 / 2" sizes="(min-width: 768px) 58vw, 100vw" />
            <AboutPhoto photo={photos.harvest} alt={m.harvest.alt} caption={m.harvest.caption} ratio="auto" sizes="(min-width: 768px) 42vw, 100vw" />
          </div>
        </div>
        <div class="container chapter__grid">
          <div class="chapter__head">
            <p class="chapter__kicker"><span class="chapter__num">{people.num}</span><span class="chapter__rule" aria-hidden="true"></span><span class="chapter__label">{people.label}</span></p>
            <h2 class="chapter__title" id={`${people.id}-title`}>{phrases(people.title).map((phrase, j, all) => (
              <>{j > 0 && !all[j - 1].endsWith('，') && ' '}<span class="chapter__phrase">{phrase}</span></>
            ))}</h2>
          </div>
          <div class="chapter__body">
            <div class="prose">{peopleBefore.map((p) => <p>{p}</p>)}</div>
            {peopleFeature.length > 0 && (
              <div class="prose chapter__feature">{peopleFeature.map((p) => <p>{p}</p>)}</div>
            )}
            {peopleAfter.length > 0 && <div class="prose">{peopleAfter.map((p) => <p>{p}</p>)}</div>}
          </div>
        </div>
      </section>
    </div>

    <!-- Intro film (header dropdown: Video giới thiệu). The player loads
         only when the reader presses play; nothing plays on its own. -->
    <section class="section film" aria-labelledby="film-title">
      <div class="container">
        <div class="film__head" data-reveal>
          <Eyebrow>{t.film.eyebrow}</Eyebrow>
          <h2 class="film__title" id="film-title">{t.film.title}</h2>
        </div>

        <!-- The anchor sits outside the reveal, whose slide would move the
             landing point. -->
        <div class="film__anchor" id="video-gioi-thieu">
          <div class="film__media" data-reveal style="--reveal-delay: 120ms" data-film>
            <button
              class="film__poster"
              type="button"
              aria-label={`${t.film.watch}: ${filmName} (02:23)`}
              data-player-title={`Hiền Nương Farm — ${filmName}`}
              data-film-play
            >
              <img
                src="/images/farm/bay-nui-canh-dong.webp"
                width="1672"
                height="941"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="film__play" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 4v16l13-8z" /></svg>
              </span>
              <span class="film__meta" aria-hidden="true">{t.film.watch} · 02:23</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="section closing" aria-labelledby="closing-title">
      <div class="container closing__grid">
        <div class="closing__heading" data-reveal>
          <Eyebrow>{t.closing.eyebrow}</Eyebrow>
          <h2 class="closing__title" id="closing-title">{t.closing.title}</h2>
        </div>
        <div class="closing__body" data-reveal style="--reveal-delay: 120ms">
          {t.closing.body.map((p) => <p>{p}</p>)}
          <a class="btn closing__btn" href={contactHref}>{t.closing.button} <Arrow /></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /**
   * Chapter bar: marks the chapter being read (aria-current) as the page
   * scrolls. Links are plain anchors, so the browser handles direct
   * links, history and focus; nothing here moves the page.
   */
  const nav = document.querySelector<HTMLElement>('[data-chapter-nav]');
  const list = nav?.querySelector<HTMLElement>('[data-chapter-list]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]')];
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (nav && list && chapters.length === links.length) {
    let active = -2;

    // On narrow screens the bar scrolls sideways: keep the marked link in it.
    const reveal = (link: HTMLElement) => {
      if (list.scrollWidth <= list.clientWidth) return;
      const left = link.offsetLeft - (list.clientWidth - link.offsetWidth) / 2;
      list.scrollTo({ left: Math.max(0, left), behavior: reduce.matches ? 'auto' : 'smooth' });
    };

    // The chapter whose top has passed a line a quarter of the way down
    // the screen below the bar; none above the first chapter.
    const update = () => {
      const line = nav.getBoundingClientRect().bottom + (window.innerHeight - nav.getBoundingClientRect().bottom) * 0.25;
      let index = -1;
      chapters.forEach((chapter, i) => {
        if (chapter.getBoundingClientRect().top <= line) index = i;
      });
      if (index === active) return;
      active = index;
      links.forEach((link, i) => {
        if (i === index) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (index >= 0) reveal(links[index]);
    };

    let frame = 0;
    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        update();
      });
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('hashchange', schedule);
    update();
    nav.classList.add('is-ready');
  }

  // Film: the player replaces the poster only when asked to play.
  const film = document.querySelector<HTMLElement>('[data-film]');
  const filmPlay = film?.querySelector<HTMLButtonElement>('[data-film-play]');
  filmPlay?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube-nocookie.com/embed/V-jPu_G8fe8?autoplay=1&playsinline=1&rel=0';
    iframe.title = filmPlay.dataset.playerTitle ?? '';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.className = 'film__player';
    film!.replaceChildren(iframe);
    iframe.focus({ preventScroll: true });
  }, { once: true });
</script>

<style>
  .about-page {
    /* Homepage display serif (Lora), as on the homepage. */
    --font-display: var(--font-editorial);
    /* Chapter bar height; chapters land just below it. */
    --nav-h: 2.75rem;
    /* Space between the text and photograph columns. */
    --split-gap: clamp(3.5rem, 5vw, 5.5rem);
  }
  @media (min-width: 1024px) {
    .about-page { --nav-h: 3.25rem; }
  }

  /* Opening: compact landscape --------------------------------------------- */

  .hero {
    display: grid;
    border-bottom: 1px solid var(--color-line);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.5rem) var(--gutter) var(--space-xl);
  }

  .hero__title {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-title);
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-wrap: balance;
    color: var(--color-deep-green);
  }

  .hero__lead {
    margin-top: var(--space-s);
    max-width: 26rem;
    text-wrap: balance;
    font-family: var(--font-display);
    font-size: var(--type-lead);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .hero :global(.hero__photo .about-photo__frame) { aspect-ratio: 16 / 9; }

  @media (min-width: 768px) {
    /* Text on the left within the page margin; the photograph runs to
       the right edge of the screen. */
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      min-height: clamp(20rem, 34vw, 30rem);
    }
    .hero__text {
      justify-content: space-between;
      padding-left: max(var(--gutter), calc((100% - var(--container)) / 2));
      padding-right: var(--space-l);
      padding-bottom: var(--space-l);
    }
    .hero :global(.hero__photo),
    .hero :global(.hero__photo .about-photo__frame) { height: 100%; }
    .hero :global(.hero__photo .about-photo__frame) { aspect-ratio: auto; }
  }

  /* Chapter bar --------------------------------------------------------- */

  .chapter-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }

  .chapter-nav__list {
    position: relative;
    display: flex;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chapter-nav__list::-webkit-scrollbar { display: none; }

  .chapter-nav__list > li { flex: none; }

  .chapter-nav__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: var(--nav-h);
    padding-inline: 0.75rem;
    white-space: nowrap;
    font-size: var(--type-small);
    color: var(--color-text-muted);
    transition: color 300ms var(--ease);
  }
  .chapter-nav__list > li:first-child .chapter-nav__link { padding-left: 0; }
  .chapter-nav__link:hover { color: var(--color-text); }
  .chapter-nav__link:focus-visible { outline: 2px solid var(--color-forest); outline-offset: -2px; }

  .chapter-nav__num {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    color: var(--color-earth);
  }

  /* The chapter being read: an earth rule along the bar's lower edge. */
  .chapter-nav__link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: -1px;
    height: 2px;
    background: var(--color-earth);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease);
  }
  .chapter-nav__list > li:first-child .chapter-nav__link::after { left: 0; }
  .chapter-nav__link[aria-current] { color: var(--color-text); }
  .chapter-nav__link[aria-current]::after { transform: none; }

  @media (min-width: 1024px) {
    /* Six equal places across the page. */
    .chapter-nav__list { justify-content: space-between; }
    .chapter-nav__link { padding-inline: 0.25rem; }
    .chapter-nav__link::after { left: 0.25rem; right: 0.25rem; }
  }

  /* Chapters: shared ------------------------------------------------------ */

  .story .chapter {
    padding-block: var(--section-y);
    scroll-margin-top: calc(var(--header-h) + var(--nav-h));
  }
  /* A thin rule, the width of the text, between chapters that do not
     open on a full-width photograph. */
  .story .chapter:not(.chapter--story, .chapter--region)::before {
    content: "";
    display: block;
    width: min(100% - 2 * var(--gutter), var(--container));
    height: 1px;
    margin: calc(-1 * clamp(3.5rem, 2rem + 5vw, 6.5rem)) auto clamp(3.5rem, 2rem + 5vw, 6.5rem);
    background: var(--color-line);
  }

  .chapter__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-xl);
  }

  .chapter__kicker {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--color-earth);
  }

  .chapter__num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .chapter__rule {
    width: 2.75rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .chapter__label {
    font-size: var(--type-eyebrow);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .chapter__title {
    margin-top: var(--space-m);
    max-width: 20ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-h2);
    line-height: 1.12;
    letter-spacing: -0.005em;
    text-wrap: balance;
    color: var(--color-deep-green);
  }

  /* Keep each phrase of a comma title on one line where it fits. */
  .chapter__phrase { display: inline-block; }

  .chapter__head > .prose { margin-top: var(--space-l); }

  /* Long-form reading: one left-aligned column of about 55–75 characters. */
  .prose {
    max-width: 36rem;
    font-size: var(--type-body);
    line-height: 1.65;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .prose > * + *,
  .prose + .prose { margin-top: 1.1em; }

