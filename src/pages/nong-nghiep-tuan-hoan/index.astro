---
/**
 * /nong-nghiep-tuan-hoan/ (and /en/, /zh/ through src/pages/[lang]/): the
 * farm's circular model.
 *
 * Vietnamese copy: owner-approved step brief for this page; solar copy from
 * docs/HIEN_NUONG_ABOUT_VI.md §04; product and closing lines reuse the
 * published /san-pham/ and /ve-chung-toi/ wording. English and Chinese are
 * translations of the same copy, with the step names, motto, product names
 * and film labels already used on the homepage and /san-pham/.
 *
 * The cycle is a wheel of five steps. Choosing a step turns the wheel the
 * short way round until that step sits at about 2 o'clock, beside its
 * explanation; the steps travel round the circle but stay upright, and the
 * arrows between them are redrawn each frame so they never cross a label.
 * Without script the five explanations are listed in order.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/page/Breadcrumb.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Arrow from '../../components/Arrow.astro';
import PlayInvite from '../../components/farm-play/PlayInvite.astro';
import { getLocale, localizePath, pageHref } from '../../i18n';
import { copy } from '../../data/copy';

const lang = getLocale(Astro.url);

// The cooperation page is Vietnamese only; other languages go to the
// homepage cooperation section.
const contactHref = pageHref('/hop-tac/', lang, '/#hop-tac');

interface Step {
  title: string;
  /** Wheel label, with its line break. */
  name: string;
  /** One-line summary under the title. */
  lead: string;
  text: string[];
}

// Facts: OWNER-VERIFIED. Keep the 100% to the electricity used for growing
// mushrooms, and the founders' names in this order.
// Copy: src/content/tuan-hoan/nong-nghiep-tuan-hoan.md.
const t = copy('tuan-hoan/nong-nghiep-tuan-hoan', lang);

// Six steps, in order round the wheel (clockwise). Each has a round picture
// for the wheel (-cartoon) and a square one, its paper edge drawn in, for
// its explanation (-mep-giay).
const icons = ['01-phu-pham', '02-gia-the', '03-cay-meo-u-phoi', '04-nuoi-trong-thu-hoach', '05-gia-the-nuoi-trun', '06-phan-trun-bon-cay'];
const steps = t.steps.map((step, i) => ({
  ...step,
  icon: icons[i],
}));

// Wheel geometry, shared with the script through CSS (--radius, --anchor):
// node centres sit on a circle of RADIUS % of the wheel's width, and the
// chosen step turns to ANCHOR degrees clockwise from 12 o'clock.
const RADIUS = 37;
const ANCHOR = 60;
const at = (i: number) => {
  const a = ((ANCHOR + i * (360 / steps.length)) * Math.PI) / 180;
  return { x: (RADIUS * Math.sin(a)).toFixed(3), y: (-RADIUS * Math.cos(a)).toFixed(3) };
};

const num = (i: number) => String(i + 1).padStart(2, '0');
// A longer motto (English) is set a size smaller, clear of the labels.
const longMotto = Math.max(...t.motto.map((line) => line.length)) > 12;
// The film's name without its closing full stop, for its button and player.
const filmName = t.filmTitle.replace(/[.。]$/, '');
---
<BaseLayout title={t.pageTitle} description={t.description}>
  <div class="circular-page">
    <header class="intro">
      <div class="container intro__inner">
        <Breadcrumb items={[{ label: t.home, href: localizePath('/', lang) }, { label: t.pageTitle }]} />
        <div class="intro__head" data-reveal>
          <Eyebrow>{t.pageTitle}</Eyebrow>
          <h1 class="intro__title">{t.title}</h1>
        </div>
        <p class="intro__lead" data-reveal style="--reveal-delay: 120ms">{t.lead}</p>
      </div>
    </header>

    <!-- 1 · The wheel ---------------------------------------------------- -->
    <section class="cycle" id="vong-tuan-hoan" aria-labelledby="cycle-title" data-cycle data-live-template={t.live}>
      <div class="container">
        <h2 class="eyebrow cycle__title" id="cycle-title">
          <span class="eyebrow__rule" aria-hidden="true"></span>
          <span>{t.cycleTitle}</span>
        </h2>

        <div class="cycle__grid">
          <div class="cycle__wheel" data-reveal style="--reveal-delay: 80ms">
            <div class="wheel" style={`--radius: ${RADIUS}; --anchor: ${ANCHOR}`} data-wheel>
              <svg class="wheel__arrows" viewBox="-500 -500 1000 1000" aria-hidden="true" focusable="false">
                <defs>
                  <marker id="wheel-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" markerUnits="strokeWidth" orient="auto">
                    <path d="M1.5 1.5 L8.5 5 L1.5 8.5" />
                  </marker>
                </defs>
                {steps.map(() => <path class="wheel__arrow" d="" marker-end="url(#wheel-arrow)" data-arrow />)}
              </svg>

              <p class:list={['wheel__motto', { 'wheel__motto--long': longMotto }]}>{t.motto[0]}<br />{t.motto[1]}</p>

              <div class="wheel__nodes" role="tablist" aria-label={t.stepsLabel}>
                {steps.map((step, i) => (
                  <button
                    class:list={['wheel__node', { 'is-selected': i === 0 }]}
                    type="button"
                    role="tab"
                    id={`cycle-tab-${i + 1}`}
                    aria-controls={`cycle-step-${i + 1}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    style={`--x: ${at(i).x}; --y: ${at(i).y}`}
                    data-node
                  >
                    <span class="wheel__num">{num(i)}</span>
                    <span class="wheel__img">
                      <img
                        src={`/images/circular/steps/${step.icon}-cartoon.webp`}
                        alt=""
                        width="320"
                        height="320"
                        decoding="async"
                      />
                    </span>
                    <!-- The label breaks onto two lines; the tab's name is the step's title. -->
                    <span class="wheel__label" aria-hidden="true">{step.name}</span>
                    <span class="sr-only">{step.title}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div class="cycle__detail" data-reveal style="--reveal-delay: 160ms">
            <div class="cycle__panels">
              {steps.map((step, i) => (
                <div
                  class:list={['step', { 'is-active': i === 0 }]}
                  id={`cycle-step-${i + 1}`}
                  role="tabpanel"
                  aria-labelledby={`cycle-tab-${i + 1}`}
                  tabindex="0"
                  data-panel
                >
                  <p class="step__kicker" aria-hidden="true">{num(i)} / {num(steps.length - 1)}</p>
                  <h3 class="step__title">{step.title}</h3>
                  <p class="step__lead">{step.lead}</p>
                  {step.text.map((para) => <p class="step__text">{para}</p>)}
                  <img
                    class="step__img"
                    src={`/images/circular/steps/${step.icon}-mep-giay.webp`}
                    alt=""
                    width="640"
                    height="640"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))}
            </div>

            <div class="cycle__controls">
              <button class="cycle__control cycle__control--prev" type="button" data-prev>
                <Arrow />
                <span>{t.prev}</span>
              </button>
              <button class="cycle__control" type="button" data-next>
                <span>{t.next}</span>
                <Arrow />
              </button>
            </div>
            <p class="sr-only" aria-live="polite" data-live></p>
          </div>
        </div>
      </div>
    </section>

    <PlayInvite title={t.playCycle.title} line={t.playCycle.line} label={t.playCycle.label} slug="mot-vong-nong-trai" />

    <!-- Farm experience (header dropdown: Trải nghiệm nông trại) ------- -->
    <section class="section film" id="trai-nghiem-nong-trai" aria-labelledby="film-title">
      <div class="container film__grid">
        <div class="film__head" data-reveal>
          <Eyebrow>{t.filmEyebrow}</Eyebrow>
          <h2 class="section-title" id="film-title">{t.filmTitle}</h2>
          <div class="section-body"><p>{t.filmBody}</p></div>
          <p class="film__note">{t.filmNote}</p>
        </div>

        <!-- A visit to the mushroom farm (YouTube). The player loads only
             when the reader presses play; nothing plays on its own. -->
        <div class="film__media" data-reveal style="--reveal-delay: 120ms" data-film>
          <button
            class="film__poster"
            type="button"
            aria-label={`${t.watch}: ${filmName}`}
            data-player-title={`Hiền Nương Farm — ${filmName}`}
            data-film-play
          >
            <img
              src="/images/farm/kham-pha-trang-trai-nam.webp"
              width="1280"
              height="720"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <span class="film__play" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 4v16l13-8z" /></svg>
            </span>
          </button>
        </div>
      </div>
    </section>

    <!-- 3 · Solar --------------------------------------------------------- -->
    <section class="section solar" id="nang-luong-mat-troi" aria-labelledby="solar-title">
      <div class="container solar__grid">
        <div class="solar__text" data-reveal>
          <Eyebrow>{t.solarEyebrow}</Eyebrow>
          <h2 class="section-title" id="solar-title">{t.solarTitle}</h2>
          <div class="section-body">
            {t.solarBody.map((p) => <p>{p}</p>)}
          </div>
          <!-- OWNER-VERIFIED: 100% of the electricity used for growing mushrooms. -->
          <dl class="solar__fact">
            <dt class="solar__value">100%</dt>
            <dd class="solar__label">{t.solarFact}</dd>
          </dl>
        </div>

        <figure class="solar__figure" data-reveal style="--reveal-delay: 120ms">
          <div class="solar__photo">
            <img
              src="/images/about/mai-dien-mat-troi.webp"
              srcset="/images/about/mai-dien-mat-troi-800.webp 800w, /images/about/mai-dien-mat-troi.webp 1430w"
              sizes="(min-width: 1024px) 55vw, 100vw"
              width="1430"
              height="804"
              alt={t.solarAlt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="solar__caption">{t.solarCaption}</figcaption>
        </figure>
      </div>
    </section>

    <PlayInvite title={t.playQuiz.title} line={t.playQuiz.line} label={t.playQuiz.label} slug="ban-hieu-nam-toi-dau" />

    <!-- 5 · Closing ------------------------------------------------------- -->
    <CtaBand title={t.closingTitle} href={contactHref}>{t.closingBody}</CtaBand>
  </div>
</BaseLayout>

<script>
  /**
   * Cycle wheel. One number, the wheel's rotation, places every step:
   * step i sits at (rotation + i × 72)° on the circle. Choosing a step
   * sets a new target rotation the short way round, counted from the
   * previous target (whole degrees, so repeated turns never drift), and
   * eases the rotation there; a new choice mid-turn starts from where the
   * wheel is. Steps move along the circle without turning, so pictures,
   * numbers and labels stay upright. Each frame the arrows between
   * neighbours are redrawn along the circle, clear of pictures and labels.
   */
  const root = document.querySelector<HTMLElement>('[data-cycle]');
  const wheel = root?.querySelector<HTMLElement>('[data-wheel]');

  if (root && wheel) {
    const nodes = [...root.querySelectorAll<HTMLButtonElement>('[data-node]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const arrows = [...root.querySelectorAll<SVGPathElement>('[data-arrow]')];
    const live = root.querySelector<HTMLElement>('[data-live]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const N = nodes.length;
    const STEP = 360 / N;
    const DURATION = 700;
    // Selected picture's enlargement (CSS: .wheel__node.is-selected).
    const SELECTED_SCALE = 1.08;

    const css = (name: string, fallback: number) =>
      parseFloat(getComputedStyle(wheel).getPropertyValue(name)) || fallback;

    let radius = css('--radius', 34) / 100;
    let anchor = css('--anchor', 60);
    let selected = 0;
    let target = anchor;
    let rotation = anchor;
    let frame = 0;

    // Site easing, cubic-bezier(0.22, 0.61, 0.36, 1) (global.css --ease).
    const bezier = (x1: number, y1: number, x2: number, y2: number) => {
      const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx;
      const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
      const sx = (t: number) => ((ax * t + bx) * t + cx) * t;
      const sy = (t: number) => ((ay * t + by) * t + cy) * t;
      const dx = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
      return (x: number) => {
        let t = x;
        for (let i = 0; i < 8; i++) {
          const d = dx(t);
          if (Math.abs(d) < 1e-6) break;
          t -= (sx(t) - x) / d;
        }
        return sy(Math.min(1, Math.max(0, t)));
      };
    };
    const ease = bezier(0.22, 0.61, 0.36, 1);

    // --- Obstacles: each step's picture, number and label, measured
    // relative to its picture's centre, in fractions of the wheel width.
    interface Box { l: number; t: number; r: number; b: number }
    let discs: number[] = [];
    let boxes: Box[][] = [];

    const measure = () => {
      const width = wheel.clientWidth || 1;
      radius = css('--radius', 34) / 100;
      anchor = css('--anchor', 60);
      pad = width < 480 ? 5 / width : 0.022;
      discs = [];
      boxes = [];
      nodes.forEach((node) => {
        const box = node.getBoundingClientRect();
        const cx = box.left + box.width / 2;
        const cy = box.top + box.height / 2;
        discs.push(node.offsetWidth / 2 / width);
        boxes.push(
          [node.querySelector('.wheel__num'), node.querySelector('.wheel__label')]
            .filter((el): el is HTMLElement => !!el)
            .map((el) => {
              const r = el.getBoundingClientRect();
              return { l: (r.left - cx) / width, t: (r.top - cy) / width, r: (r.right - cx) / width, b: (r.bottom - cy) / width };
            }),
        );
      });
    };

    const point = (deg: number, r = radius) => {
      const a = (deg * Math.PI) / 180;
      return { x: r * Math.sin(a), y: -r * Math.cos(a) };
    };

    // Clearance around pictures and text, as a share of the wheel width;
    // narrow wheels keep a few pixels so their arrows still fit.
    let pad = 0.022;

    const isFree = (deg: number, centres: { x: number; y: number }[]) => {
      const p = point(deg);
      for (let j = 0; j < N; j++) {
        const c = centres[j];
        const dx = p.x - c.x;
        const dy = p.y - c.y;
        const disc = discs[j] * (j === selected ? SELECTED_SCALE : 1) + pad;
        if (dx * dx + dy * dy < disc * disc) return false;
        for (const box of boxes[j]) {
          if (dx > box.l - pad && dx < box.r + pad && dy > box.t - pad && dy < box.b + pad) return false;
        }
      }
      return true;
    };

    const toView = (v: number) => (v * 1000).toFixed(1);

    // From each step to the next, clockwise: the longest stretch of the
    // circle that is clear of every picture and label.
    const drawArrows = (rot: number) => {
      const centres = nodes.map((_, i) => point(rot + i * STEP));
      const SAMPLES = 72;
      arrows.forEach((arrow, i) => {
        const from = rot + i * STEP;
        let best = [0, -1];
        let run = -1;
        for (let s = 0; s <= SAMPLES; s++) {
          const free = isFree(from + (STEP * s) / SAMPLES, centres);
          if (free && run < 0) run = s;
          if ((!free || s === SAMPLES) && run >= 0) {
            const end = free ? s : s - 1;
            if (end - run > best[1] - best[0]) best = [run, end];
            run = -1;
          }
        }
        const a0 = from + (STEP * best[0]) / SAMPLES;
        const a1 = from + (STEP * best[1]) / SAMPLES;
        // Too short even for an arrowhead: leave it out.
        if (a1 - a0 < 4) {
          arrow.setAttribute('d', '');
          return;
        }
        const p0 = point(a0);
        const p1 = point(a1);
        const r = toView(radius);
        arrow.setAttribute('d', `M${toView(p0.x)} ${toView(p0.y)} A${r} ${r} 0 0 1 ${toView(p1.x)} ${toView(p1.y)}`);
      });
    };

    const render = (rot: number) => {
      nodes.forEach((node, i) => {
        const p = point(rot + i * STEP, radius * 100);
        node.style.setProperty('--x', p.x.toFixed(3));
        node.style.setProperty('--y', p.y.toFixed(3));
      });
      drawArrows(rot);
    };

    const animate = () => {
      cancelAnimationFrame(frame);
      if (reduce.matches) {
        rotation = target;
        render(rotation);
        return;
      }
      const from = rotation;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / DURATION);
        rotation = t === 1 ? target : from + (target - from) * ease(t);
        render(rotation);
        if (t < 1) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };

    const select = (index: number, { focus = false, announce = false } = {}) => {
      index = ((index % N) + N) % N;
      if (index !== selected) {
        // Shortest turn from the current target: always a whole multiple
        // of 72°, between -144° and 144°.
        const desired = anchor - index * STEP;
        const delta = ((((desired - target) % 360) + 540) % 360) - 180;
        target += delta;
        selected = index;
      }

      nodes.forEach((node, i) => {
        const on = i === index;
        node.classList.toggle('is-selected', on);
        node.setAttribute('aria-selected', String(on));
        node.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => panel.classList.toggle('is-active', i === index));

      if (focus) nodes[index].focus({ preventScroll: true });
      if (announce && live) {
        const title = panels[index].querySelector('.step__title')?.textContent ?? '';
        live.textContent = (root.dataset.liveTemplate ?? '{n} / {total}: {title}')
          .replace('{n}', String(index + 1))
          .replace('{total}', String(N))
          .replace('{title}', title);
      }
      animate();
    };

    nodes.forEach((node, i) => {
      node.addEventListener('click', () => select(i));
    });

    // Tabs: arrow keys move round the cycle, Home and End go to its ends.
    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      const moves: Record<string, number> = {
        ArrowRight: selected + 1,
        ArrowDown: selected + 1,
        ArrowLeft: selected - 1,
        ArrowUp: selected - 1,
        Home: 0,
        End: N - 1,
      };
      if (!(key in moves)) return;
      event.preventDefault();
      select(moves[key], { focus: true });
    });

    root.querySelector('[data-prev]')?.addEventListener('click', () => select(selected - 1, { announce: true }));
    root.querySelector('[data-next]')?.addEventListener('click', () => select(selected + 1, { announce: true }));

    // Re-measure when the wheel resizes (and once the fonts arrive); the
    // anchor may differ between layouts, so the wheel settles on it again.
    const relayout = () => {
      measure();
      const desired = anchor - selected * STEP;
      const delta = ((((desired - target) % 360) + 540) % 360) - 180;
      target += delta;
      cancelAnimationFrame(frame);
      rotation = target;
      render(rotation);
    };

    new ResizeObserver(relayout).observe(wheel);
    document.fonts?.ready.then(relayout);
    root.classList.add('is-ready');
  }

  // A link to a section (#vong-tuan-hoan, #nang-luong-mat-troi) is followed
  // before the web fonts arrive, and the opening changes height when they
  // do; once they have, line the section up again unless the reader has
  // already moved.
  const hashTarget = window.location.hash && document.getElementById(window.location.hash.slice(1));
  if (hashTarget && document.fonts) {
    let moved = false;
    const stop = () => { moved = true; };
    ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((type) =>
      window.addEventListener(type, stop, { once: true, passive: true }),
    );
    document.fonts.ready.then(() => {
      if (!moved) hashTarget.scrollIntoView({ behavior: 'instant', block: 'start' });
    });
  }

  // Film: the player replaces the poster only when asked to play.
  const film = document.querySelector<HTMLElement>('[data-film]');
  const filmPlay = film?.querySelector<HTMLButtonElement>('[data-film-play]');
  filmPlay?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube-nocookie.com/embed/Huo8YIoQgIk?autoplay=1&playsinline=1&rel=0';
    iframe.title = filmPlay.dataset.playerTitle ?? '';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.className = 'film__player';
    film.replaceChildren(iframe);
    iframe.focus({ preventScroll: true });
  }, { once: true });
</script>

<style>
  .circular-page {
    /* Homepage display serif (Lora), as on the homepage and the story page. */
    --font-display: var(--font-editorial);
  }

  /* Shared section type ----------------------------------------------------- */

  .section-title {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-h2);
    line-height: 1.12;
    letter-spacing: -0.005em;
    text-wrap: balance;
    color: var(--color-deep-green);
  }

  .section-body {
    margin-top: var(--space-m);
    max-width: 34rem;
    font-size: var(--type-body);
    line-height: 1.68;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .section-body p + p { margin-top: 0.8em; }

  .section-link { margin-top: var(--space-l); }

  /* The closing button's focus ring: forest green, visible on the cream band. */
  .circular-page :global(.cta-band__btn:focus-visible) { outline-color: var(--color-forest); }

  /* Closing band: the same title scale as the sections above. */
  .circular-page :global(.cta-band__title) {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    line-height: 1.12;
    color: var(--color-deep-green);
  }

  /* Opening ------------------------------------------------------------------ */

  .intro {
    padding-top: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .intro__inner {
    display: grid;
    row-gap: var(--space-m);
  }

  .intro__head { margin-top: clamp(1rem, 0.5rem + 2.5vw, 2.5rem); }

  .intro__title {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-title);
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-wrap: balance;
    color: var(--color-deep-green);
  }

  .intro__lead {
    max-width: 30rem;
    text-wrap: balance;
    font-family: var(--font-display);
    font-size: var(--type-lead);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .intro__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--col-gap);
      align-items: end;
    }
