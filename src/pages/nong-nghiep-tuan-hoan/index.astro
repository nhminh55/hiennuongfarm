// Six steps, in order round the wheel (clockwise). Each has a round picture
// for the wheel (-cartoon) and a square one, its paper edge drawn in, for
// its explanation (-mep-giay).
const icons = ['01-phu-pham', '02-gia-the', '03-cay-meo-u-phoi', '04-nuoi-trong-thu-hoach', '05-gia-the-nuoi-trun', '06-phan-trun-bon-cay'];
const steps = t.steps.map((step, i) => ({
  ...step,
  icon: icons[i],
}));

// Wheel geometry, shared with the script through CSS (--radius, --anchor):
// node centres sit on a circle of RADIUS % of the wheel's width, and the
// chosen step turns to ANCHOR degrees clockwise from 12 o'clock.
const RADIUS = 37;
const ANCHOR = 60;
const at = (i: number) => {
  const a = ((ANCHOR + i * (360 / steps.length)) * Math.PI) / 180;
  return { x: (RADIUS * Math.sin(a)).toFixed(3), y: (-RADIUS * Math.cos(a)).toFixed(3) };
};

const num = (i: number) => String(i + 1).padStart(2, '0');
// A longer motto (English) is set a size smaller, clear of the labels.
const longMotto = Math.max(...t.motto.map((line) => line.length)) > 12;
// The film's name without its closing full stop, for its button and player.
const filmName = t.filmTitle.replace(/[.。]$/, '');
