---
import PlayLayout from '../../components/farm-play/PlayLayout.astro';
import {cycle} from '../../data/farm-play/cycle.mjs';
import { dataFile, fill } from '../../data/copy';
// Text: src/content/choi-cung-nong-trai/chung.md (title, intro, time) and mot-vong-nong-trai.md.
const a = dataFile('choi-cung-nong-trai/chung').activities.find((a: {slug:string}) => a.slug === 'mot-vong-nong-trai');
const t = dataFile('choi-cung-nong-trai/mot-vong-nong-trai');
---
<PlayLayout title={a.title} intro={a.intro} activity="mot-vong-nong-trai" duration={a.time}>
 <section class="farm-game" data-farm-game aria-label="Ghép vòng tuần hoàn">
  <div class="farm-board">
   <div class="farm-scene"><img src="/images/farm-play/farm.webp" alt="Minh họa năm khu vực của một nông trại: kho phụ phẩm, khu chuẩn bị giá thể, nhà nấm, khu trùn và vườn cây." width="1536" height="1024" fetchpriority="high" />
    <div class="farm-destinations">{cycle.map((step,i)=><button class={'farm-destination destination-'+i} data-destination={step.id} aria-label={'Bước '+(i+1)+': '+step.place}><span class="destination-number">{i+1}</span><span class="destination-name">{step.place}</span><span class="destination-check" hidden>{t.placed}</span></button>)}</div>
   </div>
   <aside class="farm-guide"><p class="play-eyebrow">{t.guide_eyebrow}</p><h2>{t.guide_title.map((line: string, i: number) => <>{i > 0 && <br/>}{line}</>)}</h2><p>{t.guide_text}</p><p class="farm-progress" data-progress>{fill(t.progress, {done: '0'})}</p><progress max="5" value="0" aria-label="Số bước đã ghép"></progress><div class="play-actions"><button class="play-button" data-hint disabled>{t.hint_button}</button><button class="play-button play-button--outline" data-reset disabled>{t.reset_button}</button></div></aside>
  </div>
  <div class="farm-pieces" aria-label="Chọn mảnh ghép">{[cycle[2],cycle[4],cycle[0],cycle[3],cycle[1]].map(step=><button class="farm-piece" data-piece={step.id} draggable="true" aria-pressed="false"><img src={step.image} alt="" width="128" height="128"/><span>{step.name}</span></button>)}</div>
  <p class="play-feedback" data-feedback role="status" aria-live="polite">{t.start}</p>
  <div class="farm-complete" data-complete hidden><p class="play-eyebrow">{t.complete_eyebrow}</p><h2>{t.complete_title}</h2><p>{t.complete_text}</p><a class="play-link" href="/nong-nghiep-tuan-hoan/">{t.complete_link}</a></div>
  <noscript><p class="play-note">{t.noscript} <a class="play-link" href="/nong-nghiep-tuan-hoan/">{t.noscript_link}</a>.</p></noscript>
 </section>
 <script>import '../../scripts/farm-play/farm.js';</script>
</PlayLayout>
