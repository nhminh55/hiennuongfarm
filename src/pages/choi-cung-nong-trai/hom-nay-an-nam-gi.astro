---
import PlayLayout from '../../components/farm-play/PlayLayout.astro';
import {flavors,pantry} from '../../data/farm-play/recipes.mjs';
import { dataFile } from '../../data/copy';
// Text: src/content/choi-cung-nong-trai/chung.md (title, intro, time) and hom-nay-an-nam-gi.md.
const a = dataFile('choi-cung-nong-trai/chung').activities.find((a: {slug:string}) => a.slug === 'hom-nay-an-nam-gi');
const t = dataFile('choi-cung-nong-trai/hom-nay-an-nam-gi');
const times: {id:string; name:string}[] = t.times;
---
<PlayLayout title={a.title} intro={a.intro} activity="hom-nay-an-nam-gi" duration={a.time}>
 <div class="meal-tool" data-meal-tool>
  <form class="meal-form">
   <fieldset><legend><span>01</span> {t.flavor_question}</legend><div class="meal-options">{flavors.map(f=><label class="meal-choice"><input type="radio" name="flavor" value={f.id} required/><span>{f.name}</span></label>)}</div></fieldset>
   <fieldset><legend><span>02</span> {t.time_question}</legend><div class="meal-options">{times.map(time=><label class="meal-choice"><input type="radio" name="time" value={time.id} required/><span>{time.name}</span></label>)}</div></fieldset>
   <fieldset><legend><span>03</span> {t.pantry_question}</legend><p class="play-small">{t.pantry_note}</p><div class="pantry-options">{pantry.map(p=><label class="meal-choice meal-choice--pantry"><input type="checkbox" name="pantry" value={p.id}/><span>{p.name}</span></label>)}</div></fieldset>
   <button class="play-button meal-submit" type="submit" disabled>{t.submit}</button><p class="play-small meal-disclosure">{t.disclosure}</p>
  </form>
  <section class="meal-result" aria-label="Gợi ý món ăn">
   <div data-initial><p class="play-eyebrow">{t.initial_eyebrow}</p><h2>{t.initial_title.map((line: string, i: number) => <>{i > 0 && <br/>}{line}</>)}</h2><img class="meal-art" src="/images/farm-play/soup.webp" alt="Minh họa canh nấm bào ngư với đậu hũ và rau xanh" width="768" height="768"/><p>{t.initial_text}</p></div>
   <div data-no-match hidden><p class="play-eyebrow">{t.no_match_eyebrow}</p><h2 tabindex="-1">{t.no_match_title}</h2><p data-adjustment></p><button class="play-button play-button--outline" data-relax type="button">{t.relax_button}</button></div>
   <div data-result hidden><p class="play-eyebrow">{t.result_eyebrow}</p><h2 data-recipe-title tabindex="-1"></h2><p class="recipe-meta" data-recipe-meta></p><img class="meal-art" data-recipe-image src="/images/farm-play/soup.webp" width="768" height="768" alt=""/><p class="recipe-match" data-match-note></p><div class="recipe-shopping"><h3>{t.shopping_title}</h3><p class="play-small">{t.shopping_note}</p><ul data-missing></ul></div><div class="play-actions"><button class="play-button" data-details-toggle aria-expanded="false" aria-controls="recipe-details">{t.show_details}</button><button class="play-button play-button--outline" data-alternative>{t.alternative_button}</button></div><p class="play-small" data-alternative-note></p><a class="play-link" data-product href="/san-pham/#nam-bao-ngu">{t.product_link}</a></div>
   <p class="play-feedback" data-meal-feedback role="status" aria-live="polite"></p>
  </section>
  <section id="recipe-details" class="recipe-details" hidden><h2 tabindex="-1" data-details-heading></h2><p data-details-meta></p><div class="recipe-columns"><div><h3>{t.ingredients_title}</h3><ul data-ingredients></ul></div><div><h3>{t.steps_title}</h3><ol data-steps></ol><p class="play-note" data-substitution></p></div></div><button class="play-link" data-close-details>{t.hide_details}</button></section>
  <noscript><p class="play-note">{t.noscript}</p></noscript>
 </div>
 <script>import '../../scripts/farm-play/meal.js';</script>
</PlayLayout>
