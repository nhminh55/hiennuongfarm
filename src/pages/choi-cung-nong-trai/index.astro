---
import PlayLayout from '../../components/farm-play/PlayLayout.astro';
import GameIcon from '../../components/farm-play/GameIcon.astro';
import { dataFile } from '../../data/copy';
// Text: src/content/choi-cung-nong-trai/chung.md.
const t = dataFile('choi-cung-nong-trai/chung');
const activities: {slug:string; number:string; title:string; text:string; time:string; image:string}[] = t.activities;
---
<PlayLayout title={t.title} intro={t.intro}>
 <div class="play-collection">{activities.map(a=><article class="play-activity">
  <a class="activity-art" href={'/choi-cung-nong-trai/'+a.slug+'/'} tabindex="-1" aria-hidden="true"><img src={a.image} alt="" width="720" height="480" loading="lazy" /></a>
  <div class="activity-copy"><p class="play-eyebrow">{a.number} <span>{a.time}</span></p><h2><a href={'/choi-cung-nong-trai/'+a.slug+'/'}>{a.title}</a></h2><p>{a.text}</p><a class="play-link" href={'/choi-cung-nong-trai/'+a.slug+'/'}><GameIcon class="play-link__icon" size={16} /> {t.play_label}</a></div>
 </article>)}</div>
 <p class="play-note">{t.note}</p>
</PlayLayout>
