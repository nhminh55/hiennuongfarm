---
/**
 * /hop-tac/: ways to work with Hiền Nương.
 *
 * Vietnamese only (see `viOnlyPaths` in src/i18n.ts). Copy: the owner's
 * proposed invitation copy for this page (2026-10-08). It invites a
 * conversation and promises nothing further: no training, technology
 * transfer, supply guarantees or distributor terms.
 *
 * Three directions sit at the corners of an implied triangle. Choosing one
 * shows its photograph, explanation and contact link beside it; the three
 * explanations share one place, so nothing below them moves. Three short
 * strokes along the triangle's sides are measured and drawn by the script
 * so they never touch a photograph or a label. Without script the three
 * explanations are listed in order.
 *
 * Photographs: 01 Báo Nhân Dân (2025; cropped from the left, which leaves
 * out the outlet's mark), 02 Báo An Giang, 03 the original signing
 * photograph (kyket.webp, uncropped). Press photographs are cleared for
 * use by the owner.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/page/Breadcrumb.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Arrow from '../../components/Arrow.astro';
import { contact } from '../../data/site';

const mail = (subject: string) => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}`;
const zalo = `https://zalo.me/${contact.phone.replace(/^\+84/, '0')}`;

// Order round the triangle: top, bottom left, bottom right.
const directions = [
  {
    name: 'Phân phối sản phẩm',
    title: 'Đưa sản phẩm đến gần hơn.',
    text: 'Hiền Nương mong kết nối với những đối tác quan tâm đến sản phẩm từ trang trại. Cùng trao đổi về nhu cầu, nhóm sản phẩm và cách phối hợp phù hợp để đưa nông sản Việt đến gần hơn với người tiêu dùng.',
    cta: 'Trao đổi về phân phối',
    subject: 'Phân phối sản phẩm — Hiền Nương Farm',
    caption: 'Ảnh: Báo Nhân Dân',
    image: {
      src: '/images/hop-tac/phan-phoi-san-pham.webp',
      thumb: '/images/hop-tac/phan-phoi-san-pham-640.webp',
      srcset: '/images/hop-tac/phan-phoi-san-pham-640.webp 640w, /images/hop-tac/phan-phoi-san-pham.webp 1226w',
      width: 1226,
      height: 866,
      alt: 'Những khay nấm mối tươi đã hút chân không, dán nhãn Nấm Mối Nàng Nương, xếp cạnh nhau',
    },
  },
  {
    name: 'Hợp tác sản xuất',
    title: 'Kết nối từ công việc làm nông.',
    text: 'Từ hoạt động trồng nấm và tận dụng phụ phẩm nông nghiệp, Hiền Nương mong mở rộng những kết nối trong sản xuất. Chúng tôi sẵn sàng lắng nghe ý tưởng, trao đổi kinh nghiệm và cùng tìm hướng phối hợp phù hợp với điều kiện thực tế của mỗi bên.',
    cta: 'Trao đổi về sản xuất',
    subject: 'Hợp tác sản xuất — Hiền Nương Farm',
    caption: 'Ảnh: Báo An Giang',
    image: {
      src: '/images/hop-tac/hop-tac-san-xuat.webp',
      thumb: '/images/hop-tac/hop-tac-san-xuat-640.webp',
      srcset: '/images/hop-tac/hop-tac-san-xuat-640.webp 640w, /images/hop-tac/hop-tac-san-xuat.webp 1280w',
      width: 1280,
      height: 872,
      alt: 'Các lao động ngồi quanh đống giá thể trong nhà xưởng, đóng giá thể vào bịch để trồng nấm',
    },
  },
  {
    name: 'Học tập & truyền thông',
    title: 'Chia sẻ kiến thức, lan tỏa câu chuyện.',
    text: 'Những câu chuyện từ trang trại mở ra cơ hội trao đổi kiến thức và kết nối cộng đồng. Hiền Nương chào đón các đề xuất học tập và truyền thông để cùng chia sẻ góc nhìn thực tế về công việc trồng nấm và nông nghiệp tuần hoàn.',
    cta: 'Trao đổi về học tập & truyền thông',
    subject: 'Học tập & truyền thông — Hiền Nương Farm',
    caption: 'Ký kết hợp tác truyền thông với sinh viên FPT Cần Thơ · 26.06.2025',
    image: {
      // The original photograph, whole: every person in the group stays in frame.
      src: '/images/hop-tac/kyket.webp',
      thumb: '/images/hop-tac/kyket.webp',
      srcset: undefined,
      width: 800,
      height: 565,
      alt: 'Lễ ký kết hợp tác truyền thông giữa Trang trại Hiền Nương và sinh viên FPT Cần Thơ; chị Châu Thị Nương mặc áo dài đỏ ngồi ký văn bản, xung quanh là các đại biểu chụp ảnh chung',
    },
  },
];

// Học tập & truyền thông is shown first.
const initial = 2;
const num = (i: number) => String(i + 1).padStart(2, '0');
const corner = ['top', 'left', 'right'];
---
<BaseLayout
  title="Hợp tác"
  description="Hợp tác cùng Hiền Nương Farm: phân phối sản phẩm, hợp tác sản xuất, học tập và truyền thông. Bắt đầu từ một cuộc trò chuyện."
>
  <div class="partner-page">
    <header class="intro">
      <div class="container intro__inner">
        <Breadcrumb items={[{ label: 'Trang chủ', href: '/' }, { label: 'Hợp tác' }]} />
        <div class="intro__head" data-reveal>
          <Eyebrow>Hợp tác cùng Hiền Nương</Eyebrow>
          <h1 class="intro__title">Cùng nhau mở rộng những giá trị.</h1>
        </div>
        <p class="intro__lead" data-reveal style="--reveal-delay: 120ms">
          Chúng tôi chào đón những kết nối trong sản xuất, phân phối và chia sẻ kiến thức về nông nghiệp bền vững. Mỗi sự đồng hành là cơ hội để cùng học hỏi và phát triển lâu&nbsp;dài.
        </p>
      </div>
    </header>

    <!-- 1 · Three directions ---------------------------------------------- -->
    <section class="ways" id="thong-tin-hop-tac" aria-labelledby="ways-title" data-ways>
      <div class="container">
        <div class="ways__head" data-reveal>
          <h2 class="ways__title" id="ways-title">Bạn muốn đồng hành theo cách nào?</h2>
          <p class="ways__hint">Chọn một hướng để tìm hiểu.</p>
        </div>

        <div class="ways__grid">
          <div class="ways__picker" data-reveal style="--reveal-delay: 80ms">
            <div class="tri" role="tablist" aria-label="Ba hướng hợp tác" data-tri>
              <svg class="tri__lines" aria-hidden="true" focusable="false" data-lines>
                <line data-line /><line data-line /><line data-line />
              </svg>

              {directions.map((d, i) => (
                <button
                  class:list={['tri__item', `tri__item--${corner[i]}`, { 'is-selected': i === initial }]}
                  type="button"
                  role="tab"
                  id={`ways-tab-${i + 1}`}
                  aria-controls={`ways-panel-${i + 1}`}
                  aria-selected={i === initial ? 'true' : 'false'}
                  tabindex={i === initial ? 0 : -1}
                  data-tab
                >
                  <span class="tri__frame" data-frame>
                    <img
                      src={d.image.thumb}
                      alt=""
                      width={d.image.width}
                      height={d.image.height}
                      decoding="async"
                    />
                  </span>
                  <span class="tri__label" data-label>
                    <span class="tri__num">{num(i)}</span>
                    <span class="tri__name">{d.name}</span>
                  </span>
                </button>
              ))}

              <p class="tri__centre" aria-hidden="true" data-centre>
                <span class="tri__with">Cùng</span>
                <span class="tri__brand">Hiền Nương</span>
              </p>
            </div>
          </div>

          <div class="ways__detail" data-reveal style="--reveal-delay: 160ms">
            <div class="ways__panels">
              {directions.map((d, i) => (
                <div
                  class:list={['way', { 'is-active': i === initial }]}
                  id={`ways-panel-${i + 1}`}
                  role="tabpanel"
                  aria-labelledby={`ways-tab-${i + 1}`}
                  data-panel
                >
                  <div class="way__photo">
                    <img
                      src={d.image.src}
                      srcset={d.image.srcset}
                      sizes={d.image.srcset ? '(min-width: 1024px) 38vw, (min-width: 768px) 36rem, 100vw' : undefined}
                      width={d.image.width}
                      height={d.image.height}
                      alt={d.image.alt}
                      decoding="async"
                    />
                  </div>
                  <p class="way__caption">{d.caption}</p>

                  <div class="way__body">
                    <p class="way__kicker">
                      <span class="way__num">{num(i)}</span>
                      <span class="way__rule" aria-hidden="true"></span>
                      <span>{d.name}</span>
                    </p>
                    <h3 class="way__title">{d.title}</h3>
                    <p class="way__text">{d.text}</p>
                    <a class="btn way__cta" href={mail(d.subject)}>{d.cta} <Arrow /></a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · Invitation ------------------------------------------------------ -->
    <section class="section invite" id="lien-he" aria-labelledby="invite-title">
      <div class="container grid invite__grid">
        <div class="invite__heading" data-reveal>
          <Eyebrow>Liên hệ</Eyebrow>
          <h2 class="invite__title" id="invite-title">Bắt đầu từ một cuộc trò chuyện.</h2>
        </div>

        <div class="invite__body" data-reveal style="--reveal-delay: 120ms">
          <p class="invite__text">Hãy chia sẻ ý tưởng và nhu cầu của bạn. Hiền Nương mong được cùng bạn tìm ra hướng hợp tác phù hợp.</p>
          <a class="btn invite__cta" href={mail('Hợp tác cùng Hiền Nương Farm')}>Liên hệ Hiền Nương <Arrow /></a>

          <!-- The site's existing contact channels (src/data/site.ts). -->
          <dl class="channels">
            <div class="channels__row">
              <dt>Email</dt>
              <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
            </div>
            <div class="channels__row">
              <dt>Điện thoại</dt>
              <dd>
                <a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a>
                <a href={`tel:${contact.phone2}`}>{contact.phone2Display}</a>
              </dd>
            </div>
            <div class="channels__row">
              <dt>Zalo</dt>
              <dd><a href={zalo} target="_blank" rel="noopener">{contact.phoneDisplay}</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /**
   * Three directions as tabs. Choosing one swaps the explanation (the
   * fade lives in CSS); arrow keys move between the three and Home/End go
   * to the first and last.
   *
   * The strokes: each side of the triangle runs between two photographs'
   * centres. Along it, find the longest stretch clear of every photograph,
   * label and the centre words (with a margin), and draw a short piece
   * from its middle. A side with too little room gets no stroke.
   */
  const root = document.querySelector<HTMLElement>('[data-ways]');
  const tri = root?.querySelector<HTMLElement>('[data-tri]');

  if (root && tri) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const N = tabs.length;
    let selected = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');

    const select = (index: number, { focus = false } = {}) => {
      index = ((index % N) + N) % N;
      selected = index;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.classList.toggle('is-selected', on);
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => panel.classList.toggle('is-active', i === index));
      if (focus) tabs[index].focus({ preventScroll: true });
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));

    tri.addEventListener('keydown', (event) => {
      const moves: Record<string, number> = {
        ArrowRight: selected + 1,
        ArrowDown: selected + 1,
        ArrowLeft: selected - 1,
        ArrowUp: selected - 1,
        Home: 0,
        End: N - 1,
      };
      if (!(event.key in moves)) return;
      event.preventDefault();
      select(moves[event.key], { focus: true });
    });

    // --- Strokes ---------------------------------------------------------
    const svg = tri.querySelector<SVGSVGElement>('[data-lines]');
    const lines = [...tri.querySelectorAll<SVGLineElement>('[data-line]')];
    const frames = [...tri.querySelectorAll<HTMLElement>('[data-frame]')];
    const labels = [...tri.querySelectorAll<HTMLElement>('[data-label]')];
    const centre = tri.querySelector<HTMLElement>('[data-centre]');
    // Top–bottom left, top–bottom right, bottom left–bottom right.
    const sides: [number, number][] = [[0, 1], [0, 2], [1, 2]];

    interface Box { l: number; t: number; r: number; b: number }

    const draw = () => {
      if (!svg) return;
      const origin = tri.getBoundingClientRect();
      const width = origin.width;
      const height = origin.height;
      if (!width) return;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

      const rel = (el: Element): Box => {
        const r = el.getBoundingClientRect();
        return { l: r.left - origin.left, t: r.top - origin.top, r: r.right - origin.left, b: r.bottom - origin.top };
      };
      const boxes = [...frames, ...labels, ...(centre ? [...centre.children] : [])].map(rel);
      const centres = frames.map(rel).map((b) => ({ x: (b.l + b.r) / 2, y: (b.t + b.b) / 2 }));
      // Clearance from photographs and text.
      const pad = Math.max(8, width * 0.025);
      const free = (x: number, y: number) =>
        boxes.every((b) => x < b.l - pad || x > b.r + pad || y < b.t - pad || y > b.b + pad);

      const SAMPLES = 200;
      sides.forEach(([a, b], i) => {
        const p = centres[a];
        const q = centres[b];
        let best = [0, -1];
        let run = -1;
        for (let s = 0; s <= SAMPLES; s++) {
          const t = s / SAMPLES;
          const ok = free(p.x + (q.x - p.x) * t, p.y + (q.y - p.y) * t);
          if (ok && run < 0) run = s;
          if ((!ok || s === SAMPLES) && run >= 0) {
            const end = ok ? s : s - 1;
            if (end - run > best[1] - best[0]) best = [run, end];
            run = -1;
          }
        }
        const sideLength = Math.hypot(q.x - p.x, q.y - p.y);
        const room = ((best[1] - best[0]) / SAMPLES) * sideLength;
        // Short: at most 60% of the free stretch and 14% of the width.
        const length = Math.min(room * 0.6, width * 0.14);
        const line = lines[i];
        if (length < 14) {
          line.style.display = 'none';
          return;
        }
        line.style.display = '';
        const mid = (best[0] + best[1]) / 2 / SAMPLES;
        const half = length / 2 / sideLength;
        const at = (t: number) => ({ x: p.x + (q.x - p.x) * t, y: p.y + (q.y - p.y) * t });
        const from = at(mid - half);
        const to = at(mid + half);
        line.setAttribute('x1', from.x.toFixed(1));
        line.setAttribute('y1', from.y.toFixed(1));
        line.setAttribute('x2', to.x.toFixed(1));
        line.setAttribute('y2', to.y.toFixed(1));
      });
    };

    new ResizeObserver(draw).observe(tri);
    document.fonts?.ready.then(draw);
    draw();
  }
</script>

<style>
  .partner-page {
    /* Homepage display serif (Lora), as on the other secondary pages. */
    --font-display: var(--font-editorial);
    --section-y: clamp(3.5rem, 2rem + 4.5vw, 6.5rem);
  }

  /* Opening ------------------------------------------------------------------ */

  .intro {
    padding-top: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .intro__inner {
    display: grid;
    row-gap: var(--space-m);
  }

  .intro__head { margin-top: clamp(1rem, 0.5rem + 2.5vw, 2.5rem); }

  .intro__title {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--color-deep-green);
  }

  .intro__lead {
    max-width: 32rem;
    font-size: var(--type-body);
    line-height: 1.68;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  @media (min-width: 1024px) {
    .intro__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--col-gap);
      align-items: end;
    }
    .intro__inner > :global(.breadcrumb) { grid-column: 1 / -1; }
    .intro__lead { justify-self: end; padding-bottom: 0.4rem; }
  }

  /* Directions -------------------------------------------------------------- */

  .ways {
    padding-top: var(--space-l);
    padding-bottom: var(--section-y);
  }

  .ways__head {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-line);
  }

  .ways__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 1.4rem + 1.3vw, 2.5rem);
    line-height: 1.16;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--color-deep-green);
  }

  .ways__hint {
    margin-top: var(--space-xs);
    font-size: var(--type-small);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  :global(html:not(.js)) .ways__hint { display: none; }

  .ways__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  /* The triangle -------------------------------------------------------------
     A three-row grid: the top photograph centred, the centre words, then
     the two lower photographs at the outer edges. Photograph widths follow
     the selector's own width (--w, a share of it). */

  .ways__picker { container-type: inline-size; }

  .tri {
    --w: 42cqi;
    position: relative;
    display: grid;
    grid-template-columns: var(--w) minmax(0, 1fr) var(--w);
    grid-template-areas:
      "top  top  top"
      "mid  mid  mid"
      "left .    right";
    width: 100%;
  }

  .tri__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    stroke: var(--color-earth);
    stroke-opacity: 0.7;
    stroke-width: 1;
    stroke-linecap: round;
  }

  .tri__item {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.625rem;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
  }
  .tri__item--top {
    grid-area: top;
    /* The top photograph has the lower ones' width, centred. */
    width: var(--w);
    justify-self: center;
  }
  .tri__item--left { grid-area: left; }
  .tri__item--right { grid-area: right; }
  .tri__item:focus-visible { outline: none; }

  /* The frame keeps its padding and border at all times, so selecting a
     photograph changes only the border colour. */
  .tri__frame {
    display: block;
    padding: 4px;
    border: 1px solid transparent;
    transition: border-color 300ms var(--ease);
  }
  .tri__frame img {
    width: 100%;
    aspect-ratio: 800 / 565;
    object-fit: cover;
    background: var(--color-cream);
  }

  .tri__label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-inline: 4px;
    min-height: 2.75rem;
  }

  .tri__num {
    flex: none;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 6.5cqi, 2.375rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-earth);
  }

  .tri__name {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 3cqi, 1.1875rem);
    line-height: 1.3;
    text-wrap: balance;
    color: var(--color-text);
    transition: color 300ms var(--ease);
  }

  .tri__item:hover .tri__name { color: var(--color-forest); }
  .tri__item:not(.is-selected):hover .tri__frame { border-color: var(--color-line-strong); }

  /* Chosen direction: a thin muted-gold frame and a gold label. */
  .tri__item.is-selected .tri__frame { border-color: var(--color-earth); }
  .tri__item.is-selected .tri__name { color: var(--color-earth); }

  /* Keyboard focus: a forest ring outside the frame, and an underline. */
  .tri__item:focus-visible .tri__frame {
    outline: 2px solid var(--color-forest);
    outline-offset: 3px;
  }
  .tri__item:focus-visible .tri__name {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 0.2em;
  }

  .tri__centre {
    grid-area: mid;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(1.25rem, 6cqi, 2.75rem) clamp(1.5rem, 7cqi, 3rem);
    font-family: var(--font-display);
    text-align: center;
    pointer-events: none;
  }

  .tri__with {
    font-style: italic;
    font-size: clamp(1rem, 3.6cqi, 1.375rem);
    line-height: 1.2;
    color: var(--color-earth);
  }

  .tri__brand {
    font-size: clamp(1.25rem, 5cqi, 1.875rem);
    line-height: 1.2;
    white-space: nowrap;
