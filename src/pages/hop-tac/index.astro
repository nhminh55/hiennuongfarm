---
/**
 * /hop-tac/: ways to work with Hiền Nương.
 *
 * Vietnamese only (see `viOnlyPaths` in src/i18n.ts). Copy: the owner's
 * proposed invitation copy for this page (2026-10-08). It invites a
 * conversation and promises nothing further: no training, technology
 * transfer, supply guarantees or distributor terms.
 *
 * 1 · Three directions, as three photographic prints on a cream tabletop
 * at the corners of an implied triangle. Unchosen prints lie slightly
 * askew; the chosen one straightens, lifts and takes a thin gold edge.
 * Its photograph, explanation and contact link show beside the table; the
 * three explanations share one place, so nothing below them moves. Three
 * short strokes along the triangle's sides are measured and drawn by the
 * script so they never touch a print or a label. Without script the
 * three explanations are listed in order.
 *
 * 2 · Partners & connections: six names in a static grid. Choosing one
 * shows its documented connection in one shared place below the names,
 * with the source to read. Each description says only what its source
 * says; students and lecturers are named as people, not as their
 * institutions, and programmes are named as programmes.
 *
 * 3 · Closing: the same three directions as compact choices, kept in step
 * with the tabletop. The choice goes into the prepared email's subject;
 * nothing is sent until the visitor sends it.
 *
 * Photographs: 01 Báo Nhân Dân (2025; cropped from the left, which leaves
 * out the outlet's mark), 02 Báo An Giang, 03 the original signing
 * photograph (kyket.webp, uncropped). Partner photographs come from the
 * sources they illustrate. Press photographs are cleared for use by the
 * owner.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/page/Breadcrumb.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Arrow from '../../components/Arrow.astro';
import { contact } from '../../data/site';
import { dataFile, fill } from '../../data/copy';

const mail = (subject: string) => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}`;
const zalo = `https://zalo.me/${contact.phone.replace(/^\+84/, '0')}`;

// Copy: src/content/hop-tac/ (Vietnamese only, edited in the admin).
const intro = dataFile('hop-tac/gioi-thieu');
const ways = dataFile('hop-tac/huong-hop-tac');
const links = dataFile('hop-tac/doi-tac');
const invite = dataFile('hop-tac/lien-he');

// Order round the triangle: top, bottom left, bottom right. The third
// photograph is the original, whole: every person in the group stays in frame.
const directions: { name: string; short: string; title: string; text: string; cta: string; subject: string; caption: string;
  image: { src: string; thumb: string; srcset?: string; width: number; height: number; alt: string } }[] = ways.directions;

// Học tập & truyền thông is shown first.
const initial = 2;
const num = (i: number) => String(i + 1).padStart(2, '0');
const corner = ['top', 'left', 'right'];

interface Partner {
  name: string;
  /** What kind of connection, and when: a short line above the name. */
  kind: string;
  text: string;
  /** The source to read, and the outlet named beside its link. */
  outlet: { href: string; label: string };
  photo?: { src: string; srcset?: string; width: number; height: number; alt: string; caption: string };
}

// Sources, checked 2026-10-09:
// FPT: daihoc.fpt.edu.vn (02.07.2025, from Báo Cần Thơ): signed by the
//   student group, as a graduation project, not by the university.
// Lecturers, LHPN: vwu.vn (Hội LHPN Việt Nam, 10.10.2022). The lecturers
//   are people chị Nương learned from, in her own account; no agreement
//   with either university is documented.
// Oxfam: vietnam.oxfam.org image story, tagged GRAISEA 2; the year (2022)
//   from vwu.vn (11.08.2023).
// Hội Nông dân: nhandan.vn (08.10.2025) for the 2025 title;
//   hoinongdan.org.vn (06.03.2026) for the visit. Photo: Dân Việt, whose
//   caption it follows.
// Order of the grid, row by row. Each text says only what its source says.
// The FPT photograph is the third direction's.
const partners: Partner[] = links.partners;
---
<BaseLayout
  title={intro.title}
  description={intro.nang_cao.description}
>
  <div class="partner-page" data-partner-page>
    <header class="intro">
      <div class="container intro__inner">
        <Breadcrumb items={[{ label: intro.home, href: '/' }, { label: intro.title }]} />
        <div class="intro__head" data-reveal>
          <Eyebrow>{intro.eyebrow}</Eyebrow>
          <h1 class="intro__title">{intro.heading}</h1>
        </div>
        <p class="intro__lead" data-reveal style="--reveal-delay: 120ms">
          {intro.lead.split('\u00a0').map((part: string, i: number) => <>{i > 0 && <Fragment set:html={'&nbsp;'} />}{part}</>)}
        </p>
      </div>
    </header>

    <!-- 1 · Three directions ---------------------------------------------- -->
    <section class="ways" id="thong-tin-hop-tac" aria-label={ways.nang_cao.label} data-ways>
      <div class="container ways__grid">
        <div class="ways__picker">
          <p class="ways__hint" data-reveal>{ways.hint}</p>

          <div class="tri" role="tablist" aria-label={ways.nang_cao.label} data-tri data-reveal style="--reveal-delay: 80ms">
            <svg class="tri__lines" aria-hidden="true" focusable="false" data-lines>
              <line data-line /><line data-line /><line data-line />
            </svg>

            {directions.map((d, i) => (
              <button
                class:list={['tri__item', `tri__item--${corner[i]}`, { 'is-selected': i === initial }]}
                type="button"
                role="tab"
                id={`ways-tab-${i + 1}`}
                aria-controls={`ways-panel-${i + 1}`}
                aria-selected={i === initial ? 'true' : 'false'}
                tabindex={i === initial ? 0 : -1}
                data-tab
              >
                <!-- The frame keeps the print's place untilted, for measuring;
                     the print inside it is the paper that tilts and lifts. -->
                <span class="tri__frame" data-frame>
                  <span class="tri__print">
                    <img
                      src={d.image.thumb}
                      alt=""
                      width={d.image.width}
                      height={d.image.height}
                      decoding="async"
                    />
                  </span>
                </span>
                <span class="tri__label" data-label>
                  <span class="tri__num">{num(i)}</span>
                  <span class="tri__name">{d.name}</span>
                </span>
              </button>
            ))}

            <p class="tri__centre" aria-hidden="true" data-centre>
              <span class="tri__with">{ways.centreWith}</span>
              <span class="tri__brand">{ways.centreBrand}</span>
            </p>
          </div>
        </div>

        <div class="ways__detail" data-reveal style="--reveal-delay: 160ms">
          <div class="ways__panels">
            {directions.map((d, i) => (
              <div
                class:list={['way', { 'is-active': i === initial }]}
                id={`ways-panel-${i + 1}`}
                role="tabpanel"
                aria-labelledby={`ways-tab-${i + 1}`}
                data-panel
              >
                <div class="way__photo">
                  <img
                    src={d.image.src}
                    srcset={d.image.srcset}
                    sizes={d.image.srcset ? '(min-width: 1024px) 38vw, (min-width: 768px) 36rem, 100vw' : undefined}
                    width={d.image.width}
                    height={d.image.height}
                    alt={d.image.alt}
                    decoding="async"
                  />
                </div>
                <p class="way__caption">{d.caption}</p>

                <div class="way__body">
                  <p class="way__kicker">
                    <span class="way__num">{num(i)}</span>
                    <span class="way__rule" aria-hidden="true"></span>
                    <span>{d.name}</span>
                  </p>
                  <h3 class="way__title">{d.title}</h3>
                  <p class="way__text">{d.text}</p>
                  <a class="btn way__cta" href={mail(d.subject)}>{d.cta} <Arrow /></a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · Partners & connections ------------------------------------------ -->
    <section class="section links" id="doi-tac" aria-labelledby="links-title" data-links>
      <div class="container">
        <div class="links__head" data-reveal>
          <div>
            <Eyebrow>{links.eyebrow}</Eyebrow>
            <h2 class="links__title" id="links-title">{links.title}</h2>
          </div>
          <p class="links__lead">{links.lead}</p>
        </div>

        <div class="links__names" role="tablist" aria-label={links.nang_cao.namesLabel} data-reveal style="--reveal-delay: 80ms" data-names>
          {partners.map((p, i) => (
            <button
              class:list={['links__name', { 'is-selected': i === 0 }]}
              type="button"
              role="tab"
              id={`links-tab-${i + 1}`}
              aria-controls={`links-panel-${i + 1}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab
            >
              <span>{p.name}</span>
            </button>
          ))}
        </div>

        <div class="links__panels" data-reveal style="--reveal-delay: 140ms">
          {partners.map((p, i) => (
            <div
              class:list={['link', { 'is-active': i === 0, 'link--text': !p.photo }]}
              id={`links-panel-${i + 1}`}
              role="tabpanel"
              aria-labelledby={`links-tab-${i + 1}`}
              data-panel
            >
              {p.photo && (
                <figure class="link__photo">
                  <img
                    src={p.photo.src}
                    srcset={p.photo.srcset}
                    sizes={p.photo.srcset ? '(min-width: 1024px) 34vw, (min-width: 768px) 40vw, 100vw' : undefined}
                    width={p.photo.width}
                    height={p.photo.height}
                    alt={p.photo.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{p.photo.caption}</figcaption>
                </figure>
              )}
              <div class="link__body">
                <p class="link__kind">{p.kind}</p>
                <h3 class="link__name">{p.name}</h3>
                <p class="link__text">{p.text}</p>
                <p class="link__source">
                  <a class="link-arrow" href={p.outlet.href} target="_blank" rel="noopener">
                    {links.more} <span class="sr-only">{fill(links.nang_cao.moreSr, { name: p.name, outlet: p.outlet.label })}</span><Arrow direction="up-right" />
                  </a>
                  <span class="link__outlet" aria-hidden="true">{p.outlet.label}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3 · Invitation ------------------------------------------------------ -->
    <section class="section invite" id="lien-he" aria-labelledby="invite-title">
      <div class="container grid invite__grid">
        <div class="invite__heading" data-reveal>
          <Eyebrow>{invite.eyebrow}</Eyebrow>
          <h2 class="invite__title" id="invite-title">{invite.title}</h2>
          <p class="invite__text">{invite.text}</p>
        </div>

        <div class="invite__body" data-reveal style="--reveal-delay: 120ms">
          <!-- The same three directions as the tabletop, kept in step with it. -->
          <div class="choices" role="group" aria-labelledby="choices-label" data-choices>
            <p class="choices__label" id="choices-label">{invite.choicesLabel}</p>
            <div class="choices__row">
              {directions.map((d, i) => (
                <button
                  class="choices__item"
                  type="button"
                  aria-pressed={i === initial ? 'true' : 'false'}
                  data-choice
                  data-href={mail(d.subject)}
                  data-subject={d.subject}
                >{d.short}</button>
              ))}
            </div>
          </div>

          <a class="btn invite__cta" href={mail(directions[initial].subject)} data-invite-cta>{invite.cta} <Arrow /></a>
          <p class="invite__note">
            {invite.noteBefore} <span class="invite__subject" data-invite-subject>{directions[initial].subject}</span>{invite.noteAfter}
          </p>

          <!-- The site's existing contact channels (src/data/site.ts). -->
          <dl class="channels">
            <div class="channels__row">
              <dt>{invite.email}</dt>
              <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
            </div>
            <div class="channels__row">
              <dt>{invite.phone}</dt>
              <dd>
                <a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a>
                <a href={`tel:${contact.phone2}`}>{contact.phone2Display}</a>
              </dd>
            </div>
            <div class="channels__row">
              <dt>{invite.zalo}</dt>
              <dd><a href={zalo} target="_blank" rel="noopener">{contact.phoneDisplay}</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /**
   * Two sets of tabs share one behaviour: choosing a tab shows its panel
   * (the fades live in CSS); arrow keys move between tabs and Home/End go
   * to the first and last.
   *
   * The three directions also drive the closing choices, and the closing
   * choices drive them: one selected direction for the whole page.
   *
   * The strokes: each side of the triangle runs between two prints'
   * centres. Along it, find the longest stretch clear of every print,
   * label and the centre words (with a margin), and draw a short piece
   * from its middle. A side with too little room gets no stroke.
   */
  const tabs = (list: HTMLElement, onSelect?: (index: number) => void) => {
    const buttons = [...list.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = buttons.map((b) => document.getElementById(b.getAttribute('aria-controls') ?? ''));
    const N = buttons.length;
    let selected = Math.max(0, buttons.findIndex((b) => b.getAttribute('aria-selected') === 'true'));

    const select = (index: number, { focus = false, notify = true } = {}) => {
      index = ((index % N) + N) % N;
      selected = index;
      buttons.forEach((b, i) => {
        const on = i === index;
        b.classList.toggle('is-selected', on);
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => panel?.classList.toggle('is-active', i === index));
      if (focus) buttons[index].focus({ preventScroll: true });
      if (notify) onSelect?.(index);
    };

    buttons.forEach((b, i) => b.addEventListener('click', () => select(i)));

    list.addEventListener('keydown', (event) => {
      const moves: Record<string, number> = {
        ArrowRight: selected + 1,
        ArrowDown: selected + 1,
        ArrowLeft: selected - 1,
        ArrowUp: selected - 1,
        Home: 0,
        End: N - 1,
      };
      if (!(event.key in moves)) return;
      event.preventDefault();
      select(moves[event.key], { focus: true });
    });

    return select;
  };

  // --- Directions and the closing choices --------------------------------
  const tri = document.querySelector<HTMLElement>('[data-ways] [data-tri]');
  const choices = [...document.querySelectorAll<HTMLButtonElement>('[data-choice]')];
  const cta = document.querySelector<HTMLAnchorElement>('[data-invite-cta]');
  const subject = document.querySelector<HTMLElement>('[data-invite-subject]');

  const showChoice = (index: number) => {
    choices.forEach((c, i) => c.setAttribute('aria-pressed', String(i === index)));
    const choice = choices[index];
    if (!choice) return;
    if (cta && choice.dataset.href) cta.href = choice.dataset.href;
    if (subject) subject.textContent = choice.dataset.subject ?? '';
  };

  if (tri) {
    const selectDirection = tabs(tri, showChoice);
    choices.forEach((c, i) =>
      c.addEventListener('click', () => {
        selectDirection(i, { notify: false });
        showChoice(i);
      }),
    );

    // --- Strokes ---------------------------------------------------------
    const svg = tri.querySelector<SVGSVGElement>('[data-lines]');
    const lines = [...tri.querySelectorAll<SVGLineElement>('[data-line]')];
    const frames = [...tri.querySelectorAll<HTMLElement>('[data-frame]')];
    const labels = [...tri.querySelectorAll<HTMLElement>('[data-label]')];
    const centre = tri.querySelector<HTMLElement>('[data-centre]');
    // Top–bottom left, top–bottom right, bottom left–bottom right.
    const sides: [number, number][] = [[0, 1], [0, 2], [1, 2]];

    interface Box { l: number; t: number; r: number; b: number }

    const draw = () => {
      if (!svg) return;
      const origin = tri.getBoundingClientRect();
      const width = origin.width;
      const height = origin.height;
      if (!width) return;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

      const rel = (el: Element): Box => {
        const r = el.getBoundingClientRect();
        return { l: r.left - origin.left, t: r.top - origin.top, r: r.right - origin.left, b: r.bottom - origin.top };
      };
      const boxes = [...frames, ...labels, ...(centre ? [...centre.children] : [])].map(rel);
      const centres = frames.map(rel).map((b) => ({ x: (b.l + b.r) / 2, y: (b.t + b.b) / 2 }));
      // Clearance from prints (which tilt and cast a shadow past their
      // frame) and text.
      const pad = Math.max(12, width * 0.04);
      const free = (x: number, y: number) =>
        boxes.every((b) => x < b.l - pad || x > b.r + pad || y < b.t - pad || y > b.b + pad);

      const SAMPLES = 200;
      sides.forEach(([a, b], i) => {
        const p = centres[a];
        const q = centres[b];
        let best = [0, -1];
        let run = -1;
        for (let s = 0; s <= SAMPLES; s++) {
          const t = s / SAMPLES;
          const ok = free(p.x + (q.x - p.x) * t, p.y + (q.y - p.y) * t);
          if (ok && run < 0) run = s;
          if ((!ok || s === SAMPLES) && run >= 0) {
            const end = ok ? s : s - 1;
            if (end - run > best[1] - best[0]) best = [run, end];
            run = -1;
          }
        }
        const sideLength = Math.hypot(q.x - p.x, q.y - p.y);
        const room = ((best[1] - best[0]) / SAMPLES) * sideLength;
        // Short: at most 60% of the free stretch and 14% of the width.
        const length = Math.min(room * 0.6, width * 0.14);
        const line = lines[i];
        if (length < 14) {
          line.style.display = 'none';
          return;
        }
        line.style.display = '';
        const mid = (best[0] + best[1]) / 2 / SAMPLES;
        const half = length / 2 / sideLength;
        const at = (t: number) => ({ x: p.x + (q.x - p.x) * t, y: p.y + (q.y - p.y) * t });
        const from = at(mid - half);
        const to = at(mid + half);
        line.setAttribute('x1', from.x.toFixed(1));
        line.setAttribute('y1', from.y.toFixed(1));
        line.setAttribute('x2', to.x.toFixed(1));
        line.setAttribute('y2', to.y.toFixed(1));
      });
    };

    new ResizeObserver(draw).observe(tri);
    document.fonts?.ready.then(draw);
    draw();
  }

  // --- Partners & connections ---------------------------------------------
  const names = document.querySelector<HTMLElement>('[data-links] [data-names]');
  if (names) tabs(names);
</script>

<style>
  .partner-page {
    /* Homepage display serif (Lora), as on the other secondary pages. */
    --font-display: var(--font-editorial);
    /* The table the prints lie on: a shade warmer than the page. */
    --tabletop: #EEE8DB;
    --print-paper: #FCFAF5;
    --print-shadow: 0 1px 2px rgba(32, 34, 31, 0.1), 0 10px 18px -10px rgba(32, 34, 31, 0.32);
    --print-shadow-lift: 0 2px 4px rgba(32, 34, 31, 0.08), 0 22px 30px -14px rgba(32, 34, 31, 0.36);
  }

  /* Opening ------------------------------------------------------------------ */

  .intro {
    padding-top: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    padding-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .intro__inner {
    display: grid;
    row-gap: var(--space-m);
  }

  .intro__head { margin-top: clamp(1rem, 0.5rem + 2.5vw, 2.5rem); }

  .intro__title {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-title);
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-wrap: balance;
    color: var(--color-deep-green);
  }

  .intro__lead {
    max-width: 32rem;
    font-size: var(--type-body);
    line-height: 1.68;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  @media (min-width: 1024px) {
    .intro__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--col-gap);
      align-items: end;
    }
    .intro__inner > :global(.breadcrumb) { grid-column: 1 / -1; }
    .intro__lead { justify-self: end; padding-bottom: 0.4rem; }
  }

  /* Directions -------------------------------------------------------------- */

  /* The tabletop runs edge to edge between two hairlines; the section
     clips its overhang so the page never scrolls sideways. */
  .ways {
    border-block: 1px solid var(--color-line);
    overflow-x: clip;
  }

  .ways__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .ways__picker {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    padding-block: clamp(2rem, 1.25rem + 3vw, 4.5rem) clamp(2.25rem, 1.5rem + 3vw, 4.5rem);
  }
  .ways__picker::before {
    content: "";
    position: absolute;
    inset: 0 -100vw;
    z-index: -1;
    background: var(--tabletop);
  }

  .ways__hint {
    text-align: center;
    font-size: var(--type-small);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin-bottom: clamp(1.25rem, 5cqi, 2.5rem);
  }

  :global(html:not(.js)) .ways__hint { display: none; }

  /* The triangle -------------------------------------------------------------
     A three-row grid: the top print centred, the centre words, then the
     two lower prints at the outer edges. Print widths follow the
     selector's own width (--w, a share of it). */

  .tri {
    --w: 42cqi;
    position: relative;
    display: grid;
    grid-template-columns: var(--w) minmax(0, 1fr) var(--w);
    grid-template-areas:
      "top  top  top"
      "mid  mid  mid"
      "left .    right";
    width: 100%;
  }

  .tri__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    stroke: var(--color-earth);
    stroke-opacity: 0.7;
    stroke-width: 1;
    stroke-linecap: round;
  }

  /* The whole print and its label are one button. */
  .tri__item {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: clamp(0.75rem, 3.5cqi, 1.25rem);
    text-align: center;
    -webkit-tap-highlight-color: transparent;
  }
  .tri__item--top {
    grid-area: top;
    /* The top print has the lower ones' width, centred. */
    width: var(--w);
    justify-self: center;
    --tilt: 2deg;
  }
  .tri__item--left { grid-area: left; --tilt: -2.75deg; }
  .tri__item--right { grid-area: right; --tilt: 2.5deg; }
  .tri__item:focus-visible { outline: none; }
  .tri__item.is-selected { z-index: 2; }

  .tri__frame { display: block; }

  /* The print: photograph on a paper mat with a hairline edge. Every
     print has the same proportions, whatever its photograph's. */
  .tri__print {
    display: block;
    padding: clamp(4px, 1.6cqi, 9px);
    background: var(--print-paper);
    border: 1px solid rgba(32, 34, 31, 0.08);
    box-shadow: var(--print-shadow);
